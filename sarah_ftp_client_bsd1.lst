9705+ 8D57              				;bit 0=dir already read?, 0=no, 1=yes
9706+ 8D57              				;bit 1=current items in memory, 0=abbreviated, 1=full
9707+ 8D57              				;bit 2=user wished items in memory, 0=abbreviated, 1=full

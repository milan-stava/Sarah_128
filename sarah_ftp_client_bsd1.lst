   1++9F0D              ; Shared ESP-AT framing above the unchanged Wi-Fi BIOS.
   2++9F0D              ; Firmware dialect retained: +CIPRECVDATA,<length>:<binary>.
   3++9F0D              ; Events: 1 OK, 2 ERROR, 3 prompt, 4 SEND OK, 5 SEND FAIL,
   4++9F0D              ;         6 busy, 7 active IPD header, 8 receive-data header, 0 other.
   5++9F0D              ; Binary payload is never searched for AT result strings.
   6++9F0D              AT_OK equ 1
   7++9F0D              AT_ERROR equ 2
   8++9F0D              AT_PROMPT equ 3

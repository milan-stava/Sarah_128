 9582+87DA ~            ;95) set_fdma_to_chars
 9583+87DA ~            ; --- DOKUMENTACE CZ: set_fdma_to_chars ---
 9584+87DA ~            ; Ucel: Nastaví FDMA pro vykreslování osmibajtových znaků.
 9585+87DA ~            ; Vstup: Bez parametrů.
 9586+87DA ~            ; Vystup: FD_Copy=1, FD_Mod=63, F_Len=8; A=0, Z, NC.
 9587+87DA ~            ; Meni: AF, DE, HL; BC, IX a IY zachovány.
 9588+87DA ~            ; --- KONEC DOKUMENTACE CZ ---
 9589+87DA ~            set_fdma_to_chars
 9590+87DA ~            	push	bc
 9591+87DA ~            	ld	hl,1	;1 bajt zkopiruj
 9592+87DA ~            	ld	de,63	;...a 63 preskoc
 9593+87DA ~            	ld	bc,8	;znak ma 8 bajtu
 9594+87DA ~            	jr	sftc1
 9595+87DA ~
 9596+87DA ~            ;96)
 9597+87DA ~            ; --- DOKUMENTACE CZ: set_fdma_to_fill_len_in_bc_512 ---
 9598+87DA ~            ; Ucel: Nastaví FDMA pro souvislou výplň 512 bajtů.
 9599+87DA ~            ; Vstup: Bez parametru délky: BC se pouze uchovává.
 9600+87DA ~            ; Vystup: FD_Copy=0, FD_Mod=0, F_Len=512; HL=DE=0, A=0, Z, NC.
 9601+87DA ~            ; Meni: AF, DE, HL; BC, IX a IY zachovány.
 9602+87DA ~            ; Poznamka: Přes historický název a komentář se délka z BC nepoužívá.
 9603+87DA ~            ; --- KONEC DOKUMENTACE CZ ---
 9604+87DA ~            set_fdma_to_fill_len_in_bc_512
 9605+87DA ~            ;IN=BC=length
 9606+87DA ~            	push	bc
 9607+87DA ~            	ld	hl,0
 9608+87DA ~            	ld 	d,h
 9609+87DA ~            	ld	e,h
 9610+87DA ~            	ld	bc,512
 9611+87DA ~
 9612+87DA ~            sftc1	ld	(FDMAreg.FD_Copy),hl	;...a 63 pøeskoè.
 9613+87DA ~            	ld	(FDMAreg.FD_Mod),de
 9614+87DA ~            	ld	(FDMAreg.F_Len),bc
 9615+87DA ~            	pop	bc
 9616+87DA ~            	xor	a			;signal key 0 pressed, because of main keyboard routine
 9617+87DA ~            	ret
 9618+87DA ~
 9619+87DA ~            ;97)
 9620+87DA ~            ; --- DOKUMENTACE CZ: set_hgfx_ink_planar ---
 9621+87DA ~            ; Ucel: Obnoví barvu a bitové roviny pro běžný tisk HGFX.
 9622+87DA ~            ; Vstup: Bez parametrů.
 9623+87DA ~            ; Vystup: VIDEO_REGS.COLOR=4, VIDEO_REGS.MASK=planar_pismo.
 9624+87DA ~            ; Meni: A; F, BC, DE, HL, IX a IY zachovány.
 9625+87DA ~            ; --- KONEC DOKUMENTACE CZ ---
 9626+87DA ~            set_hgfx_ink_planar
 9627+87DA ~            		ld 	a,4			;vrat puvodni
 9628+87DA ~            		ld 	(VIDEO_REGS.COLOR),a
 9629+87DA ~            ;		ld	a,63
 9630+87DA ~            		ld	a,planar_pismo
 9631+87DA ~            		ld	(VIDEO_REGS.MASK),a
 9632+87DA ~            		ret
 9633+87DA ~
 9634+87DA              	ENDIF

4158+ 72C8 E1           		pop	hl
4159+ 72C9 CD 8E 6A     		call	DIR128_MAP_DE
4160+ 72CC
4161+ 72CC              		;Read item length LOW/HIGH. Header itself may cross #FFFF/#C000.
4162+ 72CC 7E           		ld	a,(hl)
4163+ 72CD 5F           		ld	e,a			;E=length LOW
4164+ 72CE CD FF 69     		call	DIR128_INC_HL
4165+ 72D1 38 4C        		jr	c,item_add_end
4166+ 72D3 7E           		ld	a,(hl)
4167+ 72D4 57           		ld	d,a			;DE=item length
4168+ 72D5 B3           		or	e

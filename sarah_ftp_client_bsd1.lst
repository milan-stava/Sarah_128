 4162+7248              ; -----------------------------------------------------------------------------
 4163+7248              ; item_add / item_sub - 128K bank-aware directory movement
 4164+7248              ;
 4165+7248              ; IN:
 4166+7248              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
 4167+7248              ;       DE = address of its 16-bit page-table-pointer companion
 4168+7248              ;
 4169+7248              ; Example:
 4170+7248              ;       ld bc,cur_item_addr
 4171+7248              ;       ld de,cur_item_addr_page
 4172+7248              ;       call item_add
 4173+7248              ;
 4174+7248              ; OUT:
 4175+7248              ;       Z  = cannot move (end/start of directory)
 4176+7248              ;       NZ = pointer + its bank companion were moved to adjacent item
 4177+7248              ;
 4178+7248              ; The address variable and page variable deliberately do NOT have to be adjacent.
 4179+7248              ; This keeps the original IX+... variable layout completely unchanged.
 4180+7248              ; The two-byte item length at either end of an item may itself cross a bank.
 4181+7248              ; -----------------------------------------------------------------------------
 4182+7248              ; --- DOKUMENTACE CZ: item_add ---
 4183+7248              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
 4184+7248              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
 4185+7248              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
 4186+7248              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
 4187+7248              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
 4188+7248              ; --- KONEC DOKUMENTACE CZ ---
 4189+7248              item_add
 4190+7248 ED 43 A1 6F  		ld	(dir_op_addr_var),bc
 4191+724C ED 53 A3 6F  		ld	(dir_op_page_var),de
 4192+7250
 4193+7250              		;Load physical item address from *(BC).
 4194+7250 60           		ld	h,b
 4195+7251 69           		ld	l,c
 4196+7252 5E           		ld	e,(hl)
 4197+7253 23           		inc	hl
 4198+7254 56           		ld	d,(hl)
 4199+7255 ED 53 99 6F  		ld	(next_item_addr),de	;temporary physical start
 4200+7259 EB           		ex	de,hl			;HL=current physical item start
 4201+725A
 4202+725A              		;Load/map directory page from page companion variable.
 4203+725A E5           		push	hl
 4204+725B 2A A3 6F     		ld	hl,(dir_op_page_var)
 4205+725E 5E           		ld	e,(hl)
 4206+725F 23           		inc	hl
 4207+7260 56           		ld	d,(hl)
 4208+7261 E1           		pop	hl
 4209+7262 CD 50 6A     		call	DIR128_MAP_DE
 4210+7265
 4211+7265              		;Read item length LOW/HIGH. Header itself may cross #FFFF/#C000.
 4212+7265 7E           		ld	a,(hl)
 4213+7266 5F           		ld	e,a			;E=length LOW
 4214+7267 CD C1 69     		call	DIR128_INC_HL

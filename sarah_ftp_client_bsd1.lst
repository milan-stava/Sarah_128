    1+A0B3              ; Shared ESP-AT framing above the unchanged Wi-Fi BIOS.
    2+A0B3              ; Firmware dialect retained: +CIPRECVDATA,<length>:<binary>.
    3+A0B3              ; Events: 1 OK, 2 ERROR, 3 prompt, 4 SEND OK, 5 SEND FAIL,
    4+A0B3              ;         6 busy, 7 active IPD header, 8 receive-data header, 0 other.
    5+A0B3              ; Binary payload is never searched for AT result strings.
    6+A0B3              AT_OK equ 1
    7+A0B3              AT_ERROR equ 2
    8+A0B3              AT_PROMPT equ 3
    9+A0B3              AT_SEND_OK equ 4
   10+A0B3              AT_SEND_FAIL equ 5
   11+A0B3              AT_BUSY equ 6
   12+A0B3              AT_IPD equ 7
   13+A0B3              AT_DATA equ 8

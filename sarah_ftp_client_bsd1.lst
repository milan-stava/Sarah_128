 9023+83B0              ;89) get_item_name	;get file name under cursor
 9024+83B0              ;IN: current active callers use SCF. 128K parser always returns full info.
 9025+83B0              ;OUT=HL=name start, BC= name length, DE= file length
 9026+83B0              ;OUT=A=0= item is a directory+ HL, BC
 9027+83B0              ;OUT=A=1=item is a file+ HL, BC

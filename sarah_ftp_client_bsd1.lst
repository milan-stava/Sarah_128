 2534+699D              ; -----------------------------------------------------------------------------
 2535+699D              ; FTP DIRECTORY BANK API
 2536+699D              ;
 2537+699D              ; fdp_pointer always points to the table byte of the CURRENT directory page.
 2538+699D              ; ftp_dir_page has #FF sentinels on both sides:
 2539+699D              ;       #FF, 0, 1, 3, 7, #FF
 2540+699D              ;
 2541+699D              ; HL is always a physical address in the banked window #C000-#FFFF.
 2542+699D              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
 2543+699D              ;
 2544+699D              ; OUT for INC/DEC:
 2545+699D              ;       NC = movement succeeded
 2546+699D              ;       C  = no next/previous directory page (64 KB boundary)
 2547+699D              ;
 2548+699D              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
 2549+699D              ; which preserves AF/BC/DE/IX/IY exactly.
 2550+699D              ; -----------------------------------------------------------------------------
 2551+699D
 2552+699D              ; --- DOKUMENTACE CZ: DIR128_MAP_CURRENT ---
 2553+699D              ; Ucel: Namapuje aktuální banku adresáře do #C000–#FFFF.
 2554+699D              ; Vstup: fdp_pointer ukazuje do tabulky ftp_dir_page.
 2555+699D              ; Vystup: NC = platná banka, C = sentinel #FF.
 2556+699D              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
 2557+699D              ; Poznamka: Mění PAGE128_STATE a port #7FFD.
 2558+699D              ; --- KONEC DOKUMENTACE CZ ---
 2559+699D              DIR128_MAP_CURRENT:
 2560+699D E5                   push    hl
 2561+699E D5                   push    de
 2562+699F ED 5B F6 BF          ld      de,(fdp_pointer)
 2563+69A3 1A                   ld      a,(de)
 2564+69A4 FE FF                cp      #FF
 2565+69A6 28 07                jr      z,DIR128_MAP_BAD
 2566+69A8 CD E0 BF             call    PAGE128
 2567+69AB D1                   pop     de
 2568+69AC E1                   pop     hl
 2569+69AD B7                   or      a                       ;NC = valid page
 2570+69AE C9                   ret
 2571+69AF              DIR128_MAP_BAD:
 2572+69AF D1                   pop     de
 2573+69B0 E1                   pop     hl
 2574+69B1 37                   scf
 2575+69B2 C9                   ret
 2576+69B3
 2577+69B3              ;Select first FTP directory page (page 0).
 2578+69B3              ; --- DOKUMENTACE CZ: DIR128_FIRST_PAGE ---
 2579+69B3              ; Ucel: Vybere první banku adresáře (RAM 0).
 2580+69B3              ; Vstup: Bez parametrů.
 2581+69B3              ; Vystup: fdp_pointer = ftp_dir_page+1; NC.
 2582+69B3              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
 2583+69B3              ; Poznamka: Mění mapování RAM a PAGE128_STATE.
 2584+69B3              ; --- KONEC DOKUMENTACE CZ ---
 2585+69B3              DIR128_FIRST_PAGE:
 2586+69B3 E5                   push    hl
 2587+69B4 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
 2588+69B7 22 F6 BF             ld      (fdp_pointer),hl
 2589+69BA 7E                   ld      a,(hl)
 2590+69BB CD E0 BF             call    PAGE128
 2591+69BE E1                   pop     hl
 2592+69BF B7                   or      a
 2593+69C0 C9                   ret
 2594+69C1
 2595+69C1              ;HL++ across #FFFF -> #C000 of the next directory page.
 2596+69C1              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
 2597+69C1              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
 2598+69C1              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
 2599+69C1              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
 2600+69C1              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
 2601+69C1              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
 2602+69C1              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
 2603+69C1              ; --- KONEC DOKUMENTACE CZ ---
 2604+69C1              DIR128_INC_HL:
 2605+69C1 F5                   push    af                      ;old INC HL never changed A - preserve it here too
 2606+69C2 23                   inc     hl
 2607+69C3 7C                   ld      a,h
 2608+69C4 B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
 2609+69C5 28 03                jr      z,DIR128_INC_CROSS
 2610+69C7 F1                   pop     af
 2611+69C8 B7                   or      a                       ;restore A and return NC = OK
 2612+69C9 C9                   ret
 2613+69CA
 2614+69CA              DIR128_INC_CROSS:
 2615+69CA D5                   push    de
 2616+69CB ED 5B F6 BF          ld      de,(fdp_pointer)
 2617+69CF 13                   inc     de
 2618+69D0 1A                   ld      a,(de)
 2619+69D1 FE FF                cp      #FF
 2620+69D3 28 0E                jr      z,DIR128_INC_END
 2621+69D5 ED 53 F6 BF          ld      (fdp_pointer),de
 2622+69D9 CD E0 BF             call    PAGE128
 2623+69DC 21 00 C0             ld      hl,ftp_dir_start        ;#C000
 2624+69DF D1                   pop     de
 2625+69E0 F1                   pop     af                      ;restore caller's A
 2626+69E1 B7                   or      a                       ;NC = OK, A unchanged
 2627+69E2 C9                   ret
 2628+69E3              DIR128_INC_END:
 2629+69E3 1B                   dec     de                      ;keep fdp_pointer on last valid page
 2630+69E4 ED 53 F6 BF          ld      (fdp_pointer),de
 2631+69E8 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
 2632+69EB D1                   pop     de
 2633+69EC F1                   pop     af                      ;restore caller's A
 2634+69ED 37                   scf                             ;C = no following directory page
 2635+69EE C9                   ret
 2636+69EF
 2637+69EF              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
 2638+69EF              ;Unlike the general helper, this preserves the COMPLETE parser state:
 2639+69EF              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
 2640+69EF              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
 2641+69EF              ;  dir128_parser_status = 0  OK
 2642+69EF              ;  dir128_parser_status = 1  no next directory page
 2643+69EF              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
 2644+69EF              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
 2645+69EF              ; Vstup: HL = adresa v aktuální bance adresáře.
 2646+69EF              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
 2647+69EF              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
 2648+69EF              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
 2649+69EF              ; --- KONEC DOKUMENTACE CZ ---
 2650+69EF              DIR128_INC_HL_PARSER:
 2651+69EF F5                   push    af
 2652+69F0 D5                   push    de
 2653+69F1 AF                   xor     a
 2654+69F2 32 E5 88             ld      (dir128_parser_status),a
 2655+69F5 23                   inc     hl
 2656+69F6 7C                   ld      a,h
 2657+69F7 B7                   or      a
 2658+69F8 20 14                jr      nz,.ok
 2659+69FA ED 5B F6 BF          ld      de,(fdp_pointer)
 2660+69FE 13                   inc     de
 2661+69FF 1A                   ld      a,(de)
 2662+6A00 FE FF                cp      #FF
 2663+6A02 28 0D                jr      z,.full
 2664+6A04 ED 53 F6 BF          ld      (fdp_pointer),de
 2665+6A08 CD E0 BF             call    PAGE128
 2666+6A0B 21 00 C0             ld      hl,ftp_dir_start
 2667+6A0E              .ok:
 2668+6A0E D1                   pop     de
 2669+6A0F F1                   pop     af
 2670+6A10 C9                   ret
 2671+6A11              .full:
 2672+6A11 1B                   dec     de
 2673+6A12 ED 53 F6 BF          ld      (fdp_pointer),de
 2674+6A16 21 FF FF             ld      hl,#FFFF
 2675+6A19 3E 01                ld      a,1
 2676+6A1B 32 E5 88             ld      (dir128_parser_status),a
 2677+6A1E D1                   pop     de
 2678+6A1F F1                   pop     af
 2679+6A20 C9                   ret
 2680+6A21
 2681+6A21              ;HL-- across #C000 -> #FFFF of the previous directory page.
 2682+6A21              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
 2683+6A21              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
 2684+6A21              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
 2685+6A21              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
 2686+6A21              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
 2687+6A21              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
 2688+6A21              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
 2689+6A21              ; --- KONEC DOKUMENTACE CZ ---
 2690+6A21              DIR128_DEC_HL:
 2691+6A21 F5                   push    af                      ;old DEC HL never changed A - preserve it here too
 2692+6A22 2B                   dec     hl
 2693+6A23 7C                   ld      a,h
 2694+6A24 FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
 2695+6A26 28 03                jr      z,DIR128_DEC_CROSS
 2696+6A28 F1                   pop     af
 2697+6A29 B7                   or      a                       ;restore A and return NC = OK
 2698+6A2A C9                   ret
 2699+6A2B
 2700+6A2B              DIR128_DEC_CROSS:
 2701+6A2B D5                   push    de
 2702+6A2C ED 5B F6 BF          ld      de,(fdp_pointer)
 2703+6A30 1B                   dec     de
 2704+6A31 1A                   ld      a,(de)
 2705+6A32 FE FF                cp      #FF
 2706+6A34 28 0E                jr      z,DIR128_DEC_START
 2707+6A36 ED 53 F6 BF          ld      (fdp_pointer),de
 2708+6A3A CD E0 BF             call    PAGE128
 2709+6A3D 21 FF FF             ld      hl,#FFFF
 2710+6A40 D1                   pop     de
 2711+6A41 F1                   pop     af                      ;restore caller's A
 2712+6A42 B7                   or      a                       ;NC = OK, A unchanged
 2713+6A43 C9                   ret
 2714+6A44              DIR128_DEC_START:
 2715+6A44 13                   inc     de                      ;keep fdp_pointer on first valid page
 2716+6A45 ED 53 F6 BF          ld      (fdp_pointer),de
 2717+6A49 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
 2718+6A4C D1                   pop     de
 2719+6A4D F1                   pop     af                      ;restore caller's A
 2720+6A4E 37                   scf                             ;C = no previous directory page
 2721+6A4F C9                   ret
 2722+6A50
 2723+6A50              ;Map page-table pointer stored in DE. HL is preserved.
 2724+6A50              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
 2725+6A50              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
 2726+6A50              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
 2727+6A50              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
 2728+6A50              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
 2729+6A50              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
 2730+6A50              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
 2731+6A50              ; --- KONEC DOKUMENTACE CZ ---
 2732+6A50              DIR128_MAP_DE:
 2733+6A50 F5                   push    af
 2734+6A51 ED 53 F6 BF          ld      (fdp_pointer),de
 2735+6A55 1A                   ld      a,(de)
 2736+6A56 CD E0 BF             call    PAGE128
 2737+6A59 F1                   pop     af
 2738+6A5A C9                   ret
 2739+6A5B
 2740+6A5B
 2741+6A5B              ; -----------------------------------------------------------------------------
 2742+6A5B              ; DIR128_COPY_NAME_TO_DE
 2743+6A5B              ; Copy the name returned by get_item_name to fixed RAM.
 2744+6A5B              ; IN:  HL = physical source address in directory window
 2745+6A5B              ;      BC = 16-bit name length
 2746+6A5B              ;      DE = fixed-RAM destination
 2747+6A5B              ;      item_name_page = page-table pointer belonging to HL
 2748+6A5B              ; OUT: DE points behind copied bytes, BC=0
 2749+6A5B              ; The source may cross any #FFFF -> #C000 directory-page boundary.
 2750+6A5B              ; -----------------------------------------------------------------------------
 2751+6A5B              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
 2752+6A5B              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
 2753+6A5B              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
 2754+6A5B              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
 2755+6A5B              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 2756+6A5B              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
 2757+6A5B              ; --- KONEC DOKUMENTACE CZ ---
 2758+6A5B              DIR128_COPY_NAME_TO_DE:
 2759+6A5B D5                   push    de
 2760+6A5C ED 5B AD 6F          ld      de,(item_name_page)
 2761+6A60 CD 50 6A             call    DIR128_MAP_DE
 2762+6A63 D1                   pop     de
 2763+6A64              .dir128_copy_loop:
 2764+6A64 78                   ld      a,b
 2765+6A65 B1                   or      c
 2766+6A66 C8                   ret     z
 2767+6A67 7E                   ld      a,(hl)
 2768+6A68 12                   ld      (de),a
 2769+6A69 13                   inc     de
 2770+6A6A 0B                   dec     bc
 2771+6A6B 78                   ld      a,b

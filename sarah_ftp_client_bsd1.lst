 3239+6E7E              ; -----------------------------------------------------------------------------
 3240+6E7E              ; search_by_Busy_fast
 3241+6E7E              ; Fast case-insensitive substring search for a name fully contained in the
 3242+6E7E              ; currently mapped 16K directory page.
 3243+6E7E              ;
 3244+6E7E              ; IN:  HL = name start, BC = 16-bit name length
 3245+6E7E              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
 3246+6E7E              ; OUT: Z = found, NZ = not found
 3247+6E7E              ;
 3248+6E7E              ; This is deliberately close to the original Busy FIND: the inner compare uses
 3249+6E7E              ; the Z80 CPI instruction.  The pattern has already been converted to lower
 3250+6E7E              ; case once by find_items, so only the source character needs convert here.
 3251+6E7E              ;
 3252+6E7E              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
 3253+6E7E              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
 3254+6E7E              ; matches therefore cannot be skipped.
 3255+6E7E              ; -----------------------------------------------------------------------------
 3256+6E7E              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
 3257+6E7E              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
 3258+6E7E              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
 3259+6E7E              ;   délka.
 3260+6E7E              ; Vystup: Z = shoda, NZ = nenalezeno.
 3261+6E7E              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 3262+6E7E              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
 3263+6E7E              ; --- KONEC DOKUMENTACE CZ ---
 3264+6E7E              search_by_Busy_fast:
 3265+6E7E EB                   ex      de,hl                   ;DE=current candidate in file name
 3266+6E7F
 3267+6E7F                      ; candidate_count = name_length - pattern_length + 1
 3268+6E7F 60                   ld      h,b
 3269+6E80 69                   ld      l,c
 3270+6E81 ED 4B 35 7B          ld      bc,(txtlen+1)
 3271+6E85 78                   ld      a,b
 3272+6E86 B1                   or      c
 3273+6E87 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
 3274+6E89 B7                   or      a
 3275+6E8A ED 42                sbc     hl,bc
 3276+6E8C 38 25                jr      c,.fast_not_found       ;pattern longer than file name
 3277+6E8E 23                   inc     hl
 3278+6E8F
 3279+6E8F                      ; Keep number of possible candidate starts in alternate BC.
 3280+6E8F E5                   push    hl
 3281+6E90 D9                   exx
 3282+6E91 C1                   pop     bc
 3283+6E92 D9                   exx
 3284+6E93
 3285+6E93              .fast_next_candidate:
 3286+6E93 D5                   push    de                      ;remember exact candidate start
 3287+6E94 21 CB 90             ld      hl,INPBUFF
 3288+6E97 ED 4B 35 7B          ld      bc,(txtlen+1)
 3289+6E9B
 3290+6E9B              .fast_compare:
 3291+6E9B 1A                   ld      a,(de)
 3292+6E9C CD 59 7B             call    convert                 ;source char -> lower case
 3293+6E9F ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
 3294+6EA1 13                   inc     de
 3295+6EA2 20 06                jr      nz,.fast_candidate_failed
 3296+6EA4 EA 9B 6E             jp      pe,.fast_compare        ;matched, more pattern bytes remain
 3297+6EA7
 3298+6EA7 D1                   pop     de                      ;discard saved candidate start
 3299+6EA8              .fast_found:
 3300+6EA8 AF                   xor     a                       ;Z = found
 3301+6EA9 C9                   ret
 3302+6EAA
 3303+6EAA              .fast_candidate_failed:
 3304+6EAA D1                   pop     de                      ;restore previous candidate start
 3305+6EAB 13                   inc     de                      ;next candidate = previous + 1
 3306+6EAC D9                   exx
 3307+6EAD 0B                   dec     bc
 3308+6EAE 78                   ld      a,b
 3309+6EAF B1                   or      c
 3310+6EB0 D9                   exx
 3311+6EB1 20 E0                jr      nz,.fast_next_candidate
 3312+6EB3
 3313+6EB3              .fast_not_found:
 3314+6EB3 3E 01                ld      a,1
 3315+6EB5 B7                   or      a                       ;NZ = not found
 3316+6EB6 C9                   ret
 3317+6EB7

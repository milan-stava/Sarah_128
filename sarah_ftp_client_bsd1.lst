 7560+7F66              ;send_ftp_command is the main routine that sends command+ string if needed and returns ftp answer code
 7561+7F66              ;IN=A=0=command only (eg. "ABORT"). A=1=comamnd+prepared string from INPUT (eg. "STOR filename"), A=2=command+new INPUT
 7562+7F66              ;OUT=A=0=NC=sent ok, awaited ftp code returned correctly
 7563+7F66              ;A=1=C=c=1=error sending string
 7564+7F66              ;A=2=C=c=11=error in module answer (expected answer ">" not returned)

5960+ 7884              ; --- DOKUMENTACE CZ: ConvRStr16 ---
5961+ 7884              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
5962+ 7884              ; Vstup: DE = začátek číslic.
5963+ 7884              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
5964+ 7884              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
5965+ 7884              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
5966+ 7884              ;   přetečení; Z nemá pevný význam.
5967+ 7884              ; --- KONEC DOKUMENTACE CZ ---
5968+ 7884              ConvRStr16
5969+ 7884              ;===============================================================
5970+ 7884              ;http://z80-heaven.wikidot.com/math#toc32
5971+ 7884              ;Input:
5972+ 7884              ;     DE points to the base 10 number string in RAM.
5973+ 7884              ;Outputs:
5974+ 7884              ;     HL is the 16-bit value of the number
5975+ 7884              ;     DE points to the byte after the number
5976+ 7884              ;     BC is HL/10
5977+ 7884              ;     z flag reset (nz)
5978+ 7884              ;     c flag reset (nc)
5979+ 7884              ;Destroys:
5980+ 7884              ;     A (actually, add 30h and you get the ending token)
5981+ 7884              ;Size:  23 bytes
5982+ 7884              ;Speed: 104n+42+11c
5983+ 7884              ;       n is the number of digits
5984+ 7884              ;       c is at most n-2
5985+ 7884              ;       at most 595 cycles for any 16-bit decimal value
5986+ 7884              ;===============================================================
5987+ 7884
5988+ 7884 21 00 00          ld hl,0          ;  10 : 210000
5989+ 7887              ConvLoop:             ;
5990+ 7887 1A                ld a,(de)        ;   7 : 1A
5991+ 7888 D6 30             sub 30h          ;   7 : D630
5992+ 788A FE 0A             cp 10            ;   7 : FE0A
5993+ 788C D0                ret nc           ;5|11 : D0
5994+ 788D 13                inc de           ;   6 : 13
5995+ 788E                                    ;
5996+ 788E 44                ld b,h           ;   4 : 44
5997+ 788F 4D                ld c,l           ;   4 : 4D
5998+ 7890 29                add hl,hl        ;  11 : 29
5999+ 7891 29                add hl,hl        ;  11 : 29
6000+ 7892 09                add hl,bc        ;  11 : 09
6001+ 7893 29                add hl,hl        ;  11 : 29
6002+ 7894                                    ;
6003+ 7894 85                add a,l          ;   4 : 85
6004+ 7895 6F                ld l,a           ;   4 : 6F
6005+ 7896 30 EF             jr nc,ConvLoop   ;12|23: 30EE
6006+ 7898 24                inc h            ; --- : 24
6007+ 7899 18 EC             jr ConvLoop      ; --- : 18EB
6008+ 789B
6009+ 789B
6010+ 789B

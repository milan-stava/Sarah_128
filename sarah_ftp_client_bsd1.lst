 2781+6A7D              ; -----------------------------------------------------------------------------
 2782+6A7D              ; search_by_Busy_dir
 2783+6A7D              ; Bank-safe replacement used by FIND for names returned by get_item_name.
 2784+6A7D              ; IN:  HL = physical name start, BC = 16-bit name length
 2785+6A7D              ;      item_name_page = bank companion for HL
 2786+6A7D              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
 2787+6A7D              ; OUT: Z=pattern found, NZ=not found
 2788+6A7D              ; One-character input matches only the FIRST character of a name (quick jump).
 2789+6A7D              ; Two or more characters use normal case-insensitive substring search. There is
 2790+6A7D              ; no 255-byte directory-name limit; directory page crossings are transparent.
 2791+6A7D              ; -----------------------------------------------------------------------------
 2792+6A7D              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
 2793+6A7D              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
 2794+6A7D              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
 2795+6A7D              ;   = délka vzoru.
 2796+6A7D              ; Vystup: Z = shoda, NZ = nenalezeno.
 2797+6A7D              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 2798+6A7D              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
 2799+6A7D              ; --- KONEC DOKUMENTACE CZ ---
 2800+6A7D              search_by_Busy_dir:
 2801+6A7D                      ; Empty name cannot contain a non-empty search pattern.
 2802+6A7D 78                   ld      a,b
 2803+6A7E B1                   or      c
 2804+6A7F 28 2A                jr      z,.dir_search_not_found_fast
 2805+6A81
 2806+6A81                      ; Map the directory bank containing the first byte of the name ONCE.
 2807+6A81                      ; For the normal case the whole name is inside this one 16K bank and
 2808+6A81                      ; no further paging is needed during FIND.
 2809+6A81 ED 5B B6 6F          ld      de,(item_name_page)
 2810+6A85 CD 59 6A             call    DIR128_MAP_DE
 2811+6A88
 2812+6A88                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
 2813+6A88                      ; the first character of the file name.  Thus FIND "S" selects names
 2814+6A88                      ; beginning with S, while 2+ characters remain a substring search.
 2815+6A88                      ; This is also much faster for the common one-letter jump.
 2816+6A88 ED 5B 66 79          ld      de,(txtlen+1)
 2817+6A8C 7A                   ld      a,d
 2818+6A8D B7                   or      a
 2819+6A8E 20 0F                jr      nz,.dir_search_len_ge2
 2820+6A90 7B                   ld      a,e
 2821+6A91 FE 01                cp      1
 2822+6A93 20 0A                jr      nz,.dir_search_len_ge2
 2823+6A95 7E                   ld      a,(hl)
 2824+6A96 CD 8A 79             call    convert
 2825+6A99 57                   ld      d,a
 2826+6A9A 3A 9B 8F             ld      a,(INPBUFF)             ;already normalized by find_items
 2827+6A9D BA                   cp      d                       ;Z=first character matches
 2828+6A9E C9                   ret
 2829+6A9F
 2830+6A9F              .dir_search_len_ge2:
 2831+6A9F                      ; Is the LAST byte of the name still inside the same physical window?
 2832+6A9F                      ; last = HL + BC - 1
 2833+6A9F                      ; Carry means that the name crosses #FFFF -> #C000, therefore use the
 2834+6A9F                      ; fully bank-safe (but slower) routine below.
 2835+6A9F E5                   push    hl
 2836+6AA0 C5                   push    bc
 2837+6AA1 0B                   dec     bc
 2838+6AA2 09                   add     hl,bc
 2839+6AA3 C1                   pop     bc
 2840+6AA4 E1                   pop     hl

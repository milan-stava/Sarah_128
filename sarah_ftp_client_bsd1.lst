 276+ 0000
 277+ 0000
 278+ 0000              ;FTP commands of interest:
 279+ 0000              ;done	USER		username
 280+ 0000              ;done	PASS		password
 281+ 0000              ;done	PASV		enter passive mode
 282+ 0000              ;done	QUIT		quit ftp connection
 283+ 0000              ;done	STOR		upload file		;max transfer block allowed by ESP modele= 2048 bytes, top speed is 2,53 kb/sec
 284+ 0000              ;done	RETR		download file
 285+ 0000              ;done	SIZE		return file size
 286+ 0000              ;done	ABOR		abort command		;in case we got stuck, ABOR will return us
 287+ 0000              ;done	APPE		append file		;if uploaded file exist, you may choose to overwrite it or append
 288+ 0000              ;done	NOOP					;check if ftp connection is alive (ver 0.7.)
 289+ 0000              ;done	STOU					;new from 0.8 up
 290+ 0000              ;done	LIST
 291+ 0000              ;done	NLST
 292+ 0000              ;done	PWD
 293+ 0000              ;done	CWD
 294+ 0000              ;done	CDUP
 295+ 0000              ;done	DELE
 296+ 0000              ;done	MKD
 297+ 0000              ;done	RMD
 298+ 0000              ;done	RNFR+RNTO
 299+ 0000
 300+ 0000              ;the following need passive mode:
 301+ 0000              ;	RETR		download file
 302+ 0000              ;	STOR		upload file
 303+ 0000              ;	STOU		like STOR, but a new file is set
 304+ 0000              ;	LIST		download directory list
 305+ 0000              ;	NLST argument	list of directory "argument" and file names (without attributes)
 306+ 0000
 307+ 0000              ;the following do not need passive mode:
 308+ 0000              ;	MKD argument	make new directory called "argument"
 309+ 0000              ;	RMD argument	remove directory called "argument"
 310+ 0000              ;	RNFR+RNTO	rename file
 311+ 0000              ;	SIZE		find out file length
 312+ 0000              ;	QUIT		quits ftp connection
 313+ 0000              ;	PWD		returns current directory name
 314+ 0000              ;	CWD argument	go to directory "argument"
 315+ 0000              ;	CDUP		go to up directory
 316+ 0000              ;	DELE argument	delete file "argument"
 317+ 0000
 318+ 0000              ;overview:
 319+ 0000              ;LOW LEVEL- SENDING
 320+ 0000              ;1) send_string:	mainly to send direct AT commands
 321+ 0000              ;2) send_data:		to send any type of data
 322+ 0000              ;LOW LEVEL- RECEIVING
 323+ 0000              ;7) receive_data_timeout receive data with timeout.IN=BC=max.length of data to receive, HL=sata start, OUT Z= ok, received
 324+ 0000              ;LOW LEVEL- PARSING
 325+ 0000              ;10) look_for_string:	seeks certain string in memory
 326+ 0000              ;11) look_on_fly:	seeks certain string in the incoming flow of bytes
 327+ 0000              ;12) search_by_Busy	seeks string in memory, according to Busy (in BSDOS)
 328+ 0000              ;13) search_until_zero
 329+ 0000
 330+ 0000              ;OTHERS
 331+ 0000              ;15) count_com_len	counts command length
 332+ 0000              ;16) ConvRStr16		converts ASCII to HL (16 bit)
 333+ 0000              ;17) HL2ASCII		converts HL to ASCII (16 bit)
 334+ 0000              ;18) wait routines	wait certain amount of time (user definable)
 335+ 0000              ;19) print_title	printle initial title
 336+ 0000              ;20) save_dir_position	saves dir position so that you can return to where you have been
 337+ 0000              ;22) ConvrStr32		converts ASCII to HLDE (32 bit)
 338+ 0000              ;28) HL2ASCII32		converts HL to ASCII (32 bit)

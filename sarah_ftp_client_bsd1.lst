 3131+6E33              ; -----------------------------------------------------------------------------
 3132+6E33              ; DIR128_COPY_NAME_TO_DE
 3133+6E33              ; Copy the name returned by get_item_name to fixed RAM.
 3134+6E33              ; IN:  HL = physical source address in directory window
 3135+6E33              ;      BC = 16-bit name length
 3136+6E33              ;      DE = fixed-RAM destination
 3137+6E33              ;      item_name_page = page-table pointer belonging to HL
 3138+6E33              ; OUT: DE points behind copied bytes, BC=0
 3139+6E33              ; The source may cross any #FFFF -> #C000 directory-page boundary.
 3140+6E33              ; -----------------------------------------------------------------------------
 3141+6E33              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
 3142+6E33              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
 3143+6E33              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
 3144+6E33              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
 3145+6E33              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 3146+6E33              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
 3147+6E33              ; --- KONEC DOKUMENTACE CZ ---
 3148+6E33              DIR128_COPY_NAME_TO_DE:
 3149+6E33 D5                   push    de
 3150+6E34 ED 5B BA 72          ld      de,(item_name_page)
 3151+6E38 CD 28 6E             call    DIR128_MAP_DE
 3152+6E3B D1                   pop     de
 3153+6E3C              .dir128_copy_loop:
 3154+6E3C 78                   ld      a,b
 3155+6E3D B1                   or      c
 3156+6E3E C8                   ret     z
 3157+6E3F 7E                   ld      a,(hl)
 3158+6E40 12                   ld      (de),a
 3159+6E41 13                   inc     de
 3160+6E42 0B                   dec     bc
 3161+6E43 78                   ld      a,b
 3162+6E44 B1                   or      c
 3163+6E45 C8                   ret     z
 3164+6E46 CD 99 6D             call    DIR128_INC_HL
 3165+6E49 D8                   ret     c                       ;should only happen on malformed item
 3166+6E4A 18 F0                jr      .dir128_copy_loop

2840+ 6B18              ; -----------------------------------------------------------------------------
2841+ 6B18              ; search_by_Busy_dir_slow
2842+ 6B18              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
2843+ 6B18              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
2844+ 6B18              ; no longer slows down every ordinary FIND operation.
2845+ 6B18              ;
2846+ 6B18              ; One-character FIND is handled before this fallback and compares only the
2847+ 6B18              ; first character.  This slow path therefore normally handles 2+ character
2848+ 6B18              ; substring searches whose source name crosses a directory-bank boundary.
2849+ 6B18              ; -----------------------------------------------------------------------------
2850+ 6B18              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
2851+ 6B18              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
2852+ 6B18              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
2853+ 6B18              ;   a délka.
2854+ 6B18              ; Vystup: Z = shoda, NZ = nenalezeno.
2855+ 6B18              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2856+ 6B18              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
2857+ 6B18              ; --- KONEC DOKUMENTACE CZ ---
2858+ 6B18              search_by_Busy_dir_slow:
2859+ 6B18 22 E7 6F             ld      (dir_search_addr),hl
2860+ 6B1B ED 43 EB 6F          ld      (dir_search_remaining),bc
2861+ 6B1F ED 5B E0 6F          ld      de,(item_name_page)
2862+ 6B23 ED 53 E9 6F          ld      (dir_search_page),de
2863+ 6B27 2A DE 78             ld      hl,(txtlen+1)
2864+ 6B2A 22 ED 6F             ld      (dir_search_patlen),hl
2865+ 6B2D 7C                   ld      a,h
2866+ 6B2E B5                   or      l
2867+ 6B2F 28 56                jr      z,.dir_search_found
2868+ 6B31
2869+ 6B31              .dir_search_outer:
2870+ 6B31                      ;If remaining source length < pattern length, no further match exists.
2871+ 6B31 2A EB 6F             ld      hl,(dir_search_remaining)
2872+ 6B34 ED 5B ED 6F          ld      de,(dir_search_patlen)
2873+ 6B38 B7                   or      a
2874+ 6B39 ED 52                sbc     hl,de
2875+ 6B3B 38 4C                jr      c,.dir_search_not_found
2876+ 6B3D
2877+ 6B3D                      ;Start one comparison at current candidate address/page.
2878+ 6B3D 2A E7 6F             ld      hl,(dir_search_addr)
2879+ 6B40 ED 5B E9 6F          ld      de,(dir_search_page)
2880+ 6B44 CD 89 6A             call    DIR128_MAP_DE
2881+ 6B47 11 35 8E             ld      de,INPBUFF
2882+ 6B4A ED 4B ED 6F          ld      bc,(dir_search_patlen)
2883+ 6B4E
2884+ 6B4E              .dir_search_cmp:
2885+ 6B4E 7E                   ld      a,(hl)
2886+ 6B4F CD 02 79             call    convert                 ;source char -> lower case
2887+ 6B52 EB                   ex      de,hl
2888+ 6B53 BE                   cp      (hl)                    ;pattern already normalized by FIND
2889+ 6B54 EB                   ex      de,hl
2890+ 6B55 20 0D                jr      nz,.dir_search_advance_candidate
2891+ 6B57
2892+ 6B57 13                   inc     de
2893+ 6B58 0B                   dec     bc
2894+ 6B59 78                   ld      a,b
2895+ 6B5A B1                   or      c
2896+ 6B5B 28 2A                jr      z,.dir_search_found
2897+ 6B5D CD FA 69             call    DIR128_INC_HL
2898+ 6B60 38 27                jr      c,.dir_search_not_found
2899+ 6B62 18 EA                jr      .dir_search_cmp

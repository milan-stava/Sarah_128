2686+ 69ED              ; -----------------------------------------------------------------------------
2687+ 69ED              ; search_by_Busy_dir
2688+ 69ED              ; Bank-safe replacement used by FIND for names returned by get_item_name.
2689+ 69ED              ; IN:  HL = physical name start, BC = 16-bit name length
2690+ 69ED              ;      item_name_page = bank companion for HL
2691+ 69ED              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
2692+ 69ED              ; OUT: Z=pattern found, NZ=not found
2693+ 69ED              ; One-character input matches only the FIRST character of a name (quick jump).
2694+ 69ED              ; Two or more characters use normal case-insensitive substring search. There is
2695+ 69ED              ; no 255-byte directory-name limit; directory page crossings are transparent.
2696+ 69ED              ; -----------------------------------------------------------------------------
2697+ 69ED              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
2698+ 69ED              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
2699+ 69ED              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
2700+ 69ED              ;   = délka vzoru.
2701+ 69ED              ; Vystup: Z = shoda, NZ = nenalezeno.
2702+ 69ED              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2703+ 69ED              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
2704+ 69ED              ; --- KONEC DOKUMENTACE CZ ---
2705+ 69ED              search_by_Busy_dir:
2706+ 69ED                      ; Empty name cannot contain a non-empty search pattern.
2707+ 69ED 78                   ld      a,b
2708+ 69EE B1                   or      c
2709+ 69EF 28 2A                jr      z,.dir_search_not_found_fast
2710+ 69F1
2711+ 69F1                      ; Map the directory bank containing the first byte of the name ONCE.
2712+ 69F1                      ; For the normal case the whole name is inside this one 16K bank and
2713+ 69F1                      ; no further paging is needed during FIND.
2714+ 69F1 ED 5B 22 6F          ld      de,(item_name_page)
2715+ 69F5 CD C9 69             call    DIR128_MAP_DE
2716+ 69F8
2717+ 69F8                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
2718+ 69F8                      ; the first character of the file name.  Thus FIND "S" selects names
2719+ 69F8                      ; beginning with S, while 2+ characters remain a substring search.
2720+ 69F8                      ; This is also much faster for the common one-letter jump.
2721+ 69F8 ED 5B CF 77          ld      de,(txtlen+1)
2722+ 69FC 7A                   ld      a,d
2723+ 69FD B7                   or      a
2724+ 69FE 20 0F                jr      nz,.dir_search_len_ge2
2725+ 6A00 7B                   ld      a,e
2726+ 6A01 FE 01                cp      1
2727+ 6A03 20 0A                jr      nz,.dir_search_len_ge2
2728+ 6A05 7E                   ld      a,(hl)
2729+ 6A06 CD F3 77             call    convert
2730+ 6A09 57                   ld      d,a
2731+ 6A0A 3A 5A 8D             ld      a,(INPBUFF)             ;already normalized by find_items
2732+ 6A0D BA                   cp      d                       ;Z=first character matches
2733+ 6A0E C9                   ret
2734+ 6A0F
2735+ 6A0F              .dir_search_len_ge2:
2736+ 6A0F                      ; Is the LAST byte of the name still inside the same physical window?
2737+ 6A0F                      ; last = HL + BC - 1
2738+ 6A0F                      ; Carry means that the name crosses #FFFF -> #C000, therefore use the
2739+ 6A0F                      ; fully bank-safe (but slower) routine below.
2740+ 6A0F E5                   push    hl
2741+ 6A10 C5                   push    bc
2742+ 6A11 0B                   dec     bc
2743+ 6A12 09                   add     hl,bc
2744+ 6A13 C1                   pop     bc
2745+ 6A14 E1                   pop     hl
2746+ 6A15 DA 58 6A             jp      c,search_by_Busy_dir_slow
2747+ 6A18
2748+ 6A18 C3 1F 6A             jp      search_by_Busy_fast
2749+ 6A1B
2750+ 6A1B              .dir_search_not_found_fast:
2751+ 6A1B 3E 01                ld      a,1
2752+ 6A1D B7                   or      a                       ;NZ
2753+ 6A1E C9                   ret
2754+ 6A1F

 9041+83B0              ;128K bank-safe parser.
 9042+83B0              ;IN: callers currently use SCF; C/NC is kept only for source compatibility.
 9043+83B0              ;OUT=HL=name start in banked directory RAM
 9044+83B0              ;    BC=16-bit name length
 9045+83B0              ;    DE=16-bit file length for LIST abbreviated (0 for NLST/"..")
 9046+83B0              ;    item_name_page=page-table pointer belonging to returned HL
 9047+83B0              ;OUT=A=0 directory, A=1 file, A=2 NLST unknown type,
 9048+83B0              ;      A=3 LIST full/malformed, A=4 synthetic ".."
 9049+83B0              ;
 9050+83B0              ;No temporary zero is written into the directory. The parser uses the stored
 9051+83B0              ;16-bit item length as its boundary, so an item/name may cross 16K pages and
 9052+83B0              ;may also be longer than 255 bytes.
 9053+83B0 2A B0 8D             ld      hl,(cur_item_addr)
 9054+83B3 ED 5B 03 88          ld      de,(cur_item_addr_page)
 9055+83B7 CD FC 69             call    DIR128_MAP_DE
 9056+83BA
 9057+83BA                      ;Read item length LOW/HIGH. Even the length field may cross a page.

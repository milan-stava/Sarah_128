 2489+6949              ; -----------------------------------------------------------------------------
 2490+6949              ; FTP DIRECTORY BANK API
 2491+6949              ;
 2492+6949              ; fdp_pointer always points to the table byte of the CURRENT directory page.
 2493+6949              ; ftp_dir_page has #FF sentinels on both sides:
 2494+6949              ;       #FF, 0, 1, 3, 7, #FF
 2495+6949              ;
 2496+6949              ; HL is always a physical address in the banked window #C000-#FFFF.
 2497+6949              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
 2498+6949              ;
 2499+6949              ; OUT for INC/DEC:
 2500+6949              ;       NC = movement succeeded
 2501+6949              ;       C  = no next/previous directory page (64 KB boundary)
 2502+6949              ;
 2503+6949              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
 2504+6949              ; which preserves AF/BC/DE/IX/IY exactly.
 2505+6949              ; -----------------------------------------------------------------------------
 2506+6949
 2507+6949              ; --- DOKUMENTACE CZ: DIR128_MAP_CURRENT ---
 2508+6949              ; Ucel: Namapuje aktuální banku adresáře do #C000–#FFFF.
 2509+6949              ; Vstup: fdp_pointer ukazuje do tabulky ftp_dir_page.
 2510+6949              ; Vystup: NC = platná banka, C = sentinel #FF.
 2511+6949              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
 2512+6949              ; Poznamka: Mění PAGE128_STATE a port #7FFD.
 2513+6949              ; --- KONEC DOKUMENTACE CZ ---
 2514+6949              DIR128_MAP_CURRENT:
 2515+6949 E5                   push    hl
 2516+694A D5                   push    de
 2517+694B ED 5B F6 BF          ld      de,(fdp_pointer)
 2518+694F 1A                   ld      a,(de)
 2519+6950 FE FF                cp      #FF
 2520+6952 28 07                jr      z,DIR128_MAP_BAD
 2521+6954 CD E0 BF             call    PAGE128
 2522+6957 D1                   pop     de
 2523+6958 E1                   pop     hl
 2524+6959 B7                   or      a                       ;NC = valid page
 2525+695A C9                   ret
 2526+695B              DIR128_MAP_BAD:
 2527+695B D1                   pop     de
 2528+695C E1                   pop     hl
 2529+695D 37                   scf
 2530+695E C9                   ret
 2531+695F
 2532+695F              ;Select first FTP directory page (page 0).
 2533+695F              ; --- DOKUMENTACE CZ: DIR128_FIRST_PAGE ---
 2534+695F              ; Ucel: Vybere první banku adresáře (RAM 0).
 2535+695F              ; Vstup: Bez parametrů.
 2536+695F              ; Vystup: fdp_pointer = ftp_dir_page+1; NC.
 2537+695F              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
 2538+695F              ; Poznamka: Mění mapování RAM a PAGE128_STATE.
 2539+695F              ; --- KONEC DOKUMENTACE CZ ---
 2540+695F              DIR128_FIRST_PAGE:
 2541+695F E5                   push    hl
 2542+6960 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
 2543+6963 22 F6 BF             ld      (fdp_pointer),hl
 2544+6966 7E                   ld      a,(hl)
 2545+6967 CD E0 BF             call    PAGE128
 2546+696A E1                   pop     hl
 2547+696B B7                   or      a
 2548+696C C9                   ret
 2549+696D
 2550+696D              ;HL++ across #FFFF -> #C000 of the next directory page.
 2551+696D              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
 2552+696D              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
 2553+696D              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
 2554+696D              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
 2555+696D              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
 2556+696D              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
 2557+696D              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
 2558+696D              ; --- KONEC DOKUMENTACE CZ ---
 2559+696D              DIR128_INC_HL:
 2560+696D F5                   push    af                      ;old INC HL never changed A - preserve it here too
 2561+696E 23                   inc     hl
 2562+696F 7C                   ld      a,h
 2563+6970 B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
 2564+6971 28 03                jr      z,DIR128_INC_CROSS
 2565+6973 F1                   pop     af
 2566+6974 B7                   or      a                       ;restore A and return NC = OK
 2567+6975 C9                   ret
 2568+6976
 2569+6976              DIR128_INC_CROSS:
 2570+6976 D5                   push    de
 2571+6977 ED 5B F6 BF          ld      de,(fdp_pointer)
 2572+697B 13                   inc     de
 2573+697C 1A                   ld      a,(de)
 2574+697D FE FF                cp      #FF
 2575+697F 28 0E                jr      z,DIR128_INC_END
 2576+6981 ED 53 F6 BF          ld      (fdp_pointer),de
 2577+6985 CD E0 BF             call    PAGE128
 2578+6988 21 00 C0             ld      hl,ftp_dir_start        ;#C000
 2579+698B D1                   pop     de
 2580+698C F1                   pop     af                      ;restore caller's A
 2581+698D B7                   or      a                       ;NC = OK, A unchanged
 2582+698E C9                   ret
 2583+698F              DIR128_INC_END:
 2584+698F 1B                   dec     de                      ;keep fdp_pointer on last valid page
 2585+6990 ED 53 F6 BF          ld      (fdp_pointer),de
 2586+6994 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
 2587+6997 D1                   pop     de
 2588+6998 F1                   pop     af                      ;restore caller's A
 2589+6999 37                   scf                             ;C = no following directory page
 2590+699A C9                   ret
 2591+699B
 2592+699B              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
 2593+699B              ;Unlike the general helper, this preserves the COMPLETE parser state:
 2594+699B              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
 2595+699B              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
 2596+699B              ;  dir128_parser_status = 0  OK
 2597+699B              ;  dir128_parser_status = 1  no next directory page
 2598+699B              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
 2599+699B              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
 2600+699B              ; Vstup: HL = adresa v aktuální bance adresáře.
 2601+699B              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
 2602+699B              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
 2603+699B              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
 2604+699B              ; --- KONEC DOKUMENTACE CZ ---
 2605+699B              DIR128_INC_HL_PARSER:
 2606+699B F5                   push    af
 2607+699C D5                   push    de
 2608+699D AF                   xor     a
 2609+699E 32 05 88             ld      (dir128_parser_status),a
 2610+69A1 23                   inc     hl
 2611+69A2 7C                   ld      a,h
 2612+69A3 B7                   or      a
 2613+69A4 20 14                jr      nz,.ok
 2614+69A6 ED 5B F6 BF          ld      de,(fdp_pointer)
 2615+69AA 13                   inc     de
 2616+69AB 1A                   ld      a,(de)
 2617+69AC FE FF                cp      #FF
 2618+69AE 28 0D                jr      z,.full
 2619+69B0 ED 53 F6 BF          ld      (fdp_pointer),de
 2620+69B4 CD E0 BF             call    PAGE128
 2621+69B7 21 00 C0             ld      hl,ftp_dir_start
 2622+69BA              .ok:
 2623+69BA D1                   pop     de
 2624+69BB F1                   pop     af
 2625+69BC C9                   ret
 2626+69BD              .full:
 2627+69BD 1B                   dec     de
 2628+69BE ED 53 F6 BF          ld      (fdp_pointer),de
 2629+69C2 21 FF FF             ld      hl,#FFFF
 2630+69C5 3E 01                ld      a,1
 2631+69C7 32 05 88             ld      (dir128_parser_status),a
 2632+69CA D1                   pop     de
 2633+69CB F1                   pop     af
 2634+69CC C9                   ret
 2635+69CD
 2636+69CD              ;HL-- across #C000 -> #FFFF of the previous directory page.
 2637+69CD              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
 2638+69CD              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
 2639+69CD              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
 2640+69CD              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
 2641+69CD              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
 2642+69CD              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
 2643+69CD              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
 2644+69CD              ; --- KONEC DOKUMENTACE CZ ---
 2645+69CD              DIR128_DEC_HL:
 2646+69CD F5                   push    af                      ;old DEC HL never changed A - preserve it here too
 2647+69CE 2B                   dec     hl
 2648+69CF 7C                   ld      a,h
 2649+69D0 FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
 2650+69D2 28 03                jr      z,DIR128_DEC_CROSS
 2651+69D4 F1                   pop     af
 2652+69D5 B7                   or      a                       ;restore A and return NC = OK
 2653+69D6 C9                   ret
 2654+69D7
 2655+69D7              DIR128_DEC_CROSS:
 2656+69D7 D5                   push    de
 2657+69D8 ED 5B F6 BF          ld      de,(fdp_pointer)
 2658+69DC 1B                   dec     de
 2659+69DD 1A                   ld      a,(de)
 2660+69DE FE FF                cp      #FF
 2661+69E0 28 0E                jr      z,DIR128_DEC_START
 2662+69E2 ED 53 F6 BF          ld      (fdp_pointer),de
 2663+69E6 CD E0 BF             call    PAGE128
 2664+69E9 21 FF FF             ld      hl,#FFFF
 2665+69EC D1                   pop     de
 2666+69ED F1                   pop     af                      ;restore caller's A
 2667+69EE B7                   or      a                       ;NC = OK, A unchanged
 2668+69EF C9                   ret
 2669+69F0              DIR128_DEC_START:
 2670+69F0 13                   inc     de                      ;keep fdp_pointer on first valid page
 2671+69F1 ED 53 F6 BF          ld      (fdp_pointer),de
 2672+69F5 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
 2673+69F8 D1                   pop     de
 2674+69F9 F1                   pop     af                      ;restore caller's A
 2675+69FA 37                   scf                             ;C = no previous directory page
 2676+69FB C9                   ret
 2677+69FC
 2678+69FC              ;Map page-table pointer stored in DE. HL is preserved.
 2679+69FC              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
 2680+69FC              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
 2681+69FC              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
 2682+69FC              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
 2683+69FC              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
 2684+69FC              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
 2685+69FC              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
 2686+69FC              ; --- KONEC DOKUMENTACE CZ ---
 2687+69FC              DIR128_MAP_DE:
 2688+69FC F5                   push    af
 2689+69FD ED 53 F6 BF          ld      (fdp_pointer),de
 2690+6A01 1A                   ld      a,(de)
 2691+6A02 CD E0 BF             call    PAGE128
 2692+6A05 F1                   pop     af
 2693+6A06 C9                   ret
 2694+6A07
 2695+6A07
 2696+6A07              ; -----------------------------------------------------------------------------
 2697+6A07              ; DIR128_COPY_NAME_TO_DE
 2698+6A07              ; Copy the name returned by get_item_name to fixed RAM.
 2699+6A07              ; IN:  HL = physical source address in directory window
 2700+6A07              ;      BC = 16-bit name length
 2701+6A07              ;      DE = fixed-RAM destination
 2702+6A07              ;      item_name_page = page-table pointer belonging to HL
 2703+6A07              ; OUT: DE points behind copied bytes, BC=0
 2704+6A07              ; The source may cross any #FFFF -> #C000 directory-page boundary.
 2705+6A07              ; -----------------------------------------------------------------------------
 2706+6A07              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
 2707+6A07              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
 2708+6A07              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
 2709+6A07              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
 2710+6A07              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 2711+6A07              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
 2712+6A07              ; --- KONEC DOKUMENTACE CZ ---
 2713+6A07              DIR128_COPY_NAME_TO_DE:
 2714+6A07 D5                   push    de
 2715+6A08 ED 5B 55 6F          ld      de,(item_name_page)
 2716+6A0C CD FC 69             call    DIR128_MAP_DE
 2717+6A0F D1                   pop     de
 2718+6A10              .dir128_copy_loop:
 2719+6A10 78                   ld      a,b
 2720+6A11 B1                   or      c
 2721+6A12 C8                   ret     z
 2722+6A13 7E                   ld      a,(hl)
 2723+6A14 12                   ld      (de),a
 2724+6A15 13                   inc     de
 2725+6A16 0B                   dec     bc
 2726+6A17 78                   ld      a,b
 2727+6A18 B1                   or      c
 2728+6A19 C8                   ret     z
 2729+6A1A CD 6D 69             call    DIR128_INC_HL
 2730+6A1D D8                   ret     c                       ;should only happen on malformed item
 2731+6A1E 18 F0                jr      .dir128_copy_loop
 2732+6A20
 2733+6A20
 2734+6A20              ; -----------------------------------------------------------------------------
 2735+6A20              ; search_by_Busy_dir
 2736+6A20              ; Bank-safe replacement used by FIND for names returned by get_item_name.
 2737+6A20              ; IN:  HL = physical name start, BC = 16-bit name length
 2738+6A20              ;      item_name_page = bank companion for HL
 2739+6A20              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
 2740+6A20              ; OUT: Z=pattern found, NZ=not found
 2741+6A20              ; One-character input matches only the FIRST character of a name (quick jump).
 2742+6A20              ; Two or more characters use normal case-insensitive substring search. There is
 2743+6A20              ; no 255-byte directory-name limit; directory page crossings are transparent.
 2744+6A20              ; -----------------------------------------------------------------------------
 2745+6A20              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
 2746+6A20              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
 2747+6A20              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
 2748+6A20              ;   = délka vzoru.
 2749+6A20              ; Vystup: Z = shoda, NZ = nenalezeno.
 2750+6A20              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 2751+6A20              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
 2752+6A20              ; --- KONEC DOKUMENTACE CZ ---
 2753+6A20              search_by_Busy_dir:
 2754+6A20                      ; Empty name cannot contain a non-empty search pattern.
 2755+6A20 78                   ld      a,b
 2756+6A21 B1                   or      c
 2757+6A22 28 2A                jr      z,.dir_search_not_found_fast
 2758+6A24
 2759+6A24                      ; Map the directory bank containing the first byte of the name ONCE.
 2760+6A24                      ; For the normal case the whole name is inside this one 16K bank and
 2761+6A24                      ; no further paging is needed during FIND.
 2762+6A24 ED 5B 55 6F          ld      de,(item_name_page)
 2763+6A28 CD FC 69             call    DIR128_MAP_DE
 2764+6A2B
 2765+6A2B                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
 2766+6A2B                      ; the first character of the file name.  Thus FIND "S" selects names
 2767+6A2B                      ; beginning with S, while 2+ characters remain a substring search.
 2768+6A2B                      ; This is also much faster for the common one-letter jump.
 2769+6A2B ED 5B 37 78          ld      de,(txtlen+1)
 2770+6A2F 7A                   ld      a,d
 2771+6A30 B7                   or      a
 2772+6A31 20 0F                jr      nz,.dir_search_len_ge2
 2773+6A33 7B                   ld      a,e
 2774+6A34 FE 01                cp      1
 2775+6A36 20 0A                jr      nz,.dir_search_len_ge2
 2776+6A38 7E                   ld      a,(hl)

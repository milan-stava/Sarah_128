10399+BFE0              ; Vstup:
10400+BFE0              ;   A = cislo RAM stranky 0-7
10401+BFE0              ;
10402+BFE0              ; Vystup:
10403+BFE0              ;   zvolena stranka je namapovana do #C000-#FFFF
10404+BFE0              ;
10405+BFE0              ; Nastaveni #7FFD:
10406+BFE0              ;   bity 0-2 = RAM page
10407+BFE0              ;   bit 3    = screen 0  (RAM 5)
10408+BFE0              ;   bit 4    = 48K ROM
10409+BFE0              ;   bit 5    = paging enabled
10410+BFE0              ;
10411+BFE0              ; Pozor:
10412+BFE0              ;   bit 5 musi zustat 0, jinak se strankovani zamkne
10413+BFE0              ; ------------------------------------------------------------
10414+BFE0
10415+BFE0              ; --- DOKUMENTACE CZ: PAGE128 ---
10416+BFE0              ; Ucel: Přepne horní 16KB okno paměti ZX Spectrum 128.
10417+BFE0              ; Vstup: A = číslo banky 0–7 (použijí se spodní tři bity).
10418+BFE0              ; Vystup: A = hodnota zapsaná na #7FFD a do PAGE128_STATE.
10419+BFE0              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
10420+BFE0              ; Poznamka: Volí 48K ROM, obrazovku v RAM 5; bit zámku stránkování nechává nulový.
10421+BFE0              ; --- KONEC DOKUMENTACE CZ ---
10422+BFE0              PAGE128:
10423+BFE0 E6 07                and     %00000111
10424+BFE2 F6 10                or      %00010000
10425+BFE4 32 EF BF             ld      (PAGE128_STATE),a

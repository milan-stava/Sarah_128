   1++9EE7              ; Shared ESP-AT framing above the unchanged Wi-Fi BIOS.
   2++9EE7              ; Firmware dialect retained: +CIPRECVDATA,<length>:<binary>.
   3++9EE7              ; Events: 1 OK, 2 ERROR, 3 prompt, 4 SEND OK, 5 SEND FAIL,
   4++9EE7              ;         6 busy, 7 active IPD header, 8 receive-data header, 0 other.
   5++9EE7              ; Binary payload is never searched for AT result strings.
   6++9EE7              AT_OK equ 1
   7++9EE7              AT_ERROR equ 2
   8++9EE7              AT_PROMPT equ 3
   9++9EE7              AT_SEND_OK equ 4
  10++9EE7              AT_SEND_FAIL equ 5

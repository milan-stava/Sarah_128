 912+ 620E              ; Vystup: Připravená komunikace nebo obsluha chyby.
 913+ 620E              ; Meni: AF, BC, DE, HL, BC'; další změny dle volaných BIOS/DOS a tiskových služeb.
 914+ 620E              ; Poznamka: Pracuje s konfigurací rychlosti, příjmovým bufferem a stavovým výpisem.
 915+ 620E              ; --- KONEC DOKUMENTACE CZ ---
 916+ 620E              speed_management
 917+ 620E DD 36 07 FF  		ld	(ix+7),#FF		;reset currently set speed status
 918+ 6212 DD CB 00 B6  		res	6,(ix+0)		;set signal UART and module speed not aligned

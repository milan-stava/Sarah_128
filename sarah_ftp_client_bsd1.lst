2764+ 6A1E              ; -----------------------------------------------------------------------------
2765+ 6A1E              ; search_by_Busy_fast
2766+ 6A1E              ; Fast case-insensitive substring search for a name fully contained in the
2767+ 6A1E              ; currently mapped 16K directory page.
2768+ 6A1E              ;
2769+ 6A1E              ; IN:  HL = name start, BC = 16-bit name length
2770+ 6A1E              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
2771+ 6A1E              ; OUT: Z = found, NZ = not found
2772+ 6A1E              ;
2773+ 6A1E              ; This is deliberately close to the original Busy FIND: the inner compare uses
2774+ 6A1E              ; the Z80 CPI instruction.  The pattern has already been converted to lower
2775+ 6A1E              ; case once by find_items, so only the source character needs convert here.
2776+ 6A1E              ;
2777+ 6A1E              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
2778+ 6A1E              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
2779+ 6A1E              ; matches therefore cannot be skipped.
2780+ 6A1E              ; -----------------------------------------------------------------------------
2781+ 6A1E              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
2782+ 6A1E              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
2783+ 6A1E              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
2784+ 6A1E              ;   délka.
2785+ 6A1E              ; Vystup: Z = shoda, NZ = nenalezeno.
2786+ 6A1E              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2787+ 6A1E              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
2788+ 6A1E              ; --- KONEC DOKUMENTACE CZ ---
2789+ 6A1E              search_by_Busy_fast:
2790+ 6A1E EB                   ex      de,hl                   ;DE=current candidate in file name
2791+ 6A1F
2792+ 6A1F                      ; candidate_count = name_length - pattern_length + 1
2793+ 6A1F 60                   ld      h,b
2794+ 6A20 69                   ld      l,c
2795+ 6A21 ED 4B D4 77          ld      bc,(txtlen+1)
2796+ 6A25 78                   ld      a,b
2797+ 6A26 B1                   or      c
2798+ 6A27 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
2799+ 6A29 B7                   or      a
2800+ 6A2A ED 42                sbc     hl,bc
2801+ 6A2C 38 25                jr      c,.fast_not_found       ;pattern longer than file name
2802+ 6A2E 23                   inc     hl
2803+ 6A2F
2804+ 6A2F                      ; Keep number of possible candidate starts in alternate BC.
2805+ 6A2F E5                   push    hl
2806+ 6A30 D9                   exx
2807+ 6A31 C1                   pop     bc
2808+ 6A32 D9                   exx
2809+ 6A33
2810+ 6A33              .fast_next_candidate:
2811+ 6A33 D5                   push    de                      ;remember exact candidate start
2812+ 6A34 21 B9 8D             ld      hl,INPBUFF
2813+ 6A37 ED 4B D4 77          ld      bc,(txtlen+1)
2814+ 6A3B
2815+ 6A3B              .fast_compare:
2816+ 6A3B 1A                   ld      a,(de)
2817+ 6A3C CD F8 77             call    convert                 ;source char -> lower case
2818+ 6A3F ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
2819+ 6A41 13                   inc     de
2820+ 6A42 20 06                jr      nz,.fast_candidate_failed
2821+ 6A44 EA 3B 6A             jp      pe,.fast_compare        ;matched, more pattern bytes remain
2822+ 6A47
2823+ 6A47 D1                   pop     de                      ;discard saved candidate start
2824+ 6A48              .fast_found:
2825+ 6A48 AF                   xor     a                       ;Z = found
2826+ 6A49 C9                   ret
2827+ 6A4A
2828+ 6A4A              .fast_candidate_failed:
2829+ 6A4A D1                   pop     de                      ;restore previous candidate start
2830+ 6A4B 13                   inc     de                      ;next candidate = previous + 1
2831+ 6A4C D9                   exx
2832+ 6A4D 0B                   dec     bc
2833+ 6A4E 78                   ld      a,b
2834+ 6A4F B1                   or      c
2835+ 6A50 D9                   exx
2836+ 6A51 20 E0                jr      nz,.fast_next_candidate
2837+ 6A53
2838+ 6A53              .fast_not_found:
2839+ 6A53 3E 01                ld      a,1
2840+ 6A55 B7                   or      a                       ;NZ = not found
2841+ 6A56 C9                   ret

    1+A1AD              ; Shared ESP-AT framing above the unchanged Wi-Fi BIOS.
    2+A1AD              ; Firmware dialect retained: +CIPRECVDATA,<length>:<binary>.
    3+A1AD              ; Events: 1 OK, 2 ERROR, 3 prompt, 4 SEND OK, 5 SEND FAIL,
    4+A1AD              ;         6 busy, 7 active IPD header, 8 receive-data header, 0 other.
    5+A1AD              ; Binary payload is never searched for AT result strings.
    6+A1AD              AT_OK equ 1
    7+A1AD              AT_ERROR equ 2
    8+A1AD              AT_PROMPT equ 3

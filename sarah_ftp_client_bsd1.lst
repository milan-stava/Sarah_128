5946+ 7876              ;16)
5947+ 7876              ; --- DOKUMENTACE CZ: ConvRStr16 ---
5948+ 7876              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
5949+ 7876              ; Vstup: DE = začátek číslic.
5950+ 7876              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
5951+ 7876              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
5952+ 7876              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
5953+ 7876              ;   přetečení; Z nemá pevný význam.
5954+ 7876              ; --- KONEC DOKUMENTACE CZ ---
5955+ 7876              ConvRStr16
5956+ 7876              ;===============================================================
5957+ 7876              ;http://z80-heaven.wikidot.com/math#toc32
5958+ 7876              ;Input:
5959+ 7876              ;     DE points to the base 10 number string in RAM.
5960+ 7876              ;Outputs:
5961+ 7876              ;     HL is the 16-bit value of the number
5962+ 7876              ;     DE points to the byte after the number
5963+ 7876              ;     BC is HL/10
5964+ 7876              ;     z flag reset (nz)
5965+ 7876              ;     c flag reset (nc)
5966+ 7876              ;Destroys:
5967+ 7876              ;     A (actually, add 30h and you get the ending token)
5968+ 7876              ;Size:  23 bytes
5969+ 7876              ;Speed: 104n+42+11c
5970+ 7876              ;       n is the number of digits
5971+ 7876              ;       c is at most n-2
5972+ 7876              ;       at most 595 cycles for any 16-bit decimal value
5973+ 7876              ;===============================================================
5974+ 7876
5975+ 7876 21 00 00          ld hl,0          ;  10 : 210000
5976+ 7879              ConvLoop:             ;
5977+ 7879 1A                ld a,(de)        ;   7 : 1A
5978+ 787A D6 30             sub 30h          ;   7 : D630
5979+ 787C FE 0A             cp 10            ;   7 : FE0A
5980+ 787E D0                ret nc           ;5|11 : D0
5981+ 787F 13                inc de           ;   6 : 13
5982+ 7880                                    ;
5983+ 7880 44                ld b,h           ;   4 : 44
5984+ 7881 4D                ld c,l           ;   4 : 4D
5985+ 7882 29                add hl,hl        ;  11 : 29
5986+ 7883 29                add hl,hl        ;  11 : 29
5987+ 7884 09                add hl,bc        ;  11 : 09
5988+ 7885 29                add hl,hl        ;  11 : 29
5989+ 7886                                    ;
5990+ 7886 85                add a,l          ;   4 : 85
5991+ 7887 6F                ld l,a           ;   4 : 6F
5992+ 7888 30 EF             jr nc,ConvLoop   ;12|23: 30EE
5993+ 788A 24                inc h            ; --- : 24
5994+ 788B 18 EC             jr ConvLoop      ; --- : 18EB
5995+ 788D
5996+ 788D
5997+ 788D

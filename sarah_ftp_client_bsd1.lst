2748+ 6AFD              ; search_by_Busy_fast
2749+ 6AFD              ; Fast case-insensitive substring search for a name fully contained in the
2750+ 6AFD              ; currently mapped 16K directory page.
2751+ 6AFD              ;
2752+ 6AFD              ; IN:  HL = name start, BC = 16-bit name length
2753+ 6AFD              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
2754+ 6AFD              ; OUT: Z = found, NZ = not found
2755+ 6AFD              ;
2756+ 6AFD              ; This is deliberately close to the original Busy FIND: the inner compare uses
2757+ 6AFD              ; the Z80 CPI instruction.  The pattern has already been converted to lower
2758+ 6AFD              ; case once by find_items, so only the source character needs convert here.
2759+ 6AFD              ;
2760+ 6AFD              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
2761+ 6AFD              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
2762+ 6AFD              ; matches therefore cannot be skipped.
2763+ 6AFD              ; -----------------------------------------------------------------------------
2764+ 6AFD              search_by_Busy_fast:
2765+ 6AFD EB                   ex      de,hl                   ;DE=current candidate in file name
2766+ 6AFE
2767+ 6AFE                      ; candidate_count = name_length - pattern_length + 1
2768+ 6AFE 60                   ld      h,b
2769+ 6AFF 69                   ld      l,c
2770+ 6B00 ED 4B 06 78          ld      bc,(txtlen+1)
2771+ 6B04 78                   ld      a,b
2772+ 6B05 B1                   or      c
2773+ 6B06 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
2774+ 6B08 B7                   or      a
2775+ 6B09 ED 42                sbc     hl,bc
2776+ 6B0B 38 25                jr      c,.fast_not_found       ;pattern longer than file name

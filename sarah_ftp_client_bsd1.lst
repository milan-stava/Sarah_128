2476+ 69EC              ; -----------------------------------------------------------------------------
2477+ 69EC              ; FTP DIRECTORY BANK API
2478+ 69EC              ;
2479+ 69EC              ; fdp_pointer always points to the table byte of the CURRENT directory page.
2480+ 69EC              ; ftp_dir_page has #FF sentinels on both sides:
2481+ 69EC              ;       #FF, 0, 1, 3, 7, #FF
2482+ 69EC              ;
2483+ 69EC              ; HL is always a physical address in the banked window #C000-#FFFF.
2484+ 69EC              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
2485+ 69EC              ;
2486+ 69EC              ; OUT for INC/DEC:
2487+ 69EC              ;       NC = movement succeeded
2488+ 69EC              ;       C  = no next/previous directory page (64 KB boundary)
2489+ 69EC              ;
2490+ 69EC              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
2491+ 69EC              ; which preserves AF/BC/DE/IX/IY exactly.
2492+ 69EC              ; -----------------------------------------------------------------------------
2493+ 69EC
2494+ 69EC
2495+ 69EC              ; Select first FTP directory page (page 0); preserve caller's pointer.
2496+ 69EC              DIR128_FIRST_PAGE:
2497+ 69EC E5                   push    hl
2498+ 69ED 21 F1 BF             ld      hl,ftp_dir_page+1
2499+ 69F0 22 F6 BF             ld      (fdp_pointer),hl
2500+ 69F3 7E                   ld      a,(hl)
2501+ 69F4 CD E0 BF             call    PAGE128
2502+ 69F7 E1                   pop     hl
2503+ 69F8 B7                   or      a
2504+ 69F9 C9                   ret
2505+ 69FA
2506+ 69FA              ;HL++ across #FFFF -> #C000 of the next directory page.
2507+ 69FA              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
2508+ 69FA              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
2509+ 69FA              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
2510+ 69FA              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2511+ 69FA              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
2512+ 69FA              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2513+ 69FA              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2514+ 69FA              ; --- KONEC DOKUMENTACE CZ ---
2515+ 69FA              DIR128_INC_HL:
2516+ 69FA F5                   push    af                      ;old INC HL never changed A - preserve it here too
2517+ 69FB 23                   inc     hl
2518+ 69FC 7C                   ld      a,h
2519+ 69FD B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
2520+ 69FE 28 03                jr      z,DIR128_INC_CROSS
2521+ 6A00 F1                   pop     af
2522+ 6A01 B7                   or      a                       ;restore A and return NC = OK
2523+ 6A02 C9                   ret
2524+ 6A03
2525+ 6A03              DIR128_INC_CROSS:
2526+ 6A03 D5                   push    de
2527+ 6A04 ED 5B F6 BF          ld      de,(fdp_pointer)
2528+ 6A08 13                   inc     de
2529+ 6A09 1A                   ld      a,(de)
2530+ 6A0A FE FF                cp      #FF
2531+ 6A0C 28 0E                jr      z,DIR128_INC_END
2532+ 6A0E ED 53 F6 BF          ld      (fdp_pointer),de
2533+ 6A12 CD E0 BF             call    PAGE128
2534+ 6A15 21 00 C0             ld      hl,ftp_dir_start        ;#C000
2535+ 6A18 D1                   pop     de
2536+ 6A19 F1                   pop     af                      ;restore caller's A
2537+ 6A1A B7                   or      a                       ;NC = OK, A unchanged
2538+ 6A1B C9                   ret
2539+ 6A1C              DIR128_INC_END:
2540+ 6A1C 1B                   dec     de                      ;keep fdp_pointer on last valid page
2541+ 6A1D ED 53 F6 BF          ld      (fdp_pointer),de
2542+ 6A21 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
2543+ 6A24 D1                   pop     de
2544+ 6A25 F1                   pop     af                      ;restore caller's A
2545+ 6A26 37                   scf                             ;C = no following directory page
2546+ 6A27 C9                   ret
2547+ 6A28
2548+ 6A28              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
2549+ 6A28              ;Unlike the general helper, this preserves the COMPLETE parser state:
2550+ 6A28              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
2551+ 6A28              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
2552+ 6A28              ;  dir128_parser_status = 0  OK
2553+ 6A28              ;  dir128_parser_status = 1  no next directory page
2554+ 6A28              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
2555+ 6A28              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
2556+ 6A28              ; Vstup: HL = adresa v aktuální bance adresáře.
2557+ 6A28              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
2558+ 6A28              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
2559+ 6A28              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
2560+ 6A28              ; --- KONEC DOKUMENTACE CZ ---
2561+ 6A28              DIR128_INC_HL_PARSER:
2562+ 6A28 F5                   push    af
2563+ 6A29 D5                   push    de
2564+ 6A2A AF                   xor     a
2565+ 6A2B 32 4B 88             ld      (dir128_parser_status),a
2566+ 6A2E 23                   inc     hl
2567+ 6A2F 7C                   ld      a,h
2568+ 6A30 B7                   or      a
2569+ 6A31 20 14                jr      nz,.ok
2570+ 6A33 ED 5B F6 BF          ld      de,(fdp_pointer)
2571+ 6A37 13                   inc     de
2572+ 6A38 1A                   ld      a,(de)
2573+ 6A39 FE FF                cp      #FF
2574+ 6A3B 28 0D                jr      z,.full
2575+ 6A3D ED 53 F6 BF          ld      (fdp_pointer),de
2576+ 6A41 CD E0 BF             call    PAGE128
2577+ 6A44 21 00 C0             ld      hl,ftp_dir_start
2578+ 6A47              .ok:
2579+ 6A47 D1                   pop     de
2580+ 6A48 F1                   pop     af
2581+ 6A49 C9                   ret
2582+ 6A4A              .full:
2583+ 6A4A 1B                   dec     de
2584+ 6A4B ED 53 F6 BF          ld      (fdp_pointer),de
2585+ 6A4F 21 FF FF             ld      hl,#FFFF
2586+ 6A52 3E 01                ld      a,1
2587+ 6A54 32 4B 88             ld      (dir128_parser_status),a
2588+ 6A57 D1                   pop     de
2589+ 6A58 F1                   pop     af
2590+ 6A59 C9                   ret
2591+ 6A5A
2592+ 6A5A              ;HL-- across #C000 -> #FFFF of the previous directory page.
2593+ 6A5A              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
2594+ 6A5A              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
2595+ 6A5A              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
2596+ 6A5A              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2597+ 6A5A              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
2598+ 6A5A              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2599+ 6A5A              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2600+ 6A5A              ; --- KONEC DOKUMENTACE CZ ---
2601+ 6A5A              DIR128_DEC_HL:
2602+ 6A5A F5                   push    af                      ;old DEC HL never changed A - preserve it here too
2603+ 6A5B 2B                   dec     hl
2604+ 6A5C 7C                   ld      a,h
2605+ 6A5D FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
2606+ 6A5F 28 03                jr      z,DIR128_DEC_CROSS
2607+ 6A61 F1                   pop     af
2608+ 6A62 B7                   or      a                       ;restore A and return NC = OK
2609+ 6A63 C9                   ret
2610+ 6A64
2611+ 6A64              DIR128_DEC_CROSS:
2612+ 6A64 D5                   push    de
2613+ 6A65 ED 5B F6 BF          ld      de,(fdp_pointer)
2614+ 6A69 1B                   dec     de
2615+ 6A6A 1A                   ld      a,(de)
2616+ 6A6B FE FF                cp      #FF
2617+ 6A6D 28 0E                jr      z,DIR128_DEC_START
2618+ 6A6F ED 53 F6 BF          ld      (fdp_pointer),de
2619+ 6A73 CD E0 BF             call    PAGE128
2620+ 6A76 21 FF FF             ld      hl,#FFFF
2621+ 6A79 D1                   pop     de
2622+ 6A7A F1                   pop     af                      ;restore caller's A
2623+ 6A7B B7                   or      a                       ;NC = OK, A unchanged
2624+ 6A7C C9                   ret
2625+ 6A7D              DIR128_DEC_START:
2626+ 6A7D 13                   inc     de                      ;keep fdp_pointer on first valid page
2627+ 6A7E ED 53 F6 BF          ld      (fdp_pointer),de
2628+ 6A82 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
2629+ 6A85 D1                   pop     de
2630+ 6A86 F1                   pop     af                      ;restore caller's A
2631+ 6A87 37                   scf                             ;C = no previous directory page
2632+ 6A88 C9                   ret
2633+ 6A89
2634+ 6A89              ;Map page-table pointer stored in DE. HL is preserved.
2635+ 6A89              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
2636+ 6A89              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
2637+ 6A89              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
2638+ 6A89              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
2639+ 6A89              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
2640+ 6A89              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
2641+ 6A89              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
2642+ 6A89              ; --- KONEC DOKUMENTACE CZ ---
2643+ 6A89              DIR128_MAP_DE:
2644+ 6A89 F5                   push    af
2645+ 6A8A ED 53 F6 BF          ld      (fdp_pointer),de
2646+ 6A8E 1A                   ld      a,(de)
2647+ 6A8F CD E0 BF             call    PAGE128
2648+ 6A92 F1                   pop     af
2649+ 6A93 C9                   ret
2650+ 6A94
2651+ 6A94
2652+ 6A94              ; -----------------------------------------------------------------------------
2653+ 6A94              ; DIR128_COPY_NAME_TO_DE
2654+ 6A94              ; Copy the name returned by get_item_name to fixed RAM.
2655+ 6A94              ; IN:  HL = physical source address in directory window
2656+ 6A94              ;      BC = 16-bit name length
2657+ 6A94              ;      DE = fixed-RAM destination
2658+ 6A94              ;      item_name_page = page-table pointer belonging to HL
2659+ 6A94              ; OUT: DE points behind copied bytes, BC=0
2660+ 6A94              ; The source may cross any #FFFF -> #C000 directory-page boundary.
2661+ 6A94              ; -----------------------------------------------------------------------------
2662+ 6A94              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
2663+ 6A94              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
2664+ 6A94              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
2665+ 6A94              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
2666+ 6A94              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2667+ 6A94              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
2668+ 6A94              ; --- KONEC DOKUMENTACE CZ ---
2669+ 6A94              DIR128_COPY_NAME_TO_DE:
2670+ 6A94 D5                   push    de
2671+ 6A95 ED 5B E0 6F          ld      de,(item_name_page)
2672+ 6A99 CD 89 6A             call    DIR128_MAP_DE
2673+ 6A9C D1                   pop     de
2674+ 6A9D              .dir128_copy_loop:
2675+ 6A9D 78                   ld      a,b
2676+ 6A9E B1                   or      c
2677+ 6A9F C8                   ret     z
2678+ 6AA0 7E                   ld      a,(hl)
2679+ 6AA1 12                   ld      (de),a
2680+ 6AA2 13                   inc     de
2681+ 6AA3 0B                   dec     bc
2682+ 6AA4 78                   ld      a,b
2683+ 6AA5 B1                   or      c
2684+ 6AA6 C8                   ret     z
2685+ 6AA7 CD FA 69             call    DIR128_INC_HL
2686+ 6AAA D8                   ret     c                       ;should only happen on malformed item
2687+ 6AAB 18 F0                jr      .dir128_copy_loop

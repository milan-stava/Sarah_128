9826+ BFE0              ; Vstup:
9827+ BFE0              ;   A = cislo RAM stranky 0-7
9828+ BFE0              ;
9829+ BFE0              ; Vystup:
9830+ BFE0              ;   zvolena stranka je namapovana do #C000-#FFFF
9831+ BFE0              ;
9832+ BFE0              ; Nastaveni #7FFD:
9833+ BFE0              ;   bity 0-2 = RAM page
9834+ BFE0              ;   bit 3    = screen 0  (RAM 5)
9835+ BFE0              ;   bit 4    = 48K ROM
9836+ BFE0              ;   bit 5    = paging enabled
9837+ BFE0              ;
9838+ BFE0              ; Pozor:
9839+ BFE0              ;   bit 5 musi zustat 0, jinak se strankovani zamkne
9840+ BFE0              ; ------------------------------------------------------------
9841+ BFE0
9842+ BFE0              ; --- DOKUMENTACE CZ: PAGE128 ---
9843+ BFE0              ; Ucel: Přepne horní 16KB okno paměti ZX Spectrum 128.
9844+ BFE0              ; Vstup: A = číslo banky 0–7 (použijí se spodní tři bity).
9845+ BFE0              ; Vystup: A = hodnota zapsaná na #7FFD a do PAGE128_STATE.
9846+ BFE0              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
9847+ BFE0              ; Poznamka: Volí 48K ROM, obrazovku v RAM 5; bit zámku stránkování nechává nulový.
9848+ BFE0              ; --- KONEC DOKUMENTACE CZ ---
9849+ BFE0              PAGE128:
9850+ BFE0 E6 07                and     %00000111
9851+ BFE2 F6 10                or      %00010000
9852+ BFE4 32 EF BF             ld      (PAGE128_STATE),a

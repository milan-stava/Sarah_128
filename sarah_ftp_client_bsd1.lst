 9071+83D0 DA 9F 84             jp      c,gfn_bad
 9072+83D3
 9073+83D3                      ;Synthetic first item ".." is always page 0:#C000.
 9074+83D3 E5                   push    hl
 9075+83D4 2A 03 88             ld      hl,(cur_item_addr_page)

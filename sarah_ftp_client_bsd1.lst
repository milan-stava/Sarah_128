2442+ 6916              ; FTP DIRECTORY BANK API
2443+ 6916              ;
2444+ 6916              ; fdp_pointer always points to the table byte of the CURRENT directory page.
2445+ 6916              ; ftp_dir_page has #FF sentinels on both sides:
2446+ 6916              ;       #FF, 0, 1, 3, 7, #FF
2447+ 6916              ;
2448+ 6916              ; HL is always a physical address in the banked window #C000-#FFFF.
2449+ 6916              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
2450+ 6916              ;
2451+ 6916              ; OUT for INC/DEC:
2452+ 6916              ;       NC = movement succeeded
2453+ 6916              ;       C  = no next/previous directory page (64 KB boundary)
2454+ 6916              ;
2455+ 6916              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
2456+ 6916              ; which preserves AF/BC/DE/IX/IY exactly.
2457+ 6916              ; -----------------------------------------------------------------------------
2458+ 6916
2459+ 6916              ; --- DOKUMENTACE CZ: DIR128_MAP_CURRENT ---
2460+ 6916              ; Ucel: Namapuje aktuální banku adresáře do #C000–#FFFF.
2461+ 6916              ; Vstup: fdp_pointer ukazuje do tabulky ftp_dir_page.
2462+ 6916              ; Vystup: NC = platná banka, C = sentinel #FF.
2463+ 6916              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
2464+ 6916              ; Poznamka: Mění PAGE128_STATE a port #7FFD.
2465+ 6916              ; --- KONEC DOKUMENTACE CZ ---
2466+ 6916              DIR128_MAP_CURRENT:
2467+ 6916 E5                   push    hl
2468+ 6917 D5                   push    de
2469+ 6918 ED 5B F6 BF          ld      de,(fdp_pointer)
2470+ 691C 1A                   ld      a,(de)
2471+ 691D FE FF                cp      #FF
2472+ 691F 28 07                jr      z,DIR128_MAP_BAD
2473+ 6921 CD E0 BF             call    PAGE128
2474+ 6924 D1                   pop     de
2475+ 6925 E1                   pop     hl
2476+ 6926 B7                   or      a                       ;NC = valid page
2477+ 6927 C9                   ret
2478+ 6928              DIR128_MAP_BAD:
2479+ 6928 D1                   pop     de
2480+ 6929 E1                   pop     hl
2481+ 692A 37                   scf
2482+ 692B C9                   ret
2483+ 692C
2484+ 692C              ;Select first FTP directory page (page 0).
2485+ 692C              ; --- DOKUMENTACE CZ: DIR128_FIRST_PAGE ---
2486+ 692C              ; Ucel: Vybere první banku adresáře (RAM 0).
2487+ 692C              ; Vstup: Bez parametrů.
2488+ 692C              ; Vystup: fdp_pointer = ftp_dir_page+1; NC.
2489+ 692C              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
2490+ 692C              ; Poznamka: Mění mapování RAM a PAGE128_STATE.
2491+ 692C              ; --- KONEC DOKUMENTACE CZ ---
2492+ 692C              DIR128_FIRST_PAGE:
2493+ 692C E5                   push    hl
2494+ 692D 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
2495+ 6930 22 F6 BF             ld      (fdp_pointer),hl
2496+ 6933 7E                   ld      a,(hl)
2497+ 6934 CD E0 BF             call    PAGE128
2498+ 6937 E1                   pop     hl
2499+ 6938 B7                   or      a
2500+ 6939 C9                   ret
2501+ 693A
2502+ 693A              ;HL++ across #FFFF -> #C000 of the next directory page.
2503+ 693A              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
2504+ 693A              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
2505+ 693A              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
2506+ 693A              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2507+ 693A              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
2508+ 693A              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2509+ 693A              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2510+ 693A              ; --- KONEC DOKUMENTACE CZ ---
2511+ 693A              DIR128_INC_HL:
2512+ 693A F5                   push    af                      ;old INC HL never changed A - preserve it here too
2513+ 693B 23                   inc     hl
2514+ 693C 7C                   ld      a,h
2515+ 693D B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
2516+ 693E 28 03                jr      z,DIR128_INC_CROSS
2517+ 6940 F1                   pop     af
2518+ 6941 B7                   or      a                       ;restore A and return NC = OK
2519+ 6942 C9                   ret
2520+ 6943
2521+ 6943              DIR128_INC_CROSS:
2522+ 6943 D5                   push    de
2523+ 6944 ED 5B F6 BF          ld      de,(fdp_pointer)
2524+ 6948 13                   inc     de
2525+ 6949 1A                   ld      a,(de)
2526+ 694A FE FF                cp      #FF
2527+ 694C 28 0E                jr      z,DIR128_INC_END
2528+ 694E ED 53 F6 BF          ld      (fdp_pointer),de
2529+ 6952 CD E0 BF             call    PAGE128
2530+ 6955 21 00 C0             ld      hl,ftp_dir_start        ;#C000
2531+ 6958 D1                   pop     de
2532+ 6959 F1                   pop     af                      ;restore caller's A
2533+ 695A B7                   or      a                       ;NC = OK, A unchanged
2534+ 695B C9                   ret
2535+ 695C              DIR128_INC_END:
2536+ 695C 1B                   dec     de                      ;keep fdp_pointer on last valid page
2537+ 695D ED 53 F6 BF          ld      (fdp_pointer),de
2538+ 6961 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
2539+ 6964 D1                   pop     de
2540+ 6965 F1                   pop     af                      ;restore caller's A
2541+ 6966 37                   scf                             ;C = no following directory page
2542+ 6967 C9                   ret

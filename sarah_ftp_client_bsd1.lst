7550+ 7D78              ; --- DOKUMENTACE CZ: error_handler ---
7551+ 7D78              ; Ucel: Zobrazí chybu, ukončí čekání a vrátí řízení na nejvyšší úroveň.
7552+ 7D78              ; Vstup: C = číslo chyby; inicializovaný hlavní zásobník.
7553+ 7D78              ; Vystup: Nevrací se běžně volajícímu: SP nastaví na basic_end-2.
7554+ 7D78              ; Meni: AF, BC, DE, HL, BC' (přes příjem odpovědi); další registry externích služeb viz jejich
7555+ 7D78              ;   rozhraní. SP.
7556+ 7D78              ; Poznamka: Obnovuje 3,5 MHz a vypíná pasivní příjem.
7557+ 7D78              ; --- KONEC DOKUMENTACE CZ ---
7558+ 7D78 AF           error_handler xor a
7559+ 7D79 32 E6 9E                ld (upload_legacy_mode),a
7560+ 7D7C C5                      push bc                ;preserve original error across clock switch
7561+ 7D7D CD F5 80                call set_3_5mhz
7562+ 7D80 C1                      pop bc
7563+ 7D81 3A AC 7D                ld a,(error_recovering)
7564+ 7D84 B7                      or a
7565+ 7D85 20 16                   jr nz,error_handler_exit ;cleanup itself failed: do not recurse again
7566+ 7D87 3C                      inc a
7567+ 7D88 32 AC 7D                ld (error_recovering),a
7568+ 7D8B CD AD 7D                call display_error
7569+ 7D8E CD 75 7B                call wifi_unwait
7570+ 7D91 CD E6 A2                call at_reset_stream
7571+ 7D94 DD CB 00 76             bit 6,(ix+0)

 3319+6EB7              ; -----------------------------------------------------------------------------
 3320+6EB7              ; search_by_Busy_dir_slow
 3321+6EB7              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
 3322+6EB7              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
 3323+6EB7              ; no longer slows down every ordinary FIND operation.
 3324+6EB7              ;
 3325+6EB7              ; One-character FIND is handled before this fallback and compares only the
 3326+6EB7              ; first character.  This slow path therefore normally handles 2+ character
 3327+6EB7              ; substring searches whose source name crosses a directory-bank boundary.
 3328+6EB7              ; -----------------------------------------------------------------------------
 3329+6EB7              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
 3330+6EB7              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
 3331+6EB7              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
 3332+6EB7              ;   a délka.
 3333+6EB7              ; Vystup: Z = shoda, NZ = nenalezeno.
 3334+6EB7              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 3335+6EB7              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
 3336+6EB7              ; --- KONEC DOKUMENTACE CZ ---
 3337+6EB7              search_by_Busy_dir_slow:
 3338+6EB7 22 C1 72             ld      (dir_search_addr),hl
 3339+6EBA ED 43 C5 72          ld      (dir_search_remaining),bc
 3340+6EBE ED 5B BA 72          ld      de,(item_name_page)
 3341+6EC2 ED 53 C3 72          ld      (dir_search_page),de
 3342+6EC6 2A 35 7B             ld      hl,(txtlen+1)
 3343+6EC9 22 C7 72             ld      (dir_search_patlen),hl
 3344+6ECC 7C                   ld      a,h
 3345+6ECD B5                   or      l
 3346+6ECE 28 56                jr      z,.dir_search_found
 3347+6ED0
 3348+6ED0              .dir_search_outer:
 3349+6ED0                      ;If remaining source length < pattern length, no further match exists.
 3350+6ED0 2A C5 72             ld      hl,(dir_search_remaining)
 3351+6ED3 ED 5B C7 72          ld      de,(dir_search_patlen)
 3352+6ED7 B7                   or      a
 3353+6ED8 ED 52                sbc     hl,de
 3354+6EDA 38 4C                jr      c,.dir_search_not_found
 3355+6EDC
 3356+6EDC                      ;Start one comparison at current candidate address/page.
 3357+6EDC 2A C1 72             ld      hl,(dir_search_addr)
 3358+6EDF ED 5B C3 72          ld      de,(dir_search_page)
 3359+6EE3 CD 28 6E             call    DIR128_MAP_DE
 3360+6EE6 11 CB 90             ld      de,INPBUFF
 3361+6EE9 ED 4B C7 72          ld      bc,(dir_search_patlen)
 3362+6EED
 3363+6EED              .dir_search_cmp:
 3364+6EED 7E                   ld      a,(hl)
 3365+6EEE CD 59 7B             call    convert                 ;source char -> lower case
 3366+6EF1 EB                   ex      de,hl
 3367+6EF2 BE                   cp      (hl)                    ;pattern already normalized by FIND
 3368+6EF3 EB                   ex      de,hl
 3369+6EF4 20 0D                jr      nz,.dir_search_advance_candidate
 3370+6EF6
 3371+6EF6 13                   inc     de
 3372+6EF7 0B                   dec     bc
 3373+6EF8 78                   ld      a,b
 3374+6EF9 B1                   or      c
 3375+6EFA 28 2A                jr      z,.dir_search_found
 3376+6EFC CD 99 6D             call    DIR128_INC_HL
 3377+6EFF 38 27                jr      c,.dir_search_not_found
 3378+6F01 18 EA                jr      .dir_search_cmp
 3379+6F03
 3380+6F03              .dir_search_advance_candidate:
 3381+6F03                      ;Always advance by exactly ONE source character.  This fixes both the
 3382+6F03                      ;old overlapping-match bug and the old one-character special case.
 3383+6F03 2A C1 72             ld      hl,(dir_search_addr)
 3384+6F06 ED 5B C3 72          ld      de,(dir_search_page)
 3385+6F0A CD 28 6E             call    DIR128_MAP_DE
 3386+6F0D CD 99 6D             call    DIR128_INC_HL
 3387+6F10 38 16                jr      c,.dir_search_not_found
 3388+6F12 22 C1 72             ld      (dir_search_addr),hl
 3389+6F15 ED 5B F6 BF          ld      de,(fdp_pointer)
 3390+6F19 ED 53 C3 72          ld      (dir_search_page),de
 3391+6F1D 2A C5 72             ld      hl,(dir_search_remaining)
 3392+6F20 2B                   dec     hl
 3393+6F21 22 C5 72             ld      (dir_search_remaining),hl
 3394+6F24 18 AA                jr      .dir_search_outer
 3395+6F26
 3396+6F26              .dir_search_found:
 3397+6F26 AF                   xor     a                       ;Z
 3398+6F27 C9                   ret
 3399+6F28              .dir_search_not_found:
 3400+6F28 3E 01                ld      a,1
 3401+6F2A B7                   or      a                       ;NZ
 3402+6F2B C9                   ret

  947+623F              ;zde konci vetev, kdy na pocatku SM2.0 nebylo nalezeno slazeni rychlosti
  948+623F
  949+623F              ;zde jsme ze zacatku rychlost nasli a zkoumame, zda je to ta, kterou chceme, pokud ne, tak ji nastav
  950+623F CD 6B 62     speed_aligned	call	find_out_speed		;output: D= currently aligned speed
  951+6242 CD EC 7E     align_success	call	set_ud_speed
  952+6245
  953+6245              ;ve speed_we_want vyhodnotit, zda je odezva na AT prikaz. Pokud ne, neznamená to, e
  954+6245              ;rychlosti nebyly slazeny, ale ze nektere z rychlosti 0-23 nekomunikuji s modulem.
  955+6245 DD 36 06 0A  speed_we_want	ld	(ix+6),#A

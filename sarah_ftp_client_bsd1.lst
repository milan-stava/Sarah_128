8593+ 82C4 CD 6F 9E             call    ftp_poll_delay
8594+ 82C7 CD 80 9D             call    ftp_poll_cancel
8595+ 82CA 38 0E                jr      c,.file_cancel
8596+ 82CC 18 E8                jr      .file_wait

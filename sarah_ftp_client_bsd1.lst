4211+ 6FF8 CD D7 68     		call	DIR128_INC_HL
4212+ 6FFB 38 34        		jr	c,item_add_end
4213+ 6FFD 1B           		dec	de
4214+ 6FFE 18 F4        		jr	item_add_lenloop

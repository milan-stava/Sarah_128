 4391+7427              ; -----------------------------------------------------------------------------
 4392+7427              ; item_add / item_sub - 128K bank-aware directory movement
 4393+7427              ;
 4394+7427              ; IN:
 4395+7427              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
 4396+7427              ;       DE = address of its 16-bit page-table-pointer companion
 4397+7427              ;
 4398+7427              ; Example:
 4399+7427              ;       ld bc,cur_item_addr
 4400+7427              ;       ld de,cur_item_addr_page
 4401+7427              ;       call item_add
 4402+7427              ;
 4403+7427              ; OUT:
 4404+7427              ;       Z  = cannot move (end/start of directory)
 4405+7427              ;       NZ = pointer + its bank companion were moved to adjacent item
 4406+7427              ;
 4407+7427              ; The address variable and page variable deliberately do NOT have to be adjacent.
 4408+7427              ; This keeps the original IX+... variable layout completely unchanged.
 4409+7427              ; The two-byte item length at either end of an item may itself cross a bank.
 4410+7427              ; -----------------------------------------------------------------------------
 4411+7427              ; --- DOKUMENTACE CZ: item_add ---
 4412+7427              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
 4413+7427              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
 4414+7427              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
 4415+7427              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
 4416+7427              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
 4417+7427              ; --- KONEC DOKUMENTACE CZ ---
 4418+7427              item_add
 4419+7427 ED 43 AE 72  		ld	(dir_op_addr_var),bc
 4420+742B ED 53 B0 72  		ld	(dir_op_page_var),de
 4421+742F
 4422+742F              		;Load physical item address from *(BC).
 4423+742F 60           		ld	h,b
 4424+7430 69           		ld	l,c
 4425+7431 5E           		ld	e,(hl)
 4426+7432 23           		inc	hl
 4427+7433 56           		ld	d,(hl)
 4428+7434 ED 53 A6 72  		ld	(next_item_addr),de	;temporary physical start
 4429+7438 EB           		ex	de,hl			;HL=current physical item start
 4430+7439
 4431+7439              		;Load/map directory page from page companion variable.
 4432+7439 E5           		push	hl
 4433+743A 2A B0 72     		ld	hl,(dir_op_page_var)
 4434+743D 5E           		ld	e,(hl)
 4435+743E 23           		inc	hl
 4436+743F 56           		ld	d,(hl)
 4437+7440 E1           		pop	hl
 4438+7441 CD 28 6E     		call	DIR128_MAP_DE
 4439+7444
 4440+7444              		;Read item length LOW/HIGH. Header itself may cross #FFFF/#C000.
 4441+7444 7E           		ld	a,(hl)
 4442+7445 5F           		ld	e,a			;E=length LOW
 4443+7446 CD 99 6D     		call	DIR128_INC_HL
 4444+7449 38 4C        		jr	c,item_add_end
 4445+744B 7E           		ld	a,(hl)
 4446+744C 57           		ld	d,a			;DE=item length
 4447+744D B3           		or	e
 4448+744E 28 47        		jr	z,item_add_end		;00 00 = real end of directory
 4449+7450
 4450+7450              		;We are at item_start+1.
 4451+7450              		;Next item = item_start + item_length + 4.
 4452+7450              		;Therefore move 3 fixed bytes, then item_length bytes.
 4453+7450 3E 03        		ld	a,3
 4454+7452              item_add_fixed
 4455+7452 CD 99 6D     		call	DIR128_INC_HL
 4456+7455 38 40        		jr	c,item_add_end
 4457+7457 3D           		dec	a
 4458+7458 20 F8        		jr	nz,item_add_fixed
 4459+745A
 4460+745A              item_add_lenloop
 4461+745A 7A           		ld	a,d
 4462+745B B3           		or	e
 4463+745C 28 08        		jr	z,item_add_at_next
 4464+745E CD 99 6D     		call	DIR128_INC_HL
 4465+7461 38 34        		jr	c,item_add_end
 4466+7463 1B           		dec	de
 4467+7464 18 F4        		jr	item_add_lenloop
 4468+7466
 4469+7466              item_add_at_next
 4470+7466              		;Save exact candidate next-item position and its bank before peeking
 4471+7466              		;at its 00 00 / length header.
 4472+7466 22 A6 72     		ld	(next_item_addr),hl
 4473+7469 ED 5B F6 BF  		ld	de,(fdp_pointer)
 4474+746D ED 53 A8 72  		ld	(next_item_page),de
 4475+7471
 4476+7471 7E           		ld	a,(hl)
 4477+7472 5F           		ld	e,a
 4478+7473 CD 99 6D     		call	DIR128_INC_HL
 4479+7476 38 1F        		jr	c,item_add_end
 4480+7478 7E           		ld	a,(hl)
 4481+7479 B3           		or	e
 4482+747A 28 1B        		jr	z,item_add_end		;next item begins 00 00 = end of directory
 4483+747C
 4484+747C              		;Commit candidate address.
 4485+747C 2A AE 72     		ld	hl,(dir_op_addr_var)
 4486+747F ED 5B A6 72  		ld	de,(next_item_addr)
 4487+7483 73           		ld	(hl),e
 4488+7484 23           		inc	hl
 4489+7485 72           		ld	(hl),d
 4490+7486
 4491+7486              		;Commit candidate bank companion.
 4492+7486 2A B0 72     		ld	hl,(dir_op_page_var)
 4493+7489 ED 5B A8 72  		ld	de,(next_item_page)
 4494+748D 73           		ld	(hl),e
 4495+748E 23           		inc	hl
 4496+748F 72           		ld	(hl),d
 4497+7490
 4498+7490              		;Leave the bank containing the new item mapped.
 4499+7490 CD 28 6E     		call	DIR128_MAP_DE
 4500+7493 3E 01        		ld	a,1
 4501+7495 B7           		or	a			;NZ, NC
 4502+7496 C9           		ret
 4503+7497
 4504+7497              item_add_end
 4505+7497 AF           		xor	a			;Z = do not alter caller pointer variables
 4506+7498 C9           		ret
 4507+7499

5862+ 7993              ; --- DOKUMENTACE CZ: ConvRStr16 ---
5863+ 7993              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
5864+ 7993              ; Vstup: DE = začátek číslic.
5865+ 7993              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
5866+ 7993              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
5867+ 7993              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
5868+ 7993              ;   přetečení; Z nemá pevný význam.
5869+ 7993              ; --- KONEC DOKUMENTACE CZ ---
5870+ 7993              ConvRStr16
5871+ 7993              ;===============================================================
5872+ 7993              ;http://z80-heaven.wikidot.com/math#toc32
5873+ 7993              ;Input:
5874+ 7993              ;     DE points to the base 10 number string in RAM.
5875+ 7993              ;Outputs:
5876+ 7993              ;     HL is the 16-bit value of the number
5877+ 7993              ;     DE points to the byte after the number
5878+ 7993              ;     BC is HL/10
5879+ 7993              ;     z flag reset (nz)
5880+ 7993              ;     c flag reset (nc)
5881+ 7993              ;Destroys:
5882+ 7993              ;     A (actually, add 30h and you get the ending token)
5883+ 7993              ;Size:  23 bytes
5884+ 7993              ;Speed: 104n+42+11c
5885+ 7993              ;       n is the number of digits
5886+ 7993              ;       c is at most n-2
5887+ 7993              ;       at most 595 cycles for any 16-bit decimal value
5888+ 7993              ;===============================================================
5889+ 7993
5890+ 7993 21 00 00          ld hl,0          ;  10 : 210000
5891+ 7996              ConvLoop:             ;
5892+ 7996 1A                ld a,(de)        ;   7 : 1A
5893+ 7997 D6 30             sub 30h          ;   7 : D630
5894+ 7999 FE 0A             cp 10            ;   7 : FE0A
5895+ 799B D0                ret nc           ;5|11 : D0
5896+ 799C 13                inc de           ;   6 : 13
5897+ 799D                                    ;
5898+ 799D 44                ld b,h           ;   4 : 44
5899+ 799E 4D                ld c,l           ;   4 : 4D
5900+ 799F 29                add hl,hl        ;  11 : 29
5901+ 79A0 29                add hl,hl        ;  11 : 29
5902+ 79A1 09                add hl,bc        ;  11 : 09
5903+ 79A2 29                add hl,hl        ;  11 : 29
5904+ 79A3                                    ;
5905+ 79A3 85                add a,l          ;   4 : 85
5906+ 79A4 6F                ld l,a           ;   4 : 6F
5907+ 79A5 30 EF             jr nc,ConvLoop   ;12|23: 30EE
5908+ 79A7 24                inc h            ; --- : 24
5909+ 79A8 18 EC             jr ConvLoop      ; --- : 18EB

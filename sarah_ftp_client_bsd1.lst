 2931+6AE8              ; -----------------------------------------------------------------------------
 2932+6AE8              ; search_by_Busy_dir_slow
 2933+6AE8              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
 2934+6AE8              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
 2935+6AE8              ; no longer slows down every ordinary FIND operation.
 2936+6AE8              ;
 2937+6AE8              ; One-character FIND is handled before this fallback and compares only the
 2938+6AE8              ; first character.  This slow path therefore normally handles 2+ character
 2939+6AE8              ; substring searches whose source name crosses a directory-bank boundary.
 2940+6AE8              ; -----------------------------------------------------------------------------
 2941+6AE8              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
 2942+6AE8              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
 2943+6AE8              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
 2944+6AE8              ;   a délka.
 2945+6AE8              ; Vystup: Z = shoda, NZ = nenalezeno.
 2946+6AE8              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 2947+6AE8              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
 2948+6AE8              ; --- KONEC DOKUMENTACE CZ ---
 2949+6AE8              search_by_Busy_dir_slow:
 2950+6AE8 22 BD 6F             ld      (dir_search_addr),hl
 2951+6AEB ED 43 C1 6F          ld      (dir_search_remaining),bc
 2952+6AEF ED 5B B6 6F          ld      de,(item_name_page)
 2953+6AF3 ED 53 BF 6F          ld      (dir_search_page),de
 2954+6AF7 2A 66 79             ld      hl,(txtlen+1)
 2955+6AFA 22 C3 6F             ld      (dir_search_patlen),hl
 2956+6AFD 7C                   ld      a,h
 2957+6AFE B5                   or      l
 2958+6AFF 28 56                jr      z,.dir_search_found
 2959+6B01
 2960+6B01              .dir_search_outer:
 2961+6B01                      ;If remaining source length < pattern length, no further match exists.
 2962+6B01 2A C1 6F             ld      hl,(dir_search_remaining)
 2963+6B04 ED 5B C3 6F          ld      de,(dir_search_patlen)
 2964+6B08 B7                   or      a
 2965+6B09 ED 52                sbc     hl,de
 2966+6B0B 38 4C                jr      c,.dir_search_not_found
 2967+6B0D
 2968+6B0D                      ;Start one comparison at current candidate address/page.
 2969+6B0D 2A BD 6F             ld      hl,(dir_search_addr)
 2970+6B10 ED 5B BF 6F          ld      de,(dir_search_page)
 2971+6B14 CD 59 6A             call    DIR128_MAP_DE
 2972+6B17 11 9B 8F             ld      de,INPBUFF
 2973+6B1A ED 4B C3 6F          ld      bc,(dir_search_patlen)
 2974+6B1E
 2975+6B1E              .dir_search_cmp:
 2976+6B1E 7E                   ld      a,(hl)
 2977+6B1F CD 8A 79             call    convert                 ;source char -> lower case
 2978+6B22 EB                   ex      de,hl
 2979+6B23 BE                   cp      (hl)                    ;pattern already normalized by FIND
 2980+6B24 EB                   ex      de,hl
 2981+6B25 20 0D                jr      nz,.dir_search_advance_candidate
 2982+6B27
 2983+6B27 13                   inc     de
 2984+6B28 0B                   dec     bc
 2985+6B29 78                   ld      a,b
 2986+6B2A B1                   or      c
 2987+6B2B 28 2A                jr      z,.dir_search_found
 2988+6B2D CD CA 69             call    DIR128_INC_HL
 2989+6B30 38 27                jr      c,.dir_search_not_found
 2990+6B32 18 EA                jr      .dir_search_cmp
 2991+6B34
 2992+6B34              .dir_search_advance_candidate:
 2993+6B34                      ;Always advance by exactly ONE source character.  This fixes both the
 2994+6B34                      ;old overlapping-match bug and the old one-character special case.
 2995+6B34 2A BD 6F             ld      hl,(dir_search_addr)
 2996+6B37 ED 5B BF 6F          ld      de,(dir_search_page)
 2997+6B3B CD 59 6A             call    DIR128_MAP_DE
 2998+6B3E CD CA 69             call    DIR128_INC_HL
 2999+6B41 38 16                jr      c,.dir_search_not_found
 3000+6B43 22 BD 6F             ld      (dir_search_addr),hl
 3001+6B46 ED 5B F6 BF          ld      de,(fdp_pointer)
 3002+6B4A ED 53 BF 6F          ld      (dir_search_page),de
 3003+6B4E 2A C1 6F             ld      hl,(dir_search_remaining)
 3004+6B51 2B                   dec     hl
 3005+6B52 22 C1 6F             ld      (dir_search_remaining),hl
 3006+6B55 18 AA                jr      .dir_search_outer
 3007+6B57
 3008+6B57              .dir_search_found:
 3009+6B57 AF                   xor     a                       ;Z
 3010+6B58 C9                   ret
 3011+6B59              .dir_search_not_found:
 3012+6B59 3E 01                ld      a,1
 3013+6B5B B7                   or      a                       ;NZ
 3014+6B5C C9                   ret

 4525+74A5 56           		ld	d,(hl)
 4526+74A6 EB           		ex	de,hl			;HL=current physical item start
 4527+74A7
 4528+74A7              		;Load/map its directory bank.
 4529+74A7 E5           		push	hl
 4530+74A8 2A B0 72     		ld	hl,(dir_op_page_var)
 4531+74AB 5E           		ld	e,(hl)
 4532+74AC 23           		inc	hl
 4533+74AD 56           		ld	d,(hl)
 4534+74AE E1           		pop	hl
 4535+74AF CD 28 6E     		call	DIR128_MAP_DE
 4536+74B2
 4537+74B2              		;Go to previous item's trailing length HIGH then LOW.
 4538+74B2              		;The #FF sentinel before page 0 makes this also our directory-start test.
 4539+74B2 CD F9 6D     		call	DIR128_DEC_HL

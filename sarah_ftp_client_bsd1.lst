2625+ 69B3              ; -----------------------------------------------------------------------------
2626+ 69B3              ; DIR128_COPY_NAME_TO_DE
2627+ 69B3              ; Copy the name returned by get_item_name to fixed RAM.
2628+ 69B3              ; IN:  HL = physical source address in directory window
2629+ 69B3              ;      BC = 16-bit name length
2630+ 69B3              ;      DE = fixed-RAM destination
2631+ 69B3              ;      item_name_page = page-table pointer belonging to HL
2632+ 69B3              ; OUT: DE points behind copied bytes, BC=0
2633+ 69B3              ; The source may cross any #FFFF -> #C000 directory-page boundary.
2634+ 69B3              ; -----------------------------------------------------------------------------
2635+ 69B3              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
2636+ 69B3              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
2637+ 69B3              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
2638+ 69B3              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
2639+ 69B3              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2640+ 69B3              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
2641+ 69B3              ; --- KONEC DOKUMENTACE CZ ---
2642+ 69B3              DIR128_COPY_NAME_TO_DE:
2643+ 69B3 D5                   push    de
2644+ 69B4 ED 5B 01 6F          ld      de,(item_name_page)
2645+ 69B8 CD A8 69             call    DIR128_MAP_DE
2646+ 69BB D1                   pop     de
2647+ 69BC              .dir128_copy_loop:
2648+ 69BC 78                   ld      a,b
2649+ 69BD B1                   or      c
2650+ 69BE C8                   ret     z
2651+ 69BF 7E                   ld      a,(hl)
2652+ 69C0 12                   ld      (de),a
2653+ 69C1 13                   inc     de
2654+ 69C2 0B                   dec     bc
2655+ 69C3 78                   ld      a,b
2656+ 69C4 B1                   or      c
2657+ 69C5 C8                   ret     z
2658+ 69C6 CD 19 69             call    DIR128_INC_HL
2659+ 69C9 D8                   ret     c                       ;should only happen on malformed item
2660+ 69CA 18 F0                jr      .dir128_copy_loop

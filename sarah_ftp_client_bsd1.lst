 262+ 0000
 263+ 0000
 264+ 0000              ;FTP commands of interest:
 265+ 0000              ;done	USER		username
 266+ 0000              ;done	PASS		password
 267+ 0000              ;done	PASV		enter passive mode
 268+ 0000              ;done	QUIT		quit ftp connection
 269+ 0000              ;done	STOR		upload file		;max transfer block allowed by ESP modele= 2048 bytes, top speed is 2,53 kb/sec
 270+ 0000              ;done	RETR		download file
 271+ 0000              ;done	SIZE		return file size
 272+ 0000              ;done	ABOR		abort command		;in case we got stuck, ABOR will return us
 273+ 0000              ;done	APPE		append file		;if uploaded file exist, you may choose to overwrite it or append
 274+ 0000              ;done	NOOP					;check if ftp connection is alive (ver 0.7.)
 275+ 0000              ;done	STOU					;new from 0.8 up
 276+ 0000              ;done	LIST
 277+ 0000              ;done	NLST
 278+ 0000              ;done	PWD
 279+ 0000              ;done	CWD
 280+ 0000              ;done	CDUP
 281+ 0000              ;done	DELE
 282+ 0000              ;done	MKD
 283+ 0000              ;done	RMD
 284+ 0000              ;done	RNFR+RNTO
 285+ 0000
 286+ 0000              ;the following need passive mode:
 287+ 0000              ;	RETR		download file
 288+ 0000              ;	STOR		upload file
 289+ 0000              ;	STOU		like STOR, but a new file is set
 290+ 0000              ;	LIST		download directory list
 291+ 0000              ;	NLST argument	list of directory "argument" and file names (without attributes)
 292+ 0000
 293+ 0000              ;the following do not need passive mode:
 294+ 0000              ;	MKD argument	make new directory called "argument"
 295+ 0000              ;	RMD argument	remove directory called "argument"
 296+ 0000              ;	RNFR+RNTO	rename file
 297+ 0000              ;	SIZE		find out file length
 298+ 0000              ;	QUIT		quits ftp connection
 299+ 0000              ;	PWD		returns current directory name
 300+ 0000              ;	CWD argument	go to directory "argument"
 301+ 0000              ;	CDUP		go to up directory
 302+ 0000              ;	DELE argument	delete file "argument"
 303+ 0000
 304+ 0000              ;overview:
 305+ 0000              ;LOW LEVEL- SENDING
 306+ 0000              ;1) send_string:	mainly to send direct AT commands
 307+ 0000              ;2) send_data:		to send any type of data
 308+ 0000              ;LOW LEVEL- RECEIVING
 309+ 0000              ;7) receive_data_timeout receive data with timeout.IN=BC=max.length of data to receive, HL=sata start, OUT Z= ok, received
 310+ 0000              ;LOW LEVEL- PARSING
 311+ 0000              ;10) look_for_string:	seeks certain string in memory
 312+ 0000              ;11) look_on_fly:	seeks certain string in the incoming flow of bytes
 313+ 0000              ;12) search_by_Busy	seeks string in memory, according to Busy (in BSDOS)
 314+ 0000              ;13) search_until_zero
 315+ 0000
 316+ 0000              ;OTHERS
 317+ 0000              ;15) count_com_len	counts command length
 318+ 0000              ;16) ConvRStr16		converts ASCII to HL (16 bit)
 319+ 0000              ;17) HL2ASCII		converts HL to ASCII (16 bit)
 320+ 0000              ;18) wait routines	wait certain amount of time (user definable)
 321+ 0000              ;19) print_title	printle initial title
 322+ 0000              ;20) save_dir_position	saves dir position so that you can return to where you have been
 323+ 0000              ;22) ConvrStr32		converts ASCII to HLDE (32 bit)
 324+ 0000              ;28) HL2ASCII32		converts HL to ASCII (32 bit)
 325+ 0000              ;29) send_at_check_ok	sends AT command and checks for answer OK
 326+ 0000              ;40) set_print_speed	sets speed on MB UART and print it
 327+ 0000              ;48) convASCII2hex	convert eg. "14" to #14
 328+ 0000              ;49) cls_4000		clear screen
 329+ 0000              ;50) cls_9		clear 9 lines
 330+ 0000              ;;;;51) prn_ap_name_sig	print AP name and signal strength, not used!!!!!
 331+ 0000
 332+ 0000              ;53) set_def_wifi_speed	sets both speeds to default wifi speed
 333+ 0000              ;54) clear_edit_zone	clears 2 bottom lines
 334+ 0000              ;55) akey		waits for key press
 335+ 0000              ;56) wifi_wait/unwait	signals, that we wait for wifi
 336+ 0000              ;57) set_ud_speed	sets user defined speed (0-23 from IX+2), mainly for SM2.0
 337+ 0000
 338+ 0000
 339+ 0000              ;FTP RELATED
 340+ 0000              ;52) get_status_ftp	gets status, if connected to ftp server or not
 341+ 0000              ;58) send_abort		sends ABORt command
 342+ 0000              ;58) send_ftp_command	sends any ftp command placed in HL
 343+ 0000              ;59) cipsend_request	sends data to server, command eg. "AT+CIPSEND=0,6"
 344+ 0000              ;60) check_module_answercheck if module answers string in DE
 345+ 0000              ;61) receive_ftp_answer
 346+ 0000              ;65) enter_pasive_mode
 347+ 0000              ;73) print_ftp_status	prints status of URL and login

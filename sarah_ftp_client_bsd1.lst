5968+ 79F9              ; Vystup: DE za poslední číslicí, bez nulového terminátoru.
5969+ 79F9              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
5970+ 79F9              ; Poznamka: Na rozdíl od HL2ASCII nenuluje bit 7. Pro pevnou šířku jej nastavte před voláním.
5971+ 79F9              ; --- KONEC DOKUMENTACE CZ ---
5972+ 79F9 01 10 27     HL2ASCII_00000		ld bc,10000
5973+ 79FC CD 17 7A     			call string_dl
5974+ 79FF 01 E8 03     			ld bc,1000
5975+ 7A02 CD 17 7A     			call string_dl
5976+ 7A05              ; --- DOKUMENTACE CZ: HL2ASCII_000 ---
5977+ 7A05              ; Ucel: Vstup do převodu od řádu desetitisíců, resp. stovek.
5978+ 7A05              ; Vstup: HL = číslo, DE = cíl; bit 7 v (IX+0) řídí tisk úvodních nul.
5979+ 7A05              ; Vystup: DE za poslední číslicí, bez nulového terminátoru.
5980+ 7A05              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
5981+ 7A05              ; Poznamka: Na rozdíl od HL2ASCII nenuluje bit 7. Pro pevnou šířku jej nastavte před voláním.
5982+ 7A05              ; --- KONEC DOKUMENTACE CZ ---
5983+ 7A05 01 64 00     HL2ASCII_000		ld bc,100
5984+ 7A08 CD 17 7A     			call string_dl
5985+ 7A0B 01 0A 00     			ld bc,10
5986+ 7A0E CD 17 7A     			call string_dl
5987+ 7A11 7D           			ld a,l
5988+ 7A12 C6 30        			add a,'0'
5989+ 7A14 12           			LD (DE),A

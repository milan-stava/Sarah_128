 1086+62FE 30 04        		jr	nc,sws1
 1087+6300 DD 36 06 0A  		ld	(ix+6),#A		;set tieout for #A for speeds <2
 1088+6304
 1089+6304 CD A1 7B     sws1		call	send_at_check_ok

 1068+62ED
 1069+62ED              ; --- DOKUMENTACE CZ: switch_speed ---
 1070+62ED              ; Ucel: Zkouší rychlosti UART sestupně od maximální až po nulu.
 1071+62ED              ; Vstup: (IX+8) = nejvyšší zkoušený index rychlosti.
 1072+62ED              ; Vystup: Z = modul odpověděl OK, D = nalezený index; NZ = nenalezeno.
 1073+62ED              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
 1074+62ED              ; Poznamka: Mění UART a (IX+6), vyprazdňuje příjem.
 1075+62ED              ; --- KONEC DOKUMENTACE CZ ---
 1076+62ED DD 7E 08     switch_speed	ld	a,(ix+8)		;try out every speed if you find connection UART+Wifi
 1077+62F0              						;start with max speed, end with 0
 1078+62F0 F5           sws2		push	af
 1079+62F1 CD D9 7B     		call	set_print_speed
 1080+62F4 38 1B        		jr c,sws_unsupported ;do not report a UART setting rejected by BIOS
 1081+62F6

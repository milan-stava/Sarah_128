2558+ 6A36 D1                   pop     de
2559+ 6A37 F1                   pop     af                      ;restore caller's A
2560+ 6A38 B7                   or      a                       ;NC = OK, A unchanged
2561+ 6A39 C9                   ret
2562+ 6A3A              DIR128_INC_END:

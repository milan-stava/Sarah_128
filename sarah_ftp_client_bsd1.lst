  937+622B CD 8D 7B     		call	print_ez1
  938+622E              ;		ld	bc,30
  939+622E
  940+622E DD CB 00 AE  speed_m_error	res	5,(ix+0)		;set signal wifi not connected to AP
  941+6232              ;		jp	error
  942+6232 CD BC 7E     sme1		call	akey
  943+6235 CD A1 78     		call	undraw_cursor		;return from AP selection
  944+6238 CD C4 78     		call	wind_cls

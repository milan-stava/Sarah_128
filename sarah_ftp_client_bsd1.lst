 8991+8490              ;128K bank-safe parser.
 8992+8490              ;IN: callers currently use SCF; C/NC is kept only for source compatibility.
 8993+8490              ;OUT=HL=name start in banked directory RAM
 8994+8490              ;    BC=16-bit name length
 8995+8490              ;    DE=16-bit file length for LIST abbreviated (0 for NLST/"..")
 8996+8490              ;    item_name_page=page-table pointer belonging to returned HL
 8997+8490              ;OUT=A=0 directory, A=1 file, A=2 NLST unknown type,
 8998+8490              ;      A=3 LIST full/malformed, A=4 synthetic ".."
 8999+8490              ;
 9000+8490              ;No temporary zero is written into the directory. The parser uses the stored
 9001+8490              ;16-bit item length as its boundary, so an item/name may cross 16K pages and
 9002+8490              ;may also be longer than 255 bytes.
 9003+8490 2A 78 8E             ld      hl,(cur_item_addr)
 9004+8493 ED 5B E3 88          ld      de,(cur_item_addr_page)
 9005+8497 CD 50 6A             call    DIR128_MAP_DE
 9006+849A
 9007+849A                      ;Read item length LOW/HIGH. Even the length field may cross a page.
 9008+849A 7E                   ld      a,(hl)
 9009+849B 4F                   ld      c,a
 9010+849C CD C1 69             call    DIR128_INC_HL
 9011+849F DA 7F 85             jp      c,gfn_bad
 9012+84A2 7E                   ld      a,(hl)
 9013+84A3 47                   ld      b,a
 9014+84A4 78                   ld      a,b
 9015+84A5 B1                   or      c
 9016+84A6 CA 7F 85             jp      z,gfn_bad
 9017+84A9 ED 43 AF 6F          ld      (gfn_remaining),bc      ;includes mark/info byte + stored data
 9018+84AD
 9019+84AD                      ;Move from header HIGH to mark/info byte (item+2).
 9020+84AD CD C1 69             call    DIR128_INC_HL
 9021+84B0 DA 7F 85             jp      c,gfn_bad
 9022+84B3
 9023+84B3                      ;Synthetic first item ".." is always page 0:#C000.
 9024+84B3 E5                   push    hl
 9025+84B4 2A E3 88             ld      hl,(cur_item_addr_page)

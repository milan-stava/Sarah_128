6003+ 7973 01 10 27     HL2ASCII_00000		ld bc,10000
6004+ 7976 CD 91 79     			call string_dl
6005+ 7979 01 E8 03     			ld bc,1000
6006+ 797C CD 91 79     			call string_dl
6007+ 797F              ; --- DOKUMENTACE CZ: HL2ASCII_000 ---
6008+ 797F              ; Ucel: Vstup do převodu od řádu desetitisíců, resp. stovek.
6009+ 797F              ; Vstup: HL = číslo, DE = cíl; bit 7 v (IX+0) řídí tisk úvodních nul.
6010+ 797F              ; Vystup: DE za poslední číslicí, bez nulového terminátoru.
6011+ 797F              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
6012+ 797F              ; Poznamka: Na rozdíl od HL2ASCII nenuluje bit 7. Pro pevnou šířku jej nastavte před voláním.
6013+ 797F              ; --- KONEC DOKUMENTACE CZ ---
6014+ 797F 01 64 00     HL2ASCII_000		ld bc,100

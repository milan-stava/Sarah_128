 2783+6A42              .dir_search_len_ge2:
 2784+6A42                      ; Is the LAST byte of the name still inside the same physical window?
 2785+6A42                      ; last = HL + BC - 1
 2786+6A42                      ; Carry means that the name crosses #FFFF -> #C000, therefore use the
 2787+6A42                      ; fully bank-safe (but slower) routine below.

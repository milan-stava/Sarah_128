 4164+7251              ; -----------------------------------------------------------------------------
 4165+7251              ; item_add / item_sub - 128K bank-aware directory movement
 4166+7251              ;
 4167+7251              ; IN:
 4168+7251              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
 4169+7251              ;       DE = address of its 16-bit page-table-pointer companion
 4170+7251              ;
 4171+7251              ; Example:
 4172+7251              ;       ld bc,cur_item_addr
 4173+7251              ;       ld de,cur_item_addr_page
 4174+7251              ;       call item_add
 4175+7251              ;
 4176+7251              ; OUT:
 4177+7251              ;       Z  = cannot move (end/start of directory)
 4178+7251              ;       NZ = pointer + its bank companion were moved to adjacent item
 4179+7251              ;
 4180+7251              ; The address variable and page variable deliberately do NOT have to be adjacent.
 4181+7251              ; This keeps the original IX+... variable layout completely unchanged.
 4182+7251              ; The two-byte item length at either end of an item may itself cross a bank.
 4183+7251              ; -----------------------------------------------------------------------------
 4184+7251              ; --- DOKUMENTACE CZ: item_add ---
 4185+7251              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
 4186+7251              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
 4187+7251              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
 4188+7251              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
 4189+7251              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
 4190+7251              ; --- KONEC DOKUMENTACE CZ ---
 4191+7251              item_add
 4192+7251 ED 43 AA 6F  		ld	(dir_op_addr_var),bc
 4193+7255 ED 53 AC 6F  		ld	(dir_op_page_var),de
 4194+7259
 4195+7259              		;Load physical item address from *(BC).
 4196+7259 60           		ld	h,b
 4197+725A 69           		ld	l,c
 4198+725B 5E           		ld	e,(hl)
 4199+725C 23           		inc	hl
 4200+725D 56           		ld	d,(hl)
 4201+725E ED 53 A2 6F  		ld	(next_item_addr),de	;temporary physical start
 4202+7262 EB           		ex	de,hl			;HL=current physical item start
 4203+7263
 4204+7263              		;Load/map directory page from page companion variable.
 4205+7263 E5           		push	hl
 4206+7264 2A AC 6F     		ld	hl,(dir_op_page_var)
 4207+7267 5E           		ld	e,(hl)
 4208+7268 23           		inc	hl
 4209+7269 56           		ld	d,(hl)
 4210+726A E1           		pop	hl
 4211+726B CD 59 6A     		call	DIR128_MAP_DE
 4212+726E
 4213+726E              		;Read item length LOW/HIGH. Header itself may cross #FFFF/#C000.
 4214+726E 7E           		ld	a,(hl)
 4215+726F 5F           		ld	e,a			;E=length LOW
 4216+7270 CD CA 69     		call	DIR128_INC_HL
 4217+7273 38 4C        		jr	c,item_add_end

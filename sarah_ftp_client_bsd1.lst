3162+ 6AAB
3163+ 6AAB
3164+ 6AAB 3E C3        		ld	a,#C3		;"jp"= abbreviated
3165+ 6AAD 01 1D 6C     		ld	bc,dr5_skip
3166+ 6AB0 11 6E 6B     dr1		ld	de,dr_switch
3167+ 6AB3 12           		ld	(de),a
3168+ 6AB4 13           		inc	de
3169+ 6AB5 79           		ld	a,c
3170+ 6AB6 12           		ld	(de),a

  904+61F3 CD F3 9E     		call	wifi_on
  905+61F6
  906+61F6
  907+61F6 21 00 02     		ld	hl,txt_adr_speed_login	;print "Speed" text
  908+61F9 11 E3 8B     		ld	de,speed
  909+61FC CD 83 92     		call	PRINTHL
  910+61FF
  911+61FF 01 3B 78     		ld	bc,#783B		;set CPU to 3,5 MHz
  912+6202 3E 30        		ld	a,#30
  913+6204 ED 79        		out	(c),a
  914+6206 04           		inc	b
  915+6207 AF           		xor	a
  916+6208 ED 79        		out	(c),a
  917+620A
  918+620A DD E5        		push	ix
  919+620C CD EF 9E     		call	gver_inst
  920+620F DD E1        		pop	ix			;A= max MBFW speed= 7 or 12 or 23
  921+6211 DD 77 08     		ld	(ix+8),a		;save max possible speed for given FW
  922+6214
  923+6214 DD 36 06 01  		ld	(ix+6),1		;timeout for quick AT check, 1 should be ok.
  924+6218 CD 49 7D     		call	send_at_check_ok
  925+621B 28 22        		jr	z,speed_aligned		;Z= speed aligned (UART<-> module)
  926+621D
  927+621D              						;speed not aligned

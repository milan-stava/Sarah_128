2756+ 6A1F              ; -----------------------------------------------------------------------------
2757+ 6A1F              ; search_by_Busy_fast
2758+ 6A1F              ; Fast case-insensitive substring search for a name fully contained in the
2759+ 6A1F              ; currently mapped 16K directory page.
2760+ 6A1F              ;
2761+ 6A1F              ; IN:  HL = name start, BC = 16-bit name length
2762+ 6A1F              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
2763+ 6A1F              ; OUT: Z = found, NZ = not found
2764+ 6A1F              ;
2765+ 6A1F              ; This is deliberately close to the original Busy FIND: the inner compare uses
2766+ 6A1F              ; the Z80 CPI instruction.  The pattern has already been converted to lower
2767+ 6A1F              ; case once by find_items, so only the source character needs convert here.
2768+ 6A1F              ;
2769+ 6A1F              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
2770+ 6A1F              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
2771+ 6A1F              ; matches therefore cannot be skipped.
2772+ 6A1F              ; -----------------------------------------------------------------------------
2773+ 6A1F              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
2774+ 6A1F              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
2775+ 6A1F              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
2776+ 6A1F              ;   délka.
2777+ 6A1F              ; Vystup: Z = shoda, NZ = nenalezeno.
2778+ 6A1F              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2779+ 6A1F              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
2780+ 6A1F              ; --- KONEC DOKUMENTACE CZ ---
2781+ 6A1F              search_by_Busy_fast:
2782+ 6A1F EB                   ex      de,hl                   ;DE=current candidate in file name
2783+ 6A20
2784+ 6A20                      ; candidate_count = name_length - pattern_length + 1
2785+ 6A20 60                   ld      h,b
2786+ 6A21 69                   ld      l,c
2787+ 6A22 ED 4B CF 77          ld      bc,(txtlen+1)
2788+ 6A26 78                   ld      a,b
2789+ 6A27 B1                   or      c
2790+ 6A28 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
2791+ 6A2A B7                   or      a
2792+ 6A2B ED 42                sbc     hl,bc
2793+ 6A2D 38 25                jr      c,.fast_not_found       ;pattern longer than file name
2794+ 6A2F 23                   inc     hl
2795+ 6A30
2796+ 6A30                      ; Keep number of possible candidate starts in alternate BC.
2797+ 6A30 E5                   push    hl
2798+ 6A31 D9                   exx
2799+ 6A32 C1                   pop     bc
2800+ 6A33 D9                   exx
2801+ 6A34
2802+ 6A34              .fast_next_candidate:
2803+ 6A34 D5                   push    de                      ;remember exact candidate start
2804+ 6A35 21 5A 8D             ld      hl,INPBUFF
2805+ 6A38 ED 4B CF 77          ld      bc,(txtlen+1)
2806+ 6A3C
2807+ 6A3C              .fast_compare:
2808+ 6A3C 1A                   ld      a,(de)
2809+ 6A3D CD F3 77             call    convert                 ;source char -> lower case
2810+ 6A40 ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
2811+ 6A42 13                   inc     de
2812+ 6A43 20 06                jr      nz,.fast_candidate_failed
2813+ 6A45 EA 3C 6A             jp      pe,.fast_compare        ;matched, more pattern bytes remain
2814+ 6A48
2815+ 6A48 D1                   pop     de                      ;discard saved candidate start
2816+ 6A49              .fast_found:
2817+ 6A49 AF                   xor     a                       ;Z = found
2818+ 6A4A C9                   ret
2819+ 6A4B
2820+ 6A4B              .fast_candidate_failed:
2821+ 6A4B D1                   pop     de                      ;restore previous candidate start
2822+ 6A4C 13                   inc     de                      ;next candidate = previous + 1
2823+ 6A4D D9                   exx
2824+ 6A4E 0B                   dec     bc
2825+ 6A4F 78                   ld      a,b
2826+ 6A50 B1                   or      c
2827+ 6A51 D9                   exx
2828+ 6A52 20 E0                jr      nz,.fast_next_candidate
2829+ 6A54
2830+ 6A54              .fast_not_found:
2831+ 6A54 3E 01                ld      a,1
2832+ 6A56 B7                   or      a                       ;NZ = not found
2833+ 6A57 C9                   ret

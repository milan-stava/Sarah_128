5930+ 785E              ;16)
5931+ 785E              ; --- DOKUMENTACE CZ: ConvRStr16 ---
5932+ 785E              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
5933+ 785E              ; Vstup: DE = začátek číslic.
5934+ 785E              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
5935+ 785E              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
5936+ 785E              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
5937+ 785E              ;   přetečení; Z nemá pevný význam.
5938+ 785E              ; --- KONEC DOKUMENTACE CZ ---
5939+ 785E              ConvRStr16
5940+ 785E              ;===============================================================
5941+ 785E              ;http://z80-heaven.wikidot.com/math#toc32
5942+ 785E              ;Input:
5943+ 785E              ;     DE points to the base 10 number string in RAM.
5944+ 785E              ;Outputs:
5945+ 785E              ;     HL is the 16-bit value of the number
5946+ 785E              ;     DE points to the byte after the number
5947+ 785E              ;     BC is HL/10
5948+ 785E              ;     z flag reset (nz)
5949+ 785E              ;     c flag reset (nc)
5950+ 785E              ;Destroys:
5951+ 785E              ;     A (actually, add 30h and you get the ending token)
5952+ 785E              ;Size:  23 bytes
5953+ 785E              ;Speed: 104n+42+11c
5954+ 785E              ;       n is the number of digits
5955+ 785E              ;       c is at most n-2
5956+ 785E              ;       at most 595 cycles for any 16-bit decimal value
5957+ 785E              ;===============================================================
5958+ 785E
5959+ 785E 21 00 00          ld hl,0          ;  10 : 210000
5960+ 7861              ConvLoop:             ;
5961+ 7861 1A                ld a,(de)        ;   7 : 1A
5962+ 7862 D6 30             sub 30h          ;   7 : D630
5963+ 7864 FE 0A             cp 10            ;   7 : FE0A
5964+ 7866 D0                ret nc           ;5|11 : D0
5965+ 7867 13                inc de           ;   6 : 13
5966+ 7868                                    ;
5967+ 7868 44                ld b,h           ;   4 : 44
5968+ 7869 4D                ld c,l           ;   4 : 4D
5969+ 786A 29                add hl,hl        ;  11 : 29
5970+ 786B 29                add hl,hl        ;  11 : 29
5971+ 786C 09                add hl,bc        ;  11 : 09
5972+ 786D 29                add hl,hl        ;  11 : 29
5973+ 786E                                    ;
5974+ 786E 85                add a,l          ;   4 : 85
5975+ 786F 6F                ld l,a           ;   4 : 6F
5976+ 7870 30 EF             jr nc,ConvLoop   ;12|23: 30EE
5977+ 7872 24                inc h            ; --- : 24
5978+ 7873 18 EC             jr ConvLoop      ; --- : 18EB
5979+ 7875
5980+ 7875
5981+ 7875

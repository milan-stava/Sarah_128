 3113+6E28              ;Map page-table pointer stored in DE. HL is preserved.
 3114+6E28              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
 3115+6E28              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
 3116+6E28              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
 3117+6E28              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
 3118+6E28              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
 3119+6E28              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
 3120+6E28              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
 3121+6E28              ; --- KONEC DOKUMENTACE CZ ---
 3122+6E28              DIR128_MAP_DE:
 3123+6E28 F5                   push    af
 3124+6E29 ED 53 F6 BF          ld      (fdp_pointer),de
 3125+6E2D 1A                   ld      a,(de)
 3126+6E2E CD E0 BF             call    PAGE128
 3127+6E31 F1                   pop     af
 3128+6E32 C9                   ret

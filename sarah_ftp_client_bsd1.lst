 1047+62CD
 1048+62CD              ; --- DOKUMENTACE CZ: switch_speed ---
 1049+62CD              ; Ucel: Zkouší rychlosti UART sestupně od maximální až po nulu.
 1050+62CD              ; Vstup: (IX+8) = nejvyšší zkoušený index rychlosti.
 1051+62CD              ; Vystup: Z = modul odpověděl OK, D = nalezený index; NZ = nenalezeno.
 1052+62CD              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
 1053+62CD              ; Poznamka: Mění UART a (IX+6), vyprazdňuje příjem.
 1054+62CD              ; --- KONEC DOKUMENTACE CZ ---
 1055+62CD DD 7E 08     switch_speed	ld	a,(ix+8)		;try out every speed if you find connection UART+Wifi
 1056+62D0              						;start with max speed, end with 0
 1057+62D0 F5           sws2		push	af
 1058+62D1 CD A1 7B     		call	set_print_speed

    1+A0E8              ; Shared ESP-AT framing above the unchanged Wi-Fi BIOS.
    2+A0E8              ; Firmware dialect retained: +CIPRECVDATA,<length>:<binary>.
    3+A0E8              ; Events: 1 OK, 2 ERROR, 3 prompt, 4 SEND OK, 5 SEND FAIL,
    4+A0E8              ;         6 busy, 7 active IPD header, 8 receive-data header, 0 other.
    5+A0E8              ; Binary payload is never searched for AT result strings.
    6+A0E8              AT_OK equ 1

 6072+7A12              ;16)
 6073+7A12              ; --- DOKUMENTACE CZ: ConvRStr16 ---
 6074+7A12              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
 6075+7A12              ; Vstup: DE = začátek číslic.
 6076+7A12              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
 6077+7A12              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 6078+7A12              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
 6079+7A12              ;   přetečení; Z nemá pevný význam.
 6080+7A12              ; --- KONEC DOKUMENTACE CZ ---
 6081+7A12              ConvRStr16
 6082+7A12              ;===============================================================
 6083+7A12              ;http://z80-heaven.wikidot.com/math#toc32
 6084+7A12              ;Input:
 6085+7A12              ;     DE points to the base 10 number string in RAM.
 6086+7A12              ;Outputs:
 6087+7A12              ;     HL is the 16-bit value of the number
 6088+7A12              ;     DE points to the byte after the number
 6089+7A12              ;     BC is HL/10
 6090+7A12              ;     z flag reset (nz)
 6091+7A12              ;     c flag reset (nc)
 6092+7A12              ;Destroys:
 6093+7A12              ;     A (actually, add 30h and you get the ending token)
 6094+7A12              ;Size:  23 bytes
 6095+7A12              ;Speed: 104n+42+11c
 6096+7A12              ;       n is the number of digits
 6097+7A12              ;       c is at most n-2
 6098+7A12              ;       at most 595 cycles for any 16-bit decimal value
 6099+7A12              ;===============================================================
 6100+7A12
 6101+7A12 21 00 00          ld hl,0          ;  10 : 210000
 6102+7A15              ConvLoop:             ;
 6103+7A15 1A                ld a,(de)        ;   7 : 1A
 6104+7A16 D6 30             sub 30h          ;   7 : D630
 6105+7A18 FE 0A             cp 10            ;   7 : FE0A
 6106+7A1A D0                ret nc           ;5|11 : D0
 6107+7A1B 13                inc de           ;   6 : 13
 6108+7A1C                                    ;
 6109+7A1C 44                ld b,h           ;   4 : 44
 6110+7A1D 4D                ld c,l           ;   4 : 4D
 6111+7A1E 29                add hl,hl        ;  11 : 29
 6112+7A1F 29                add hl,hl        ;  11 : 29
 6113+7A20 09                add hl,bc        ;  11 : 09
 6114+7A21 29                add hl,hl        ;  11 : 29
 6115+7A22                                    ;
 6116+7A22 85                add a,l          ;   4 : 85
 6117+7A23 6F                ld l,a           ;   4 : 6F
 6118+7A24 30 EF             jr nc,ConvLoop   ;12|23: 30EE
 6119+7A26 24                inc h            ; --- : 24
 6120+7A27 18 EC             jr ConvLoop      ; --- : 18EB
 6121+7A29
 6122+7A29
 6123+7A29
 6124+7A29              ;17)
 6125+7A29              ;IN=HL=number, OUT=DE=address with the string
 6126+7A29              ; --- DOKUMENTACE CZ: HL2ASCII ---
 6127+7A29              ; Ucel: Zapíše 16bitové číslo jako desetinný text bez úvodních nul.
 6128+7A29              ; Vstup: HL = číslo, DE = cílový buffer; IX = flag1.
 6129+7A29              ; Vystup: DE za poslední číslicí; HL = zbytek jednotek.
 6130+7A29              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 6131+7A29              ; Poznamka: Mění bit 7 v (IX+0); nepřidává nulový terminátor.
 6132+7A29              ; --- KONEC DOKUMENTACE CZ ---

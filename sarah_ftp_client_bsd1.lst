5904+ 79DE              ; --- DOKUMENTACE CZ: ConvRStr16 ---
5905+ 79DE              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
5906+ 79DE              ; Vstup: DE = začátek číslic.
5907+ 79DE              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
5908+ 79DE              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
5909+ 79DE              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
5910+ 79DE              ;   přetečení; Z nemá pevný význam.
5911+ 79DE              ; --- KONEC DOKUMENTACE CZ ---
5912+ 79DE              ConvRStr16
5913+ 79DE              ;===============================================================
5914+ 79DE              ;http://z80-heaven.wikidot.com/math#toc32
5915+ 79DE              ;Input:
5916+ 79DE              ;     DE points to the base 10 number string in RAM.
5917+ 79DE              ;Outputs:
5918+ 79DE              ;     HL is the 16-bit value of the number
5919+ 79DE              ;     DE points to the byte after the number
5920+ 79DE              ;     BC is HL/10
5921+ 79DE              ;     z flag reset (nz)
5922+ 79DE              ;     c flag reset (nc)
5923+ 79DE              ;Destroys:
5924+ 79DE              ;     A (actually, add 30h and you get the ending token)
5925+ 79DE              ;Size:  23 bytes
5926+ 79DE              ;Speed: 104n+42+11c
5927+ 79DE              ;       n is the number of digits
5928+ 79DE              ;       c is at most n-2
5929+ 79DE              ;       at most 595 cycles for any 16-bit decimal value
5930+ 79DE              ;===============================================================
5931+ 79DE
5932+ 79DE 21 00 00          ld hl,0          ;  10 : 210000
5933+ 79E1              ConvLoop:             ;
5934+ 79E1 1A                ld a,(de)        ;   7 : 1A
5935+ 79E2 D6 30             sub 30h          ;   7 : D630
5936+ 79E4 FE 0A             cp 10            ;   7 : FE0A
5937+ 79E6 D0                ret nc           ;5|11 : D0
5938+ 79E7 13                inc de           ;   6 : 13
5939+ 79E8                                    ;
5940+ 79E8 44                ld b,h           ;   4 : 44
5941+ 79E9 4D                ld c,l           ;   4 : 4D
5942+ 79EA 29                add hl,hl        ;  11 : 29
5943+ 79EB 29                add hl,hl        ;  11 : 29
5944+ 79EC 09                add hl,bc        ;  11 : 09
5945+ 79ED 29                add hl,hl        ;  11 : 29
5946+ 79EE                                    ;
5947+ 79EE 85                add a,l          ;   4 : 85
5948+ 79EF 6F                ld l,a           ;   4 : 6F
5949+ 79F0 30 EF             jr nc,ConvLoop   ;12|23: 30EE
5950+ 79F2 24                inc h            ; --- : 24
5951+ 79F3 18 EC             jr ConvLoop      ; --- : 18EB
5952+ 79F5
5953+ 79F5
5954+ 79F5

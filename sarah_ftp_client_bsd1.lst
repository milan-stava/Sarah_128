 1021+62B9              ;SM2.0 subroutines
 1022+62B9              ; --- DOKUMENTACE CZ: find_out_speed ---
 1023+62B9              ; Ucel: Zjistí index aktuální rychlosti UART, případně rychlosti vyzkouší.
 1024+62B9              ; Vstup: IX = flag1; dostupné služby get_baud/set_baud.
 1025+62B9              ; Vystup: D = index zjištěné rychlosti při úspěchu.
 1026+62B9              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
 1027+62B9              ; Poznamka: Při nepodporovaném get_baud používá switch_speed; jeho neúspěch nepovažujte za
 1028+62B9              ;   platnou rychlost.
 1029+62B9              ; --- KONEC DOKUMENTACE CZ ---
 1030+62B9              find_out_speed
 1031+62B9 CD 69 A6             call get_baud
 1032+62BC 30 06                jr nc,.known
 1033+62BE CD CD 62             call switch_speed
 1034+62C1 20 08                jr nz,.failed

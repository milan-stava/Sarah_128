 8726+8372 E6 03                and     3
 8727+8374 20 0D                jr      nz,.file_closed ; real closure plus empty buffer, not a Wi-Fi pause
 8728+8376 CD 21 9F             call    ftp_poll_delay
 8729+8379 CD 32 9E             call    ftp_poll_cancel
 8730+837C 38 0E                jr      c,.file_cancel
 8731+837E 18 E8                jr      .file_wait

2828+ 6A4D              ; -----------------------------------------------------------------------------
2829+ 6A4D              ; search_by_Busy_dir_slow
2830+ 6A4D              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
2831+ 6A4D              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
2832+ 6A4D              ; no longer slows down every ordinary FIND operation.
2833+ 6A4D              ;
2834+ 6A4D              ; One-character FIND is handled before this fallback and compares only the
2835+ 6A4D              ; first character.  This slow path therefore normally handles 2+ character
2836+ 6A4D              ; substring searches whose source name crosses a directory-bank boundary.
2837+ 6A4D              ; -----------------------------------------------------------------------------
2838+ 6A4D              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
2839+ 6A4D              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
2840+ 6A4D              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
2841+ 6A4D              ;   a délka.
2842+ 6A4D              ; Vystup: Z = shoda, NZ = nenalezeno.
2843+ 6A4D              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2844+ 6A4D              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
2845+ 6A4D              ; --- KONEC DOKUMENTACE CZ ---
2846+ 6A4D              search_by_Busy_dir_slow:
2847+ 6A4D 22 20 6F             ld      (dir_search_addr),hl
2848+ 6A50 ED 43 24 6F          ld      (dir_search_remaining),bc
2849+ 6A54 ED 5B 19 6F          ld      de,(item_name_page)
2850+ 6A58 ED 53 22 6F          ld      (dir_search_page),de
2851+ 6A5C 2A C1 77             ld      hl,(txtlen+1)
2852+ 6A5F 22 26 6F             ld      (dir_search_patlen),hl
2853+ 6A62 7C                   ld      a,h
2854+ 6A63 B5                   or      l
2855+ 6A64 28 56                jr      z,.dir_search_found
2856+ 6A66
2857+ 6A66              .dir_search_outer:
2858+ 6A66                      ;If remaining source length < pattern length, no further match exists.
2859+ 6A66 2A 24 6F             ld      hl,(dir_search_remaining)
2860+ 6A69 ED 5B 26 6F          ld      de,(dir_search_patlen)
2861+ 6A6D B7                   or      a
2862+ 6A6E ED 52                sbc     hl,de
2863+ 6A70 38 4C                jr      c,.dir_search_not_found
2864+ 6A72
2865+ 6A72                      ;Start one comparison at current candidate address/page.
2866+ 6A72 2A 20 6F             ld      hl,(dir_search_addr)
2867+ 6A75 ED 5B 22 6F          ld      de,(dir_search_page)
2868+ 6A79 CD BE 69             call    DIR128_MAP_DE
2869+ 6A7C 11 15 8D             ld      de,INPBUFF
2870+ 6A7F ED 4B 26 6F          ld      bc,(dir_search_patlen)
2871+ 6A83
2872+ 6A83              .dir_search_cmp:
2873+ 6A83 7E                   ld      a,(hl)
2874+ 6A84 CD E5 77             call    convert                 ;source char -> lower case
2875+ 6A87 EB                   ex      de,hl
2876+ 6A88 BE                   cp      (hl)                    ;pattern already normalized by FIND
2877+ 6A89 EB                   ex      de,hl
2878+ 6A8A 20 0D                jr      nz,.dir_search_advance_candidate
2879+ 6A8C
2880+ 6A8C 13                   inc     de
2881+ 6A8D 0B                   dec     bc
2882+ 6A8E 78                   ld      a,b
2883+ 6A8F B1                   or      c
2884+ 6A90 28 2A                jr      z,.dir_search_found
2885+ 6A92 CD 2F 69             call    DIR128_INC_HL
2886+ 6A95 38 27                jr      c,.dir_search_not_found
2887+ 6A97 18 EA                jr      .dir_search_cmp

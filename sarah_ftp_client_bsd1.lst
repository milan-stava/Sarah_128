 2922+6D75
 2923+6D75
 2924+6D75              ; -----------------------------------------------------------------------------
 2925+6D75              ; FTP DIRECTORY BANK API
 2926+6D75              ;
 2927+6D75              ; fdp_pointer always points to the table byte of the CURRENT directory page.
 2928+6D75              ; ftp_dir_page has #FF sentinels on both sides:
 2929+6D75              ;       #FF, 0, 1, 3, 7, #FF
 2930+6D75              ;
 2931+6D75              ; HL is always a physical address in the banked window #C000-#FFFF.
 2932+6D75              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
 2933+6D75              ;
 2934+6D75              ; OUT for INC/DEC:
 2935+6D75              ;       NC = movement succeeded
 2936+6D75              ;       C  = no next/previous directory page (64 KB boundary)
 2937+6D75              ;
 2938+6D75              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
 2939+6D75              ; which preserves AF/BC/DE/IX/IY exactly.
 2940+6D75              ; -----------------------------------------------------------------------------
 2941+6D75
 2942+6D75              ; --- DOKUMENTACE CZ: DIR128_MAP_CURRENT ---
 2943+6D75              ; Ucel: Namapuje aktuální banku adresáře do #C000–#FFFF.
 2944+6D75              ; Vstup: fdp_pointer ukazuje do tabulky ftp_dir_page.
 2945+6D75              ; Vystup: NC = platná banka, C = sentinel #FF.
 2946+6D75              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
 2947+6D75              ; Poznamka: Mění PAGE128_STATE a port #7FFD.
 2948+6D75              ; --- KONEC DOKUMENTACE CZ ---
 2949+6D75              DIR128_MAP_CURRENT:
 2950+6D75 E5                   push    hl
 2951+6D76 D5                   push    de
 2952+6D77 ED 5B F6 BF          ld      de,(fdp_pointer)
 2953+6D7B 1A                   ld      a,(de)
 2954+6D7C FE FF                cp      #FF
 2955+6D7E 28 07                jr      z,DIR128_MAP_BAD
 2956+6D80 CD E0 BF             call    PAGE128
 2957+6D83 D1                   pop     de
 2958+6D84 E1                   pop     hl
 2959+6D85 B7                   or      a                       ;NC = valid page
 2960+6D86 C9                   ret
 2961+6D87              DIR128_MAP_BAD:
 2962+6D87 D1                   pop     de
 2963+6D88 E1                   pop     hl
 2964+6D89 37                   scf
 2965+6D8A C9                   ret
 2966+6D8B
 2967+6D8B              ;Select first FTP directory page (page 0).
 2968+6D8B              ; --- DOKUMENTACE CZ: DIR128_FIRST_PAGE ---
 2969+6D8B              ; Ucel: Vybere první banku adresáře (RAM 0).
 2970+6D8B              ; Vstup: Bez parametrů.
 2971+6D8B              ; Vystup: fdp_pointer = ftp_dir_page+1; NC.
 2972+6D8B              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
 2973+6D8B              ; Poznamka: Mění mapování RAM a PAGE128_STATE.
 2974+6D8B              ; --- KONEC DOKUMENTACE CZ ---
 2975+6D8B              DIR128_FIRST_PAGE:
 2976+6D8B E5                   push    hl
 2977+6D8C 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
 2978+6D8F 22 F6 BF             ld      (fdp_pointer),hl
 2979+6D92 7E                   ld      a,(hl)
 2980+6D93 CD E0 BF             call    PAGE128
 2981+6D96 E1                   pop     hl
 2982+6D97 B7                   or      a
 2983+6D98 C9                   ret
 2984+6D99
 2985+6D99              ;HL++ across #FFFF -> #C000 of the next directory page.
 2986+6D99              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
 2987+6D99              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
 2988+6D99              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
 2989+6D99              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
 2990+6D99              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
 2991+6D99              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
 2992+6D99              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
 2993+6D99              ; --- KONEC DOKUMENTACE CZ ---
 2994+6D99              DIR128_INC_HL:
 2995+6D99 F5                   push    af                      ;old INC HL never changed A - preserve it here too
 2996+6D9A 23                   inc     hl
 2997+6D9B 7C                   ld      a,h
 2998+6D9C B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
 2999+6D9D 28 03                jr      z,DIR128_INC_CROSS
 3000+6D9F F1                   pop     af
 3001+6DA0 B7                   or      a                       ;restore A and return NC = OK
 3002+6DA1 C9                   ret
 3003+6DA2
 3004+6DA2              DIR128_INC_CROSS:
 3005+6DA2 D5                   push    de
 3006+6DA3 ED 5B F6 BF          ld      de,(fdp_pointer)
 3007+6DA7 13                   inc     de
 3008+6DA8 1A                   ld      a,(de)
 3009+6DA9 FE FF                cp      #FF
 3010+6DAB 28 0E                jr      z,DIR128_INC_END
 3011+6DAD ED 53 F6 BF          ld      (fdp_pointer),de
 3012+6DB1 CD E0 BF             call    PAGE128
 3013+6DB4 21 00 C0             ld      hl,ftp_dir_start        ;#C000
 3014+6DB7 D1                   pop     de
 3015+6DB8 F1                   pop     af                      ;restore caller's A
 3016+6DB9 B7                   or      a                       ;NC = OK, A unchanged
 3017+6DBA C9                   ret
 3018+6DBB              DIR128_INC_END:
 3019+6DBB 1B                   dec     de                      ;keep fdp_pointer on last valid page
 3020+6DBC ED 53 F6 BF          ld      (fdp_pointer),de
 3021+6DC0 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
 3022+6DC3 D1                   pop     de
 3023+6DC4 F1                   pop     af                      ;restore caller's A
 3024+6DC5 37                   scf                             ;C = no following directory page
 3025+6DC6 C9                   ret
 3026+6DC7
 3027+6DC7              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
 3028+6DC7              ;Unlike the general helper, this preserves the COMPLETE parser state:
 3029+6DC7              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
 3030+6DC7              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
 3031+6DC7              ;  dir128_parser_status = 0  OK
 3032+6DC7              ;  dir128_parser_status = 1  no next directory page
 3033+6DC7              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
 3034+6DC7              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
 3035+6DC7              ; Vstup: HL = adresa v aktuální bance adresáře.
 3036+6DC7              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
 3037+6DC7              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
 3038+6DC7              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
 3039+6DC7              ; --- KONEC DOKUMENTACE CZ ---
 3040+6DC7              DIR128_INC_HL_PARSER:
 3041+6DC7 F5                   push    af
 3042+6DC8 D5                   push    de
 3043+6DC9 AF                   xor     a
 3044+6DCA 32 17 8A             ld      (dir128_parser_status),a
 3045+6DCD 23                   inc     hl
 3046+6DCE 7C                   ld      a,h
 3047+6DCF B7                   or      a
 3048+6DD0 20 14                jr      nz,.ok
 3049+6DD2 ED 5B F6 BF          ld      de,(fdp_pointer)
 3050+6DD6 13                   inc     de
 3051+6DD7 1A                   ld      a,(de)
 3052+6DD8 FE FF                cp      #FF
 3053+6DDA 28 0D                jr      z,.full
 3054+6DDC ED 53 F6 BF          ld      (fdp_pointer),de
 3055+6DE0 CD E0 BF             call    PAGE128
 3056+6DE3 21 00 C0             ld      hl,ftp_dir_start
 3057+6DE6              .ok:
 3058+6DE6 D1                   pop     de
 3059+6DE7 F1                   pop     af
 3060+6DE8 C9                   ret
 3061+6DE9              .full:
 3062+6DE9 1B                   dec     de
 3063+6DEA ED 53 F6 BF          ld      (fdp_pointer),de
 3064+6DEE 21 FF FF             ld      hl,#FFFF
 3065+6DF1 3E 01                ld      a,1
 3066+6DF3 32 17 8A             ld      (dir128_parser_status),a
 3067+6DF6 D1                   pop     de
 3068+6DF7 F1                   pop     af
 3069+6DF8 C9                   ret
 3070+6DF9
 3071+6DF9              ;HL-- across #C000 -> #FFFF of the previous directory page.
 3072+6DF9              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
 3073+6DF9              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
 3074+6DF9              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
 3075+6DF9              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
 3076+6DF9              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
 3077+6DF9              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
 3078+6DF9              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
 3079+6DF9              ; --- KONEC DOKUMENTACE CZ ---
 3080+6DF9              DIR128_DEC_HL:
 3081+6DF9 F5                   push    af                      ;old DEC HL never changed A - preserve it here too
 3082+6DFA 2B                   dec     hl
 3083+6DFB 7C                   ld      a,h
 3084+6DFC FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
 3085+6DFE 28 03                jr      z,DIR128_DEC_CROSS
 3086+6E00 F1                   pop     af
 3087+6E01 B7                   or      a                       ;restore A and return NC = OK
 3088+6E02 C9                   ret
 3089+6E03
 3090+6E03              DIR128_DEC_CROSS:
 3091+6E03 D5                   push    de
 3092+6E04 ED 5B F6 BF          ld      de,(fdp_pointer)
 3093+6E08 1B                   dec     de
 3094+6E09 1A                   ld      a,(de)
 3095+6E0A FE FF                cp      #FF
 3096+6E0C 28 0E                jr      z,DIR128_DEC_START
 3097+6E0E ED 53 F6 BF          ld      (fdp_pointer),de
 3098+6E12 CD E0 BF             call    PAGE128
 3099+6E15 21 FF FF             ld      hl,#FFFF
 3100+6E18 D1                   pop     de
 3101+6E19 F1                   pop     af                      ;restore caller's A
 3102+6E1A B7                   or      a                       ;NC = OK, A unchanged
 3103+6E1B C9                   ret
 3104+6E1C              DIR128_DEC_START:
 3105+6E1C 13                   inc     de                      ;keep fdp_pointer on first valid page
 3106+6E1D ED 53 F6 BF          ld      (fdp_pointer),de
 3107+6E21 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
 3108+6E24 D1                   pop     de
 3109+6E25 F1                   pop     af                      ;restore caller's A
 3110+6E26 37                   scf                             ;C = no previous directory page
 3111+6E27 C9                   ret

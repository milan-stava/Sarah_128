5926+ 785B              ;16)
5927+ 785B              ; --- DOKUMENTACE CZ: ConvRStr16 ---
5928+ 785B              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
5929+ 785B              ; Vstup: DE = začátek číslic.
5930+ 785B              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
5931+ 785B              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
5932+ 785B              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
5933+ 785B              ;   přetečení; Z nemá pevný význam.
5934+ 785B              ; --- KONEC DOKUMENTACE CZ ---
5935+ 785B              ConvRStr16
5936+ 785B              ;===============================================================
5937+ 785B              ;http://z80-heaven.wikidot.com/math#toc32
5938+ 785B              ;Input:
5939+ 785B              ;     DE points to the base 10 number string in RAM.
5940+ 785B              ;Outputs:
5941+ 785B              ;     HL is the 16-bit value of the number
5942+ 785B              ;     DE points to the byte after the number
5943+ 785B              ;     BC is HL/10
5944+ 785B              ;     z flag reset (nz)
5945+ 785B              ;     c flag reset (nc)
5946+ 785B              ;Destroys:
5947+ 785B              ;     A (actually, add 30h and you get the ending token)
5948+ 785B              ;Size:  23 bytes
5949+ 785B              ;Speed: 104n+42+11c
5950+ 785B              ;       n is the number of digits
5951+ 785B              ;       c is at most n-2
5952+ 785B              ;       at most 595 cycles for any 16-bit decimal value
5953+ 785B              ;===============================================================
5954+ 785B
5955+ 785B 21 00 00          ld hl,0          ;  10 : 210000
5956+ 785E              ConvLoop:             ;
5957+ 785E 1A                ld a,(de)        ;   7 : 1A
5958+ 785F D6 30             sub 30h          ;   7 : D630
5959+ 7861 FE 0A             cp 10            ;   7 : FE0A
5960+ 7863 D0                ret nc           ;5|11 : D0
5961+ 7864 13                inc de           ;   6 : 13
5962+ 7865                                    ;
5963+ 7865 44                ld b,h           ;   4 : 44
5964+ 7866 4D                ld c,l           ;   4 : 4D
5965+ 7867 29                add hl,hl        ;  11 : 29
5966+ 7868 29                add hl,hl        ;  11 : 29
5967+ 7869 09                add hl,bc        ;  11 : 09
5968+ 786A 29                add hl,hl        ;  11 : 29
5969+ 786B                                    ;
5970+ 786B 85                add a,l          ;   4 : 85
5971+ 786C 6F                ld l,a           ;   4 : 6F
5972+ 786D 30 EF             jr nc,ConvLoop   ;12|23: 30EE
5973+ 786F 24                inc h            ; --- : 24
5974+ 7870 18 EC             jr ConvLoop      ; --- : 18EB
5975+ 7872
5976+ 7872

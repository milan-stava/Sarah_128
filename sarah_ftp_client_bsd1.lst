2418+ 68F5              ; -----------------------------------------------------------------------------
2419+ 68F5              ; FTP DIRECTORY BANK API
2420+ 68F5              ;
2421+ 68F5              ; fdp_pointer always points to the table byte of the CURRENT directory page.
2422+ 68F5              ; ftp_dir_page has #FF sentinels on both sides:
2423+ 68F5              ;       #FF, 0, 1, 3, 7, #FF
2424+ 68F5              ;
2425+ 68F5              ; HL is always a physical address in the banked window #C000-#FFFF.
2426+ 68F5              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
2427+ 68F5              ;
2428+ 68F5              ; OUT for INC/DEC:
2429+ 68F5              ;       NC = movement succeeded
2430+ 68F5              ;       C  = no next/previous directory page (64 KB boundary)
2431+ 68F5              ;
2432+ 68F5              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
2433+ 68F5              ; which preserves AF/BC/DE/IX/IY exactly.
2434+ 68F5              ; -----------------------------------------------------------------------------
2435+ 68F5
2436+ 68F5              ; --- DOKUMENTACE CZ: DIR128_MAP_CURRENT ---
2437+ 68F5              ; Ucel: Namapuje aktuální banku adresáře do #C000–#FFFF.
2438+ 68F5              ; Vstup: fdp_pointer ukazuje do tabulky ftp_dir_page.
2439+ 68F5              ; Vystup: NC = platná banka, C = sentinel #FF.
2440+ 68F5              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
2441+ 68F5              ; Poznamka: Mění PAGE128_STATE a port #7FFD.
2442+ 68F5              ; --- KONEC DOKUMENTACE CZ ---
2443+ 68F5              DIR128_MAP_CURRENT:
2444+ 68F5 E5                   push    hl
2445+ 68F6 D5                   push    de
2446+ 68F7 ED 5B F6 BF          ld      de,(fdp_pointer)
2447+ 68FB 1A                   ld      a,(de)
2448+ 68FC FE FF                cp      #FF
2449+ 68FE 28 07                jr      z,DIR128_MAP_BAD
2450+ 6900 CD E0 BF             call    PAGE128
2451+ 6903 D1                   pop     de
2452+ 6904 E1                   pop     hl
2453+ 6905 B7                   or      a                       ;NC = valid page
2454+ 6906 C9                   ret
2455+ 6907              DIR128_MAP_BAD:
2456+ 6907 D1                   pop     de
2457+ 6908 E1                   pop     hl
2458+ 6909 37                   scf
2459+ 690A C9                   ret
2460+ 690B
2461+ 690B              ;Select first FTP directory page (page 0).
2462+ 690B              ; --- DOKUMENTACE CZ: DIR128_FIRST_PAGE ---
2463+ 690B              ; Ucel: Vybere první banku adresáře (RAM 0).
2464+ 690B              ; Vstup: Bez parametrů.
2465+ 690B              ; Vystup: fdp_pointer = ftp_dir_page+1; NC.
2466+ 690B              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
2467+ 690B              ; Poznamka: Mění mapování RAM a PAGE128_STATE.
2468+ 690B              ; --- KONEC DOKUMENTACE CZ ---
2469+ 690B              DIR128_FIRST_PAGE:
2470+ 690B E5                   push    hl
2471+ 690C 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
2472+ 690F 22 F6 BF             ld      (fdp_pointer),hl
2473+ 6912 7E                   ld      a,(hl)
2474+ 6913 CD E0 BF             call    PAGE128
2475+ 6916 E1                   pop     hl
2476+ 6917 B7                   or      a
2477+ 6918 C9                   ret
2478+ 6919
2479+ 6919              ;HL++ across #FFFF -> #C000 of the next directory page.
2480+ 6919              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
2481+ 6919              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
2482+ 6919              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
2483+ 6919              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2484+ 6919              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
2485+ 6919              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2486+ 6919              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2487+ 6919              ; --- KONEC DOKUMENTACE CZ ---
2488+ 6919              DIR128_INC_HL:
2489+ 6919 F5                   push    af                      ;old INC HL never changed A - preserve it here too
2490+ 691A 23                   inc     hl
2491+ 691B 7C                   ld      a,h
2492+ 691C B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
2493+ 691D 28 03                jr      z,DIR128_INC_CROSS
2494+ 691F F1                   pop     af
2495+ 6920 B7                   or      a                       ;restore A and return NC = OK
2496+ 6921 C9                   ret
2497+ 6922
2498+ 6922              DIR128_INC_CROSS:
2499+ 6922 D5                   push    de
2500+ 6923 ED 5B F6 BF          ld      de,(fdp_pointer)
2501+ 6927 13                   inc     de
2502+ 6928 1A                   ld      a,(de)
2503+ 6929 FE FF                cp      #FF
2504+ 692B 28 0E                jr      z,DIR128_INC_END
2505+ 692D ED 53 F6 BF          ld      (fdp_pointer),de
2506+ 6931 CD E0 BF             call    PAGE128
2507+ 6934 21 00 C0             ld      hl,ftp_dir_start        ;#C000
2508+ 6937 D1                   pop     de
2509+ 6938 F1                   pop     af                      ;restore caller's A
2510+ 6939 B7                   or      a                       ;NC = OK, A unchanged
2511+ 693A C9                   ret
2512+ 693B              DIR128_INC_END:
2513+ 693B 1B                   dec     de                      ;keep fdp_pointer on last valid page
2514+ 693C ED 53 F6 BF          ld      (fdp_pointer),de
2515+ 6940 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
2516+ 6943 D1                   pop     de
2517+ 6944 F1                   pop     af                      ;restore caller's A
2518+ 6945 37                   scf                             ;C = no following directory page
2519+ 6946 C9                   ret
2520+ 6947
2521+ 6947              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
2522+ 6947              ;Unlike the general helper, this preserves the COMPLETE parser state:
2523+ 6947              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
2524+ 6947              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
2525+ 6947              ;  dir128_parser_status = 0  OK
2526+ 6947              ;  dir128_parser_status = 1  no next directory page
2527+ 6947              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
2528+ 6947              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
2529+ 6947              ; Vstup: HL = adresa v aktuální bance adresáře.
2530+ 6947              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
2531+ 6947              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
2532+ 6947              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
2533+ 6947              ; --- KONEC DOKUMENTACE CZ ---
2534+ 6947              DIR128_INC_HL_PARSER:
2535+ 6947 F5                   push    af
2536+ 6948 D5                   push    de
2537+ 6949 AF                   xor     a
2538+ 694A 32 78 86             ld      (dir128_parser_status),a
2539+ 694D 23                   inc     hl
2540+ 694E 7C                   ld      a,h
2541+ 694F B7                   or      a
2542+ 6950 20 14                jr      nz,.ok
2543+ 6952 ED 5B F6 BF          ld      de,(fdp_pointer)
2544+ 6956 13                   inc     de
2545+ 6957 1A                   ld      a,(de)
2546+ 6958 FE FF                cp      #FF
2547+ 695A 28 0D                jr      z,.full
2548+ 695C ED 53 F6 BF          ld      (fdp_pointer),de
2549+ 6960 CD E0 BF             call    PAGE128
2550+ 6963 21 00 C0             ld      hl,ftp_dir_start
2551+ 6966              .ok:
2552+ 6966 D1                   pop     de
2553+ 6967 F1                   pop     af
2554+ 6968 C9                   ret
2555+ 6969              .full:
2556+ 6969 1B                   dec     de
2557+ 696A ED 53 F6 BF          ld      (fdp_pointer),de
2558+ 696E 21 FF FF             ld      hl,#FFFF
2559+ 6971 3E 01                ld      a,1
2560+ 6973 32 78 86             ld      (dir128_parser_status),a
2561+ 6976 D1                   pop     de
2562+ 6977 F1                   pop     af
2563+ 6978 C9                   ret
2564+ 6979
2565+ 6979              ;HL-- across #C000 -> #FFFF of the previous directory page.
2566+ 6979              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
2567+ 6979              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
2568+ 6979              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
2569+ 6979              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2570+ 6979              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
2571+ 6979              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2572+ 6979              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2573+ 6979              ; --- KONEC DOKUMENTACE CZ ---
2574+ 6979              DIR128_DEC_HL:
2575+ 6979 F5                   push    af                      ;old DEC HL never changed A - preserve it here too
2576+ 697A 2B                   dec     hl
2577+ 697B 7C                   ld      a,h
2578+ 697C FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
2579+ 697E 28 03                jr      z,DIR128_DEC_CROSS
2580+ 6980 F1                   pop     af
2581+ 6981 B7                   or      a                       ;restore A and return NC = OK
2582+ 6982 C9                   ret
2583+ 6983
2584+ 6983              DIR128_DEC_CROSS:
2585+ 6983 D5                   push    de
2586+ 6984 ED 5B F6 BF          ld      de,(fdp_pointer)
2587+ 6988 1B                   dec     de
2588+ 6989 1A                   ld      a,(de)
2589+ 698A FE FF                cp      #FF
2590+ 698C 28 0E                jr      z,DIR128_DEC_START
2591+ 698E ED 53 F6 BF          ld      (fdp_pointer),de
2592+ 6992 CD E0 BF             call    PAGE128
2593+ 6995 21 FF FF             ld      hl,#FFFF
2594+ 6998 D1                   pop     de
2595+ 6999 F1                   pop     af                      ;restore caller's A
2596+ 699A B7                   or      a                       ;NC = OK, A unchanged
2597+ 699B C9                   ret
2598+ 699C              DIR128_DEC_START:
2599+ 699C 13                   inc     de                      ;keep fdp_pointer on first valid page
2600+ 699D ED 53 F6 BF          ld      (fdp_pointer),de
2601+ 69A1 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
2602+ 69A4 D1                   pop     de
2603+ 69A5 F1                   pop     af                      ;restore caller's A
2604+ 69A6 37                   scf                             ;C = no previous directory page
2605+ 69A7 C9                   ret
2606+ 69A8
2607+ 69A8              ;Map page-table pointer stored in DE. HL is preserved.
2608+ 69A8              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
2609+ 69A8              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
2610+ 69A8              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
2611+ 69A8              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
2612+ 69A8              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
2613+ 69A8              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
2614+ 69A8              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
2615+ 69A8              ; --- KONEC DOKUMENTACE CZ ---
2616+ 69A8              DIR128_MAP_DE:
2617+ 69A8 F5                   push    af
2618+ 69A9 ED 53 F6 BF          ld      (fdp_pointer),de
2619+ 69AD 1A                   ld      a,(de)
2620+ 69AE CD E0 BF             call    PAGE128
2621+ 69B1 F1                   pop     af
2622+ 69B2 C9                   ret

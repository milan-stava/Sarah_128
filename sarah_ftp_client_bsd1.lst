6048+ 78B5 30 FA        			jr nc,string_lp2
6049+ 78B7 09           			add hl,bc
6050+ 78B8 FE 30        			CP '0'
6051+ 78BA 28 04        			JR Z,string_store
6052+ 78BC
6053+ 78BC DD CB 00 FE  			SET 7,(IX+0)		;Had something other than zero
6054+ 78C0
6055+ 78C0 DD CB 00 7E  string_store:		BIT 7,(IX+0)		;Test if still leading zeros
6056+ 78C4 C8           			RET Z
6057+ 78C5 12           			LD (DE),A		;If not store it
6058+ 78C6 13           			INC DE

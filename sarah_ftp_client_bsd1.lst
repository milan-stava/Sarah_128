 2755+6A4A              ; -----------------------------------------------------------------------------
 2756+6A4A              ; search_by_Busy_dir
 2757+6A4A              ; Bank-safe replacement used by FIND for names returned by get_item_name.
 2758+6A4A              ; IN:  HL = physical name start, BC = 16-bit name length
 2759+6A4A              ;      item_name_page = bank companion for HL
 2760+6A4A              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
 2761+6A4A              ; OUT: Z=pattern found, NZ=not found
 2762+6A4A              ; One-character input matches only the FIRST character of a name (quick jump).
 2763+6A4A              ; Two or more characters use normal case-insensitive substring search. There is
 2764+6A4A              ; no 255-byte directory-name limit; directory page crossings are transparent.
 2765+6A4A              ; -----------------------------------------------------------------------------
 2766+6A4A              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
 2767+6A4A              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
 2768+6A4A              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
 2769+6A4A              ;   = délka vzoru.
 2770+6A4A              ; Vystup: Z = shoda, NZ = nenalezeno.
 2771+6A4A              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 2772+6A4A              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
 2773+6A4A              ; --- KONEC DOKUMENTACE CZ ---
 2774+6A4A              search_by_Busy_dir:
 2775+6A4A                      ; Empty name cannot contain a non-empty search pattern.
 2776+6A4A 78                   ld      a,b
 2777+6A4B B1                   or      c
 2778+6A4C 28 2A                jr      z,.dir_search_not_found_fast
 2779+6A4E
 2780+6A4E                      ; Map the directory bank containing the first byte of the name ONCE.
 2781+6A4E                      ; For the normal case the whole name is inside this one 16K bank and
 2782+6A4E                      ; no further paging is needed during FIND.
 2783+6A4E ED 5B 7F 6F          ld      de,(item_name_page)
 2784+6A52 CD 26 6A             call    DIR128_MAP_DE
 2785+6A55
 2786+6A55                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
 2787+6A55                      ; the first character of the file name.  Thus FIND "S" selects names
 2788+6A55                      ; beginning with S, while 2+ characters remain a substring search.
 2789+6A55                      ; This is also much faster for the common one-letter jump.
 2790+6A55 ED 5B 2E 79          ld      de,(txtlen+1)
 2791+6A59 7A                   ld      a,d
 2792+6A5A B7                   or      a
 2793+6A5B 20 0F                jr      nz,.dir_search_len_ge2
 2794+6A5D 7B                   ld      a,e
 2795+6A5E FE 01                cp      1
 2796+6A60 20 0A                jr      nz,.dir_search_len_ge2
 2797+6A62 7E                   ld      a,(hl)
 2798+6A63 CD 52 79             call    convert
 2799+6A66 57                   ld      d,a
 2800+6A67 3A B9 8F             ld      a,(INPBUFF)             ;already normalized by find_items
 2801+6A6A BA                   cp      d                       ;Z=first character matches
 2802+6A6B C9                   ret

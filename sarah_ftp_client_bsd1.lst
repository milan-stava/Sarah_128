4050+ 70B1 ED 53 0E 6F  		ld	(next_item_addr),de	;temporary physical start
4051+ 70B5 EB           		ex	de,hl			;HL=current physical item start
4052+ 70B6
4053+ 70B6              		;Load/map directory page from page companion variable.
4054+ 70B6 E5           		push	hl
4055+ 70B7 2A 18 6F     		ld	hl,(dir_op_page_var)
4056+ 70BA 5E           		ld	e,(hl)
4057+ 70BB 23           		inc	hl
4058+ 70BC 56           		ld	d,(hl)
4059+ 70BD E1           		pop	hl
4060+ 70BE CD C9 69     		call	DIR128_MAP_DE
4061+ 70C1
4062+ 70C1              		;Read item length LOW/HIGH. Header itself may cross #FFFF/#C000.
4063+ 70C1 7E           		ld	a,(hl)

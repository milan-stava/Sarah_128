1024+ 62A3              ; --- DOKUMENTACE CZ: switch_speed ---
1025+ 62A3              ; Ucel: Zkouší rychlosti UART sestupně od maximální až po nulu.
1026+ 62A3              ; Vstup: (IX+8) = nejvyšší zkoušený index rychlosti.
1027+ 62A3              ; Vystup: Z = modul odpověděl OK, D = nalezený index; NZ = nenalezeno.
1028+ 62A3              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
1029+ 62A3              ; Poznamka: Mění UART a (IX+6), vyprazdňuje příjem.
1030+ 62A3              ; --- KONEC DOKUMENTACE CZ ---
1031+ 62A3 DD 7E 08     switch_speed	ld	a,(ix+8)		;try out every speed if you find connection UART+Wifi
1032+ 62A6              						;start with max speed, end with 0
1033+ 62A6 F5           sws2		push	af
1034+ 62A7 CD 42 7A     		call	set_print_speed
1035+ 62AA 38 1B        		jr c,sws_unsupported ;do not report a UART setting rejected by BIOS
1036+ 62AC
1037+ 62AC F1           		pop	af			;we need to inrease timeout for speeds <3
1038+ 62AD F5           		push	af
1039+ 62AE FE 03        		cp	3
1040+ 62B0 DD 36 06 01  		ld	(ix+6),1		;set timeout for 1 for speeds >3
1041+ 62B4 30 04        		jr	nc,sws1
1042+ 62B6 DD 36 06 0A  		ld	(ix+6),#A		;set tieout for #A for speeds <2
1043+ 62BA
1044+ 62BA CD 0A 7A     sws1		call	send_at_check_ok
1045+ 62BD D1           		pop	de
1046+ 62BE C8           		ret	z			;Z=answer found, D= speed set in HW
1047+ 62BF 7A           sws_next ld	a,d
1048+ 62C0 3D           		dec	a
1049+ 62C1 FE FF        		cp	255			;test for 255, so that also speed 0 is tested
1050+ 62C3 20 E1        		jr	nz,sws2
1051+ 62C5 3D           		dec	a			;NZ=not successfull
1052+ 62C6 C9           		ret
1053+ 62C7 D1           sws_unsupported pop de
1054+ 62C8 18 F5                jr sws_next

 1001+628F              ; --- DOKUMENTACE CZ: find_out_speed ---
 1002+628F              ; Ucel: Zjistí index aktuální rychlosti UART, případně rychlosti vyzkouší.
 1003+628F              ; Vstup: IX = flag1; dostupné služby get_baud/set_baud.
 1004+628F              ; Vystup: D = index zjištěné rychlosti při úspěchu.
 1005+628F              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
 1006+628F              ; Poznamka: Při nepodporovaném get_baud používá switch_speed; jeho neúspěch nepovažujte za
 1007+628F              ;   platnou rychlost.
 1008+628F              ; --- KONEC DOKUMENTACE CZ ---
 1009+628F              find_out_speed
 1010+628F CD 6F A5             call get_baud
 1011+6292 30 06                jr nc,.known
 1012+6294 CD A3 62             call switch_speed
 1013+6297 20 08                jr nz,.failed
 1014+6299 7A                   ld a,d
 1015+629A FE 18        .known  cp 24
 1016+629C 30 03                jr nc,.failed
 1017+629E 57                   ld d,a
 1018+629F B7                   or a
 1019+62A0 C9                   ret
 1020+62A1 37           .failed scf
 1021+62A2 C9                   ret
 1022+62A3              						;tests speeds <7-0>, then <max-8>
 1023+62A3              ;switch_speed	ld	a,7			;start with speeds 7-0 (quicker finds the speed)
 1024+62A3              ;		call	sws2
 1025+62A3              ;		ret	z			;Z= speed <0,7> found
 1026+62A3
 1027+62A3              ; --- DOKUMENTACE CZ: switch_speed ---
 1028+62A3              ; Ucel: Zkouší rychlosti UART sestupně od maximální až po nulu.
 1029+62A3              ; Vstup: (IX+8) = nejvyšší zkoušený index rychlosti.
 1030+62A3              ; Vystup: Z = modul odpověděl OK, D = nalezený index; NZ = nenalezeno.
 1031+62A3              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
 1032+62A3              ; Poznamka: Mění UART a (IX+6), vyprazdňuje příjem.
 1033+62A3              ; --- KONEC DOKUMENTACE CZ ---
 1034+62A3 DD 7E 08     switch_speed	ld	a,(ix+8)		;try out every speed if you find connection UART+Wifi
 1035+62A6              						;start with max speed, end with 0
 1036+62A6 F5           sws2		push	af
 1037+62A7 CD AA 7A     		call	set_print_speed
 1038+62AA 38 1B        		jr c,sws_unsupported ;do not report a UART setting rejected by BIOS
 1039+62AC
 1040+62AC F1           		pop	af			;we need to inrease timeout for speeds <3
 1041+62AD F5           		push	af
 1042+62AE FE 03        		cp	3
 1043+62B0 DD 36 06 01  		ld	(ix+6),1		;set timeout for 1 for speeds >3
 1044+62B4 30 04        		jr	nc,sws1
 1045+62B6 DD 36 06 0A  		ld	(ix+6),#A		;set tieout for #A for speeds <2
 1046+62BA
 1047+62BA CD 72 7A     sws1		call	send_at_check_ok
 1048+62BD D1           		pop	de
 1049+62BE C8           		ret	z			;Z=answer found, D= speed set in HW
 1050+62BF 7A           sws_next ld	a,d
 1051+62C0 3D           		dec	a
 1052+62C1 FE FF        		cp	255			;test for 255, so that also speed 0 is tested
 1053+62C3 20 E1        		jr	nz,sws2
 1054+62C5 3D           		dec	a			;NZ=not successfull
 1055+62C6 C9           		ret
 1056+62C7 D1           sws_unsupported pop de
 1057+62C8 18 F5                jr sws_next

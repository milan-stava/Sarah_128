 998+ 628F              ; --- DOKUMENTACE CZ: find_out_speed ---
 999+ 628F              ; Ucel: Zjistí index aktuální rychlosti UART, případně rychlosti vyzkouší.
1000+ 628F              ; Vstup: IX = flag1; dostupné služby get_baud/set_baud.
1001+ 628F              ; Vystup: D = index zjištěné rychlosti při úspěchu.
1002+ 628F              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
1003+ 628F              ; Poznamka: Při nepodporovaném get_baud používá switch_speed; jeho neúspěch nepovažujte za
1004+ 628F              ;   platnou rychlost.
1005+ 628F              ; --- KONEC DOKUMENTACE CZ ---
1006+ 628F              find_out_speed
1007+ 628F CD C9 A3             call get_baud
1008+ 6292 30 06                jr nc,.known
1009+ 6294 CD A3 62             call switch_speed
1010+ 6297 20 08                jr nz,.failed
1011+ 6299 7A                   ld a,d
1012+ 629A FE 18        .known  cp 24
1013+ 629C 30 03                jr nc,.failed
1014+ 629E 57                   ld d,a
1015+ 629F B7                   or a
1016+ 62A0 C9                   ret
1017+ 62A1 37           .failed scf
1018+ 62A2 C9                   ret

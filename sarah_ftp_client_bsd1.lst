6024+ 7991              ; --- DOKUMENTACE CZ: string_dl ---
6025+ 7991              ; Ucel: Vypočítá a případně zapíše jednu desetinnou číslici.
6026+ 7991              ; Vstup: HL = zbytek čísla, BC = desítkový řád, DE = cíl; IX = flag1.
6027+ 7991              ; Vystup: HL = zbytek po odečtení řádu; DE posunut pouze při zápisu číslice.
6028+ 7991              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
6029+ 7991              ; Poznamka: Používá a nastavuje bit 7 v (IX+0) pro potlačení úvodních nul.
6030+ 7991              ; --- KONEC DOKUMENTACE CZ ---
6031+ 7991 3E 2F        string_dl:		ld a,'0'-1
6032+ 7993
6033+ 7993 3C           string_lp2:		inc a
6034+ 7994 B7           			or a
6035+ 7995 ED 42        			sbc hl,bc
6036+ 7997 30 FA        			jr nc,string_lp2
6037+ 7999 09           			add hl,bc
6038+ 799A FE 30        			CP '0'
6039+ 799C 28 04        			JR Z,string_store
6040+ 799E
6041+ 799E DD CB 00 FE  			SET 7,(IX+0)		;Had something other than zero
6042+ 79A2
6043+ 79A2 DD CB 00 7E  string_store:		BIT 7,(IX+0)		;Test if still leading zeros
6044+ 79A6 C8           			RET Z
6045+ 79A7 12           			LD (DE),A		;If not store it
6046+ 79A8 13           			INC DE
6047+ 79A9 C9           			RET

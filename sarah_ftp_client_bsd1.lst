2678+ 69E2              ; -----------------------------------------------------------------------------
2679+ 69E2              ; search_by_Busy_dir
2680+ 69E2              ; Bank-safe replacement used by FIND for names returned by get_item_name.
2681+ 69E2              ; IN:  HL = physical name start, BC = 16-bit name length
2682+ 69E2              ;      item_name_page = bank companion for HL
2683+ 69E2              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
2684+ 69E2              ; OUT: Z=pattern found, NZ=not found
2685+ 69E2              ; One-character input matches only the FIRST character of a name (quick jump).
2686+ 69E2              ; Two or more characters use normal case-insensitive substring search. There is
2687+ 69E2              ; no 255-byte directory-name limit; directory page crossings are transparent.
2688+ 69E2              ; -----------------------------------------------------------------------------
2689+ 69E2              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
2690+ 69E2              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
2691+ 69E2              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
2692+ 69E2              ;   = délka vzoru.
2693+ 69E2              ; Vystup: Z = shoda, NZ = nenalezeno.
2694+ 69E2              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2695+ 69E2              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
2696+ 69E2              ; --- KONEC DOKUMENTACE CZ ---
2697+ 69E2              search_by_Busy_dir:
2698+ 69E2                      ; Empty name cannot contain a non-empty search pattern.
2699+ 69E2 78                   ld      a,b
2700+ 69E3 B1                   or      c
2701+ 69E4 28 2A                jr      z,.dir_search_not_found_fast
2702+ 69E6
2703+ 69E6                      ; Map the directory bank containing the first byte of the name ONCE.
2704+ 69E6                      ; For the normal case the whole name is inside this one 16K bank and
2705+ 69E6                      ; no further paging is needed during FIND.
2706+ 69E6 ED 5B 19 6F          ld      de,(item_name_page)
2707+ 69EA CD BE 69             call    DIR128_MAP_DE
2708+ 69ED
2709+ 69ED                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
2710+ 69ED                      ; the first character of the file name.  Thus FIND "S" selects names
2711+ 69ED                      ; beginning with S, while 2+ characters remain a substring search.
2712+ 69ED                      ; This is also much faster for the common one-letter jump.
2713+ 69ED ED 5B C1 77          ld      de,(txtlen+1)
2714+ 69F1 7A                   ld      a,d
2715+ 69F2 B7                   or      a
2716+ 69F3 20 0F                jr      nz,.dir_search_len_ge2
2717+ 69F5 7B                   ld      a,e
2718+ 69F6 FE 01                cp      1
2719+ 69F8 20 0A                jr      nz,.dir_search_len_ge2
2720+ 69FA 7E                   ld      a,(hl)
2721+ 69FB CD E5 77             call    convert
2722+ 69FE 57                   ld      d,a
2723+ 69FF 3A 15 8D             ld      a,(INPBUFF)             ;already normalized by find_items
2724+ 6A02 BA                   cp      d                       ;Z=first character matches
2725+ 6A03 C9                   ret
2726+ 6A04
2727+ 6A04              .dir_search_len_ge2:
2728+ 6A04                      ; Is the LAST byte of the name still inside the same physical window?
2729+ 6A04                      ; last = HL + BC - 1
2730+ 6A04                      ; Carry means that the name crosses #FFFF -> #C000, therefore use the
2731+ 6A04                      ; fully bank-safe (but slower) routine below.

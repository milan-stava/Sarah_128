2433+ 690B              ; -----------------------------------------------------------------------------
2434+ 690B              ; FTP DIRECTORY BANK API
2435+ 690B              ;
2436+ 690B              ; fdp_pointer always points to the table byte of the CURRENT directory page.
2437+ 690B              ; ftp_dir_page has #FF sentinels on both sides:
2438+ 690B              ;       #FF, 0, 1, 3, 7, #FF
2439+ 690B              ;
2440+ 690B              ; HL is always a physical address in the banked window #C000-#FFFF.
2441+ 690B              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
2442+ 690B              ;
2443+ 690B              ; OUT for INC/DEC:
2444+ 690B              ;       NC = movement succeeded
2445+ 690B              ;       C  = no next/previous directory page (64 KB boundary)
2446+ 690B              ;
2447+ 690B              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
2448+ 690B              ; which preserves AF/BC/DE/IX/IY exactly.
2449+ 690B              ; -----------------------------------------------------------------------------
2450+ 690B
2451+ 690B              ; --- DOKUMENTACE CZ: DIR128_MAP_CURRENT ---
2452+ 690B              ; Ucel: Namapuje aktuální banku adresáře do #C000–#FFFF.
2453+ 690B              ; Vstup: fdp_pointer ukazuje do tabulky ftp_dir_page.
2454+ 690B              ; Vystup: NC = platná banka, C = sentinel #FF.
2455+ 690B              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
2456+ 690B              ; Poznamka: Mění PAGE128_STATE a port #7FFD.
2457+ 690B              ; --- KONEC DOKUMENTACE CZ ---
2458+ 690B              DIR128_MAP_CURRENT:
2459+ 690B E5                   push    hl
2460+ 690C D5                   push    de
2461+ 690D ED 5B F6 BF          ld      de,(fdp_pointer)
2462+ 6911 1A                   ld      a,(de)
2463+ 6912 FE FF                cp      #FF
2464+ 6914 28 07                jr      z,DIR128_MAP_BAD
2465+ 6916 CD E0 BF             call    PAGE128
2466+ 6919 D1                   pop     de
2467+ 691A E1                   pop     hl
2468+ 691B B7                   or      a                       ;NC = valid page
2469+ 691C C9                   ret
2470+ 691D              DIR128_MAP_BAD:
2471+ 691D D1                   pop     de
2472+ 691E E1                   pop     hl
2473+ 691F 37                   scf
2474+ 6920 C9                   ret
2475+ 6921
2476+ 6921              ;Select first FTP directory page (page 0).
2477+ 6921              ; --- DOKUMENTACE CZ: DIR128_FIRST_PAGE ---
2478+ 6921              ; Ucel: Vybere první banku adresáře (RAM 0).
2479+ 6921              ; Vstup: Bez parametrů.
2480+ 6921              ; Vystup: fdp_pointer = ftp_dir_page+1; NC.
2481+ 6921              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
2482+ 6921              ; Poznamka: Mění mapování RAM a PAGE128_STATE.
2483+ 6921              ; --- KONEC DOKUMENTACE CZ ---
2484+ 6921              DIR128_FIRST_PAGE:
2485+ 6921 E5                   push    hl
2486+ 6922 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
2487+ 6925 22 F6 BF             ld      (fdp_pointer),hl
2488+ 6928 7E                   ld      a,(hl)
2489+ 6929 CD E0 BF             call    PAGE128
2490+ 692C E1                   pop     hl
2491+ 692D B7                   or      a
2492+ 692E C9                   ret
2493+ 692F
2494+ 692F              ;HL++ across #FFFF -> #C000 of the next directory page.
2495+ 692F              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
2496+ 692F              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
2497+ 692F              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
2498+ 692F              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2499+ 692F              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
2500+ 692F              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2501+ 692F              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2502+ 692F              ; --- KONEC DOKUMENTACE CZ ---
2503+ 692F              DIR128_INC_HL:
2504+ 692F F5                   push    af                      ;old INC HL never changed A - preserve it here too
2505+ 6930 23                   inc     hl
2506+ 6931 7C                   ld      a,h
2507+ 6932 B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
2508+ 6933 28 03                jr      z,DIR128_INC_CROSS
2509+ 6935 F1                   pop     af
2510+ 6936 B7                   or      a                       ;restore A and return NC = OK
2511+ 6937 C9                   ret
2512+ 6938
2513+ 6938              DIR128_INC_CROSS:
2514+ 6938 D5                   push    de
2515+ 6939 ED 5B F6 BF          ld      de,(fdp_pointer)
2516+ 693D 13                   inc     de
2517+ 693E 1A                   ld      a,(de)
2518+ 693F FE FF                cp      #FF
2519+ 6941 28 0E                jr      z,DIR128_INC_END
2520+ 6943 ED 53 F6 BF          ld      (fdp_pointer),de
2521+ 6947 CD E0 BF             call    PAGE128
2522+ 694A 21 00 C0             ld      hl,ftp_dir_start        ;#C000
2523+ 694D D1                   pop     de
2524+ 694E F1                   pop     af                      ;restore caller's A
2525+ 694F B7                   or      a                       ;NC = OK, A unchanged
2526+ 6950 C9                   ret
2527+ 6951              DIR128_INC_END:
2528+ 6951 1B                   dec     de                      ;keep fdp_pointer on last valid page
2529+ 6952 ED 53 F6 BF          ld      (fdp_pointer),de
2530+ 6956 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
2531+ 6959 D1                   pop     de
2532+ 695A F1                   pop     af                      ;restore caller's A
2533+ 695B 37                   scf                             ;C = no following directory page
2534+ 695C C9                   ret
2535+ 695D
2536+ 695D              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
2537+ 695D              ;Unlike the general helper, this preserves the COMPLETE parser state:
2538+ 695D              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
2539+ 695D              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
2540+ 695D              ;  dir128_parser_status = 0  OK
2541+ 695D              ;  dir128_parser_status = 1  no next directory page
2542+ 695D              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
2543+ 695D              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
2544+ 695D              ; Vstup: HL = adresa v aktuální bance adresáře.
2545+ 695D              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
2546+ 695D              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
2547+ 695D              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
2548+ 695D              ; --- KONEC DOKUMENTACE CZ ---
2549+ 695D              DIR128_INC_HL_PARSER:
2550+ 695D F5                   push    af
2551+ 695E D5                   push    de
2552+ 695F AF                   xor     a
2553+ 6960 32 5C 86             ld      (dir128_parser_status),a
2554+ 6963 23                   inc     hl
2555+ 6964 7C                   ld      a,h
2556+ 6965 B7                   or      a
2557+ 6966 20 14                jr      nz,.ok
2558+ 6968 ED 5B F6 BF          ld      de,(fdp_pointer)
2559+ 696C 13                   inc     de
2560+ 696D 1A                   ld      a,(de)
2561+ 696E FE FF                cp      #FF
2562+ 6970 28 0D                jr      z,.full
2563+ 6972 ED 53 F6 BF          ld      (fdp_pointer),de
2564+ 6976 CD E0 BF             call    PAGE128
2565+ 6979 21 00 C0             ld      hl,ftp_dir_start
2566+ 697C              .ok:
2567+ 697C D1                   pop     de
2568+ 697D F1                   pop     af
2569+ 697E C9                   ret
2570+ 697F              .full:
2571+ 697F 1B                   dec     de
2572+ 6980 ED 53 F6 BF          ld      (fdp_pointer),de
2573+ 6984 21 FF FF             ld      hl,#FFFF
2574+ 6987 3E 01                ld      a,1
2575+ 6989 32 5C 86             ld      (dir128_parser_status),a
2576+ 698C D1                   pop     de
2577+ 698D F1                   pop     af
2578+ 698E C9                   ret
2579+ 698F
2580+ 698F              ;HL-- across #C000 -> #FFFF of the previous directory page.
2581+ 698F              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
2582+ 698F              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
2583+ 698F              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
2584+ 698F              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2585+ 698F              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
2586+ 698F              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2587+ 698F              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2588+ 698F              ; --- KONEC DOKUMENTACE CZ ---
2589+ 698F              DIR128_DEC_HL:
2590+ 698F F5                   push    af                      ;old DEC HL never changed A - preserve it here too
2591+ 6990 2B                   dec     hl
2592+ 6991 7C                   ld      a,h
2593+ 6992 FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
2594+ 6994 28 03                jr      z,DIR128_DEC_CROSS
2595+ 6996 F1                   pop     af
2596+ 6997 B7                   or      a                       ;restore A and return NC = OK
2597+ 6998 C9                   ret
2598+ 6999
2599+ 6999              DIR128_DEC_CROSS:
2600+ 6999 D5                   push    de
2601+ 699A ED 5B F6 BF          ld      de,(fdp_pointer)
2602+ 699E 1B                   dec     de
2603+ 699F 1A                   ld      a,(de)
2604+ 69A0 FE FF                cp      #FF
2605+ 69A2 28 0E                jr      z,DIR128_DEC_START
2606+ 69A4 ED 53 F6 BF          ld      (fdp_pointer),de
2607+ 69A8 CD E0 BF             call    PAGE128
2608+ 69AB 21 FF FF             ld      hl,#FFFF
2609+ 69AE D1                   pop     de
2610+ 69AF F1                   pop     af                      ;restore caller's A
2611+ 69B0 B7                   or      a                       ;NC = OK, A unchanged
2612+ 69B1 C9                   ret
2613+ 69B2              DIR128_DEC_START:
2614+ 69B2 13                   inc     de                      ;keep fdp_pointer on first valid page
2615+ 69B3 ED 53 F6 BF          ld      (fdp_pointer),de
2616+ 69B7 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
2617+ 69BA D1                   pop     de
2618+ 69BB F1                   pop     af                      ;restore caller's A
2619+ 69BC 37                   scf                             ;C = no previous directory page
2620+ 69BD C9                   ret
2621+ 69BE
2622+ 69BE              ;Map page-table pointer stored in DE. HL is preserved.
2623+ 69BE              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
2624+ 69BE              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
2625+ 69BE              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
2626+ 69BE              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
2627+ 69BE              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
2628+ 69BE              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
2629+ 69BE              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
2630+ 69BE              ; --- KONEC DOKUMENTACE CZ ---
2631+ 69BE              DIR128_MAP_DE:
2632+ 69BE F5                   push    af
2633+ 69BF ED 53 F6 BF          ld      (fdp_pointer),de
2634+ 69C3 1A                   ld      a,(de)
2635+ 69C4 CD E0 BF             call    PAGE128
2636+ 69C7 F1                   pop     af
2637+ 69C8 C9                   ret

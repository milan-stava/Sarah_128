2871+ 6B36              .dir_search_outer:
2872+ 6B36                      ;If remaining source length < pattern length, no further match exists.
2873+ 6B36 2A F3 6F             ld      hl,(dir_search_remaining)
2874+ 6B39 ED 5B F5 6F          ld      de,(dir_search_patlen)

 3450+6F6B 01 D0 70     		ld	bc,dr5_skip
 3451+6F6E 11 21 70     dr1		ld	de,dr_switch
 3452+6F71 12           		ld	(de),a
 3453+6F72 13           		inc	de
 3454+6F73 79           		ld	a,c
 3455+6F74 12           		ld	(de),a
 3456+6F75 13           		inc	de
 3457+6F76 78           		ld	a,b
 3458+6F77 12           		ld	(de),a

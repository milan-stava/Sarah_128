2952+ 69BC              ; -----------------------------------------------------------------------------
2953+ 69BC              ; search_by_Busy_fast
2954+ 69BC              ; Fast case-insensitive substring search for a name fully contained in the
2955+ 69BC              ; currently mapped 16K directory page.
2956+ 69BC              ;
2957+ 69BC              ; IN:  HL = name start, BC = 16-bit name length
2958+ 69BC              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
2959+ 69BC              ; OUT: Z = found, NZ = not found
2960+ 69BC              ;
2961+ 69BC              ; This is deliberately close to the original Busy FIND: the inner compare uses
2962+ 69BC              ; the Z80 CPI instruction.  The pattern has already been converted to lower
2963+ 69BC              ; case once by find_items, so only the source character needs convert here.
2964+ 69BC              ;
2965+ 69BC              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
2966+ 69BC              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
2967+ 69BC              ; matches therefore cannot be skipped.
2968+ 69BC              ; -----------------------------------------------------------------------------
2969+ 69BC              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
2970+ 69BC              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
2971+ 69BC              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
2972+ 69BC              ;   délka.
2973+ 69BC              ; Vystup: Z = shoda, NZ = nenalezeno.
2974+ 69BC              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2975+ 69BC              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
2976+ 69BC              ; --- KONEC DOKUMENTACE CZ ---
2977+ 69BC              search_by_Busy_fast:
2978+ 69BC EB                   ex      de,hl                   ;DE=current candidate in file name
2979+ 69BD
2980+ 69BD                      ; candidate_count = name_length - pattern_length + 1
2981+ 69BD 60                   ld      h,b
2982+ 69BE 69                   ld      l,c
2983+ 69BF ED 4B D3 76          ld      bc,(txtlen+1)
2984+ 69C3 78                   ld      a,b
2985+ 69C4 B1                   or      c
2986+ 69C5 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
2987+ 69C7 B7                   or      a
2988+ 69C8 ED 42                sbc     hl,bc
2989+ 69CA 38 25                jr      c,.fast_not_found       ;pattern longer than file name
2990+ 69CC 23                   inc     hl
2991+ 69CD
2992+ 69CD                      ; Keep number of possible candidate starts in alternate BC.
2993+ 69CD E5                   push    hl
2994+ 69CE D9                   exx
2995+ 69CF C1                   pop     bc
2996+ 69D0 D9                   exx
2997+ 69D1
2998+ 69D1              .fast_next_candidate:
2999+ 69D1 D5                   push    de                      ;remember exact candidate start
3000+ 69D2 21 7C 8B             ld      hl,INPBUFF
3001+ 69D5 ED 4B D3 76          ld      bc,(txtlen+1)
3002+ 69D9
3003+ 69D9              .fast_compare:
3004+ 69D9 1A                   ld      a,(de)
3005+ 69DA CD F7 76             call    convert                 ;source char -> lower case
3006+ 69DD ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
3007+ 69DF 13                   inc     de
3008+ 69E0 20 06                jr      nz,.fast_candidate_failed
3009+ 69E2 EA D9 69             jp      pe,.fast_compare        ;matched, more pattern bytes remain
3010+ 69E5
3011+ 69E5 D1                   pop     de                      ;discard saved candidate start
3012+ 69E6              .fast_found:
3013+ 69E6 AF                   xor     a                       ;Z = found
3014+ 69E7 C9                   ret
3015+ 69E8
3016+ 69E8              .fast_candidate_failed:
3017+ 69E8 D1                   pop     de                      ;restore previous candidate start
3018+ 69E9 13                   inc     de                      ;next candidate = previous + 1
3019+ 69EA D9                   exx
3020+ 69EB 0B                   dec     bc
3021+ 69EC 78                   ld      a,b
3022+ 69ED B1                   or      c
3023+ 69EE D9                   exx
3024+ 69EF 20 E0                jr      nz,.fast_next_candidate
3025+ 69F1
3026+ 69F1              .fast_not_found:
3027+ 69F1 3E 01                ld      a,1
3028+ 69F3 B7                   or      a                       ;NZ = not found
3029+ 69F4 C9                   ret

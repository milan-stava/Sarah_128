6001+ 788D              ; Ucel: Zapíše 16bitové číslo jako desetinný text bez úvodních nul.
6002+ 788D              ; Vstup: HL = číslo, DE = cílový buffer; IX = flag1.
6003+ 788D              ; Vystup: DE za poslední číslicí; HL = zbytek jednotek.
6004+ 788D              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
6005+ 788D              ; Poznamka: Mění bit 7 v (IX+0); nepřidává nulový terminátor.
6006+ 788D              ; --- KONEC DOKUMENTACE CZ ---
6007+ 788D DD CB 00 BE  HL2ASCII		res 7,(IX+0)		;Leading zero suppression

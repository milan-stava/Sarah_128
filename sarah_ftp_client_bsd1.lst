2882+ 698A              ; -----------------------------------------------------------------------------
2883+ 698A              ; search_by_Busy_dir
2884+ 698A              ; Bank-safe replacement used by FIND for names returned by get_item_name.
2885+ 698A              ; IN:  HL = physical name start, BC = 16-bit name length
2886+ 698A              ;      item_name_page = bank companion for HL
2887+ 698A              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
2888+ 698A              ; OUT: Z=pattern found, NZ=not found
2889+ 698A              ; One-character input matches only the FIRST character of a name (quick jump).
2890+ 698A              ; Two or more characters use normal case-insensitive substring search. There is
2891+ 698A              ; no 255-byte directory-name limit; directory page crossings are transparent.
2892+ 698A              ; -----------------------------------------------------------------------------
2893+ 698A              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
2894+ 698A              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
2895+ 698A              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
2896+ 698A              ;   = délka vzoru.
2897+ 698A              ; Vystup: Z = shoda, NZ = nenalezeno.
2898+ 698A              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2899+ 698A              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
2900+ 698A              ; --- KONEC DOKUMENTACE CZ ---
2901+ 698A              search_by_Busy_dir:
2902+ 698A                      ; Empty name cannot contain a non-empty search pattern.
2903+ 698A 78                   ld      a,b
2904+ 698B B1                   or      c
2905+ 698C 28 2A                jr      z,.dir_search_not_found_fast
2906+ 698E
2907+ 698E                      ; Map the directory bank containing the first byte of the name ONCE.
2908+ 698E                      ; For the normal case the whole name is inside this one 16K bank and
2909+ 698E                      ; no further paging is needed during FIND.
2910+ 698E ED 5B 54 6E          ld      de,(item_name_page)
2911+ 6992 CD 66 69             call    DIR128_MAP_DE
2912+ 6995
2913+ 6995                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
2914+ 6995                      ; the first character of the file name.  Thus FIND "S" selects names
2915+ 6995                      ; beginning with S, while 2+ characters remain a substring search.
2916+ 6995                      ; This is also much faster for the common one-letter jump.
2917+ 6995 ED 5B D3 76          ld      de,(txtlen+1)
2918+ 6999 7A                   ld      a,d
2919+ 699A B7                   or      a
2920+ 699B 20 0F                jr      nz,.dir_search_len_ge2
2921+ 699D 7B                   ld      a,e
2922+ 699E FE 01                cp      1
2923+ 69A0 20 0A                jr      nz,.dir_search_len_ge2
2924+ 69A2 7E                   ld      a,(hl)
2925+ 69A3 CD F7 76             call    convert
2926+ 69A6 57                   ld      d,a
2927+ 69A7 3A 7C 8B             ld      a,(INPBUFF)             ;already normalized by find_items
2928+ 69AA BA                   cp      d                       ;Z=first character matches
2929+ 69AB C9                   ret

9767+ BFE0              ; Vstup: A = číslo banky 0–7 (použijí se spodní tři bity).
9768+ BFE0              ; Vystup: A = hodnota zapsaná na #7FFD a do PAGE128_STATE.
9769+ BFE0              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
9770+ BFE0              ; Poznamka: Volí 48K ROM, obrazovku v RAM 5; bit zámku stránkování nechává nulový.
9771+ BFE0              ; --- KONEC DOKUMENTACE CZ ---
9772+ BFE0              PAGE128:
9773+ BFE0 E6 07                and     %00000111
9774+ BFE2 F6 10                or      %00010000
9775+ BFE4 32 EF BF             ld      (PAGE128_STATE),a
9776+ BFE7 C5           	push	bc
9777+ BFE8 01 FD 7F             ld      bc,#7FFD
9778+ BFEB ED 79                out     (c),a
9779+ BFED C1           	pop	bc
9780+ BFEE C9                   ret
9781+ BFEF
9782+ BFEF              PAGE128_STATE:
9783+ BFEF 00                   db 0
9784+ BFF0
9785+ BFF0
9786+ BFF0              PAGE128_RESTORE:
9787+ BFF0
9788+ BFF0              ;definice stranek:
9789+ BFF0              ;ftp directory
9790+ BFF0              ;last_ftp_dir_page	equ	3
9791+ BFF0 FF 00 01 03  ftp_dir_page	defb	#FF,0,1,3,7,#FF	;sentinel on both sides for forward/backward movement
9791+ BFF4 07 FF
9792+ BFF6 F1 BF        fdp_pointer	defw	ftp_dir_page+1	;points to CURRENT mapped directory page entry
9793+ BFF8              dwnld_pag	equ	4
9794+ BFF8              ;download_page	defb	dwnld_pag
9795+ BFF8              program_page	equ	6		;zde budou PRINT, INPUT......
9796+ BFF8
9797+ BFF8
9798+ BFF8
9799+ BFF8
9800+ BFF8              ;To znamená napøíklad:
9801+ BFF8              ;		ld a,6
9802+ BFF8              ;		call PAGE128
9803+ BFF8
9804+ BFF8              ;total_len	equ $-code_
9805+ BFF8              total_len	equ $-start_ldir

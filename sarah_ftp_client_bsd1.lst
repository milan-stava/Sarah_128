2908+ 6B70 CD 8E 6A             call    DIR128_MAP_DE
2909+ 6B73 CD FF 69             call    DIR128_INC_HL
2910+ 6B76 38 16                jr      c,.dir_search_not_found
2911+ 6B78 22 EF 6F             ld      (dir_search_addr),hl
2912+ 6B7B ED 5B F6 BF          ld      de,(fdp_pointer)
2913+ 6B7F ED 53 F1 6F          ld      (dir_search_page),de
2914+ 6B83 2A F3 6F             ld      hl,(dir_search_remaining)
2915+ 6B86 2B                   dec     hl

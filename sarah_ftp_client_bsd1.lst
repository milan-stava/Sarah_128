2863+ 6B24 ED 5B E8 6F          ld      de,(item_name_page)
2864+ 6B28 ED 53 F1 6F          ld      (dir_search_page),de
2865+ 6B2C 2A 29 79             ld      hl,(txtlen+1)
2866+ 6B2F 22 F5 6F             ld      (dir_search_patlen),hl
2867+ 6B32 7C                   ld      a,h
2868+ 6B33 B5                   or      l
2869+ 6B34 28 56                jr      z,.dir_search_found

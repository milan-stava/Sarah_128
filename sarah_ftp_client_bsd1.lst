4014+ 70A4              ; item_add / item_sub - 128K bank-aware directory movement
4015+ 70A4              ;
4016+ 70A4              ; IN:
4017+ 70A4              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
4018+ 70A4              ;       DE = address of its 16-bit page-table-pointer companion
4019+ 70A4              ;
4020+ 70A4              ; Example:
4021+ 70A4              ;       ld bc,cur_item_addr
4022+ 70A4              ;       ld de,cur_item_addr_page
4023+ 70A4              ;       call item_add
4024+ 70A4              ;
4025+ 70A4              ; OUT:
4026+ 70A4              ;       Z  = cannot move (end/start of directory)
4027+ 70A4              ;       NZ = pointer + its bank companion were moved to adjacent item
4028+ 70A4              ;
4029+ 70A4              ; The address variable and page variable deliberately do NOT have to be adjacent.
4030+ 70A4              ; This keeps the original IX+... variable layout completely unchanged.
4031+ 70A4              ; The two-byte item length at either end of an item may itself cross a bank.
4032+ 70A4              ; -----------------------------------------------------------------------------
4033+ 70A4              ; --- DOKUMENTACE CZ: item_add ---
4034+ 70A4              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
4035+ 70A4              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
4036+ 70A4              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
4037+ 70A4              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
4038+ 70A4              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
4039+ 70A4              ; --- KONEC DOKUMENTACE CZ ---
4040+ 70A4              item_add
4041+ 70A4 ED 43 16 6F  		ld	(dir_op_addr_var),bc
4042+ 70A8 ED 53 18 6F  		ld	(dir_op_page_var),de

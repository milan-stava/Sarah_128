2617+ 69A7              ; -----------------------------------------------------------------------------
2618+ 69A7              ; DIR128_COPY_NAME_TO_DE
2619+ 69A7              ; Copy the name returned by get_item_name to fixed RAM.
2620+ 69A7              ; IN:  HL = physical source address in directory window
2621+ 69A7              ;      BC = 16-bit name length
2622+ 69A7              ;      DE = fixed-RAM destination
2623+ 69A7              ;      item_name_page = page-table pointer belonging to HL
2624+ 69A7              ; OUT: DE points behind copied bytes, BC=0
2625+ 69A7              ; The source may cross any #FFFF -> #C000 directory-page boundary.
2626+ 69A7              ; -----------------------------------------------------------------------------
2627+ 69A7              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
2628+ 69A7              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
2629+ 69A7              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
2630+ 69A7              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
2631+ 69A7              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2632+ 69A7              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
2633+ 69A7              ; --- KONEC DOKUMENTACE CZ ---
2634+ 69A7              DIR128_COPY_NAME_TO_DE:
2635+ 69A7 D5                   push    de
2636+ 69A8 ED 5B FE 6E          ld      de,(item_name_page)
2637+ 69AC CD 9C 69             call    DIR128_MAP_DE
2638+ 69AF D1                   pop     de
2639+ 69B0              .dir128_copy_loop:
2640+ 69B0 78                   ld      a,b
2641+ 69B1 B1                   or      c
2642+ 69B2 C8                   ret     z
2643+ 69B3 7E                   ld      a,(hl)
2644+ 69B4 12                   ld      (de),a
2645+ 69B5 13                   inc     de
2646+ 69B6 0B                   dec     bc
2647+ 69B7 78                   ld      a,b
2648+ 69B8 B1                   or      c
2649+ 69B9 C8                   ret     z
2650+ 69BA CD 0D 69             call    DIR128_INC_HL
2651+ 69BD D8                   ret     c                       ;should only happen on malformed item
2652+ 69BE 18 F0                jr      .dir128_copy_loop

2787+ 6A7D              ; search_by_Busy_dir
2788+ 6A7D              ; Bank-safe replacement used by FIND for names returned by get_item_name.
2789+ 6A7D              ; IN:  HL = physical name start, BC = 16-bit name length
2790+ 6A7D              ;      item_name_page = bank companion for HL
2791+ 6A7D              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
2792+ 6A7D              ; OUT: Z=pattern found, NZ=not found
2793+ 6A7D              ; One-character input matches only the FIRST character of a name (quick jump).
2794+ 6A7D              ; Two or more characters use normal case-insensitive substring search. There is
2795+ 6A7D              ; no 255-byte directory-name limit; directory page crossings are transparent.
2796+ 6A7D              ; -----------------------------------------------------------------------------
2797+ 6A7D              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
2798+ 6A7D              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
2799+ 6A7D              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
2800+ 6A7D              ;   = délka vzoru.
2801+ 6A7D              ; Vystup: Z = shoda, NZ = nenalezeno.
2802+ 6A7D              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2803+ 6A7D              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
2804+ 6A7D              ; --- KONEC DOKUMENTACE CZ ---
2805+ 6A7D              search_by_Busy_dir:
2806+ 6A7D                      ; Empty name cannot contain a non-empty search pattern.
2807+ 6A7D 78                   ld      a,b
2808+ 6A7E B1                   or      c
2809+ 6A7F 28 2A                jr      z,.dir_search_not_found_fast
2810+ 6A81
2811+ 6A81                      ; Map the directory bank containing the first byte of the name ONCE.
2812+ 6A81                      ; For the normal case the whole name is inside this one 16K bank and
2813+ 6A81                      ; no further paging is needed during FIND.
2814+ 6A81 ED 5B B6 6F          ld      de,(item_name_page)
2815+ 6A85 CD 59 6A             call    DIR128_MAP_DE
2816+ 6A88
2817+ 6A88                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
2818+ 6A88                      ; the first character of the file name.  Thus FIND "S" selects names
2819+ 6A88                      ; beginning with S, while 2+ characters remain a substring search.
2820+ 6A88                      ; This is also much faster for the common one-letter jump.
2821+ 6A88 ED 5B A3 78          ld      de,(txtlen+1)
2822+ 6A8C 7A                   ld      a,d
2823+ 6A8D B7                   or      a

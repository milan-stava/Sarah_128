2879+ 6A8E
2880+ 6A8E              .dir_search_cmp:
2881+ 6A8E 7E                   ld      a,(hl)
2882+ 6A8F CD F3 77             call    convert                 ;source char -> lower case
2883+ 6A92 EB                   ex      de,hl
2884+ 6A93 BE                   cp      (hl)                    ;pattern already normalized by FIND
2885+ 6A94 EB                   ex      de,hl
2886+ 6A95 20 0D                jr      nz,.dir_search_advance_candidate
2887+ 6A97
2888+ 6A97 13                   inc     de
2889+ 6A98 0B                   dec     bc
2890+ 6A99 78                   ld      a,b
2891+ 6A9A B1                   or      c
2892+ 6A9B 28 2A                jr      z,.dir_search_found
2893+ 6A9D CD 3A 69             call    DIR128_INC_HL
2894+ 6AA0 38 27                jr      c,.dir_search_not_found

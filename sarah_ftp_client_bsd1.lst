2637+ 68B3              ; -----------------------------------------------------------------------------
2638+ 68B3              ; FTP DIRECTORY BANK API
2639+ 68B3              ;
2640+ 68B3              ; fdp_pointer always points to the table byte of the CURRENT directory page.
2641+ 68B3              ; ftp_dir_page has #FF sentinels on both sides:
2642+ 68B3              ;       #FF, 0, 1, 3, 7, #FF
2643+ 68B3              ;
2644+ 68B3              ; HL is always a physical address in the banked window #C000-#FFFF.
2645+ 68B3              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
2646+ 68B3              ;
2647+ 68B3              ; OUT for INC/DEC:
2648+ 68B3              ;       NC = movement succeeded
2649+ 68B3              ;       C  = no next/previous directory page (64 KB boundary)
2650+ 68B3              ;
2651+ 68B3              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
2652+ 68B3              ; which preserves AF/BC/DE/IX/IY exactly.
2653+ 68B3              ; -----------------------------------------------------------------------------
2654+ 68B3
2655+ 68B3              ; --- DOKUMENTACE CZ: DIR128_MAP_CURRENT ---
2656+ 68B3              ; Ucel: Namapuje aktuální banku adresáře do #C000–#FFFF.
2657+ 68B3              ; Vstup: fdp_pointer ukazuje do tabulky ftp_dir_page.
2658+ 68B3              ; Vystup: NC = platná banka, C = sentinel #FF.
2659+ 68B3              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
2660+ 68B3              ; Poznamka: Mění PAGE128_STATE a port #7FFD.
2661+ 68B3              ; --- KONEC DOKUMENTACE CZ ---
2662+ 68B3              DIR128_MAP_CURRENT:
2663+ 68B3 E5                   push    hl
2664+ 68B4 D5                   push    de
2665+ 68B5 ED 5B F6 BF          ld      de,(fdp_pointer)
2666+ 68B9 1A                   ld      a,(de)
2667+ 68BA FE FF                cp      #FF
2668+ 68BC 28 07                jr      z,DIR128_MAP_BAD
2669+ 68BE CD E0 BF             call    PAGE128
2670+ 68C1 D1                   pop     de
2671+ 68C2 E1                   pop     hl
2672+ 68C3 B7                   or      a                       ;NC = valid page
2673+ 68C4 C9                   ret
2674+ 68C5              DIR128_MAP_BAD:
2675+ 68C5 D1                   pop     de
2676+ 68C6 E1                   pop     hl
2677+ 68C7 37                   scf
2678+ 68C8 C9                   ret
2679+ 68C9
2680+ 68C9              ;Select first FTP directory page (page 0).
2681+ 68C9              ; --- DOKUMENTACE CZ: DIR128_FIRST_PAGE ---
2682+ 68C9              ; Ucel: Vybere první banku adresáře (RAM 0).
2683+ 68C9              ; Vstup: Bez parametrů.
2684+ 68C9              ; Vystup: fdp_pointer = ftp_dir_page+1; NC.
2685+ 68C9              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
2686+ 68C9              ; Poznamka: Mění mapování RAM a PAGE128_STATE.
2687+ 68C9              ; --- KONEC DOKUMENTACE CZ ---
2688+ 68C9              DIR128_FIRST_PAGE:
2689+ 68C9 E5                   push    hl
2690+ 68CA 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
2691+ 68CD 22 F6 BF             ld      (fdp_pointer),hl
2692+ 68D0 7E                   ld      a,(hl)
2693+ 68D1 CD E0 BF             call    PAGE128
2694+ 68D4 E1                   pop     hl
2695+ 68D5 B7                   or      a
2696+ 68D6 C9                   ret
2697+ 68D7
2698+ 68D7              ;HL++ across #FFFF -> #C000 of the next directory page.
2699+ 68D7              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
2700+ 68D7              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
2701+ 68D7              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
2702+ 68D7              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2703+ 68D7              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
2704+ 68D7              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2705+ 68D7              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2706+ 68D7              ; --- KONEC DOKUMENTACE CZ ---
2707+ 68D7              DIR128_INC_HL:
2708+ 68D7 F5                   push    af                      ;old INC HL never changed A - preserve it here too
2709+ 68D8 23                   inc     hl
2710+ 68D9 7C                   ld      a,h
2711+ 68DA B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
2712+ 68DB 28 03                jr      z,DIR128_INC_CROSS
2713+ 68DD F1                   pop     af
2714+ 68DE B7                   or      a                       ;restore A and return NC = OK
2715+ 68DF C9                   ret
2716+ 68E0
2717+ 68E0              DIR128_INC_CROSS:
2718+ 68E0 D5                   push    de
2719+ 68E1 ED 5B F6 BF          ld      de,(fdp_pointer)
2720+ 68E5 13                   inc     de
2721+ 68E6 1A                   ld      a,(de)
2722+ 68E7 FE FF                cp      #FF
2723+ 68E9 28 0E                jr      z,DIR128_INC_END
2724+ 68EB ED 53 F6 BF          ld      (fdp_pointer),de
2725+ 68EF CD E0 BF             call    PAGE128
2726+ 68F2 21 00 C0             ld      hl,ftp_dir_start        ;#C000
2727+ 68F5 D1                   pop     de
2728+ 68F6 F1                   pop     af                      ;restore caller's A
2729+ 68F7 B7                   or      a                       ;NC = OK, A unchanged
2730+ 68F8 C9                   ret
2731+ 68F9              DIR128_INC_END:
2732+ 68F9 1B                   dec     de                      ;keep fdp_pointer on last valid page
2733+ 68FA ED 53 F6 BF          ld      (fdp_pointer),de
2734+ 68FE 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
2735+ 6901 D1                   pop     de
2736+ 6902 F1                   pop     af                      ;restore caller's A
2737+ 6903 37                   scf                             ;C = no following directory page
2738+ 6904 C9                   ret
2739+ 6905
2740+ 6905              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
2741+ 6905              ;Unlike the general helper, this preserves the COMPLETE parser state:
2742+ 6905              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
2743+ 6905              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
2744+ 6905              ;  dir128_parser_status = 0  OK
2745+ 6905              ;  dir128_parser_status = 1  no next directory page
2746+ 6905              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
2747+ 6905              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
2748+ 6905              ; Vstup: HL = adresa v aktuální bance adresáře.
2749+ 6905              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
2750+ 6905              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
2751+ 6905              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
2752+ 6905              ; --- KONEC DOKUMENTACE CZ ---
2753+ 6905              DIR128_INC_HL_PARSER:
2754+ 6905 F5                   push    af
2755+ 6906 D5                   push    de
2756+ 6907 AF                   xor     a
2757+ 6908 32 CA 84             ld      (dir128_parser_status),a
2758+ 690B 23                   inc     hl
2759+ 690C 7C                   ld      a,h
2760+ 690D B7                   or      a
2761+ 690E 20 14                jr      nz,.ok
2762+ 6910 ED 5B F6 BF          ld      de,(fdp_pointer)
2763+ 6914 13                   inc     de
2764+ 6915 1A                   ld      a,(de)
2765+ 6916 FE FF                cp      #FF
2766+ 6918 28 0D                jr      z,.full
2767+ 691A ED 53 F6 BF          ld      (fdp_pointer),de
2768+ 691E CD E0 BF             call    PAGE128
2769+ 6921 21 00 C0             ld      hl,ftp_dir_start
2770+ 6924              .ok:
2771+ 6924 D1                   pop     de
2772+ 6925 F1                   pop     af
2773+ 6926 C9                   ret
2774+ 6927              .full:
2775+ 6927 1B                   dec     de
2776+ 6928 ED 53 F6 BF          ld      (fdp_pointer),de
2777+ 692C 21 FF FF             ld      hl,#FFFF
2778+ 692F 3E 01                ld      a,1
2779+ 6931 32 CA 84             ld      (dir128_parser_status),a
2780+ 6934 D1                   pop     de
2781+ 6935 F1                   pop     af
2782+ 6936 C9                   ret
2783+ 6937
2784+ 6937              ;HL-- across #C000 -> #FFFF of the previous directory page.
2785+ 6937              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
2786+ 6937              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
2787+ 6937              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
2788+ 6937              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2789+ 6937              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
2790+ 6937              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2791+ 6937              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2792+ 6937              ; --- KONEC DOKUMENTACE CZ ---

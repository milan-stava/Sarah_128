4243+ 7029 72           		ld	(hl),d
4244+ 702A
4245+ 702A              		;Leave the bank containing the new item mapped.
4246+ 702A CD 66 69     		call	DIR128_MAP_DE
4247+ 702D 3E 01        		ld	a,1
4248+ 702F B7           		or	a			;NZ, NC
4249+ 7030 C9           		ret
4250+ 7031
4251+ 7031              item_add_end

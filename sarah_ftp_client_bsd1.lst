2931+ 69AC              .dir_search_len_ge2:
2932+ 69AC                      ; Is the LAST byte of the name still inside the same physical window?
2933+ 69AC                      ; last = HL + BC - 1
2934+ 69AC                      ; Carry means that the name crosses #FFFF -> #C000, therefore use the
2935+ 69AC                      ; fully bank-safe (but slower) routine below.
2936+ 69AC E5                   push    hl
2937+ 69AD C5                   push    bc
2938+ 69AE 0B                   dec     bc
2939+ 69AF 09                   add     hl,bc
2940+ 69B0 C1                   pop     bc
2941+ 69B1 E1                   pop     hl
2942+ 69B2 DA F5 69             jp      c,search_by_Busy_dir_slow
2943+ 69B5
2944+ 69B5 C3 BC 69             jp      search_by_Busy_fast

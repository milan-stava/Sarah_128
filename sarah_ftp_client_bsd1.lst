6075+ 78CA 09           			add hl,bc
6076+ 78CB FE 30        			CP '0'
6077+ 78CD 28 04        			JR Z,string_store
6078+ 78CF
6079+ 78CF DD CB 00 FE  			SET 7,(IX+0)		;Had something other than zero
6080+ 78D3
6081+ 78D3 DD CB 00 7E  string_store:		BIT 7,(IX+0)		;Test if still leading zeros
6082+ 78D7 C8           			RET Z
6083+ 78D8 12           			LD (DE),A		;If not store it
6084+ 78D9 13           			INC DE
6085+ 78DA C9           			RET

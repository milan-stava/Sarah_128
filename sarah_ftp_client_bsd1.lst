 4548+74BE              item_sub_lenloop
 4549+74BE 7A           		ld	a,d
 4550+74BF B3           		or	e
 4551+74C0 28 08        		jr	z,item_sub_header
 4552+74C2 CD F9 6D     		call	DIR128_DEC_HL

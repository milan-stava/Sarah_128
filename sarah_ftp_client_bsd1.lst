 6574+7BCC              ; --- DOKUMENTACE CZ: convASCII2hex ---
 6575+7BCC              ; Ucel: Složí dolní půlbajty dvou znaků do jednoho bajtu.
 6576+7BCC              ; Vstup: HL = adresa dvou ASCII číslic, např. "14".
 6577+7BCC              ; Vystup: A = #14 pro vstup "14"; HL ukazuje na druhý znak.
 6578+7BCC              ; Meni: AF, E, HL; D, BC, IX a IY zachovány.
 6579+7BCC              ; Poznamka: Není obecný hexadecimální parser: nepřevádí písmena A–F.
 6580+7BCC              ; --- KONEC DOKUMENTACE CZ ---
 6581+7BCC              convASCII2hex
 6582+7BCC              ;IN=HL ASCII number address (2 digits) eg. hl,14
 6583+7BCC              ;OUT=A=#14
 6584+7BCC 7E           		ld	a,(hl)
 6585+7BCD E6 0F        		and	%00001111
 6586+7BCF CB 27        		sla	a
 6587+7BD1 CB 27        		sla	a
 6588+7BD3 CB 27        		sla	a
 6589+7BD5 CB 27        		sla	a
 6590+7BD7 5F           		ld	e,a
 6591+7BD8 23           		inc	hl
 6592+7BD9 7E           		ld	a,(hl)
 6593+7BDA E6 0F        		and	%00001111
 6594+7BDC B3           		or	e
 6595+7BDD C9           		ret

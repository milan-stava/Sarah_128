 7670+7E0E              ; --- DOKUMENTACE CZ: error_handler ---
 7671+7E0E              ; Ucel: Zobrazí chybu, ukončí čekání a vrátí řízení na nejvyšší úroveň.
 7672+7E0E              ; Vstup: C = číslo chyby; inicializovaný hlavní zásobník.
 7673+7E0E              ; Vystup: Nevrací se běžně volajícímu: SP nastaví na basic_end-2.
 7674+7E0E              ; Meni: AF, BC, DE, HL, BC' (přes příjem odpovědi); další registry externích služeb viz jejich
 7675+7E0E              ;   rozhraní. SP.
 7676+7E0E              ; Poznamka: Obnovuje 3,5 MHz a vypíná pasivní příjem.
 7677+7E0E              ; --- KONEC DOKUMENTACE CZ ---
 7678+7E0E AF           error_handler xor a
 7679+7E0F 32 B2 A0                ld (upload_legacy_mode),a
 7680+7E12 C5                      push bc                ;preserve original error across clock switch
 7681+7E13 CD DD 81                call set_3_5mhz
 7682+7E16 C1                      pop bc
 7683+7E17 3A 42 7E                ld a,(error_recovering)
 7684+7E1A B7                      or a
 7685+7E1B 20 16                   jr nz,error_handler_exit ;cleanup itself failed: do not recurse again
 7686+7E1D 3C                      inc a
 7687+7E1E 32 42 7E                ld (error_recovering),a
 7688+7E21 CD 43 7E                call display_error
 7689+7E24 CD 03 7C                call wifi_unwait
 7690+7E27 CD B2 A4                call at_reset_stream
 7691+7E2A DD CB 00 76             bit 6,(ix+0)

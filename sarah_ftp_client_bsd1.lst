1048+ 62D9              ; --- DOKUMENTACE CZ: find_out_speed ---
1049+ 62D9              ; Ucel: Zjistí index aktuální rychlosti UART, případně rychlosti vyzkouší.
1050+ 62D9              ; Vstup: IX = flag1; dostupné služby get_baud/set_baud.
1051+ 62D9              ; Vystup: D = index zjištěné rychlosti při úspěchu.
1052+ 62D9              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
1053+ 62D9              ; Poznamka: Při nepodporovaném get_baud používá switch_speed; jeho neúspěch nepovažujte za
1054+ 62D9              ;   platnou rychlost.
1055+ 62D9              ; --- KONEC DOKUMENTACE CZ ---
1056+ 62D9              find_out_speed
1057+ 62D9 CD F0 A5             call get_baud
1058+ 62DC 30 06                jr nc,.known
1059+ 62DE CD ED 62             call switch_speed
1060+ 62E1 20 08                jr nz,.failed
1061+ 62E3 7A                   ld a,d
1062+ 62E4 FE 18        .known  cp 24
1063+ 62E6 30 03                jr nc,.failed
1064+ 62E8 57                   ld d,a
1065+ 62E9 B7                   or a
1066+ 62EA C9                   ret
1067+ 62EB 37           .failed scf
1068+ 62EC C9                   ret
1069+ 62ED              						;tests speeds <7-0>, then <max-8>

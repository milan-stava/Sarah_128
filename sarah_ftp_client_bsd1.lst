6125+ 779F              ; --- DOKUMENTACE CZ: HL2ASCII ---
6126+ 779F              ; Ucel: Zapíše 16bitové číslo jako desetinný text bez úvodních nul.
6127+ 779F              ; Vstup: HL = číslo, DE = cílový buffer; IX = flag1.
6128+ 779F              ; Vystup: DE za poslední číslicí; HL = zbytek jednotek.
6129+ 779F              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
6130+ 779F              ; Poznamka: Mění bit 7 v (IX+0); nepřidává nulový terminátor.
6131+ 779F              ; --- KONEC DOKUMENTACE CZ ---
6132+ 779F DD CB 00 BE  HL2ASCII		res 7,(IX+0)		;Leading zero suppression

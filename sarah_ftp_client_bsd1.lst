7569+ 7D97 CD 44 82                call passive_receive_off ;one best-effort cleanup attempt only
7570+ 7D9A              error_handler_exit
7571+ 7D9A AF                      xor a
7572+ 7D9B 32 A9 7D                ld (error_recovering),a
7573+ 7D9E DD CB 00 76             bit 6,(ix+0)
7574+ 7DA2 CA 04 77                jp z,quit_keep_directory
7575+ 7DA5 31 FE 5F                ld sp,basic_end-2
7576+ 7DA8 C9                      ret
7577+ 7DA9 00           error_recovering db 0

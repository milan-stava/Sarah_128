2449+ 6915              ; -----------------------------------------------------------------------------
2450+ 6915              ; FTP DIRECTORY BANK API
2451+ 6915              ;
2452+ 6915              ; fdp_pointer always points to the table byte of the CURRENT directory page.
2453+ 6915              ; ftp_dir_page has #FF sentinels on both sides:
2454+ 6915              ;       #FF, 0, 1, 3, 7, #FF
2455+ 6915              ;
2456+ 6915              ; HL is always a physical address in the banked window #C000-#FFFF.
2457+ 6915              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
2458+ 6915              ;
2459+ 6915              ; OUT for INC/DEC:
2460+ 6915              ;       NC = movement succeeded
2461+ 6915              ;       C  = no next/previous directory page (64 KB boundary)
2462+ 6915              ;
2463+ 6915              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
2464+ 6915              ; which preserves AF/BC/DE/IX/IY exactly.
2465+ 6915              ; -----------------------------------------------------------------------------
2466+ 6915
2467+ 6915              ; --- DOKUMENTACE CZ: DIR128_MAP_CURRENT ---
2468+ 6915              ; Ucel: Namapuje aktuální banku adresáře do #C000–#FFFF.
2469+ 6915              ; Vstup: fdp_pointer ukazuje do tabulky ftp_dir_page.
2470+ 6915              ; Vystup: NC = platná banka, C = sentinel #FF.
2471+ 6915              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
2472+ 6915              ; Poznamka: Mění PAGE128_STATE a port #7FFD.
2473+ 6915              ; --- KONEC DOKUMENTACE CZ ---
2474+ 6915              DIR128_MAP_CURRENT:
2475+ 6915 E5                   push    hl
2476+ 6916 D5                   push    de
2477+ 6917 ED 5B F6 BF          ld      de,(fdp_pointer)
2478+ 691B 1A                   ld      a,(de)
2479+ 691C FE FF                cp      #FF
2480+ 691E 28 07                jr      z,DIR128_MAP_BAD
2481+ 6920 CD E0 BF             call    PAGE128
2482+ 6923 D1                   pop     de
2483+ 6924 E1                   pop     hl
2484+ 6925 B7                   or      a                       ;NC = valid page
2485+ 6926 C9                   ret
2486+ 6927              DIR128_MAP_BAD:
2487+ 6927 D1                   pop     de
2488+ 6928 E1                   pop     hl
2489+ 6929 37                   scf
2490+ 692A C9                   ret
2491+ 692B
2492+ 692B              ;Select first FTP directory page (page 0).
2493+ 692B              ; --- DOKUMENTACE CZ: DIR128_FIRST_PAGE ---
2494+ 692B              ; Ucel: Vybere první banku adresáře (RAM 0).
2495+ 692B              ; Vstup: Bez parametrů.
2496+ 692B              ; Vystup: fdp_pointer = ftp_dir_page+1; NC.
2497+ 692B              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
2498+ 692B              ; Poznamka: Mění mapování RAM a PAGE128_STATE.
2499+ 692B              ; --- KONEC DOKUMENTACE CZ ---
2500+ 692B              DIR128_FIRST_PAGE:
2501+ 692B E5                   push    hl
2502+ 692C 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
2503+ 692F 22 F6 BF             ld      (fdp_pointer),hl
2504+ 6932 7E                   ld      a,(hl)
2505+ 6933 CD E0 BF             call    PAGE128
2506+ 6936 E1                   pop     hl
2507+ 6937 B7                   or      a
2508+ 6938 C9                   ret
2509+ 6939
2510+ 6939              ;HL++ across #FFFF -> #C000 of the next directory page.
2511+ 6939              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
2512+ 6939              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
2513+ 6939              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
2514+ 6939              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2515+ 6939              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
2516+ 6939              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2517+ 6939              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2518+ 6939              ; --- KONEC DOKUMENTACE CZ ---
2519+ 6939              DIR128_INC_HL:
2520+ 6939 F5                   push    af                      ;old INC HL never changed A - preserve it here too
2521+ 693A 23                   inc     hl
2522+ 693B 7C                   ld      a,h
2523+ 693C B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
2524+ 693D 28 03                jr      z,DIR128_INC_CROSS
2525+ 693F F1                   pop     af
2526+ 6940 B7                   or      a                       ;restore A and return NC = OK
2527+ 6941 C9                   ret
2528+ 6942
2529+ 6942              DIR128_INC_CROSS:
2530+ 6942 D5                   push    de
2531+ 6943 ED 5B F6 BF          ld      de,(fdp_pointer)
2532+ 6947 13                   inc     de
2533+ 6948 1A                   ld      a,(de)
2534+ 6949 FE FF                cp      #FF
2535+ 694B 28 0E                jr      z,DIR128_INC_END
2536+ 694D ED 53 F6 BF          ld      (fdp_pointer),de
2537+ 6951 CD E0 BF             call    PAGE128
2538+ 6954 21 00 C0             ld      hl,ftp_dir_start        ;#C000
2539+ 6957 D1                   pop     de
2540+ 6958 F1                   pop     af                      ;restore caller's A
2541+ 6959 B7                   or      a                       ;NC = OK, A unchanged
2542+ 695A C9                   ret
2543+ 695B              DIR128_INC_END:
2544+ 695B 1B                   dec     de                      ;keep fdp_pointer on last valid page
2545+ 695C ED 53 F6 BF          ld      (fdp_pointer),de
2546+ 6960 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
2547+ 6963 D1                   pop     de
2548+ 6964 F1                   pop     af                      ;restore caller's A
2549+ 6965 37                   scf                             ;C = no following directory page
2550+ 6966 C9                   ret
2551+ 6967
2552+ 6967              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
2553+ 6967              ;Unlike the general helper, this preserves the COMPLETE parser state:
2554+ 6967              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
2555+ 6967              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
2556+ 6967              ;  dir128_parser_status = 0  OK
2557+ 6967              ;  dir128_parser_status = 1  no next directory page
2558+ 6967              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
2559+ 6967              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
2560+ 6967              ; Vstup: HL = adresa v aktuální bance adresáře.
2561+ 6967              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
2562+ 6967              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
2563+ 6967              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
2564+ 6967              ; --- KONEC DOKUMENTACE CZ ---
2565+ 6967              DIR128_INC_HL_PARSER:
2566+ 6967 F5                   push    af
2567+ 6968 D5                   push    de
2568+ 6969 AF                   xor     a
2569+ 696A 32 FD 86             ld      (dir128_parser_status),a
2570+ 696D 23                   inc     hl
2571+ 696E 7C                   ld      a,h
2572+ 696F B7                   or      a
2573+ 6970 20 14                jr      nz,.ok
2574+ 6972 ED 5B F6 BF          ld      de,(fdp_pointer)
2575+ 6976 13                   inc     de
2576+ 6977 1A                   ld      a,(de)
2577+ 6978 FE FF                cp      #FF
2578+ 697A 28 0D                jr      z,.full
2579+ 697C ED 53 F6 BF          ld      (fdp_pointer),de
2580+ 6980 CD E0 BF             call    PAGE128
2581+ 6983 21 00 C0             ld      hl,ftp_dir_start
2582+ 6986              .ok:
2583+ 6986 D1                   pop     de
2584+ 6987 F1                   pop     af
2585+ 6988 C9                   ret
2586+ 6989              .full:
2587+ 6989 1B                   dec     de
2588+ 698A ED 53 F6 BF          ld      (fdp_pointer),de
2589+ 698E 21 FF FF             ld      hl,#FFFF
2590+ 6991 3E 01                ld      a,1
2591+ 6993 32 FD 86             ld      (dir128_parser_status),a
2592+ 6996 D1                   pop     de
2593+ 6997 F1                   pop     af
2594+ 6998 C9                   ret
2595+ 6999
2596+ 6999              ;HL-- across #C000 -> #FFFF of the previous directory page.
2597+ 6999              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
2598+ 6999              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
2599+ 6999              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
2600+ 6999              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2601+ 6999              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
2602+ 6999              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2603+ 6999              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2604+ 6999              ; --- KONEC DOKUMENTACE CZ ---
2605+ 6999              DIR128_DEC_HL:
2606+ 6999 F5                   push    af                      ;old DEC HL never changed A - preserve it here too
2607+ 699A 2B                   dec     hl
2608+ 699B 7C                   ld      a,h
2609+ 699C FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
2610+ 699E 28 03                jr      z,DIR128_DEC_CROSS
2611+ 69A0 F1                   pop     af
2612+ 69A1 B7                   or      a                       ;restore A and return NC = OK
2613+ 69A2 C9                   ret
2614+ 69A3
2615+ 69A3              DIR128_DEC_CROSS:
2616+ 69A3 D5                   push    de
2617+ 69A4 ED 5B F6 BF          ld      de,(fdp_pointer)
2618+ 69A8 1B                   dec     de
2619+ 69A9 1A                   ld      a,(de)
2620+ 69AA FE FF                cp      #FF
2621+ 69AC 28 0E                jr      z,DIR128_DEC_START
2622+ 69AE ED 53 F6 BF          ld      (fdp_pointer),de
2623+ 69B2 CD E0 BF             call    PAGE128
2624+ 69B5 21 FF FF             ld      hl,#FFFF
2625+ 69B8 D1                   pop     de
2626+ 69B9 F1                   pop     af                      ;restore caller's A
2627+ 69BA B7                   or      a                       ;NC = OK, A unchanged
2628+ 69BB C9                   ret
2629+ 69BC              DIR128_DEC_START:
2630+ 69BC 13                   inc     de                      ;keep fdp_pointer on first valid page
2631+ 69BD ED 53 F6 BF          ld      (fdp_pointer),de
2632+ 69C1 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
2633+ 69C4 D1                   pop     de
2634+ 69C5 F1                   pop     af                      ;restore caller's A
2635+ 69C6 37                   scf                             ;C = no previous directory page
2636+ 69C7 C9                   ret
2637+ 69C8
2638+ 69C8              ;Map page-table pointer stored in DE. HL is preserved.
2639+ 69C8              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
2640+ 69C8              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
2641+ 69C8              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
2642+ 69C8              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
2643+ 69C8              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
2644+ 69C8              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
2645+ 69C8              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
2646+ 69C8              ; --- KONEC DOKUMENTACE CZ ---
2647+ 69C8              DIR128_MAP_DE:
2648+ 69C8 F5                   push    af
2649+ 69C9 ED 53 F6 BF          ld      (fdp_pointer),de
2650+ 69CD 1A                   ld      a,(de)
2651+ 69CE CD E0 BF             call    PAGE128
2652+ 69D1 F1                   pop     af
2653+ 69D2 C9                   ret
2654+ 69D3
2655+ 69D3
2656+ 69D3              ; -----------------------------------------------------------------------------
2657+ 69D3              ; DIR128_COPY_NAME_TO_DE
2658+ 69D3              ; Copy the name returned by get_item_name to fixed RAM.
2659+ 69D3              ; IN:  HL = physical source address in directory window
2660+ 69D3              ;      BC = 16-bit name length
2661+ 69D3              ;      DE = fixed-RAM destination
2662+ 69D3              ;      item_name_page = page-table pointer belonging to HL
2663+ 69D3              ; OUT: DE points behind copied bytes, BC=0
2664+ 69D3              ; The source may cross any #FFFF -> #C000 directory-page boundary.
2665+ 69D3              ; -----------------------------------------------------------------------------
2666+ 69D3              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
2667+ 69D3              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
2668+ 69D3              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
2669+ 69D3              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
2670+ 69D3              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2671+ 69D3              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
2672+ 69D3              ; --- KONEC DOKUMENTACE CZ ---
2673+ 69D3              DIR128_COPY_NAME_TO_DE:
2674+ 69D3 D5                   push    de
2675+ 69D4 ED 5B 21 6F          ld      de,(item_name_page)
2676+ 69D8 CD C8 69             call    DIR128_MAP_DE
2677+ 69DB D1                   pop     de
2678+ 69DC              .dir128_copy_loop:
2679+ 69DC 78                   ld      a,b
2680+ 69DD B1                   or      c
2681+ 69DE C8                   ret     z
2682+ 69DF 7E                   ld      a,(hl)
2683+ 69E0 12                   ld      (de),a
2684+ 69E1 13                   inc     de
2685+ 69E2 0B                   dec     bc
2686+ 69E3 78                   ld      a,b
2687+ 69E4 B1                   or      c
2688+ 69E5 C8                   ret     z
2689+ 69E6 CD 39 69             call    DIR128_INC_HL
2690+ 69E9 D8                   ret     c                       ;should only happen on malformed item
2691+ 69EA 18 F0                jr      .dir128_copy_loop
2692+ 69EC
2693+ 69EC
2694+ 69EC              ; -----------------------------------------------------------------------------
2695+ 69EC              ; search_by_Busy_dir
2696+ 69EC              ; Bank-safe replacement used by FIND for names returned by get_item_name.
2697+ 69EC              ; IN:  HL = physical name start, BC = 16-bit name length
2698+ 69EC              ;      item_name_page = bank companion for HL
2699+ 69EC              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
2700+ 69EC              ; OUT: Z=pattern found, NZ=not found
2701+ 69EC              ; One-character input matches only the FIRST character of a name (quick jump).
2702+ 69EC              ; Two or more characters use normal case-insensitive substring search. There is
2703+ 69EC              ; no 255-byte directory-name limit; directory page crossings are transparent.
2704+ 69EC              ; -----------------------------------------------------------------------------
2705+ 69EC              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
2706+ 69EC              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
2707+ 69EC              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
2708+ 69EC              ;   = délka vzoru.
2709+ 69EC              ; Vystup: Z = shoda, NZ = nenalezeno.
2710+ 69EC              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2711+ 69EC              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
2712+ 69EC              ; --- KONEC DOKUMENTACE CZ ---
2713+ 69EC              search_by_Busy_dir:
2714+ 69EC                      ; Empty name cannot contain a non-empty search pattern.
2715+ 69EC 78                   ld      a,b
2716+ 69ED B1                   or      c
2717+ 69EE 28 2A                jr      z,.dir_search_not_found_fast
2718+ 69F0
2719+ 69F0                      ; Map the directory bank containing the first byte of the name ONCE.
2720+ 69F0                      ; For the normal case the whole name is inside this one 16K bank and
2721+ 69F0                      ; no further paging is needed during FIND.
2722+ 69F0 ED 5B 21 6F          ld      de,(item_name_page)
2723+ 69F4 CD C8 69             call    DIR128_MAP_DE
2724+ 69F7
2725+ 69F7                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
2726+ 69F7                      ; the first character of the file name.  Thus FIND "S" selects names
2727+ 69F7                      ; beginning with S, while 2+ characters remain a substring search.
2728+ 69F7                      ; This is also much faster for the common one-letter jump.
2729+ 69F7 ED 5B D4 77          ld      de,(txtlen+1)
2730+ 69FB 7A                   ld      a,d
2731+ 69FC B7                   or      a
2732+ 69FD 20 0F                jr      nz,.dir_search_len_ge2
2733+ 69FF 7B                   ld      a,e
2734+ 6A00 FE 01                cp      1
2735+ 6A02 20 0A                jr      nz,.dir_search_len_ge2
2736+ 6A04 7E                   ld      a,(hl)
2737+ 6A05 CD F8 77             call    convert
2738+ 6A08 57                   ld      d,a
2739+ 6A09 3A B9 8D             ld      a,(INPBUFF)             ;already normalized by find_items
2740+ 6A0C BA                   cp      d                       ;Z=first character matches
2741+ 6A0D C9                   ret
2742+ 6A0E
2743+ 6A0E              .dir_search_len_ge2:
2744+ 6A0E                      ; Is the LAST byte of the name still inside the same physical window?
2745+ 6A0E                      ; last = HL + BC - 1
2746+ 6A0E                      ; Carry means that the name crosses #FFFF -> #C000, therefore use the
2747+ 6A0E                      ; fully bank-safe (but slower) routine below.
2748+ 6A0E E5                   push    hl
2749+ 6A0F C5                   push    bc
2750+ 6A10 0B                   dec     bc
2751+ 6A11 09                   add     hl,bc
2752+ 6A12 C1                   pop     bc
2753+ 6A13 E1                   pop     hl
2754+ 6A14 DA 57 6A             jp      c,search_by_Busy_dir_slow
2755+ 6A17
2756+ 6A17 C3 1E 6A             jp      search_by_Busy_fast
2757+ 6A1A
2758+ 6A1A              .dir_search_not_found_fast:
2759+ 6A1A 3E 01                ld      a,1
2760+ 6A1C B7                   or      a                       ;NZ
2761+ 6A1D C9                   ret

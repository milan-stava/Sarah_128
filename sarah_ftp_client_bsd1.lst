 1043+62D9              ; --- DOKUMENTACE CZ: find_out_speed ---
 1044+62D9              ; Ucel: Zjistí index aktuální rychlosti UART, případně rychlosti vyzkouší.
 1045+62D9              ; Vstup: IX = flag1; dostupné služby get_baud/set_baud.
 1046+62D9              ; Vystup: D = index zjištěné rychlosti při úspěchu.
 1047+62D9              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
 1048+62D9              ; Poznamka: Při nepodporovaném get_baud používá switch_speed; jeho neúspěch nepovažujte za
 1049+62D9              ;   platnou rychlost.
 1050+62D9              ; --- KONEC DOKUMENTACE CZ ---
 1051+62D9              find_out_speed
 1052+62D9 CD 65 A6             call get_baud
 1053+62DC 30 06                jr nc,.known
 1054+62DE CD ED 62             call switch_speed
 1055+62E1 20 08                jr nz,.failed
 1056+62E3 7A                   ld a,d
 1057+62E4 FE 18        .known  cp 24
 1058+62E6 30 03                jr nc,.failed
 1059+62E8 57                   ld d,a
 1060+62E9 B7                   or a
 1061+62EA C9                   ret
 1062+62EB 37           .failed scf
 1063+62EC C9                   ret

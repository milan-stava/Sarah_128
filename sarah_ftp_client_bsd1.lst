2529+ 6A0E 22 F6 BF             ld      (fdp_pointer),hl
2530+ 6A11 7E                   ld      a,(hl)
2531+ 6A12 CD E0 BF             call    PAGE128
2532+ 6A15 E1                   pop     hl
2533+ 6A16 B7                   or      a

 9051+84A7              ;89) get_item_name	;get file name under cursor
 9052+84A7              ;IN: current active callers use SCF. 128K parser always returns full info.
 9053+84A7              ;OUT=HL=name start, BC= name length, DE= file length
 9054+84A7              ;OUT=A=0= item is a directory+ HL, BC
 9055+84A7              ;OUT=A=1=item is a file+ HL, BC
 9056+84A7              ;OUT=A=2=item type cannot be determined (because of NLST command)+ HL, BC
 9057+84A7              ;OUT=A=3= item not parsed (for the moment) bacause it is LIST in full, HL, BC irrelevant
 9058+84A7              ;OUT=A=4= starting item ".."
 9059+84A7              ;bits 1 (items 0=abbreviated, 1= full) and 3 (current command type 0=LIST, 1=NLST) from flag_dir are of interest here
 9060+84A7              ; --- DOKUMENTACE CZ: get_item_name ---
 9061+84A7              ; Ucel: Rozebere aktuální položku adresáře a vrátí jméno a typ.
 9062+84A7              ; Vstup: cur_item_addr/cur_item_addr_page; IX=flag1; vstupní Carry se nevyužívá.
 9063+84A7              ; Vystup: HL=jméno, BC=délka, item_name_page=banka; DE=16bitová velikost u zkráceného LIST.
 9064+84A7              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 9065+84A7              ; Poznamka: A: 0 adresář, 1 soubor, 2 NLST (typ neznámý), 3 plný LIST/chybná položka, 4
 9066+84A7              ;   syntetické ..; pro A=3 nejsou HL/BC obecně platné.
 9067+84A7              ; --- KONEC DOKUMENTACE CZ ---
 9068+84A7              get_item_name
 9069+84A7              ;128K bank-safe parser.
 9070+84A7              ;IN: callers currently use SCF; C/NC is kept only for source compatibility.
 9071+84A7              ;OUT=HL=name start in banked directory RAM
 9072+84A7              ;    BC=16-bit name length
 9073+84A7              ;    DE=16-bit file length for LIST abbreviated (0 for NLST/"..")
 9074+84A7              ;    item_name_page=page-table pointer belonging to returned HL
 9075+84A7              ;OUT=A=0 directory, A=1 file, A=2 NLST unknown type,
 9076+84A7              ;      A=3 LIST full/malformed, A=4 synthetic ".."
 9077+84A7              ;
 9078+84A7              ;No temporary zero is written into the directory. The parser uses the stored
 9079+84A7              ;16-bit item length as its boundary, so an item/name may cross 16K pages and
 9080+84A7              ;may also be longer than 255 bytes.
 9081+84A7 2A A7 8E             ld      hl,(cur_item_addr)
 9082+84AA ED 5B FA 88          ld      de,(cur_item_addr_page)
 9083+84AE CD 26 6A             call    DIR128_MAP_DE
 9084+84B1
 9085+84B1                      ;Read item length LOW/HIGH. Even the length field may cross a page.
 9086+84B1 7E                   ld      a,(hl)
 9087+84B2 4F                   ld      c,a
 9088+84B3 CD 97 69             call    DIR128_INC_HL
 9089+84B6 DA 96 85             jp      c,gfn_bad
 9090+84B9 7E                   ld      a,(hl)

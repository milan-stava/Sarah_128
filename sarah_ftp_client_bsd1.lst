 251+ 0000              ;- ver 0.1	- login to ftp server (login+ pasword), done
 252+ 0000              ;		- find out file size, done
 253+ 0000              ;		- quit ftp connection, done
 254+ 0000              ;		- download file, in process
 255+ 0000              ;		- upload file, done
 256+ 0000
 257+ 0000              ;	output "zx_ftp_client"
 258+ 0000
 259+ 0000              ;set C=		SCF

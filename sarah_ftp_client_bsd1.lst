 6074+7A1B              ;16)
 6075+7A1B              ; --- DOKUMENTACE CZ: ConvRStr16 ---
 6076+7A1B              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
 6077+7A1B              ; Vstup: DE = začátek číslic.
 6078+7A1B              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
 6079+7A1B              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 6080+7A1B              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
 6081+7A1B              ;   přetečení; Z nemá pevný význam.
 6082+7A1B              ; --- KONEC DOKUMENTACE CZ ---
 6083+7A1B              ConvRStr16
 6084+7A1B              ;===============================================================
 6085+7A1B              ;http://z80-heaven.wikidot.com/math#toc32
 6086+7A1B              ;Input:
 6087+7A1B              ;     DE points to the base 10 number string in RAM.
 6088+7A1B              ;Outputs:
 6089+7A1B              ;     HL is the 16-bit value of the number
 6090+7A1B              ;     DE points to the byte after the number
 6091+7A1B              ;     BC is HL/10
 6092+7A1B              ;     z flag reset (nz)
 6093+7A1B              ;     c flag reset (nc)
 6094+7A1B              ;Destroys:
 6095+7A1B              ;     A (actually, add 30h and you get the ending token)
 6096+7A1B              ;Size:  23 bytes
 6097+7A1B              ;Speed: 104n+42+11c
 6098+7A1B              ;       n is the number of digits
 6099+7A1B              ;       c is at most n-2
 6100+7A1B              ;       at most 595 cycles for any 16-bit decimal value
 6101+7A1B              ;===============================================================
 6102+7A1B
 6103+7A1B 21 00 00          ld hl,0          ;  10 : 210000
 6104+7A1E              ConvLoop:             ;
 6105+7A1E 1A                ld a,(de)        ;   7 : 1A
 6106+7A1F D6 30             sub 30h          ;   7 : D630
 6107+7A21 FE 0A             cp 10            ;   7 : FE0A
 6108+7A23 D0                ret nc           ;5|11 : D0
 6109+7A24 13                inc de           ;   6 : 13
 6110+7A25                                    ;
 6111+7A25 44                ld b,h           ;   4 : 44
 6112+7A26 4D                ld c,l           ;   4 : 4D
 6113+7A27 29                add hl,hl        ;  11 : 29
 6114+7A28 29                add hl,hl        ;  11 : 29
 6115+7A29 09                add hl,bc        ;  11 : 09
 6116+7A2A 29                add hl,hl        ;  11 : 29
 6117+7A2B                                    ;
 6118+7A2B 85                add a,l          ;   4 : 85
 6119+7A2C 6F                ld l,a           ;   4 : 6F
 6120+7A2D 30 EF             jr nc,ConvLoop   ;12|23: 30EE
 6121+7A2F 24                inc h            ; --- : 24
 6122+7A30 18 EC             jr ConvLoop      ; --- : 18EB
 6123+7A32
 6124+7A32
 6125+7A32
 6126+7A32              ;17)
 6127+7A32              ;IN=HL=number, OUT=DE=address with the string
 6128+7A32              ; --- DOKUMENTACE CZ: HL2ASCII ---
 6129+7A32              ; Ucel: Zapíše 16bitové číslo jako desetinný text bez úvodních nul.
 6130+7A32              ; Vstup: HL = číslo, DE = cílový buffer; IX = flag1.
 6131+7A32              ; Vystup: DE za poslední číslicí; HL = zbytek jednotek.
 6132+7A32              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 6133+7A32              ; Poznamka: Mění bit 7 v (IX+0); nepřidává nulový terminátor.
 6134+7A32              ; --- KONEC DOKUMENTACE CZ ---
 6135+7A32 DD CB 00 BE  HL2ASCII		res 7,(IX+0)		;Leading zero suppression
 6136+7A36              ; --- DOKUMENTACE CZ: HL2ASCII_00000 ---
 6137+7A36              ; Ucel: Vstup do převodu od řádu desetitisíců, resp. stovek.
 6138+7A36              ; Vstup: HL = číslo, DE = cíl; bit 7 v (IX+0) řídí tisk úvodních nul.

2630+ 69C9              ;Map page-table pointer stored in DE. HL is preserved.
2631+ 69C9              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
2632+ 69C9              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
2633+ 69C9              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
2634+ 69C9              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
2635+ 69C9              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
2636+ 69C9              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
2637+ 69C9              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
2638+ 69C9              ; --- KONEC DOKUMENTACE CZ ---
2639+ 69C9              DIR128_MAP_DE:
2640+ 69C9 F5                   push    af
2641+ 69CA ED 53 F6 BF          ld      (fdp_pointer),de
2642+ 69CE 1A                   ld      a,(de)
2643+ 69CF CD E0 BF             call    PAGE128
2644+ 69D2 F1                   pop     af
2645+ 69D3 C9                   ret

 2883+6A8B
 2884+6A8B              ; -----------------------------------------------------------------------------
 2885+6A8B              ; search_by_Busy_dir_slow
 2886+6A8B              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
 2887+6A8B              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
 2888+6A8B              ; no longer slows down every ordinary FIND operation.
 2889+6A8B              ;
 2890+6A8B              ; One-character FIND is handled before this fallback and compares only the
 2891+6A8B              ; first character.  This slow path therefore normally handles 2+ character
 2892+6A8B              ; substring searches whose source name crosses a directory-bank boundary.
 2893+6A8B              ; -----------------------------------------------------------------------------
 2894+6A8B              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
 2895+6A8B              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
 2896+6A8B              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
 2897+6A8B              ;   a délka.
 2898+6A8B              ; Vystup: Z = shoda, NZ = nenalezeno.
 2899+6A8B              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 2900+6A8B              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
 2901+6A8B              ; --- KONEC DOKUMENTACE CZ ---
 2902+6A8B              search_by_Busy_dir_slow:
 2903+6A8B 22 5C 6F             ld      (dir_search_addr),hl
 2904+6A8E ED 43 60 6F          ld      (dir_search_remaining),bc
 2905+6A92 ED 5B 55 6F          ld      de,(item_name_page)
 2906+6A96 ED 53 5E 6F          ld      (dir_search_page),de
 2907+6A9A 2A 37 78             ld      hl,(txtlen+1)
 2908+6A9D 22 62 6F             ld      (dir_search_patlen),hl
 2909+6AA0 7C                   ld      a,h
 2910+6AA1 B5                   or      l
 2911+6AA2 28 56                jr      z,.dir_search_found
 2912+6AA4
 2913+6AA4              .dir_search_outer:
 2914+6AA4                      ;If remaining source length < pattern length, no further match exists.
 2915+6AA4 2A 60 6F             ld      hl,(dir_search_remaining)
 2916+6AA7 ED 5B 62 6F          ld      de,(dir_search_patlen)
 2917+6AAB B7                   or      a
 2918+6AAC ED 52                sbc     hl,de
 2919+6AAE 38 4C                jr      c,.dir_search_not_found
 2920+6AB0
 2921+6AB0                      ;Start one comparison at current candidate address/page.
 2922+6AB0 2A 5C 6F             ld      hl,(dir_search_addr)
 2923+6AB3 ED 5B 5E 6F          ld      de,(dir_search_page)
 2924+6AB7 CD FC 69             call    DIR128_MAP_DE
 2925+6ABA 11 C2 8E             ld      de,INPBUFF
 2926+6ABD ED 4B 62 6F          ld      bc,(dir_search_patlen)
 2927+6AC1
 2928+6AC1              .dir_search_cmp:
 2929+6AC1 7E                   ld      a,(hl)
 2930+6AC2 CD 5B 78             call    convert                 ;source char -> lower case
 2931+6AC5 EB                   ex      de,hl
 2932+6AC6 BE                   cp      (hl)                    ;pattern already normalized by FIND
 2933+6AC7 EB                   ex      de,hl
 2934+6AC8 20 0D                jr      nz,.dir_search_advance_candidate
 2935+6ACA
 2936+6ACA 13                   inc     de
 2937+6ACB 0B                   dec     bc
 2938+6ACC 78                   ld      a,b
 2939+6ACD B1                   or      c
 2940+6ACE 28 2A                jr      z,.dir_search_found
 2941+6AD0 CD 6D 69             call    DIR128_INC_HL
 2942+6AD3 38 27                jr      c,.dir_search_not_found
 2943+6AD5 18 EA                jr      .dir_search_cmp
 2944+6AD7
 2945+6AD7              .dir_search_advance_candidate:
 2946+6AD7                      ;Always advance by exactly ONE source character.  This fixes both the
 2947+6AD7                      ;old overlapping-match bug and the old one-character special case.
 2948+6AD7 2A 5C 6F             ld      hl,(dir_search_addr)
 2949+6ADA ED 5B 5E 6F          ld      de,(dir_search_page)
 2950+6ADE CD FC 69             call    DIR128_MAP_DE
 2951+6AE1 CD 6D 69             call    DIR128_INC_HL
 2952+6AE4 38 16                jr      c,.dir_search_not_found
 2953+6AE6 22 5C 6F             ld      (dir_search_addr),hl
 2954+6AE9 ED 5B F6 BF          ld      de,(fdp_pointer)
 2955+6AED ED 53 5E 6F          ld      (dir_search_page),de
 2956+6AF1 2A 60 6F             ld      hl,(dir_search_remaining)
 2957+6AF4 2B                   dec     hl
 2958+6AF5 22 60 6F             ld      (dir_search_remaining),hl
 2959+6AF8 18 AA                jr      .dir_search_outer
 2960+6AFA
 2961+6AFA              .dir_search_found:
 2962+6AFA AF                   xor     a                       ;Z
 2963+6AFB C9                   ret
 2964+6AFC              .dir_search_not_found:
 2965+6AFC 3E 01                ld      a,1
 2966+6AFE B7                   or      a                       ;NZ
 2967+6AFF C9                   ret

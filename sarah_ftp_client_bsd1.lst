 2929+6ADF              ; -----------------------------------------------------------------------------
 2930+6ADF              ; search_by_Busy_dir_slow
 2931+6ADF              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
 2932+6ADF              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
 2933+6ADF              ; no longer slows down every ordinary FIND operation.
 2934+6ADF              ;
 2935+6ADF              ; One-character FIND is handled before this fallback and compares only the
 2936+6ADF              ; first character.  This slow path therefore normally handles 2+ character
 2937+6ADF              ; substring searches whose source name crosses a directory-bank boundary.
 2938+6ADF              ; -----------------------------------------------------------------------------
 2939+6ADF              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
 2940+6ADF              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
 2941+6ADF              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
 2942+6ADF              ;   a délka.
 2943+6ADF              ; Vystup: Z = shoda, NZ = nenalezeno.
 2944+6ADF              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 2945+6ADF              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
 2946+6ADF              ; --- KONEC DOKUMENTACE CZ ---
 2947+6ADF              search_by_Busy_dir_slow:
 2948+6ADF 22 B4 6F             ld      (dir_search_addr),hl
 2949+6AE2 ED 43 B8 6F          ld      (dir_search_remaining),bc
 2950+6AE6 ED 5B AD 6F          ld      de,(item_name_page)
 2951+6AEA ED 53 B6 6F          ld      (dir_search_page),de
 2952+6AEE 2A 5D 79             ld      hl,(txtlen+1)
 2953+6AF1 22 BA 6F             ld      (dir_search_patlen),hl
 2954+6AF4 7C                   ld      a,h
 2955+6AF5 B5                   or      l
 2956+6AF6 28 56                jr      z,.dir_search_found
 2957+6AF8
 2958+6AF8              .dir_search_outer:
 2959+6AF8                      ;If remaining source length < pattern length, no further match exists.
 2960+6AF8 2A B8 6F             ld      hl,(dir_search_remaining)
 2961+6AFB ED 5B BA 6F          ld      de,(dir_search_patlen)
 2962+6AFF B7                   or      a
 2963+6B00 ED 52                sbc     hl,de
 2964+6B02 38 4C                jr      c,.dir_search_not_found
 2965+6B04
 2966+6B04                      ;Start one comparison at current candidate address/page.
 2967+6B04 2A B4 6F             ld      hl,(dir_search_addr)
 2968+6B07 ED 5B B6 6F          ld      de,(dir_search_page)
 2969+6B0B CD 50 6A             call    DIR128_MAP_DE
 2970+6B0E 11 8A 8F             ld      de,INPBUFF
 2971+6B11 ED 4B BA 6F          ld      bc,(dir_search_patlen)
 2972+6B15
 2973+6B15              .dir_search_cmp:
 2974+6B15 7E                   ld      a,(hl)
 2975+6B16 CD 81 79             call    convert                 ;source char -> lower case
 2976+6B19 EB                   ex      de,hl
 2977+6B1A BE                   cp      (hl)                    ;pattern already normalized by FIND
 2978+6B1B EB                   ex      de,hl
 2979+6B1C 20 0D                jr      nz,.dir_search_advance_candidate
 2980+6B1E
 2981+6B1E 13                   inc     de
 2982+6B1F 0B                   dec     bc
 2983+6B20 78                   ld      a,b
 2984+6B21 B1                   or      c
 2985+6B22 28 2A                jr      z,.dir_search_found
 2986+6B24 CD C1 69             call    DIR128_INC_HL
 2987+6B27 38 27                jr      c,.dir_search_not_found
 2988+6B29 18 EA                jr      .dir_search_cmp
 2989+6B2B
 2990+6B2B              .dir_search_advance_candidate:
 2991+6B2B                      ;Always advance by exactly ONE source character.  This fixes both the
 2992+6B2B                      ;old overlapping-match bug and the old one-character special case.
 2993+6B2B 2A B4 6F             ld      hl,(dir_search_addr)
 2994+6B2E ED 5B B6 6F          ld      de,(dir_search_page)
 2995+6B32 CD 50 6A             call    DIR128_MAP_DE
 2996+6B35 CD C1 69             call    DIR128_INC_HL
 2997+6B38 38 16                jr      c,.dir_search_not_found
 2998+6B3A 22 B4 6F             ld      (dir_search_addr),hl
 2999+6B3D ED 5B F6 BF          ld      de,(fdp_pointer)
 3000+6B41 ED 53 B6 6F          ld      (dir_search_page),de
 3001+6B45 2A B8 6F             ld      hl,(dir_search_remaining)
 3002+6B48 2B                   dec     hl
 3003+6B49 22 B8 6F             ld      (dir_search_remaining),hl
 3004+6B4C 18 AA                jr      .dir_search_outer
 3005+6B4E
 3006+6B4E              .dir_search_found:
 3007+6B4E AF                   xor     a                       ;Z
 3008+6B4F C9                   ret
 3009+6B50              .dir_search_not_found:
 3010+6B50 3E 01                ld      a,1
 3011+6B52 B7                   or      a                       ;NZ
 3012+6B53 C9                   ret

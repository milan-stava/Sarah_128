 2804+6A6C              .dir_search_len_ge2:
 2805+6A6C                      ; Is the LAST byte of the name still inside the same physical window?
 2806+6A6C                      ; last = HL + BC - 1
 2807+6A6C                      ; Carry means that the name crosses #FFFF -> #C000, therefore use the
 2808+6A6C                      ; fully bank-safe (but slower) routine below.
 2809+6A6C E5                   push    hl
 2810+6A6D C5                   push    bc
 2811+6A6E 0B                   dec     bc
 2812+6A6F 09                   add     hl,bc
 2813+6A70 C1                   pop     bc
 2814+6A71 E1                   pop     hl

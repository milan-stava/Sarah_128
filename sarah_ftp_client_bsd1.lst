4007+ 709B              ; item_add / item_sub - 128K bank-aware directory movement
4008+ 709B              ;
4009+ 709B              ; IN:
4010+ 709B              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
4011+ 709B              ;       DE = address of its 16-bit page-table-pointer companion
4012+ 709B              ;
4013+ 709B              ; Example:
4014+ 709B              ;       ld bc,cur_item_addr
4015+ 709B              ;       ld de,cur_item_addr_page
4016+ 709B              ;       call item_add
4017+ 709B              ;
4018+ 709B              ; OUT:
4019+ 709B              ;       Z  = cannot move (end/start of directory)
4020+ 709B              ;       NZ = pointer + its bank companion were moved to adjacent item
4021+ 709B              ;
4022+ 709B              ; The address variable and page variable deliberately do NOT have to be adjacent.
4023+ 709B              ; This keeps the original IX+... variable layout completely unchanged.
4024+ 709B              ; The two-byte item length at either end of an item may itself cross a bank.
4025+ 709B              ; -----------------------------------------------------------------------------
4026+ 709B              ; --- DOKUMENTACE CZ: item_add ---
4027+ 709B              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
4028+ 709B              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
4029+ 709B              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
4030+ 709B              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
4031+ 709B              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
4032+ 709B              ; --- KONEC DOKUMENTACE CZ ---
4033+ 709B              item_add
4034+ 709B ED 43 0D 6F  		ld	(dir_op_addr_var),bc
4035+ 709F ED 53 0F 6F  		ld	(dir_op_page_var),de

 3169+6E4C              ; -----------------------------------------------------------------------------
 3170+6E4C              ; search_by_Busy_dir
 3171+6E4C              ; Bank-safe replacement used by FIND for names returned by get_item_name.
 3172+6E4C              ; IN:  HL = physical name start, BC = 16-bit name length
 3173+6E4C              ;      item_name_page = bank companion for HL
 3174+6E4C              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
 3175+6E4C              ; OUT: Z=pattern found, NZ=not found
 3176+6E4C              ; One-character input matches only the FIRST character of a name (quick jump).
 3177+6E4C              ; Two or more characters use normal case-insensitive substring search. There is
 3178+6E4C              ; no 255-byte directory-name limit; directory page crossings are transparent.
 3179+6E4C              ; -----------------------------------------------------------------------------
 3180+6E4C              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
 3181+6E4C              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
 3182+6E4C              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
 3183+6E4C              ;   = délka vzoru.
 3184+6E4C              ; Vystup: Z = shoda, NZ = nenalezeno.
 3185+6E4C              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 3186+6E4C              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
 3187+6E4C              ; --- KONEC DOKUMENTACE CZ ---
 3188+6E4C              search_by_Busy_dir:
 3189+6E4C                      ; Empty name cannot contain a non-empty search pattern.
 3190+6E4C 78                   ld      a,b
 3191+6E4D B1                   or      c
 3192+6E4E 28 2A                jr      z,.dir_search_not_found_fast
 3193+6E50
 3194+6E50                      ; Map the directory bank containing the first byte of the name ONCE.
 3195+6E50                      ; For the normal case the whole name is inside this one 16K bank and
 3196+6E50                      ; no further paging is needed during FIND.
 3197+6E50 ED 5B BA 72          ld      de,(item_name_page)
 3198+6E54 CD 28 6E             call    DIR128_MAP_DE
 3199+6E57
 3200+6E57                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
 3201+6E57                      ; the first character of the file name.  Thus FIND "S" selects names
 3202+6E57                      ; beginning with S, while 2+ characters remain a substring search.
 3203+6E57                      ; This is also much faster for the common one-letter jump.
 3204+6E57 ED 5B 35 7B          ld      de,(txtlen+1)
 3205+6E5B 7A                   ld      a,d
 3206+6E5C B7                   or      a
 3207+6E5D 20 0F                jr      nz,.dir_search_len_ge2
 3208+6E5F 7B                   ld      a,e
 3209+6E60 FE 01                cp      1
 3210+6E62 20 0A                jr      nz,.dir_search_len_ge2
 3211+6E64 7E                   ld      a,(hl)
 3212+6E65 CD 59 7B             call    convert
 3213+6E68 57                   ld      d,a
 3214+6E69 3A CB 90             ld      a,(INPBUFF)             ;already normalized by find_items
 3215+6E6C BA                   cp      d                       ;Z=first character matches
 3216+6E6D C9                   ret
 3217+6E6E
 3218+6E6E              .dir_search_len_ge2:
 3219+6E6E                      ; Is the LAST byte of the name still inside the same physical window?
 3220+6E6E                      ; last = HL + BC - 1
 3221+6E6E                      ; Carry means that the name crosses #FFFF -> #C000, therefore use the
 3222+6E6E                      ; fully bank-safe (but slower) routine below.
 3223+6E6E E5                   push    hl
 3224+6E6F C5                   push    bc
 3225+6E70 0B                   dec     bc
 3226+6E71 09                   add     hl,bc
 3227+6E72 C1                   pop     bc
 3228+6E73 E1                   pop     hl
 3229+6E74 DA B7 6E             jp      c,search_by_Busy_dir_slow
 3230+6E77
 3231+6E77 C3 7E 6E             jp      search_by_Busy_fast
 3232+6E7A
 3233+6E7A              .dir_search_not_found_fast:
 3234+6E7A 3E 01                ld      a,1
 3235+6E7C B7                   or      a                       ;NZ
 3236+6E7D C9                   ret

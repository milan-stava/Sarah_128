2898+ 6AA4                      ;Always advance by exactly ONE source character.  This fixes both the
2899+ 6AA4                      ;old overlapping-match bug and the old one-character special case.
2900+ 6AA4 2A 29 6F             ld      hl,(dir_search_addr)
2901+ 6AA7 ED 5B 2B 6F          ld      de,(dir_search_page)
2902+ 6AAB CD C9 69             call    DIR128_MAP_DE
2903+ 6AAE CD 3A 69             call    DIR128_INC_HL
2904+ 6AB1 38 16                jr      c,.dir_search_not_found
2905+ 6AB3 22 29 6F             ld      (dir_search_addr),hl
2906+ 6AB6 ED 5B F6 BF          ld      de,(fdp_pointer)
2907+ 6ABA ED 53 2B 6F          ld      (dir_search_page),de
2908+ 6ABE 2A 2D 6F             ld      hl,(dir_search_remaining)
2909+ 6AC1 2B                   dec     hl
2910+ 6AC2 22 2D 6F             ld      (dir_search_remaining),hl

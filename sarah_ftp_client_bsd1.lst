 9558+86CF              ;89) get_item_name	;get file name under cursor
 9559+86CF              ;IN: current active callers use SCF. 128K parser always returns full info.
 9560+86CF              ;OUT=HL=name start, BC= name length, DE= file length
 9561+86CF              ;OUT=A=0= item is a directory+ HL, BC
 9562+86CF              ;OUT=A=1=item is a file+ HL, BC
 9563+86CF              ;OUT=A=2=item type cannot be determined (because of NLST command)+ HL, BC
 9564+86CF              ;OUT=A=3= item not parsed (for the moment) bacause it is LIST in full, HL, BC irrelevant

 2849+6AA6              ; -----------------------------------------------------------------------------
 2850+6AA6              ; search_by_Busy_fast
 2851+6AA6              ; Fast case-insensitive substring search for a name fully contained in the
 2852+6AA6              ; currently mapped 16K directory page.
 2853+6AA6              ;
 2854+6AA6              ; IN:  HL = name start, BC = 16-bit name length
 2855+6AA6              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
 2856+6AA6              ; OUT: Z = found, NZ = not found
 2857+6AA6              ;
 2858+6AA6              ; This is deliberately close to the original Busy FIND: the inner compare uses
 2859+6AA6              ; the Z80 CPI instruction.  The pattern has already been converted to lower
 2860+6AA6              ; case once by find_items, so only the source character needs convert here.
 2861+6AA6              ;
 2862+6AA6              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
 2863+6AA6              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
 2864+6AA6              ; matches therefore cannot be skipped.
 2865+6AA6              ; -----------------------------------------------------------------------------
 2866+6AA6              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
 2867+6AA6              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
 2868+6AA6              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
 2869+6AA6              ;   délka.
 2870+6AA6              ; Vystup: Z = shoda, NZ = nenalezeno.
 2871+6AA6              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 2872+6AA6              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
 2873+6AA6              ; --- KONEC DOKUMENTACE CZ ---
 2874+6AA6              search_by_Busy_fast:
 2875+6AA6 EB                   ex      de,hl                   ;DE=current candidate in file name
 2876+6AA7
 2877+6AA7                      ; candidate_count = name_length - pattern_length + 1
 2878+6AA7 60                   ld      h,b
 2879+6AA8 69                   ld      l,c
 2880+6AA9 ED 4B 5D 79          ld      bc,(txtlen+1)
 2881+6AAD 78                   ld      a,b
 2882+6AAE B1                   or      c
 2883+6AAF 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
 2884+6AB1 B7                   or      a
 2885+6AB2 ED 42                sbc     hl,bc
 2886+6AB4 38 25                jr      c,.fast_not_found       ;pattern longer than file name
 2887+6AB6 23                   inc     hl
 2888+6AB7
 2889+6AB7                      ; Keep number of possible candidate starts in alternate BC.
 2890+6AB7 E5                   push    hl
 2891+6AB8 D9                   exx
 2892+6AB9 C1                   pop     bc
 2893+6ABA D9                   exx
 2894+6ABB
 2895+6ABB              .fast_next_candidate:
 2896+6ABB D5                   push    de                      ;remember exact candidate start
 2897+6ABC 21 8A 8F             ld      hl,INPBUFF
 2898+6ABF ED 4B 5D 79          ld      bc,(txtlen+1)
 2899+6AC3
 2900+6AC3              .fast_compare:
 2901+6AC3 1A                   ld      a,(de)
 2902+6AC4 CD 81 79             call    convert                 ;source char -> lower case
 2903+6AC7 ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
 2904+6AC9 13                   inc     de
 2905+6ACA 20 06                jr      nz,.fast_candidate_failed
 2906+6ACC EA C3 6A             jp      pe,.fast_compare        ;matched, more pattern bytes remain
 2907+6ACF
 2908+6ACF D1                   pop     de                      ;discard saved candidate start
 2909+6AD0              .fast_found:
 2910+6AD0 AF                   xor     a                       ;Z = found
 2911+6AD1 C9                   ret
 2912+6AD2
 2913+6AD2              .fast_candidate_failed:
 2914+6AD2 D1                   pop     de                      ;restore previous candidate start
 2915+6AD3 13                   inc     de                      ;next candidate = previous + 1
 2916+6AD4 D9                   exx
 2917+6AD5 0B                   dec     bc
 2918+6AD6 78                   ld      a,b
 2919+6AD7 B1                   or      c
 2920+6AD8 D9                   exx
 2921+6AD9 20 E0                jr      nz,.fast_next_candidate
 2922+6ADB
 2923+6ADB              .fast_not_found:
 2924+6ADB 3E 01                ld      a,1
 2925+6ADD B7                   or      a                       ;NZ = not found
 2926+6ADE C9                   ret

 9631+86E9 ~            ; Meni: AF, DE, HL; BC, IX a IY zachovány.
 9632+86E9 ~            ; --- KONEC DOKUMENTACE CZ ---
 9633+86E9 ~            set_fdma_to_chars
 9634+86E9 ~            	push	bc
 9635+86E9 ~            	ld	hl,1	;1 bajt zkopiruj
 9636+86E9 ~            	ld	de,63	;...a 63 preskoc
 9637+86E9 ~            	ld	bc,8	;znak ma 8 bajtu
 9638+86E9 ~            	jr	sftc1
 9639+86E9 ~
 9640+86E9 ~            ;96)
 9641+86E9 ~            ; --- DOKUMENTACE CZ: set_fdma_to_fill_len_in_bc_512 ---
 9642+86E9 ~            ; Ucel: Nastaví FDMA pro souvislou výplň 512 bajtů.
 9643+86E9 ~            ; Vstup: Bez parametru délky: BC se pouze uchovává.
 9644+86E9 ~            ; Vystup: FD_Copy=0, FD_Mod=0, F_Len=512; HL=DE=0, A=0, Z, NC.
 9645+86E9 ~            ; Meni: AF, DE, HL; BC, IX a IY zachovány.
 9646+86E9 ~            ; Poznamka: Přes historický název a komentář se délka z BC nepoužívá.
 9647+86E9 ~            ; --- KONEC DOKUMENTACE CZ ---
 9648+86E9 ~            set_fdma_to_fill_len_in_bc_512
 9649+86E9 ~            ;IN=BC=length
 9650+86E9 ~            	push	bc
 9651+86E9 ~            	ld	hl,0
 9652+86E9 ~            	ld 	d,h
 9653+86E9 ~            	ld	e,h
 9654+86E9 ~            	ld	bc,512
 9655+86E9 ~
 9656+86E9 ~            sftc1	ld	(FDMAreg.FD_Copy),hl	;...a 63 pøeskoè.
 9657+86E9 ~            	ld	(FDMAreg.FD_Mod),de
 9658+86E9 ~            	ld	(FDMAreg.F_Len),bc
 9659+86E9 ~            	pop	bc
 9660+86E9 ~            	xor	a			;signal key 0 pressed, because of main keyboard routine
 9661+86E9 ~            	ret
 9662+86E9 ~
 9663+86E9 ~            ;97)
 9664+86E9 ~            ; --- DOKUMENTACE CZ: set_hgfx_ink_planar ---
 9665+86E9 ~            ; Ucel: Obnoví barvu a bitové roviny pro běžný tisk HGFX.
 9666+86E9 ~            ; Vstup: Bez parametrů.
 9667+86E9 ~            ; Vystup: VIDEO_REGS.COLOR=4, VIDEO_REGS.MASK=planar_pismo.
 9668+86E9 ~            ; Meni: A; F, BC, DE, HL, IX a IY zachovány.
 9669+86E9 ~            ; --- KONEC DOKUMENTACE CZ ---
 9670+86E9 ~            set_hgfx_ink_planar
 9671+86E9 ~            		ld 	a,4			;vrat puvodni
 9672+86E9 ~            		ld 	(VIDEO_REGS.COLOR),a
 9673+86E9 ~            ;		ld	a,63
 9674+86E9 ~            		ld	a,planar_pismo
 9675+86E9 ~            		ld	(VIDEO_REGS.MASK),a
 9676+86E9 ~            		ret
 9677+86E9 ~
 9678+86E9              	ENDIF

2702+ 6ACF                      ; Map the directory bank containing the first byte of the name ONCE.
2703+ 6ACF                      ; For the normal case the whole name is inside this one 16K bank and
2704+ 6ACF                      ; no further paging is needed during FIND.
2705+ 6ACF ED 5B 39 6F          ld      de,(item_name_page)
2706+ 6AD3 CD A7 6A             call    DIR128_MAP_DE
2707+ 6AD6
2708+ 6AD6                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
2709+ 6AD6                      ; the first character of the file name.  Thus FIND "S" selects names
2710+ 6AD6                      ; beginning with S, while 2+ characters remain a substring search.
2711+ 6AD6                      ; This is also much faster for the common one-letter jump.
2712+ 6AD6 ED 5B 06 78          ld      de,(txtlen+1)
2713+ 6ADA 7A                   ld      a,d
2714+ 6ADB B7                   or      a
2715+ 6ADC 20 0F                jr      nz,.dir_search_len_ge2
2716+ 6ADE 7B                   ld      a,e
2717+ 6ADF FE 01                cp      1

2489+ 69F4              ; -----------------------------------------------------------------------------
2490+ 69F4              ; FTP DIRECTORY BANK API
2491+ 69F4              ;
2492+ 69F4              ; fdp_pointer always points to the table byte of the CURRENT directory page.
2493+ 69F4              ; ftp_dir_page has #FF sentinels on both sides:
2494+ 69F4              ;       #FF, 0, 1, 3, 7, #FF
2495+ 69F4              ;
2496+ 69F4              ; HL is always a physical address in the banked window #C000-#FFFF.
2497+ 69F4              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
2498+ 69F4              ;
2499+ 69F4              ; OUT for INC/DEC:
2500+ 69F4              ;       NC = movement succeeded
2501+ 69F4              ;       C  = no next/previous directory page (64 KB boundary)
2502+ 69F4              ;
2503+ 69F4              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
2504+ 69F4              ; which preserves AF/BC/DE/IX/IY exactly.
2505+ 69F4              ; -----------------------------------------------------------------------------
2506+ 69F4
2507+ 69F4              DIR128_MAP_CURRENT:
2508+ 69F4 E5                   push    hl
2509+ 69F5 D5                   push    de
2510+ 69F6 ED 5B F6 BF          ld      de,(fdp_pointer)
2511+ 69FA 1A                   ld      a,(de)
2512+ 69FB FE FF                cp      #FF
2513+ 69FD 28 07                jr      z,DIR128_MAP_BAD
2514+ 69FF CD E0 BF             call    PAGE128

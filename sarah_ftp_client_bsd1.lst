2656+ 69C0              ; search_by_Busy_dir
2657+ 69C0              ; Bank-safe replacement used by FIND for names returned by get_item_name.
2658+ 69C0              ; IN:  HL = physical name start, BC = 16-bit name length
2659+ 69C0              ;      item_name_page = bank companion for HL
2660+ 69C0              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
2661+ 69C0              ; OUT: Z=pattern found, NZ=not found
2662+ 69C0              ; One-character input matches only the FIRST character of a name (quick jump).
2663+ 69C0              ; Two or more characters use normal case-insensitive substring search. There is
2664+ 69C0              ; no 255-byte directory-name limit; directory page crossings are transparent.
2665+ 69C0              ; -----------------------------------------------------------------------------
2666+ 69C0              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
2667+ 69C0              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
2668+ 69C0              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
2669+ 69C0              ;   = délka vzoru.
2670+ 69C0              ; Vystup: Z = shoda, NZ = nenalezeno.
2671+ 69C0              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2672+ 69C0              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
2673+ 69C0              ; --- KONEC DOKUMENTACE CZ ---
2674+ 69C0              search_by_Busy_dir:
2675+ 69C0                      ; Empty name cannot contain a non-empty search pattern.
2676+ 69C0 78                   ld      a,b
2677+ 69C1 B1                   or      c
2678+ 69C2 28 2A                jr      z,.dir_search_not_found_fast
2679+ 69C4
2680+ 69C4                      ; Map the directory bank containing the first byte of the name ONCE.
2681+ 69C4                      ; For the normal case the whole name is inside this one 16K bank and
2682+ 69C4                      ; no further paging is needed during FIND.
2683+ 69C4 ED 5B FE 6E          ld      de,(item_name_page)
2684+ 69C8 CD 9C 69             call    DIR128_MAP_DE
2685+ 69CB
2686+ 69CB                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
2687+ 69CB                      ; the first character of the file name.  Thus FIND "S" selects names
2688+ 69CB                      ; beginning with S, while 2+ characters remain a substring search.
2689+ 69CB                      ; This is also much faster for the common one-letter jump.
2690+ 69CB ED 5B A6 77          ld      de,(txtlen+1)
2691+ 69CF 7A                   ld      a,d
2692+ 69D0 B7                   or      a
2693+ 69D1 20 0F                jr      nz,.dir_search_len_ge2
2694+ 69D3 7B                   ld      a,e
2695+ 69D4 FE 01                cp      1
2696+ 69D6 20 0A                jr      nz,.dir_search_len_ge2
2697+ 69D8 7E                   ld      a,(hl)
2698+ 69D9 CD CA 77             call    convert
2699+ 69DC 57                   ld      d,a
2700+ 69DD 3A 24 8D             ld      a,(INPBUFF)             ;already normalized by find_items
2701+ 69E0 BA                   cp      d                       ;Z=first character matches
2702+ 69E1 C9                   ret
2703+ 69E2
2704+ 69E2              .dir_search_len_ge2:
2705+ 69E2                      ; Is the LAST byte of the name still inside the same physical window?
2706+ 69E2                      ; last = HL + BC - 1
2707+ 69E2                      ; Carry means that the name crosses #FFFF -> #C000, therefore use the
2708+ 69E2                      ; fully bank-safe (but slower) routine below.
2709+ 69E2 E5                   push    hl
2710+ 69E3 C5                   push    bc
2711+ 69E4 0B                   dec     bc
2712+ 69E5 09                   add     hl,bc
2713+ 69E6 C1                   pop     bc
2714+ 69E7 E1                   pop     hl
2715+ 69E8 DA 2B 6A             jp      c,search_by_Busy_dir_slow
2716+ 69EB
2717+ 69EB C3 F2 69             jp      search_by_Busy_fast
2718+ 69EE
2719+ 69EE              .dir_search_not_found_fast:
2720+ 69EE 3E 01                ld      a,1
2721+ 69F0 B7                   or      a                       ;NZ
2722+ 69F1 C9                   ret

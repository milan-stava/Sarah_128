4138+ 6FC1              ; -----------------------------------------------------------------------------
4139+ 6FC1              ; item_add / item_sub - 128K bank-aware directory movement
4140+ 6FC1              ;
4141+ 6FC1              ; IN:
4142+ 6FC1              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
4143+ 6FC1              ;       DE = address of its 16-bit page-table-pointer companion
4144+ 6FC1              ;
4145+ 6FC1              ; Example:
4146+ 6FC1              ;       ld bc,cur_item_addr
4147+ 6FC1              ;       ld de,cur_item_addr_page
4148+ 6FC1              ;       call item_add
4149+ 6FC1              ;
4150+ 6FC1              ; OUT:
4151+ 6FC1              ;       Z  = cannot move (end/start of directory)
4152+ 6FC1              ;       NZ = pointer + its bank companion were moved to adjacent item
4153+ 6FC1              ;
4154+ 6FC1              ; The address variable and page variable deliberately do NOT have to be adjacent.
4155+ 6FC1              ; This keeps the original IX+... variable layout completely unchanged.
4156+ 6FC1              ; The two-byte item length at either end of an item may itself cross a bank.
4157+ 6FC1              ; -----------------------------------------------------------------------------
4158+ 6FC1              ; --- DOKUMENTACE CZ: item_add ---
4159+ 6FC1              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
4160+ 6FC1              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
4161+ 6FC1              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
4162+ 6FC1              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
4163+ 6FC1              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
4164+ 6FC1              ; --- KONEC DOKUMENTACE CZ ---
4165+ 6FC1              item_add
4166+ 6FC1 ED 43 48 6E  		ld	(dir_op_addr_var),bc
4167+ 6FC5 ED 53 4A 6E  		ld	(dir_op_page_var),de
4168+ 6FC9
4169+ 6FC9              		;Load physical item address from *(BC).
4170+ 6FC9 60           		ld	h,b
4171+ 6FCA 69           		ld	l,c
4172+ 6FCB 5E           		ld	e,(hl)

2748+ 6A64              ; -----------------------------------------------------------------------------
2749+ 6A64              ; DIR128_COPY_NAME_TO_DE
2750+ 6A64              ; Copy the name returned by get_item_name to fixed RAM.
2751+ 6A64              ; IN:  HL = physical source address in directory window
2752+ 6A64              ;      BC = 16-bit name length
2753+ 6A64              ;      DE = fixed-RAM destination
2754+ 6A64              ;      item_name_page = page-table pointer belonging to HL
2755+ 6A64              ; OUT: DE points behind copied bytes, BC=0
2756+ 6A64              ; The source may cross any #FFFF -> #C000 directory-page boundary.
2757+ 6A64              ; -----------------------------------------------------------------------------
2758+ 6A64              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
2759+ 6A64              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
2760+ 6A64              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
2761+ 6A64              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
2762+ 6A64              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2763+ 6A64              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
2764+ 6A64              ; --- KONEC DOKUMENTACE CZ ---
2765+ 6A64              DIR128_COPY_NAME_TO_DE:
2766+ 6A64 D5                   push    de
2767+ 6A65 ED 5B B6 6F          ld      de,(item_name_page)
2768+ 6A69 CD 59 6A             call    DIR128_MAP_DE
2769+ 6A6C D1                   pop     de
2770+ 6A6D              .dir128_copy_loop:
2771+ 6A6D 78                   ld      a,b
2772+ 6A6E B1                   or      c
2773+ 6A6F C8                   ret     z
2774+ 6A70 7E                   ld      a,(hl)
2775+ 6A71 12                   ld      (de),a
2776+ 6A72 13                   inc     de
2777+ 6A73 0B                   dec     bc
2778+ 6A74 78                   ld      a,b
2779+ 6A75 B1                   or      c
2780+ 6A76 C8                   ret     z
2781+ 6A77 CD CA 69             call    DIR128_INC_HL
2782+ 6A7A D8                   ret     c                       ;should only happen on malformed item
2783+ 6A7B 18 F0                jr      .dir128_copy_loop

5963+ 79D2 30 FA        			jr nc,string_lp2
5964+ 79D4 09           			add hl,bc
5965+ 79D5 FE 30        			CP '0'
5966+ 79D7 28 04        			JR Z,string_store
5967+ 79D9
5968+ 79D9 DD CB 00 FE  			SET 7,(IX+0)		;Had something other than zero
5969+ 79DD
5970+ 79DD DD CB 00 7E  string_store:		BIT 7,(IX+0)		;Test if still leading zeros
5971+ 79E1 C8           			RET Z
5972+ 79E2 12           			LD (DE),A		;If not store it
5973+ 79E3 13           			INC DE
5974+ 79E4 C9           			RET

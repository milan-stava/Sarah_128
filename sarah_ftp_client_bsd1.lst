  911+6238              ;speed management 2.0. starts here. Enables to set user_defined speed. Works with every MBFW.
  912+6238              ;the principle:
  913+6238              ;are you aligned?
  914+6238              ;NO: try to align, if not success->error. If sucess, you have AKT (=current alligned speed is ;known). Is user defined speed definied? (IX+2=255 for no user defined speed) yes, END. NO. set ;speed according to ix+2 (max up to MBFW), end
  915+6238              ;
  916+6238              ;YES:
  917+6238              ;is user defined speed set? (ix+2=255 or other?) NO=check if FW is 7/12? YES, align at speed
  918+6238              ;ix+2, end. FW is higher then 7/12, then check if AKT=IX+2? YES, end, NO, align at ix+2, END.
  919+6238              ;ix+2 was not 255, is FW 7/12? YES, then set FWmax, end. NO the is AKT=MBFW max? YES, then END
  920+6238              ;NO, then align at FW max speed, end
  921+6238              ;output: ix+7= 0-23 if speed set, or 255 if not set
  922+6238
  923+6238              ;SM20 uses:
  924+6238              ;bit 4,(ix+0)	PRINT or not to PRINT
  925+6238              ;(ix+8)		contains maximum speed by detected MBFW (7, 12 or 23)
  926+6238              ;(ix+6)		timeout value
  927+6238              ;bit 6,(ix+0)	state of speed alignment between uart& module, 0 not aligned
  928+6238              ;bit 5,(ix+0)	state of module connection to AP, 0 not connected to AP
  929+6238
  930+6238              ;internal subroutines: switch_speed, find_out_speed
  931+6238              ;external subroutines: send_at:check_ok, set_ud_speed, set_print_speed, print_speed
  932+6238
  933+6238              ; --- DOKUMENTACE CZ: speed_management ---
  934+6238              ; Ucel: Sjednotí rychlost komunikace UART a Wi-Fi při inicializaci.
  935+6238              ; Vstup: Inicializovaný BIOS a příznaky na IX.
  936+6238              ; Vystup: Připravená komunikace nebo obsluha chyby.
  937+6238              ; Meni: AF, BC, DE, HL, BC'; další změny dle volaných BIOS/DOS a tiskových služeb.
  938+6238              ; Poznamka: Pracuje s konfigurací rychlosti, příjmovým bufferem a stavovým výpisem.
  939+6238              ; --- KONEC DOKUMENTACE CZ ---
  940+6238              speed_management
  941+6238 DD 36 07 FF  		ld	(ix+7),#FF		;reset currently set speed status
  942+623C DD CB 00 B6  		res	6,(ix+0)		;set signal UART and module speed not aligned
  943+6240

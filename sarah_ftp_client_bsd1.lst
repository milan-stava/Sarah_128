 9594+87C9 ~            ; Vstup: Bez parametru délky: BC se pouze uchovává.
 9595+87C9 ~            ; Vystup: FD_Copy=0, FD_Mod=0, F_Len=512; HL=DE=0, A=0, Z, NC.
 9596+87C9 ~            ; Meni: AF, DE, HL; BC, IX a IY zachovány.
 9597+87C9 ~            ; Poznamka: Přes historický název a komentář se délka z BC nepoužívá.
 9598+87C9 ~            ; --- KONEC DOKUMENTACE CZ ---
 9599+87C9 ~            set_fdma_to_fill_len_in_bc_512
 9600+87C9 ~            ;IN=BC=length
 9601+87C9 ~            	push	bc
 9602+87C9 ~            	ld	hl,0
 9603+87C9 ~            	ld 	d,h
 9604+87C9 ~            	ld	e,h
 9605+87C9 ~            	ld	bc,512
 9606+87C9 ~
 9607+87C9 ~            sftc1	ld	(FDMAreg.FD_Copy),hl	;...a 63 pøeskoè.
 9608+87C9 ~            	ld	(FDMAreg.FD_Mod),de
 9609+87C9 ~            	ld	(FDMAreg.F_Len),bc
 9610+87C9 ~            	pop	bc
 9611+87C9 ~            	xor	a			;signal key 0 pressed, because of main keyboard routine
 9612+87C9 ~            	ret
 9613+87C9 ~
 9614+87C9 ~            ;97)
 9615+87C9 ~            ; --- DOKUMENTACE CZ: set_hgfx_ink_planar ---
 9616+87C9 ~            ; Ucel: Obnoví barvu a bitové roviny pro běžný tisk HGFX.
 9617+87C9 ~            ; Vstup: Bez parametrů.
 9618+87C9 ~            ; Vystup: VIDEO_REGS.COLOR=4, VIDEO_REGS.MASK=planar_pismo.
 9619+87C9 ~            ; Meni: A; F, BC, DE, HL, IX a IY zachovány.
 9620+87C9 ~            ; --- KONEC DOKUMENTACE CZ ---
 9621+87C9 ~            set_hgfx_ink_planar
 9622+87C9 ~            		ld 	a,4			;vrat puvodni
 9623+87C9 ~            		ld 	(VIDEO_REGS.COLOR),a
 9624+87C9 ~            ;		ld	a,63
 9625+87C9 ~            		ld	a,planar_pismo
 9626+87C9 ~            		ld	(VIDEO_REGS.MASK),a
 9627+87C9 ~            		ret
 9628+87C9 ~
 9629+87C9              	ENDIF

 4145+7125 CD 6D 69     		call	DIR128_INC_HL
 4146+7128 38 4C        		jr	c,item_add_end
 4147+712A 7E           		ld	a,(hl)
 4148+712B 57           		ld	d,a			;DE=item length
 4149+712C B3           		or	e
 4150+712D 28 47        		jr	z,item_add_end		;00 00 = real end of directory
 4151+712F
 4152+712F              		;We are at item_start+1.
 4153+712F              		;Next item = item_start + item_length + 4.
 4154+712F              		;Therefore move 3 fixed bytes, then item_length bytes.
 4155+712F 3E 03        		ld	a,3

 2804+6A52              ; -----------------------------------------------------------------------------
 2805+6A52              ; search_by_Busy_fast
 2806+6A52              ; Fast case-insensitive substring search for a name fully contained in the
 2807+6A52              ; currently mapped 16K directory page.
 2808+6A52              ;
 2809+6A52              ; IN:  HL = name start, BC = 16-bit name length
 2810+6A52              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
 2811+6A52              ; OUT: Z = found, NZ = not found
 2812+6A52              ;
 2813+6A52              ; This is deliberately close to the original Busy FIND: the inner compare uses
 2814+6A52              ; the Z80 CPI instruction.  The pattern has already been converted to lower
 2815+6A52              ; case once by find_items, so only the source character needs convert here.
 2816+6A52              ;
 2817+6A52              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
 2818+6A52              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
 2819+6A52              ; matches therefore cannot be skipped.
 2820+6A52              ; -----------------------------------------------------------------------------
 2821+6A52              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
 2822+6A52              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
 2823+6A52              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
 2824+6A52              ;   délka.
 2825+6A52              ; Vystup: Z = shoda, NZ = nenalezeno.
 2826+6A52              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 2827+6A52              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
 2828+6A52              ; --- KONEC DOKUMENTACE CZ ---
 2829+6A52              search_by_Busy_fast:
 2830+6A52 EB                   ex      de,hl                   ;DE=current candidate in file name
 2831+6A53
 2832+6A53                      ; candidate_count = name_length - pattern_length + 1
 2833+6A53 60                   ld      h,b
 2834+6A54 69                   ld      l,c
 2835+6A55 ED 4B 37 78          ld      bc,(txtlen+1)
 2836+6A59 78                   ld      a,b
 2837+6A5A B1                   or      c
 2838+6A5B 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
 2839+6A5D B7                   or      a
 2840+6A5E ED 42                sbc     hl,bc
 2841+6A60 38 25                jr      c,.fast_not_found       ;pattern longer than file name
 2842+6A62 23                   inc     hl
 2843+6A63
 2844+6A63                      ; Keep number of possible candidate starts in alternate BC.
 2845+6A63 E5                   push    hl
 2846+6A64 D9                   exx
 2847+6A65 C1                   pop     bc
 2848+6A66 D9                   exx
 2849+6A67
 2850+6A67              .fast_next_candidate:
 2851+6A67 D5                   push    de                      ;remember exact candidate start
 2852+6A68 21 C2 8E             ld      hl,INPBUFF
 2853+6A6B ED 4B 37 78          ld      bc,(txtlen+1)
 2854+6A6F
 2855+6A6F              .fast_compare:
 2856+6A6F 1A                   ld      a,(de)
 2857+6A70 CD 5B 78             call    convert                 ;source char -> lower case
 2858+6A73 ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
 2859+6A75 13                   inc     de
 2860+6A76 20 06                jr      nz,.fast_candidate_failed
 2861+6A78 EA 6F 6A             jp      pe,.fast_compare        ;matched, more pattern bytes remain
 2862+6A7B
 2863+6A7B D1                   pop     de                      ;discard saved candidate start
 2864+6A7C              .fast_found:
 2865+6A7C AF                   xor     a                       ;Z = found
 2866+6A7D C9                   ret
 2867+6A7E
 2868+6A7E              .fast_candidate_failed:
 2869+6A7E D1                   pop     de                      ;restore previous candidate start
 2870+6A7F 13                   inc     de                      ;next candidate = previous + 1
 2871+6A80 D9                   exx
 2872+6A81 0B                   dec     bc
 2873+6A82 78                   ld      a,b
 2874+6A83 B1                   or      c
 2875+6A84 D9                   exx
 2876+6A85 20 E0                jr      nz,.fast_next_candidate
 2877+6A87
 2878+6A87              .fast_not_found:
 2879+6A87 3E 01                ld      a,1
 2880+6A89 B7                   or      a                       ;NZ = not found
 2881+6A8A C9                   ret

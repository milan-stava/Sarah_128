5955+ 79CC              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
5956+ 79CC              ; Poznamka: Používá a nastavuje bit 7 v (IX+0) pro potlačení úvodních nul.
5957+ 79CC              ; --- KONEC DOKUMENTACE CZ ---
5958+ 79CC 3E 2F        string_dl:		ld a,'0'-1
5959+ 79CE
5960+ 79CE 3C           string_lp2:		inc a

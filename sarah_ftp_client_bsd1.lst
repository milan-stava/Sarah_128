2686+ 6ACB              ; search_by_Busy_dir
2687+ 6ACB              ; Bank-safe replacement used by FIND for names returned by get_item_name.
2688+ 6ACB              ; IN:  HL = physical name start, BC = 16-bit name length
2689+ 6ACB              ;      item_name_page = bank companion for HL
2690+ 6ACB              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
2691+ 6ACB              ; OUT: Z=pattern found, NZ=not found
2692+ 6ACB              ; One-character input matches only the FIRST character of a name (quick jump).
2693+ 6ACB              ; Two or more characters use normal case-insensitive substring search. There is
2694+ 6ACB              ; no 255-byte directory-name limit; directory page crossings are transparent.
2695+ 6ACB              ; -----------------------------------------------------------------------------
2696+ 6ACB              search_by_Busy_dir:
2697+ 6ACB                      ; Empty name cannot contain a non-empty search pattern.
2698+ 6ACB 78                   ld      a,b
2699+ 6ACC B1                   or      c
2700+ 6ACD 28 2A                jr      z,.dir_search_not_found_fast

4112+ 72AF              ; -----------------------------------------------------------------------------
4113+ 72AF              ; item_add / item_sub - 128K bank-aware directory movement
4114+ 72AF              ;
4115+ 72AF              ; IN:
4116+ 72AF              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
4117+ 72AF              ;       DE = address of its 16-bit page-table-pointer companion
4118+ 72AF              ;
4119+ 72AF              ; Example:
4120+ 72AF              ;       ld bc,cur_item_addr
4121+ 72AF              ;       ld de,cur_item_addr_page
4122+ 72AF              ;       call item_add
4123+ 72AF              ;
4124+ 72AF              ; OUT:
4125+ 72AF              ;       Z  = cannot move (end/start of directory)
4126+ 72AF              ;       NZ = pointer + its bank companion were moved to adjacent item
4127+ 72AF              ;
4128+ 72AF              ; The address variable and page variable deliberately do NOT have to be adjacent.
4129+ 72AF              ; This keeps the original IX+... variable layout completely unchanged.
4130+ 72AF              ; The two-byte item length at either end of an item may itself cross a bank.
4131+ 72AF              ; -----------------------------------------------------------------------------
4132+ 72AF              ; --- DOKUMENTACE CZ: item_add ---
4133+ 72AF              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
4134+ 72AF              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
4135+ 72AF              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
4136+ 72AF              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
4137+ 72AF              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
4138+ 72AF              ; --- KONEC DOKUMENTACE CZ ---
4139+ 72AF              item_add
4140+ 72AF ED 43 DC 6F  		ld	(dir_op_addr_var),bc
4141+ 72B3 ED 53 DE 6F  		ld	(dir_op_page_var),de
4142+ 72B7
4143+ 72B7              		;Load physical item address from *(BC).
4144+ 72B7 60           		ld	h,b
4145+ 72B8 69           		ld	l,c
4146+ 72B9 5E           		ld	e,(hl)
4147+ 72BA 23           		inc	hl
4148+ 72BB 56           		ld	d,(hl)
4149+ 72BC ED 53 D4 6F  		ld	(next_item_addr),de	;temporary physical start
4150+ 72C0 EB           		ex	de,hl			;HL=current physical item start
4151+ 72C1
4152+ 72C1              		;Load/map directory page from page companion variable.
4153+ 72C1 E5           		push	hl
4154+ 72C2 2A DE 6F     		ld	hl,(dir_op_page_var)
4155+ 72C5 5E           		ld	e,(hl)
4156+ 72C6 23           		inc	hl

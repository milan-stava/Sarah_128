1071+ 62ED              ;		call	sws2
1072+ 62ED              ;		ret	z			;Z= speed <0,7> found
1073+ 62ED
1074+ 62ED              ; --- DOKUMENTACE CZ: switch_speed ---
1075+ 62ED              ; Ucel: Zkouší rychlosti UART sestupně od maximální až po nulu.
1076+ 62ED              ; Vstup: (IX+8) = nejvyšší zkoušený index rychlosti.
1077+ 62ED              ; Vystup: Z = modul odpověděl OK, D = nalezený index; NZ = nenalezeno.
1078+ 62ED              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
1079+ 62ED              ; Poznamka: Mění UART a (IX+6), vyprazdňuje příjem.
1080+ 62ED              ; --- KONEC DOKUMENTACE CZ ---
1081+ 62ED DD 7E 08     switch_speed	ld	a,(ix+8)		;try out every speed if you find connection UART+Wifi
1082+ 62F0              						;start with max speed, end with 0
1083+ 62F0 F5           sws2		push	af
1084+ 62F1 CD 16 7B     		call	set_print_speed
1085+ 62F4 38 1B        		jr c,sws_unsupported ;do not report a UART setting rejected by BIOS
1086+ 62F6
1087+ 62F6 F1           		pop	af			;we need to inrease timeout for speeds <3
1088+ 62F7 F5           		push	af
1089+ 62F8 FE 03        		cp	3
1090+ 62FA DD 36 06 01  		ld	(ix+6),1		;set timeout for 1 for speeds >3
1091+ 62FE 30 04        		jr	nc,sws1
1092+ 6300 DD 36 06 0A  		ld	(ix+6),#A		;set tieout for #A for speeds <2
1093+ 6304
1094+ 6304 CD DE 7A     sws1		call	send_at_check_ok
1095+ 6307 D1           		pop	de
1096+ 6308 C8           		ret	z			;Z=answer found, D= speed set in HW
1097+ 6309 7A           sws_next ld	a,d
1098+ 630A 3D           		dec	a
1099+ 630B FE FF        		cp	255			;test for 255, so that also speed 0 is tested
1100+ 630D 20 E1        		jr	nz,sws2
1101+ 630F 3D           		dec	a			;NZ=not successfull
1102+ 6310 C9           		ret
1103+ 6311 D1           sws_unsupported pop de
1104+ 6312 18 F5                jr sws_next

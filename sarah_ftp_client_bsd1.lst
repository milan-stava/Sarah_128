  957+624C 20 D7        		jr	nz,speed_uart_err
  958+624E
  959+624E              wifi_cont					;we are at speed we want. Final steps... print UART speed+ Baud speed
  960+624E DD CB 00 F6  		set	6,(ix+0)		;signal, that uart and module speed is aligned
  961+6252
  962+6252              ;		call	get_baud
  963+6252 CD 6B 62     		call	find_out_speed
  964+6255 7A           		ld	a,d			;A=aligned speed we ended with
  965+6256 DD 77 07     		ld	(ix+7),a		;save it
  966+6259 CD 88 7D     		call	print_speed
  967+625C CD 9B 62     		call	print_bauds
  968+625F
  969+625F 21 1D 8A     		ld	hl,ate0

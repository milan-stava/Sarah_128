 2510+6973              ; -----------------------------------------------------------------------------
 2511+6973              ; FTP DIRECTORY BANK API
 2512+6973              ;
 2513+6973              ; fdp_pointer always points to the table byte of the CURRENT directory page.
 2514+6973              ; ftp_dir_page has #FF sentinels on both sides:
 2515+6973              ;       #FF, 0, 1, 3, 7, #FF
 2516+6973              ;
 2517+6973              ; HL is always a physical address in the banked window #C000-#FFFF.
 2518+6973              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
 2519+6973              ;
 2520+6973              ; OUT for INC/DEC:
 2521+6973              ;       NC = movement succeeded
 2522+6973              ;       C  = no next/previous directory page (64 KB boundary)
 2523+6973              ;
 2524+6973              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
 2525+6973              ; which preserves AF/BC/DE/IX/IY exactly.
 2526+6973              ; -----------------------------------------------------------------------------
 2527+6973
 2528+6973              ; --- DOKUMENTACE CZ: DIR128_MAP_CURRENT ---
 2529+6973              ; Ucel: Namapuje aktuální banku adresáře do #C000–#FFFF.
 2530+6973              ; Vstup: fdp_pointer ukazuje do tabulky ftp_dir_page.
 2531+6973              ; Vystup: NC = platná banka, C = sentinel #FF.
 2532+6973              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
 2533+6973              ; Poznamka: Mění PAGE128_STATE a port #7FFD.
 2534+6973              ; --- KONEC DOKUMENTACE CZ ---
 2535+6973              DIR128_MAP_CURRENT:
 2536+6973 E5                   push    hl
 2537+6974 D5                   push    de
 2538+6975 ED 5B F6 BF          ld      de,(fdp_pointer)
 2539+6979 1A                   ld      a,(de)
 2540+697A FE FF                cp      #FF
 2541+697C 28 07                jr      z,DIR128_MAP_BAD
 2542+697E CD E0 BF             call    PAGE128
 2543+6981 D1                   pop     de
 2544+6982 E1                   pop     hl
 2545+6983 B7                   or      a                       ;NC = valid page
 2546+6984 C9                   ret
 2547+6985              DIR128_MAP_BAD:
 2548+6985 D1                   pop     de
 2549+6986 E1                   pop     hl
 2550+6987 37                   scf
 2551+6988 C9                   ret
 2552+6989
 2553+6989              ;Select first FTP directory page (page 0).
 2554+6989              ; --- DOKUMENTACE CZ: DIR128_FIRST_PAGE ---
 2555+6989              ; Ucel: Vybere první banku adresáře (RAM 0).
 2556+6989              ; Vstup: Bez parametrů.
 2557+6989              ; Vystup: fdp_pointer = ftp_dir_page+1; NC.
 2558+6989              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
 2559+6989              ; Poznamka: Mění mapování RAM a PAGE128_STATE.
 2560+6989              ; --- KONEC DOKUMENTACE CZ ---
 2561+6989              DIR128_FIRST_PAGE:
 2562+6989 E5                   push    hl
 2563+698A 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
 2564+698D 22 F6 BF             ld      (fdp_pointer),hl
 2565+6990 7E                   ld      a,(hl)
 2566+6991 CD E0 BF             call    PAGE128
 2567+6994 E1                   pop     hl
 2568+6995 B7                   or      a
 2569+6996 C9                   ret
 2570+6997
 2571+6997              ;HL++ across #FFFF -> #C000 of the next directory page.
 2572+6997              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
 2573+6997              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
 2574+6997              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
 2575+6997              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
 2576+6997              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
 2577+6997              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
 2578+6997              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
 2579+6997              ; --- KONEC DOKUMENTACE CZ ---
 2580+6997              DIR128_INC_HL:
 2581+6997 F5                   push    af                      ;old INC HL never changed A - preserve it here too
 2582+6998 23                   inc     hl
 2583+6999 7C                   ld      a,h
 2584+699A B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
 2585+699B 28 03                jr      z,DIR128_INC_CROSS
 2586+699D F1                   pop     af
 2587+699E B7                   or      a                       ;restore A and return NC = OK
 2588+699F C9                   ret
 2589+69A0
 2590+69A0              DIR128_INC_CROSS:
 2591+69A0 D5                   push    de
 2592+69A1 ED 5B F6 BF          ld      de,(fdp_pointer)
 2593+69A5 13                   inc     de
 2594+69A6 1A                   ld      a,(de)
 2595+69A7 FE FF                cp      #FF
 2596+69A9 28 0E                jr      z,DIR128_INC_END
 2597+69AB ED 53 F6 BF          ld      (fdp_pointer),de
 2598+69AF CD E0 BF             call    PAGE128
 2599+69B2 21 00 C0             ld      hl,ftp_dir_start        ;#C000
 2600+69B5 D1                   pop     de
 2601+69B6 F1                   pop     af                      ;restore caller's A
 2602+69B7 B7                   or      a                       ;NC = OK, A unchanged
 2603+69B8 C9                   ret
 2604+69B9              DIR128_INC_END:
 2605+69B9 1B                   dec     de                      ;keep fdp_pointer on last valid page
 2606+69BA ED 53 F6 BF          ld      (fdp_pointer),de
 2607+69BE 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
 2608+69C1 D1                   pop     de
 2609+69C2 F1                   pop     af                      ;restore caller's A
 2610+69C3 37                   scf                             ;C = no following directory page
 2611+69C4 C9                   ret
 2612+69C5
 2613+69C5              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
 2614+69C5              ;Unlike the general helper, this preserves the COMPLETE parser state:
 2615+69C5              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
 2616+69C5              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
 2617+69C5              ;  dir128_parser_status = 0  OK
 2618+69C5              ;  dir128_parser_status = 1  no next directory page
 2619+69C5              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
 2620+69C5              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
 2621+69C5              ; Vstup: HL = adresa v aktuální bance adresáře.
 2622+69C5              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
 2623+69C5              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
 2624+69C5              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
 2625+69C5              ; --- KONEC DOKUMENTACE CZ ---
 2626+69C5              DIR128_INC_HL_PARSER:
 2627+69C5 F5                   push    af
 2628+69C6 D5                   push    de
 2629+69C7 AF                   xor     a
 2630+69C8 32 FC 88             ld      (dir128_parser_status),a
 2631+69CB 23                   inc     hl
 2632+69CC 7C                   ld      a,h
 2633+69CD B7                   or      a
 2634+69CE 20 14                jr      nz,.ok
 2635+69D0 ED 5B F6 BF          ld      de,(fdp_pointer)
 2636+69D4 13                   inc     de
 2637+69D5 1A                   ld      a,(de)
 2638+69D6 FE FF                cp      #FF
 2639+69D8 28 0D                jr      z,.full
 2640+69DA ED 53 F6 BF          ld      (fdp_pointer),de
 2641+69DE CD E0 BF             call    PAGE128
 2642+69E1 21 00 C0             ld      hl,ftp_dir_start
 2643+69E4              .ok:
 2644+69E4 D1                   pop     de
 2645+69E5 F1                   pop     af
 2646+69E6 C9                   ret
 2647+69E7              .full:
 2648+69E7 1B                   dec     de
 2649+69E8 ED 53 F6 BF          ld      (fdp_pointer),de
 2650+69EC 21 FF FF             ld      hl,#FFFF
 2651+69EF 3E 01                ld      a,1
 2652+69F1 32 FC 88             ld      (dir128_parser_status),a
 2653+69F4 D1                   pop     de
 2654+69F5 F1                   pop     af
 2655+69F6 C9                   ret
 2656+69F7
 2657+69F7              ;HL-- across #C000 -> #FFFF of the previous directory page.
 2658+69F7              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
 2659+69F7              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
 2660+69F7              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
 2661+69F7              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
 2662+69F7              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
 2663+69F7              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
 2664+69F7              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
 2665+69F7              ; --- KONEC DOKUMENTACE CZ ---
 2666+69F7              DIR128_DEC_HL:
 2667+69F7 F5                   push    af                      ;old DEC HL never changed A - preserve it here too
 2668+69F8 2B                   dec     hl
 2669+69F9 7C                   ld      a,h
 2670+69FA FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
 2671+69FC 28 03                jr      z,DIR128_DEC_CROSS
 2672+69FE F1                   pop     af
 2673+69FF B7                   or      a                       ;restore A and return NC = OK
 2674+6A00 C9                   ret
 2675+6A01
 2676+6A01              DIR128_DEC_CROSS:
 2677+6A01 D5                   push    de
 2678+6A02 ED 5B F6 BF          ld      de,(fdp_pointer)
 2679+6A06 1B                   dec     de
 2680+6A07 1A                   ld      a,(de)
 2681+6A08 FE FF                cp      #FF
 2682+6A0A 28 0E                jr      z,DIR128_DEC_START
 2683+6A0C ED 53 F6 BF          ld      (fdp_pointer),de
 2684+6A10 CD E0 BF             call    PAGE128
 2685+6A13 21 FF FF             ld      hl,#FFFF
 2686+6A16 D1                   pop     de
 2687+6A17 F1                   pop     af                      ;restore caller's A
 2688+6A18 B7                   or      a                       ;NC = OK, A unchanged
 2689+6A19 C9                   ret
 2690+6A1A              DIR128_DEC_START:
 2691+6A1A 13                   inc     de                      ;keep fdp_pointer on first valid page
 2692+6A1B ED 53 F6 BF          ld      (fdp_pointer),de
 2693+6A1F 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
 2694+6A22 D1                   pop     de
 2695+6A23 F1                   pop     af                      ;restore caller's A
 2696+6A24 37                   scf                             ;C = no previous directory page
 2697+6A25 C9                   ret
 2698+6A26
 2699+6A26              ;Map page-table pointer stored in DE. HL is preserved.
 2700+6A26              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
 2701+6A26              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
 2702+6A26              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
 2703+6A26              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
 2704+6A26              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
 2705+6A26              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
 2706+6A26              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
 2707+6A26              ; --- KONEC DOKUMENTACE CZ ---
 2708+6A26              DIR128_MAP_DE:
 2709+6A26 F5                   push    af
 2710+6A27 ED 53 F6 BF          ld      (fdp_pointer),de
 2711+6A2B 1A                   ld      a,(de)
 2712+6A2C CD E0 BF             call    PAGE128
 2713+6A2F F1                   pop     af
 2714+6A30 C9                   ret
 2715+6A31
 2716+6A31
 2717+6A31              ; -----------------------------------------------------------------------------
 2718+6A31              ; DIR128_COPY_NAME_TO_DE
 2719+6A31              ; Copy the name returned by get_item_name to fixed RAM.
 2720+6A31              ; IN:  HL = physical source address in directory window
 2721+6A31              ;      BC = 16-bit name length
 2722+6A31              ;      DE = fixed-RAM destination
 2723+6A31              ;      item_name_page = page-table pointer belonging to HL
 2724+6A31              ; OUT: DE points behind copied bytes, BC=0
 2725+6A31              ; The source may cross any #FFFF -> #C000 directory-page boundary.
 2726+6A31              ; -----------------------------------------------------------------------------
 2727+6A31              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
 2728+6A31              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
 2729+6A31              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
 2730+6A31              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
 2731+6A31              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 2732+6A31              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
 2733+6A31              ; --- KONEC DOKUMENTACE CZ ---
 2734+6A31              DIR128_COPY_NAME_TO_DE:
 2735+6A31 D5                   push    de
 2736+6A32 ED 5B 7F 6F          ld      de,(item_name_page)
 2737+6A36 CD 26 6A             call    DIR128_MAP_DE
 2738+6A39 D1                   pop     de
 2739+6A3A              .dir128_copy_loop:
 2740+6A3A 78                   ld      a,b
 2741+6A3B B1                   or      c
 2742+6A3C C8                   ret     z
 2743+6A3D 7E                   ld      a,(hl)

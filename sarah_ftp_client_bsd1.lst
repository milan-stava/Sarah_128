2890+ 6A99                      ;Always advance by exactly ONE source character.  This fixes both the
2891+ 6A99                      ;old overlapping-match bug and the old one-character special case.
2892+ 6A99 2A 20 6F             ld      hl,(dir_search_addr)
2893+ 6A9C ED 5B 22 6F          ld      de,(dir_search_page)
2894+ 6AA0 CD BE 69             call    DIR128_MAP_DE
2895+ 6AA3 CD 2F 69             call    DIR128_INC_HL
2896+ 6AA6 38 16                jr      c,.dir_search_not_found
2897+ 6AA8 22 20 6F             ld      (dir_search_addr),hl
2898+ 6AAB ED 5B F6 BF          ld      de,(fdp_pointer)
2899+ 6AAF ED 53 22 6F          ld      (dir_search_page),de
2900+ 6AB3 2A 24 6F             ld      hl,(dir_search_remaining)
2901+ 6AB6 2B                   dec     hl
2902+ 6AB7 22 24 6F             ld      (dir_search_remaining),hl
2903+ 6ABA 18 AA                jr      .dir_search_outer
2904+ 6ABC
2905+ 6ABC              .dir_search_found:
2906+ 6ABC AF                   xor     a                       ;Z
2907+ 6ABD C9                   ret
2908+ 6ABE              .dir_search_not_found:
2909+ 6ABE 3E 01                ld      a,1
2910+ 6AC0 B7                   or      a                       ;NZ
2911+ 6AC1 C9                   ret

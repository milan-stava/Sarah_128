2876+ 6B3E ED 52                sbc     hl,de
2877+ 6B40 38 4C                jr      c,.dir_search_not_found
2878+ 6B42
2879+ 6B42                      ;Start one comparison at current candidate address/page.
2880+ 6B42 2A EF 6F             ld      hl,(dir_search_addr)
2881+ 6B45 ED 5B F1 6F          ld      de,(dir_search_page)
2882+ 6B49 CD 8E 6A             call    DIR128_MAP_DE
2883+ 6B4C 11 80 8E             ld      de,INPBUFF
2884+ 6B4F ED 4B F5 6F          ld      bc,(dir_search_patlen)
2885+ 6B53
2886+ 6B53              .dir_search_cmp:
2887+ 6B53 7E                   ld      a,(hl)
2888+ 6B54 CD 4D 79             call    convert                 ;source char -> lower case
2889+ 6B57 EB                   ex      de,hl
2890+ 6B58 BE                   cp      (hl)                    ;pattern already normalized by FIND
2891+ 6B59 EB                   ex      de,hl
2892+ 6B5A 20 0D                jr      nz,.dir_search_advance_candidate
2893+ 6B5C
2894+ 6B5C 13                   inc     de
2895+ 6B5D 0B                   dec     bc
2896+ 6B5E 78                   ld      a,b
2897+ 6B5F B1                   or      c
2898+ 6B60 28 2A                jr      z,.dir_search_found
2899+ 6B62 CD FF 69             call    DIR128_INC_HL
2900+ 6B65 38 27                jr      c,.dir_search_not_found

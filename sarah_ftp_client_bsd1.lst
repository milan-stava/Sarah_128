7546+ 7D75              ; --- DOKUMENTACE CZ: error_handler ---
7547+ 7D75              ; Ucel: Zobrazí chybu, ukončí čekání a vrátí řízení na nejvyšší úroveň.
7548+ 7D75              ; Vstup: C = číslo chyby; inicializovaný hlavní zásobník.
7549+ 7D75              ; Vystup: Nevrací se běžně volajícímu: SP nastaví na basic_end-2.
7550+ 7D75              ; Meni: AF, BC, DE, HL, BC' (přes příjem odpovědi); další registry externích služeb viz jejich
7551+ 7D75              ;   rozhraní. SP.
7552+ 7D75              ; Poznamka: Obnovuje 3,5 MHz a vypíná pasivní příjem.
7553+ 7D75              ; --- KONEC DOKUMENTACE CZ ---
7554+ 7D75 AF           error_handler xor a
7555+ 7D76 32 D3 9E                ld (upload_legacy_mode),a
7556+ 7D79 C5                      push bc                ;preserve original error across clock switch
7557+ 7D7A CD F2 80                call set_3_5mhz
7558+ 7D7D C1                      pop bc
7559+ 7D7E 3A A9 7D                ld a,(error_recovering)
7560+ 7D81 B7                      or a
7561+ 7D82 20 16                   jr nz,error_handler_exit ;cleanup itself failed: do not recurse again
7562+ 7D84 3C                      inc a
7563+ 7D85 32 A9 7D                ld (error_recovering),a
7564+ 7D88 CD AA 7D                call display_error
7565+ 7D8B CD 72 7B                call wifi_unwait
7566+ 7D8E CD D6 A2                call at_reset_stream
7567+ 7D91 DD CB 00 76             bit 6,(ix+0)

 4185+715B
 4186+715B              		;Commit candidate address.
 4187+715B 2A 49 6F     		ld	hl,(dir_op_addr_var)
 4188+715E ED 5B 41 6F  		ld	de,(next_item_addr)
 4189+7162 73           		ld	(hl),e

 9061+83BF DA 9F 84             jp      c,gfn_bad
 9062+83C2 7E                   ld      a,(hl)
 9063+83C3 47                   ld      b,a
 9064+83C4 78                   ld      a,b
 9065+83C5 B1                   or      c

 4541+74B7 56           		ld	d,(hl)			;previous trailing length HIGH
 4542+74B8 CD F9 6D     		call	DIR128_DEC_HL
 4543+74BB 38 3D        		jr	c,item_sub_start
 4544+74BD 5E           		ld	e,(hl)			;previous trailing length LOW
 4545+74BE
 4546+74BE              		;Now HL = previous tail LOW = previous_start + length + 2.

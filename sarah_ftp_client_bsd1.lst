 6322+7BD2              ;16)
 6323+7BD2              ; --- DOKUMENTACE CZ: ConvRStr16 ---
 6324+7BD2              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
 6325+7BD2              ; Vstup: DE = začátek číslic.
 6326+7BD2              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
 6327+7BD2              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 6328+7BD2              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
 6329+7BD2              ;   přetečení; Z nemá pevný význam.
 6330+7BD2              ; --- KONEC DOKUMENTACE CZ ---
 6331+7BD2              ConvRStr16
 6332+7BD2              ;===============================================================
 6333+7BD2              ;http://z80-heaven.wikidot.com/math#toc32
 6334+7BD2              ;Input:
 6335+7BD2              ;     DE points to the base 10 number string in RAM.
 6336+7BD2              ;Outputs:
 6337+7BD2              ;     HL is the 16-bit value of the number
 6338+7BD2              ;     DE points to the byte after the number
 6339+7BD2              ;     BC is HL/10
 6340+7BD2              ;     z flag reset (nz)
 6341+7BD2              ;     c flag reset (nc)
 6342+7BD2              ;Destroys:
 6343+7BD2              ;     A (actually, add 30h and you get the ending token)
 6344+7BD2              ;Size:  23 bytes
 6345+7BD2              ;Speed: 104n+42+11c
 6346+7BD2              ;       n is the number of digits
 6347+7BD2              ;       c is at most n-2
 6348+7BD2              ;       at most 595 cycles for any 16-bit decimal value
 6349+7BD2              ;===============================================================
 6350+7BD2
 6351+7BD2 21 00 00          ld hl,0          ;  10 : 210000
 6352+7BD5              ConvLoop:             ;
 6353+7BD5 1A                ld a,(de)        ;   7 : 1A
 6354+7BD6 D6 30             sub 30h          ;   7 : D630
 6355+7BD8 FE 0A             cp 10            ;   7 : FE0A
 6356+7BDA D0                ret nc           ;5|11 : D0
 6357+7BDB 13                inc de           ;   6 : 13
 6358+7BDC                                    ;
 6359+7BDC 44                ld b,h           ;   4 : 44
 6360+7BDD 4D                ld c,l           ;   4 : 4D
 6361+7BDE 29                add hl,hl        ;  11 : 29
 6362+7BDF 29                add hl,hl        ;  11 : 29
 6363+7BE0 09                add hl,bc        ;  11 : 09
 6364+7BE1 29                add hl,hl        ;  11 : 29
 6365+7BE2                                    ;
 6366+7BE2 85                add a,l          ;   4 : 85
 6367+7BE3 6F                ld l,a           ;   4 : 6F
 6368+7BE4 30 EF             jr nc,ConvLoop   ;12|23: 30EE
 6369+7BE6 24                inc h            ; --- : 24
 6370+7BE7 18 EC             jr ConvLoop      ; --- : 18EB
 6371+7BE9
 6372+7BE9

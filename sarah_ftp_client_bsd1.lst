7596+ 7DAE 32 D2 7D                ld (error_recovering),a
7597+ 7DB1 CD D3 7D                call display_error
7598+ 7DB4 CD 9B 7B                call wifi_unwait
7599+ 7DB7 CD 0C A3                call at_reset_stream
7600+ 7DBA DD CB 00 76             bit 6,(ix+0)
7601+ 7DBE 28 03                   jr z,error_handler_exit ;no cleanup AT commands at an unknown baud
7602+ 7DC0 CD 6D 82                call passive_receive_off ;one best-effort cleanup attempt only
7603+ 7DC3              error_handler_exit
7604+ 7DC3 AF                      xor a
7605+ 7DC4 32 D2 7D                ld (error_recovering),a
7606+ 7DC7 DD CB 00 76             bit 6,(ix+0)
7607+ 7DCB CA 2D 77                jp z,quit_keep_directory
7608+ 7DCE 31 FE 5F                ld sp,basic_end-2
7609+ 7DD1 C9                      ret
7610+ 7DD2 00           error_recovering db 0

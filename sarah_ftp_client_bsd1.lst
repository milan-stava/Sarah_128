 6574+7BFB              ; --- DOKUMENTACE CZ: convASCII2hex ---
 6575+7BFB              ; Ucel: Složí dolní půlbajty dvou znaků do jednoho bajtu.
 6576+7BFB              ; Vstup: HL = adresa dvou ASCII číslic, např. "14".
 6577+7BFB              ; Vystup: A = #14 pro vstup "14"; HL ukazuje na druhý znak.
 6578+7BFB              ; Meni: AF, E, HL; D, BC, IX a IY zachovány.
 6579+7BFB              ; Poznamka: Není obecný hexadecimální parser: nepřevádí písmena A–F.
 6580+7BFB              ; --- KONEC DOKUMENTACE CZ ---
 6581+7BFB              convASCII2hex
 6582+7BFB              ;IN=HL ASCII number address (2 digits) eg. hl,14
 6583+7BFB              ;OUT=A=#14
 6584+7BFB 7E           		ld	a,(hl)
 6585+7BFC E6 0F        		and	%00001111
 6586+7BFE CB 27        		sla	a
 6587+7C00 CB 27        		sla	a
 6588+7C02 CB 27        		sla	a
 6589+7C04 CB 27        		sla	a
 6590+7C06 5F           		ld	e,a
 6591+7C07 23           		inc	hl
 6592+7C08 7E           		ld	a,(hl)
 6593+7C09 E6 0F        		and	%00001111
 6594+7C0B B3           		or	e
 6595+7C0C C9           		ret

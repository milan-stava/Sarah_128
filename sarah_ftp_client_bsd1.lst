2513+ 693B              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
2514+ 693B              ;Unlike the general helper, this preserves the COMPLETE parser state:
2515+ 693B              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
2516+ 693B              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
2517+ 693B              ;  dir128_parser_status = 0  OK
2518+ 693B              ;  dir128_parser_status = 1  no next directory page
2519+ 693B              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
2520+ 693B              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
2521+ 693B              ; Vstup: HL = adresa v aktuální bance adresáře.
2522+ 693B              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
2523+ 693B              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
2524+ 693B              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
2525+ 693B              ; --- KONEC DOKUMENTACE CZ ---
2526+ 693B              DIR128_INC_HL_PARSER:
2527+ 693B F5                   push    af
2528+ 693C D5                   push    de
2529+ 693D AF                   xor     a
2530+ 693E 32 6B 86             ld      (dir128_parser_status),a
2531+ 6941 23                   inc     hl
2532+ 6942 7C                   ld      a,h
2533+ 6943 B7                   or      a
2534+ 6944 20 14                jr      nz,.ok
2535+ 6946 ED 5B F6 BF          ld      de,(fdp_pointer)
2536+ 694A 13                   inc     de
2537+ 694B 1A                   ld      a,(de)
2538+ 694C FE FF                cp      #FF
2539+ 694E 28 0D                jr      z,.full
2540+ 6950 ED 53 F6 BF          ld      (fdp_pointer),de
2541+ 6954 CD E0 BF             call    PAGE128
2542+ 6957 21 00 C0             ld      hl,ftp_dir_start
2543+ 695A              .ok:
2544+ 695A D1                   pop     de
2545+ 695B F1                   pop     af
2546+ 695C C9                   ret
2547+ 695D              .full:
2548+ 695D 1B                   dec     de
2549+ 695E ED 53 F6 BF          ld      (fdp_pointer),de
2550+ 6962 21 FF FF             ld      hl,#FFFF
2551+ 6965 3E 01                ld      a,1
2552+ 6967 32 6B 86             ld      (dir128_parser_status),a
2553+ 696A D1                   pop     de
2554+ 696B F1                   pop     af
2555+ 696C C9                   ret
2556+ 696D
2557+ 696D              ;HL-- across #C000 -> #FFFF of the previous directory page.
2558+ 696D              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
2559+ 696D              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
2560+ 696D              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
2561+ 696D              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2562+ 696D              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
2563+ 696D              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2564+ 696D              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2565+ 696D              ; --- KONEC DOKUMENTACE CZ ---
2566+ 696D              DIR128_DEC_HL:
2567+ 696D F5                   push    af                      ;old DEC HL never changed A - preserve it here too
2568+ 696E 2B                   dec     hl
2569+ 696F 7C                   ld      a,h
2570+ 6970 FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
2571+ 6972 28 03                jr      z,DIR128_DEC_CROSS
2572+ 6974 F1                   pop     af
2573+ 6975 B7                   or      a                       ;restore A and return NC = OK
2574+ 6976 C9                   ret
2575+ 6977
2576+ 6977              DIR128_DEC_CROSS:
2577+ 6977 D5                   push    de
2578+ 6978 ED 5B F6 BF          ld      de,(fdp_pointer)
2579+ 697C 1B                   dec     de
2580+ 697D 1A                   ld      a,(de)
2581+ 697E FE FF                cp      #FF
2582+ 6980 28 0E                jr      z,DIR128_DEC_START
2583+ 6982 ED 53 F6 BF          ld      (fdp_pointer),de
2584+ 6986 CD E0 BF             call    PAGE128
2585+ 6989 21 FF FF             ld      hl,#FFFF
2586+ 698C D1                   pop     de
2587+ 698D F1                   pop     af                      ;restore caller's A
2588+ 698E B7                   or      a                       ;NC = OK, A unchanged
2589+ 698F C9                   ret
2590+ 6990              DIR128_DEC_START:
2591+ 6990 13                   inc     de                      ;keep fdp_pointer on first valid page
2592+ 6991 ED 53 F6 BF          ld      (fdp_pointer),de
2593+ 6995 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
2594+ 6998 D1                   pop     de
2595+ 6999 F1                   pop     af                      ;restore caller's A
2596+ 699A 37                   scf                             ;C = no previous directory page
2597+ 699B C9                   ret
2598+ 699C
2599+ 699C              ;Map page-table pointer stored in DE. HL is preserved.
2600+ 699C              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
2601+ 699C              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
2602+ 699C              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
2603+ 699C              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
2604+ 699C              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
2605+ 699C              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
2606+ 699C              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
2607+ 699C              ; --- KONEC DOKUMENTACE CZ ---
2608+ 699C              DIR128_MAP_DE:
2609+ 699C F5                   push    af
2610+ 699D ED 53 F6 BF          ld      (fdp_pointer),de
2611+ 69A1 1A                   ld      a,(de)
2612+ 69A2 CD E0 BF             call    PAGE128
2613+ 69A5 F1                   pop     af
2614+ 69A6 C9                   ret

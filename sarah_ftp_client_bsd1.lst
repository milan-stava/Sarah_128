6072+ 7788              ; --- DOKUMENTACE CZ: ConvRStr16 ---
6073+ 7788              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
6074+ 7788              ; Vstup: DE = začátek číslic.
6075+ 7788              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
6076+ 7788              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
6077+ 7788              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
6078+ 7788              ;   přetečení; Z nemá pevný význam.
6079+ 7788              ; --- KONEC DOKUMENTACE CZ ---
6080+ 7788              ConvRStr16
6081+ 7788              ;===============================================================
6082+ 7788              ;http://z80-heaven.wikidot.com/math#toc32
6083+ 7788              ;Input:
6084+ 7788              ;     DE points to the base 10 number string in RAM.
6085+ 7788              ;Outputs:
6086+ 7788              ;     HL is the 16-bit value of the number
6087+ 7788              ;     DE points to the byte after the number
6088+ 7788              ;     BC is HL/10
6089+ 7788              ;     z flag reset (nz)
6090+ 7788              ;     c flag reset (nc)
6091+ 7788              ;Destroys:
6092+ 7788              ;     A (actually, add 30h and you get the ending token)
6093+ 7788              ;Size:  23 bytes
6094+ 7788              ;Speed: 104n+42+11c
6095+ 7788              ;       n is the number of digits
6096+ 7788              ;       c is at most n-2
6097+ 7788              ;       at most 595 cycles for any 16-bit decimal value
6098+ 7788              ;===============================================================
6099+ 7788
6100+ 7788 21 00 00          ld hl,0          ;  10 : 210000
6101+ 778B              ConvLoop:             ;
6102+ 778B 1A                ld a,(de)        ;   7 : 1A
6103+ 778C D6 30             sub 30h          ;   7 : D630
6104+ 778E FE 0A             cp 10            ;   7 : FE0A
6105+ 7790 D0                ret nc           ;5|11 : D0
6106+ 7791 13                inc de           ;   6 : 13
6107+ 7792                                    ;
6108+ 7792 44                ld b,h           ;   4 : 44
6109+ 7793 4D                ld c,l           ;   4 : 4D
6110+ 7794 29                add hl,hl        ;  11 : 29
6111+ 7795 29                add hl,hl        ;  11 : 29
6112+ 7796 09                add hl,bc        ;  11 : 09
6113+ 7797 29                add hl,hl        ;  11 : 29
6114+ 7798                                    ;
6115+ 7798 85                add a,l          ;   4 : 85
6116+ 7799 6F                ld l,a           ;   4 : 6F
6117+ 779A 30 EF             jr nc,ConvLoop   ;12|23: 30EE
6118+ 779C 24                inc h            ; --- : 24
6119+ 779D 18 EC             jr ConvLoop      ; --- : 18EB
6120+ 779F
6121+ 779F
6122+ 779F

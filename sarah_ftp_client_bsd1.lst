  279+0000              ;FTP commands of interest:
  280+0000              ;done	USER		username
  281+0000              ;done	PASS		password
  282+0000              ;done	PASV		enter passive mode
  283+0000              ;done	QUIT		quit ftp connection
  284+0000              ;done	STOR		upload file		;max transfer block allowed by ESP modele= 2048 bytes, top speed is 2,53 kb/sec
  285+0000              ;done	RETR		download file
  286+0000              ;done	SIZE		return file size
  287+0000              ;done	ABOR		abort command		;in case we got stuck, ABOR will return us
  288+0000              ;done	APPE		append file		;if uploaded file exist, you may choose to overwrite it or append
  289+0000              ;done	NOOP					;check if ftp connection is alive (ver 0.7.)
  290+0000              ;done	STOU					;new from 0.8 up
  291+0000              ;done	LIST
  292+0000              ;done	NLST
  293+0000              ;done	PWD
  294+0000              ;done	CWD
  295+0000              ;done	CDUP
  296+0000              ;done	DELE
  297+0000              ;done	MKD
  298+0000              ;done	RMD
  299+0000              ;done	RNFR+RNTO
  300+0000
  301+0000              ;the following need passive mode:
  302+0000              ;	RETR		download file
  303+0000              ;	STOR		upload file
  304+0000              ;	STOU		like STOR, but a new file is set
  305+0000              ;	LIST		download directory list
  306+0000              ;	NLST argument	list of directory "argument" and file names (without attributes)
  307+0000
  308+0000              ;the following do not need passive mode:
  309+0000              ;	MKD argument	make new directory called "argument"
  310+0000              ;	RMD argument	remove directory called "argument"
  311+0000              ;	RNFR+RNTO	rename file
  312+0000              ;	SIZE		find out file length
  313+0000              ;	QUIT		quits ftp connection
  314+0000              ;	PWD		returns current directory name
  315+0000              ;	CWD argument	go to directory "argument"
  316+0000              ;	CDUP		go to up directory
  317+0000              ;	DELE argument	delete file "argument"
  318+0000
  319+0000              ;overview:
  320+0000              ;LOW LEVEL- SENDING
  321+0000              ;1) send_string:	mainly to send direct AT commands
  322+0000              ;2) send_data:		to send any type of data
  323+0000              ;LOW LEVEL- RECEIVING
  324+0000              ;7) receive_data_timeout receive data with timeout.IN=BC=max.length of data to receive, HL=sata start, OUT Z= ok, received
  325+0000              ;LOW LEVEL- PARSING
  326+0000              ;10) look_for_string:	seeks certain string in memory
  327+0000              ;11) look_on_fly:	seeks certain string in the incoming flow of bytes
  328+0000              ;12) search_by_Busy	seeks string in memory, according to Busy (in BSDOS)
  329+0000              ;13) search_until_zero

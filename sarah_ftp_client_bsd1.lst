 6576+7C04              ; --- DOKUMENTACE CZ: convASCII2hex ---
 6577+7C04              ; Ucel: Složí dolní půlbajty dvou znaků do jednoho bajtu.
 6578+7C04              ; Vstup: HL = adresa dvou ASCII číslic, např. "14".
 6579+7C04              ; Vystup: A = #14 pro vstup "14"; HL ukazuje na druhý znak.
 6580+7C04              ; Meni: AF, E, HL; D, BC, IX a IY zachovány.
 6581+7C04              ; Poznamka: Není obecný hexadecimální parser: nepřevádí písmena A–F.
 6582+7C04              ; --- KONEC DOKUMENTACE CZ ---
 6583+7C04              convASCII2hex
 6584+7C04              ;IN=HL ASCII number address (2 digits) eg. hl,14
 6585+7C04              ;OUT=A=#14
 6586+7C04 7E           		ld	a,(hl)
 6587+7C05 E6 0F        		and	%00001111
 6588+7C07 CB 27        		sla	a
 6589+7C09 CB 27        		sla	a
 6590+7C0B CB 27        		sla	a
 6591+7C0D CB 27        		sla	a
 6592+7C0F 5F           		ld	e,a
 6593+7C10 23           		inc	hl
 6594+7C11 7E           		ld	a,(hl)
 6595+7C12 E6 0F        		and	%00001111
 6596+7C14 B3           		or	e
 6597+7C15 C9           		ret

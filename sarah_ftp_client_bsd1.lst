3032+ 69F5              ; -----------------------------------------------------------------------------
3033+ 69F5              ; search_by_Busy_dir_slow
3034+ 69F5              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
3035+ 69F5              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
3036+ 69F5              ; no longer slows down every ordinary FIND operation.
3037+ 69F5              ;
3038+ 69F5              ; One-character FIND is handled before this fallback and compares only the
3039+ 69F5              ; first character.  This slow path therefore normally handles 2+ character
3040+ 69F5              ; substring searches whose source name crosses a directory-bank boundary.
3041+ 69F5              ; -----------------------------------------------------------------------------
3042+ 69F5              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
3043+ 69F5              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
3044+ 69F5              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
3045+ 69F5              ;   a délka.
3046+ 69F5              ; Vystup: Z = shoda, NZ = nenalezeno.
3047+ 69F5              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
3048+ 69F5              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
3049+ 69F5              ; --- KONEC DOKUMENTACE CZ ---
3050+ 69F5              search_by_Busy_dir_slow:
3051+ 69F5 22 5B 6E             ld      (dir_search_addr),hl
3052+ 69F8 ED 43 5F 6E          ld      (dir_search_remaining),bc
3053+ 69FC ED 5B 54 6E          ld      de,(item_name_page)
3054+ 6A00 ED 53 5D 6E          ld      (dir_search_page),de
3055+ 6A04 2A D3 76             ld      hl,(txtlen+1)
3056+ 6A07 22 61 6E             ld      (dir_search_patlen),hl
3057+ 6A0A 7C                   ld      a,h
3058+ 6A0B B5                   or      l
3059+ 6A0C 28 56                jr      z,.dir_search_found
3060+ 6A0E
3061+ 6A0E              .dir_search_outer:
3062+ 6A0E                      ;If remaining source length < pattern length, no further match exists.
3063+ 6A0E 2A 5F 6E             ld      hl,(dir_search_remaining)
3064+ 6A11 ED 5B 61 6E          ld      de,(dir_search_patlen)
3065+ 6A15 B7                   or      a
3066+ 6A16 ED 52                sbc     hl,de
3067+ 6A18 38 4C                jr      c,.dir_search_not_found
3068+ 6A1A
3069+ 6A1A                      ;Start one comparison at current candidate address/page.
3070+ 6A1A 2A 5B 6E             ld      hl,(dir_search_addr)
3071+ 6A1D ED 5B 5D 6E          ld      de,(dir_search_page)
3072+ 6A21 CD 66 69             call    DIR128_MAP_DE
3073+ 6A24 11 7C 8B             ld      de,INPBUFF
3074+ 6A27 ED 4B 61 6E          ld      bc,(dir_search_patlen)
3075+ 6A2B
3076+ 6A2B              .dir_search_cmp:
3077+ 6A2B 7E                   ld      a,(hl)
3078+ 6A2C CD F7 76             call    convert                 ;source char -> lower case
3079+ 6A2F EB                   ex      de,hl
3080+ 6A30 BE                   cp      (hl)                    ;pattern already normalized by FIND
3081+ 6A31 EB                   ex      de,hl
3082+ 6A32 20 0D                jr      nz,.dir_search_advance_candidate
3083+ 6A34
3084+ 6A34 13                   inc     de
3085+ 6A35 0B                   dec     bc
3086+ 6A36 78                   ld      a,b
3087+ 6A37 B1                   or      c
3088+ 6A38 28 2A                jr      z,.dir_search_found
3089+ 6A3A CD D7 68             call    DIR128_INC_HL
3090+ 6A3D 38 27                jr      c,.dir_search_not_found
3091+ 6A3F 18 EA                jr      .dir_search_cmp
3092+ 6A41
3093+ 6A41              .dir_search_advance_candidate:
3094+ 6A41                      ;Always advance by exactly ONE source character.  This fixes both the
3095+ 6A41                      ;old overlapping-match bug and the old one-character special case.
3096+ 6A41 2A 5B 6E             ld      hl,(dir_search_addr)
3097+ 6A44 ED 5B 5D 6E          ld      de,(dir_search_page)
3098+ 6A48 CD 66 69             call    DIR128_MAP_DE
3099+ 6A4B CD D7 68             call    DIR128_INC_HL
3100+ 6A4E 38 16                jr      c,.dir_search_not_found
3101+ 6A50 22 5B 6E             ld      (dir_search_addr),hl
3102+ 6A53 ED 5B F6 BF          ld      de,(fdp_pointer)
3103+ 6A57 ED 53 5D 6E          ld      (dir_search_page),de
3104+ 6A5B 2A 5F 6E             ld      hl,(dir_search_remaining)
3105+ 6A5E 2B                   dec     hl
3106+ 6A5F 22 5F 6E             ld      (dir_search_remaining),hl
3107+ 6A62 18 AA                jr      .dir_search_outer
3108+ 6A64
3109+ 6A64              .dir_search_found:
3110+ 6A64 AF                   xor     a                       ;Z
3111+ 6A65 C9                   ret
3112+ 6A66              .dir_search_not_found:
3113+ 6A66 3E 01                ld      a,1
3114+ 6A68 B7                   or      a                       ;NZ
3115+ 6A69 C9                   ret

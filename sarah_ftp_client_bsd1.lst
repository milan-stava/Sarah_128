4174+ 6FCD 56           		ld	d,(hl)
4175+ 6FCE ED 53 40 6E  		ld	(next_item_addr),de	;temporary physical start
4176+ 6FD2 EB           		ex	de,hl			;HL=current physical item start
4177+ 6FD3
4178+ 6FD3              		;Load/map directory page from page companion variable.
4179+ 6FD3 E5           		push	hl
4180+ 6FD4 2A 4A 6E     		ld	hl,(dir_op_page_var)
4181+ 6FD7 5E           		ld	e,(hl)
4182+ 6FD8 23           		inc	hl
4183+ 6FD9 56           		ld	d,(hl)
4184+ 6FDA E1           		pop	hl
4185+ 6FDB CD 66 69     		call	DIR128_MAP_DE
4186+ 6FDE
4187+ 6FDE              		;Read item length LOW/HIGH. Header itself may cross #FFFF/#C000.
4188+ 6FDE 7E           		ld	a,(hl)
4189+ 6FDF 5F           		ld	e,a			;E=length LOW
4190+ 6FE0 CD D7 68     		call	DIR128_INC_HL
4191+ 6FE3 38 4C        		jr	c,item_add_end
4192+ 6FE5 7E           		ld	a,(hl)
4193+ 6FE6 57           		ld	d,a			;DE=item length
4194+ 6FE7 B3           		or	e
4195+ 6FE8 28 47        		jr	z,item_add_end		;00 00 = real end of directory
4196+ 6FEA
4197+ 6FEA              		;We are at item_start+1.
4198+ 6FEA              		;Next item = item_start + item_length + 4.
4199+ 6FEA              		;Therefore move 3 fixed bytes, then item_length bytes.
4200+ 6FEA 3E 03        		ld	a,3

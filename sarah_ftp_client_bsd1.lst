2936+ 6AE8              ; -----------------------------------------------------------------------------
2937+ 6AE8              ; search_by_Busy_dir_slow
2938+ 6AE8              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
2939+ 6AE8              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
2940+ 6AE8              ; no longer slows down every ordinary FIND operation.
2941+ 6AE8              ;
2942+ 6AE8              ; One-character FIND is handled before this fallback and compares only the
2943+ 6AE8              ; first character.  This slow path therefore normally handles 2+ character
2944+ 6AE8              ; substring searches whose source name crosses a directory-bank boundary.
2945+ 6AE8              ; -----------------------------------------------------------------------------
2946+ 6AE8              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
2947+ 6AE8              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
2948+ 6AE8              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
2949+ 6AE8              ;   a délka.
2950+ 6AE8              ; Vystup: Z = shoda, NZ = nenalezeno.
2951+ 6AE8              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2952+ 6AE8              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
2953+ 6AE8              ; --- KONEC DOKUMENTACE CZ ---
2954+ 6AE8              search_by_Busy_dir_slow:
2955+ 6AE8 22 BD 6F             ld      (dir_search_addr),hl
2956+ 6AEB ED 43 C1 6F          ld      (dir_search_remaining),bc
2957+ 6AEF ED 5B B6 6F          ld      de,(item_name_page)
2958+ 6AF3 ED 53 BF 6F          ld      (dir_search_page),de
2959+ 6AF7 2A A3 78             ld      hl,(txtlen+1)
2960+ 6AFA 22 C3 6F             ld      (dir_search_patlen),hl
2961+ 6AFD 7C                   ld      a,h
2962+ 6AFE B5                   or      l
2963+ 6AFF 28 56                jr      z,.dir_search_found
2964+ 6B01
2965+ 6B01              .dir_search_outer:
2966+ 6B01                      ;If remaining source length < pattern length, no further match exists.
2967+ 6B01 2A C1 6F             ld      hl,(dir_search_remaining)
2968+ 6B04 ED 5B C3 6F          ld      de,(dir_search_patlen)
2969+ 6B08 B7                   or      a
2970+ 6B09 ED 52                sbc     hl,de
2971+ 6B0B 38 4C                jr      c,.dir_search_not_found
2972+ 6B0D
2973+ 6B0D                      ;Start one comparison at current candidate address/page.
2974+ 6B0D 2A BD 6F             ld      hl,(dir_search_addr)
2975+ 6B10 ED 5B BF 6F          ld      de,(dir_search_page)
2976+ 6B14 CD 59 6A             call    DIR128_MAP_DE
2977+ 6B17 11 D8 8E             ld      de,INPBUFF
2978+ 6B1A ED 4B C3 6F          ld      bc,(dir_search_patlen)
2979+ 6B1E
2980+ 6B1E              .dir_search_cmp:
2981+ 6B1E 7E                   ld      a,(hl)
2982+ 6B1F CD C7 78             call    convert                 ;source char -> lower case
2983+ 6B22 EB                   ex      de,hl
2984+ 6B23 BE                   cp      (hl)                    ;pattern already normalized by FIND
2985+ 6B24 EB                   ex      de,hl
2986+ 6B25 20 0D                jr      nz,.dir_search_advance_candidate
2987+ 6B27
2988+ 6B27 13                   inc     de
2989+ 6B28 0B                   dec     bc
2990+ 6B29 78                   ld      a,b
2991+ 6B2A B1                   or      c
2992+ 6B2B 28 2A                jr      z,.dir_search_found
2993+ 6B2D CD CA 69             call    DIR128_INC_HL
2994+ 6B30 38 27                jr      c,.dir_search_not_found
2995+ 6B32 18 EA                jr      .dir_search_cmp
2996+ 6B34
2997+ 6B34              .dir_search_advance_candidate:
2998+ 6B34                      ;Always advance by exactly ONE source character.  This fixes both the
2999+ 6B34                      ;old overlapping-match bug and the old one-character special case.
3000+ 6B34 2A BD 6F             ld      hl,(dir_search_addr)
3001+ 6B37 ED 5B BF 6F          ld      de,(dir_search_page)
3002+ 6B3B CD 59 6A             call    DIR128_MAP_DE
3003+ 6B3E CD CA 69             call    DIR128_INC_HL
3004+ 6B41 38 16                jr      c,.dir_search_not_found
3005+ 6B43 22 BD 6F             ld      (dir_search_addr),hl
3006+ 6B46 ED 5B F6 BF          ld      de,(fdp_pointer)
3007+ 6B4A ED 53 BF 6F          ld      (dir_search_page),de
3008+ 6B4E 2A C1 6F             ld      hl,(dir_search_remaining)
3009+ 6B51 2B                   dec     hl
3010+ 6B52 22 C1 6F             ld      (dir_search_remaining),hl
3011+ 6B55 18 AA                jr      .dir_search_outer
3012+ 6B57
3013+ 6B57              .dir_search_found:
3014+ 6B57 AF                   xor     a                       ;Z
3015+ 6B58 C9                   ret
3016+ 6B59              .dir_search_not_found:
3017+ 6B59 3E 01                ld      a,1
3018+ 6B5B B7                   or      a                       ;NZ
3019+ 6B5C C9                   ret

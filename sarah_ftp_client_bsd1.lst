5933+ 79B7 CD CC 79     			call string_dl
5934+ 79BA              ; --- DOKUMENTACE CZ: HL2ASCII_000 ---
5935+ 79BA              ; Ucel: Vstup do převodu od řádu desetitisíců, resp. stovek.
5936+ 79BA              ; Vstup: HL = číslo, DE = cíl; bit 7 v (IX+0) řídí tisk úvodních nul.
5937+ 79BA              ; Vystup: DE za poslední číslicí, bez nulového terminátoru.
5938+ 79BA              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
5939+ 79BA              ; Poznamka: Na rozdíl od HL2ASCII nenuluje bit 7. Pro pevnou šířku jej nastavte před voláním.
5940+ 79BA              ; --- KONEC DOKUMENTACE CZ ---
5941+ 79BA 01 64 00     HL2ASCII_000		ld bc,100

2748+ 6A14              ; -----------------------------------------------------------------------------
2749+ 6A14              ; search_by_Busy_fast
2750+ 6A14              ; Fast case-insensitive substring search for a name fully contained in the
2751+ 6A14              ; currently mapped 16K directory page.
2752+ 6A14              ;
2753+ 6A14              ; IN:  HL = name start, BC = 16-bit name length
2754+ 6A14              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
2755+ 6A14              ; OUT: Z = found, NZ = not found
2756+ 6A14              ;
2757+ 6A14              ; This is deliberately close to the original Busy FIND: the inner compare uses
2758+ 6A14              ; the Z80 CPI instruction.  The pattern has already been converted to lower
2759+ 6A14              ; case once by find_items, so only the source character needs convert here.
2760+ 6A14              ;
2761+ 6A14              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
2762+ 6A14              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
2763+ 6A14              ; matches therefore cannot be skipped.
2764+ 6A14              ; -----------------------------------------------------------------------------
2765+ 6A14              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
2766+ 6A14              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
2767+ 6A14              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
2768+ 6A14              ;   délka.
2769+ 6A14              ; Vystup: Z = shoda, NZ = nenalezeno.
2770+ 6A14              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2771+ 6A14              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
2772+ 6A14              ; --- KONEC DOKUMENTACE CZ ---
2773+ 6A14              search_by_Busy_fast:
2774+ 6A14 EB                   ex      de,hl                   ;DE=current candidate in file name
2775+ 6A15
2776+ 6A15                      ; candidate_count = name_length - pattern_length + 1
2777+ 6A15 60                   ld      h,b
2778+ 6A16 69                   ld      l,c
2779+ 6A17 ED 4B C1 77          ld      bc,(txtlen+1)
2780+ 6A1B 78                   ld      a,b
2781+ 6A1C B1                   or      c
2782+ 6A1D 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
2783+ 6A1F B7                   or      a
2784+ 6A20 ED 42                sbc     hl,bc
2785+ 6A22 38 25                jr      c,.fast_not_found       ;pattern longer than file name
2786+ 6A24 23                   inc     hl
2787+ 6A25
2788+ 6A25                      ; Keep number of possible candidate starts in alternate BC.
2789+ 6A25 E5                   push    hl
2790+ 6A26 D9                   exx
2791+ 6A27 C1                   pop     bc
2792+ 6A28 D9                   exx
2793+ 6A29
2794+ 6A29              .fast_next_candidate:
2795+ 6A29 D5                   push    de                      ;remember exact candidate start
2796+ 6A2A 21 15 8D             ld      hl,INPBUFF
2797+ 6A2D ED 4B C1 77          ld      bc,(txtlen+1)
2798+ 6A31
2799+ 6A31              .fast_compare:
2800+ 6A31 1A                   ld      a,(de)
2801+ 6A32 CD E5 77             call    convert                 ;source char -> lower case
2802+ 6A35 ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
2803+ 6A37 13                   inc     de
2804+ 6A38 20 06                jr      nz,.fast_candidate_failed
2805+ 6A3A EA 31 6A             jp      pe,.fast_compare        ;matched, more pattern bytes remain
2806+ 6A3D
2807+ 6A3D D1                   pop     de                      ;discard saved candidate start
2808+ 6A3E              .fast_found:
2809+ 6A3E AF                   xor     a                       ;Z = found
2810+ 6A3F C9                   ret
2811+ 6A40
2812+ 6A40              .fast_candidate_failed:
2813+ 6A40 D1                   pop     de                      ;restore previous candidate start
2814+ 6A41 13                   inc     de                      ;next candidate = previous + 1
2815+ 6A42 D9                   exx
2816+ 6A43 0B                   dec     bc
2817+ 6A44 78                   ld      a,b
2818+ 6A45 B1                   or      c
2819+ 6A46 D9                   exx
2820+ 6A47 20 E0                jr      nz,.fast_next_candidate
2821+ 6A49
2822+ 6A49              .fast_not_found:
2823+ 6A49 3E 01                ld      a,1
2824+ 6A4B B7                   or      a                       ;NZ = not found
2825+ 6A4C C9                   ret

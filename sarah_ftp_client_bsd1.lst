  978+626B              ; --- DOKUMENTACE CZ: find_out_speed ---
  979+626B              ; Ucel: Zjistí index aktuální rychlosti UART, případně rychlosti vyzkouší.
  980+626B              ; Vstup: IX = flag1; dostupné služby get_baud/set_baud.
  981+626B              ; Vystup: D = index zjištěné rychlosti při úspěchu.
  982+626B              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
  983+626B              ; Poznamka: Při nepodporovaném get_baud používá switch_speed; jeho neúspěch nepovažujte za
  984+626B              ;   platnou rychlost.
  985+626B              ; --- KONEC DOKUMENTACE CZ ---
  986+626B              find_out_speed					;subroutine is able to find out current speed for all MBFW, output in D
  987+626B CD F9 9E     		call	get_baud		;we are at aligned speed, is the one we want?
  988+626E 30 04        		jr	nc,fos1			;C=speed reading not supported by given MBFW
  989+6270 CD 76 62     		call	switch_speed		;in case of MBFW 7, 12-> find out currently aligned speed
  990+6273 7A           		ld	a,d
  991+6274 57           fos1		ld	d,a			;D=curently aligned speed
  992+6275 C9           		ret
  993+6276
  994+6276              						;tests speeds <7-0>, then <max-8>
  995+6276              ;switch_speed	ld	a,7			;start with speeds 7-0 (quicker finds the speed)
  996+6276              ;		call	sws2
  997+6276              ;		ret	z			;Z= speed <0,7> found
  998+6276
  999+6276              ; --- DOKUMENTACE CZ: switch_speed ---
 1000+6276              ; Ucel: Zkouší rychlosti UART sestupně od maximální až po nulu.
 1001+6276              ; Vstup: (IX+8) = nejvyšší zkoušený index rychlosti.
 1002+6276              ; Vystup: Z = modul odpověděl OK, D = nalezený index; NZ = nenalezeno.
 1003+6276              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
 1004+6276              ; Poznamka: Mění UART a (IX+6), vyprazdňuje příjem.
 1005+6276              ; --- KONEC DOKUMENTACE CZ ---
 1006+6276 DD 7E 08     switch_speed	ld	a,(ix+8)		;try out every speed if you find connection UART+Wifi
 1007+6279              						;start with max speed, end with 0
 1008+6279 F5           sws2		push	af
 1009+627A CD 81 7D     		call	set_print_speed
 1010+627D
 1011+627D CD FB 9E     		call	clear_rece_buf		;very important to clear receive buffer!!!
 1012+6280
 1013+6280 F1           		pop	af			;we need to inrease timeout for speeds <3
 1014+6281 F5           		push	af
 1015+6282 FE 03        		cp	3
 1016+6284 DD 36 06 01  		ld	(ix+6),1		;set timeout for 1 for speeds >3
 1017+6288 30 04        		jr	nc,sws1
 1018+628A DD 36 06 0A  		ld	(ix+6),#A		;set tieout for #A for speeds <2
 1019+628E
 1020+628E CD 49 7D     sws1		call	send_at_check_ok
 1021+6291 D1           		pop	de
 1022+6292 C8           		ret	z			;Z=answer found, D= speed set in HW
 1023+6293 7A           		ld	a,d
 1024+6294 3D           		dec	a
 1025+6295 FE FF        		cp	255			;test for 255, so that also speed 0 is tested
 1026+6297 20 E0        		jr	nz,sws2
 1027+6299 3D           		dec	a			;NZ=not successfull
 1028+629A C9           		ret

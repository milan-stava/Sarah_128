  961+624C CD 8F 78     		call	print_ez1
  962+624F              ;		ld	bc,30
  963+624F
  964+624F DD CB 00 AE  speed_m_error	res	5,(ix+0)		;set signal wifi not connected to AP
  965+6253              ;		jp	error
  966+6253 CD DB 7B     sme1		call	akey
  967+6256 CD 80 75     		call	undraw_cursor		;return from AP selection
  968+6259 CD A3 75     		call	wind_cls
  969+625C CD 14 7B     		call	clear_edit_zone
  970+625F C9           		ret
  971+6260              ;zde konci vetev, kdy na pocatku SM2.0 nebylo nalezeno slazeni rychlosti
  972+6260
  973+6260              ;zde jsme ze zacatku rychlost nasli a zkoumame, zda je to ta, kterou chceme, pokud ne, tak ji nastav
  974+6260 CD 8F 62     speed_aligned	call	find_out_speed		;output: D= currently aligned speed
  975+6263 DA 49 62             jp c,speed_uart_err
  976+6266 CD 0B 7C     align_success	call	set_ud_speed
  977+6269
  978+6269              ;ve speed_we_want vyhodnotit, zda je odezva na AT prikaz. Pokud ne, neznamená to, e
  979+6269              ;rychlosti nebyly slazeny, ale ze nektere z rychlosti 0-23 nekomunikuji s modulem.
  980+6269 DD 36 06 0A  speed_we_want	ld	(ix+6),#A
  981+626D CD 72 7A     		call	send_at_check_ok
  982+6270 20 D7        		jr	nz,speed_uart_err
  983+6272
  984+6272              wifi_cont					;we are at speed we want. Final steps... print UART speed+ Baud speed
  985+6272              ;Alignment is recorded only after the final ATE0 acknowledgement.
  986+6272
  987+6272              ;		call	get_baud
  988+6272 CD 8F 62     		call	find_out_speed
  989+6275 DA 49 62             jp c,speed_uart_err
  990+6278 7A           		ld	a,d			;A=aligned speed we ended with
  991+6279 DD 77 07     		ld	(ix+7),a		;save it
  992+627C CD B1 7A     		call	print_speed
  993+627F
  994+627F 21 0B 88             ld hl,ate0
  995+6282 CD B3 A0             call at_send_ok
  996+6285 0E 33                ld c,51
  997+6287 DA 0E 7E             jp c,error_handler
  998+628A DD CB 00 F6          set 6,(ix+0)
  999+628E C9                   ret

7621+ 7DCD CD CC 82                call passive_receive_off ;one best-effort cleanup attempt only
7622+ 7DD0              error_handler_exit
7623+ 7DD0 AF                      xor a
7624+ 7DD1 32 DF 7D                ld (error_recovering),a
7625+ 7DD4 DD CB 00 76             bit 6,(ix+0)
7626+ 7DD8 CA 32 77                jp z,quit_keep_directory
7627+ 7DDB 31 FE 5F                ld sp,basic_end-2
7628+ 7DDE C9                      ret
7629+ 7DDF 00           error_recovering db 0

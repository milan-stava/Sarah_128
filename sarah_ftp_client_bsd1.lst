 7698+7F05              ; --- DOKUMENTACE CZ: error_handler ---
 7699+7F05              ; Ucel: Zobrazí chybu, ukončí čekání a vrátí řízení na nejvyšší úroveň.
 7700+7F05              ; Vstup: C = číslo chyby; inicializovaný hlavní zásobník.
 7701+7F05              ; Vystup: Nevrací se běžně volajícímu: SP nastaví na basic_end-2.
 7702+7F05              ; Meni: AF, BC, DE, HL, BC' (přes příjem odpovědi); další registry externích služeb viz jejich
 7703+7F05              ;   rozhraní. SP.
 7704+7F05              ; Poznamka: Obnovuje 3,5 MHz a vypíná pasivní příjem.
 7705+7F05              ; --- KONEC DOKUMENTACE CZ ---
 7706+7F05 AF           error_handler xor a
 7707+7F06 32 AC A1                ld (upload_legacy_mode),a
 7708+7F09 C5                      push bc                ;preserve original error across clock switch
 7709+7F0A CD D4 82                call set_3_5mhz
 7710+7F0D C1                      pop bc
 7711+7F0E 3A 39 7F                ld a,(error_recovering)
 7712+7F11 B7                      or a
 7713+7F12 20 16                   jr nz,error_handler_exit ;cleanup itself failed: do not recurse again
 7714+7F14 3C                      inc a
 7715+7F15 32 39 7F                ld (error_recovering),a
 7716+7F18 CD 3A 7F                call display_error
 7717+7F1B CD FA 7C                call wifi_unwait
 7718+7F1E CD AC A5                call at_reset_stream
 7719+7F21 DD CB 00 76             bit 6,(ix+0)
 7720+7F25 28 03                   jr z,error_handler_exit ;no cleanup AT commands at an unknown baud
 7721+7F27 CD 26 84                call passive_receive_off ;one best-effort cleanup attempt only
 7722+7F2A              error_handler_exit
 7723+7F2A AF                      xor a
 7724+7F2B 32 39 7F                ld (error_recovering),a
 7725+7F2E DD CB 00 76             bit 6,(ix+0)
 7726+7F32 CA 8C 78                jp z,quit_keep_directory
 7727+7F35 31 FE 5F                ld sp,basic_end-2
 7728+7F38 C9                      ret
 7729+7F39 00           error_recovering db 0

4110+ 72A7              ; item_add / item_sub - 128K bank-aware directory movement
4111+ 72A7              ;
4112+ 72A7              ; IN:
4113+ 72A7              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
4114+ 72A7              ;       DE = address of its 16-bit page-table-pointer companion
4115+ 72A7              ;
4116+ 72A7              ; Example:
4117+ 72A7              ;       ld bc,cur_item_addr
4118+ 72A7              ;       ld de,cur_item_addr_page
4119+ 72A7              ;       call item_add
4120+ 72A7              ;
4121+ 72A7              ; OUT:
4122+ 72A7              ;       Z  = cannot move (end/start of directory)
4123+ 72A7              ;       NZ = pointer + its bank companion were moved to adjacent item
4124+ 72A7              ;
4125+ 72A7              ; The address variable and page variable deliberately do NOT have to be adjacent.
4126+ 72A7              ; This keeps the original IX+... variable layout completely unchanged.
4127+ 72A7              ; The two-byte item length at either end of an item may itself cross a bank.
4128+ 72A7              ; -----------------------------------------------------------------------------
4129+ 72A7              ; --- DOKUMENTACE CZ: item_add ---
4130+ 72A7              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
4131+ 72A7              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
4132+ 72A7              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
4133+ 72A7              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
4134+ 72A7              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
4135+ 72A7              ; --- KONEC DOKUMENTACE CZ ---
4136+ 72A7              item_add
4137+ 72A7 ED 43 D4 6F  		ld	(dir_op_addr_var),bc
4138+ 72AB ED 53 D6 6F  		ld	(dir_op_page_var),de

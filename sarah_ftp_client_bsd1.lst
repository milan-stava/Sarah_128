 8718+8379              ; data_available_in_module_file:
 8719+8379              ; NZ/NC = HL available data (clamped to download_length).
 8720+8379              ; Z/NC = closed socket with no queued bytes; Z/C = user pressed B.
 8721+8379              ; Temporary emptiness is paced and retried, never treated as EOF.
 8722+8379              ; Empty polls wait until data, confirmed closure or B; AT query replies remain bounded.
 8723+8379              ; Changes AF/BC/DE/HL. Directory polling above keeps its own completion policy.
 8724+8379              data_available_in_module_file
 8725+8379              .file_wait:
 8726+8379 CD 3B 9F             call    ftp_query_lengths
 8727+837C 7C                   ld      a,h
 8728+837D B5                   or      l
 8729+837E 20 11                jr      nz,.file_data
 8730+8380 3A EF A4             ld      a,(at_closed)
 8731+8383 E6 03                and     3
 8732+8385 20 0D                jr      nz,.file_closed ; real closure plus empty buffer, not a Wi-Fi pause
 8733+8387 CD 32 9F             call    ftp_poll_delay
 8734+838A CD 43 9E             call    ftp_poll_cancel
 8735+838D 38 0E                jr      c,.file_cancel
 8736+838F 18 E8                jr      .file_wait
 8737+8391              .file_data:
 8738+8391 C3 AA 83             jp      dam_available
 8739+8394              .file_closed:
 8740+8394 CD 3B 9F             call    ftp_query_lengths ; recheck after closure notice: final bytes may be queued
 8741+8397 7C                   ld      a,h
 8742+8398 B5                   or      l
 8743+8399 20 F6                jr      nz,.file_data
 8744+839B AF                   xor     a
 8745+839C C9                   ret
 8746+839D              .file_cancel:
 8747+839D AF                   xor     a
 8748+839E 37                   scf
 8749+839F C9                   ret

5943+ 79C0 01 0A 00     			ld bc,10
5944+ 79C3 CD CC 79     			call string_dl
5945+ 79C6 7D           			ld a,l
5946+ 79C7 C6 30        			add a,'0'
5947+ 79C9 12           			LD (DE),A

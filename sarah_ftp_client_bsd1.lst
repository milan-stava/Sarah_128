2867+ 697A 78                   ld      a,b
2868+ 697B B1                   or      c
2869+ 697C C8                   ret     z
2870+ 697D 7E                   ld      a,(hl)
2871+ 697E 12                   ld      (de),a
2872+ 697F 13                   inc     de
2873+ 6980 0B                   dec     bc
2874+ 6981 78                   ld      a,b
2875+ 6982 B1                   or      c
2876+ 6983 C8                   ret     z
2877+ 6984 CD D7 68             call    DIR128_INC_HL
2878+ 6987 D8                   ret     c                       ;should only happen on malformed item
2879+ 6988 18 F0                jr      .dir128_copy_loop

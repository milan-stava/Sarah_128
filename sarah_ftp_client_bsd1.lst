4084+ 70D8 B3           		or	e
4085+ 70D9 28 08        		jr	z,item_add_at_next
4086+ 70DB CD 3A 69     		call	DIR128_INC_HL
4087+ 70DE 38 34        		jr	c,item_add_end
4088+ 70E0 1B           		dec	de
4089+ 70E1 18 F4        		jr	item_add_lenloop
4090+ 70E3
4091+ 70E3              item_add_at_next
4092+ 70E3              		;Save exact candidate next-item position and its bank before peeking
4093+ 70E3              		;at its 00 00 / length header.

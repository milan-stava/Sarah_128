2546+ 6A20 C9                   ret
2547+ 6A21
2548+ 6A21              DIR128_INC_CROSS:
2549+ 6A21 D5                   push    de
2550+ 6A22 ED 5B F6 BF          ld      de,(fdp_pointer)
2551+ 6A26 13                   inc     de
2552+ 6A27 1A                   ld      a,(de)
2553+ 6A28 FE FF                cp      #FF
2554+ 6A2A 28 0E                jr      z,DIR128_INC_END
2555+ 6A2C ED 53 F6 BF          ld      (fdp_pointer),de
2556+ 6A30 CD E0 BF             call    PAGE128

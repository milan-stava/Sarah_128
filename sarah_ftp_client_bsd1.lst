10003+8905              	IFDEF hgfx64x24
10004+8905 ~            ;95) set_fdma_to_chars
10005+8905 ~            ; --- DOKUMENTACE CZ: set_fdma_to_chars ---
10006+8905 ~            ; Ucel: Nastaví FDMA pro vykreslování osmibajtových znaků.
10007+8905 ~            ; Vstup: Bez parametrů.
10008+8905 ~            ; Vystup: FD_Copy=1, FD_Mod=63, F_Len=8; A=0, Z, NC.
10009+8905 ~            ; Meni: AF, DE, HL; BC, IX a IY zachovány.
10010+8905 ~            ; --- KONEC DOKUMENTACE CZ ---
10011+8905 ~            set_fdma_to_chars
10012+8905 ~            	push	bc
10013+8905 ~            	ld	hl,1	;1 bajt zkopiruj
10014+8905 ~            	ld	de,63	;...a 63 preskoc
10015+8905 ~            	ld	bc,8	;znak ma 8 bajtu
10016+8905 ~            	jr	sftc1
10017+8905 ~
10018+8905 ~            ;96)
10019+8905 ~            ; --- DOKUMENTACE CZ: set_fdma_to_fill_len_in_bc_512 ---
10020+8905 ~            ; Ucel: Nastaví FDMA pro souvislou výplň 512 bajtů.
10021+8905 ~            ; Vstup: Bez parametru délky: BC se pouze uchovává.
10022+8905 ~            ; Vystup: FD_Copy=0, FD_Mod=0, F_Len=512; HL=DE=0, A=0, Z, NC.
10023+8905 ~            ; Meni: AF, DE, HL; BC, IX a IY zachovány.
10024+8905 ~            ; Poznamka: Přes historický název a komentář se délka z BC nepoužívá.
10025+8905 ~            ; --- KONEC DOKUMENTACE CZ ---
10026+8905 ~            set_fdma_to_fill_len_in_bc_512
10027+8905 ~            ;IN=BC=length
10028+8905 ~            	push	bc
10029+8905 ~            	ld	hl,0
10030+8905 ~            	ld 	d,h
10031+8905 ~            	ld	e,h
10032+8905 ~            	ld	bc,512
10033+8905 ~
10034+8905 ~            sftc1	ld	(FDMAreg.FD_Copy),hl	;...a 63 pøeskoè.
10035+8905 ~            	ld	(FDMAreg.FD_Mod),de
10036+8905 ~            	ld	(FDMAreg.F_Len),bc
10037+8905 ~            	pop	bc
10038+8905 ~            	xor	a			;signal key 0 pressed, because of main keyboard routine
10039+8905 ~            	ret
10040+8905 ~
10041+8905 ~            ;97)
10042+8905 ~            ; --- DOKUMENTACE CZ: set_hgfx_ink_planar ---
10043+8905 ~            ; Ucel: Obnoví barvu a bitové roviny pro běžný tisk HGFX.
10044+8905 ~            ; Vstup: Bez parametrů.
10045+8905 ~            ; Vystup: VIDEO_REGS.COLOR=4, VIDEO_REGS.MASK=planar_pismo.
10046+8905 ~            ; Meni: A; F, BC, DE, HL, IX a IY zachovány.
10047+8905 ~            ; --- KONEC DOKUMENTACE CZ ---
10048+8905 ~            set_hgfx_ink_planar
10049+8905 ~            		ld 	a,4			;vrat puvodni
10050+8905 ~            		ld 	(VIDEO_REGS.COLOR),a
10051+8905 ~            ;		ld	a,63
10052+8905 ~            		ld	a,planar_pismo
10053+8905 ~            		ld	(VIDEO_REGS.MASK),a
10054+8905 ~            		ret
10055+8905 ~
10056+8905              	ENDIF

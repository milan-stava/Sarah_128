7579+ 7D9E              ; --- DOKUMENTACE CZ: error_handler ---
7580+ 7D9E              ; Ucel: Zobrazí chybu, ukončí čekání a vrátí řízení na nejvyšší úroveň.
7581+ 7D9E              ; Vstup: C = číslo chyby; inicializovaný hlavní zásobník.
7582+ 7D9E              ; Vystup: Nevrací se běžně volajícímu: SP nastaví na basic_end-2.
7583+ 7D9E              ; Meni: AF, BC, DE, HL, BC' (přes příjem odpovědi); další registry externích služeb viz jejich
7584+ 7D9E              ;   rozhraní. SP.
7585+ 7D9E              ; Poznamka: Obnovuje 3,5 MHz a vypíná pasivní příjem.
7586+ 7D9E              ; --- KONEC DOKUMENTACE CZ ---
7587+ 7D9E AF           error_handler xor a
7588+ 7D9F 32 0C 9F                ld (upload_legacy_mode),a

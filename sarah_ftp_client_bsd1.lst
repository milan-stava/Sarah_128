 2825+6A7C              ; -----------------------------------------------------------------------------
 2826+6A7C              ; search_by_Busy_fast
 2827+6A7C              ; Fast case-insensitive substring search for a name fully contained in the
 2828+6A7C              ; currently mapped 16K directory page.
 2829+6A7C              ;
 2830+6A7C              ; IN:  HL = name start, BC = 16-bit name length
 2831+6A7C              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
 2832+6A7C              ; OUT: Z = found, NZ = not found
 2833+6A7C              ;
 2834+6A7C              ; This is deliberately close to the original Busy FIND: the inner compare uses
 2835+6A7C              ; the Z80 CPI instruction.  The pattern has already been converted to lower
 2836+6A7C              ; case once by find_items, so only the source character needs convert here.
 2837+6A7C              ;
 2838+6A7C              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
 2839+6A7C              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
 2840+6A7C              ; matches therefore cannot be skipped.
 2841+6A7C              ; -----------------------------------------------------------------------------
 2842+6A7C              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
 2843+6A7C              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
 2844+6A7C              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
 2845+6A7C              ;   délka.
 2846+6A7C              ; Vystup: Z = shoda, NZ = nenalezeno.
 2847+6A7C              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 2848+6A7C              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
 2849+6A7C              ; --- KONEC DOKUMENTACE CZ ---
 2850+6A7C              search_by_Busy_fast:
 2851+6A7C EB                   ex      de,hl                   ;DE=current candidate in file name
 2852+6A7D
 2853+6A7D                      ; candidate_count = name_length - pattern_length + 1
 2854+6A7D 60                   ld      h,b
 2855+6A7E 69                   ld      l,c
 2856+6A7F ED 4B 2E 79          ld      bc,(txtlen+1)
 2857+6A83 78                   ld      a,b
 2858+6A84 B1                   or      c
 2859+6A85 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
 2860+6A87 B7                   or      a
 2861+6A88 ED 42                sbc     hl,bc
 2862+6A8A 38 25                jr      c,.fast_not_found       ;pattern longer than file name
 2863+6A8C 23                   inc     hl
 2864+6A8D
 2865+6A8D                      ; Keep number of possible candidate starts in alternate BC.
 2866+6A8D E5                   push    hl
 2867+6A8E D9                   exx
 2868+6A8F C1                   pop     bc
 2869+6A90 D9                   exx
 2870+6A91
 2871+6A91              .fast_next_candidate:
 2872+6A91 D5                   push    de                      ;remember exact candidate start
 2873+6A92 21 B9 8F             ld      hl,INPBUFF
 2874+6A95 ED 4B 2E 79          ld      bc,(txtlen+1)
 2875+6A99
 2876+6A99              .fast_compare:
 2877+6A99 1A                   ld      a,(de)
 2878+6A9A CD 52 79             call    convert                 ;source char -> lower case
 2879+6A9D ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
 2880+6A9F 13                   inc     de
 2881+6AA0 20 06                jr      nz,.fast_candidate_failed
 2882+6AA2 EA 99 6A             jp      pe,.fast_compare        ;matched, more pattern bytes remain
 2883+6AA5
 2884+6AA5 D1                   pop     de                      ;discard saved candidate start
 2885+6AA6              .fast_found:
 2886+6AA6 AF                   xor     a                       ;Z = found
 2887+6AA7 C9                   ret
 2888+6AA8
 2889+6AA8              .fast_candidate_failed:
 2890+6AA8 D1                   pop     de                      ;restore previous candidate start
 2891+6AA9 13                   inc     de                      ;next candidate = previous + 1
 2892+6AAA D9                   exx
 2893+6AAB 0B                   dec     bc
 2894+6AAC 78                   ld      a,b
 2895+6AAD B1                   or      c
 2896+6AAE D9                   exx
 2897+6AAF 20 E0                jr      nz,.fast_next_candidate
 2898+6AB1
 2899+6AB1              .fast_not_found:
 2900+6AB1 3E 01                ld      a,1
 2901+6AB3 B7                   or      a                       ;NZ = not found
 2902+6AB4 C9                   ret

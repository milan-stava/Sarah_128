2411+ 68E9              ; FTP DIRECTORY BANK API
2412+ 68E9              ;
2413+ 68E9              ; fdp_pointer always points to the table byte of the CURRENT directory page.
2414+ 68E9              ; ftp_dir_page has #FF sentinels on both sides:
2415+ 68E9              ;       #FF, 0, 1, 3, 7, #FF
2416+ 68E9              ;
2417+ 68E9              ; HL is always a physical address in the banked window #C000-#FFFF.
2418+ 68E9              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
2419+ 68E9              ;
2420+ 68E9              ; OUT for INC/DEC:
2421+ 68E9              ;       NC = movement succeeded
2422+ 68E9              ;       C  = no next/previous directory page (64 KB boundary)
2423+ 68E9              ;
2424+ 68E9              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
2425+ 68E9              ; which preserves AF/BC/DE/IX/IY exactly.
2426+ 68E9              ; -----------------------------------------------------------------------------
2427+ 68E9
2428+ 68E9              ; --- DOKUMENTACE CZ: DIR128_MAP_CURRENT ---
2429+ 68E9              ; Ucel: Namapuje aktuální banku adresáře do #C000–#FFFF.
2430+ 68E9              ; Vstup: fdp_pointer ukazuje do tabulky ftp_dir_page.
2431+ 68E9              ; Vystup: NC = platná banka, C = sentinel #FF.
2432+ 68E9              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
2433+ 68E9              ; Poznamka: Mění PAGE128_STATE a port #7FFD.
2434+ 68E9              ; --- KONEC DOKUMENTACE CZ ---
2435+ 68E9              DIR128_MAP_CURRENT:
2436+ 68E9 E5                   push    hl
2437+ 68EA D5                   push    de
2438+ 68EB ED 5B F6 BF          ld      de,(fdp_pointer)
2439+ 68EF 1A                   ld      a,(de)
2440+ 68F0 FE FF                cp      #FF
2441+ 68F2 28 07                jr      z,DIR128_MAP_BAD
2442+ 68F4 CD E0 BF             call    PAGE128
2443+ 68F7 D1                   pop     de
2444+ 68F8 E1                   pop     hl
2445+ 68F9 B7                   or      a                       ;NC = valid page
2446+ 68FA C9                   ret
2447+ 68FB              DIR128_MAP_BAD:
2448+ 68FB D1                   pop     de
2449+ 68FC E1                   pop     hl
2450+ 68FD 37                   scf
2451+ 68FE C9                   ret
2452+ 68FF
2453+ 68FF              ;Select first FTP directory page (page 0).
2454+ 68FF              ; --- DOKUMENTACE CZ: DIR128_FIRST_PAGE ---
2455+ 68FF              ; Ucel: Vybere první banku adresáře (RAM 0).
2456+ 68FF              ; Vstup: Bez parametrů.
2457+ 68FF              ; Vystup: fdp_pointer = ftp_dir_page+1; NC.
2458+ 68FF              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
2459+ 68FF              ; Poznamka: Mění mapování RAM a PAGE128_STATE.
2460+ 68FF              ; --- KONEC DOKUMENTACE CZ ---
2461+ 68FF              DIR128_FIRST_PAGE:
2462+ 68FF E5                   push    hl
2463+ 6900 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
2464+ 6903 22 F6 BF             ld      (fdp_pointer),hl
2465+ 6906 7E                   ld      a,(hl)
2466+ 6907 CD E0 BF             call    PAGE128
2467+ 690A E1                   pop     hl
2468+ 690B B7                   or      a
2469+ 690C C9                   ret
2470+ 690D
2471+ 690D              ;HL++ across #FFFF -> #C000 of the next directory page.
2472+ 690D              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
2473+ 690D              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
2474+ 690D              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
2475+ 690D              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2476+ 690D              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
2477+ 690D              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2478+ 690D              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2479+ 690D              ; --- KONEC DOKUMENTACE CZ ---
2480+ 690D              DIR128_INC_HL:
2481+ 690D F5                   push    af                      ;old INC HL never changed A - preserve it here too
2482+ 690E 23                   inc     hl
2483+ 690F 7C                   ld      a,h
2484+ 6910 B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
2485+ 6911 28 03                jr      z,DIR128_INC_CROSS
2486+ 6913 F1                   pop     af
2487+ 6914 B7                   or      a                       ;restore A and return NC = OK
2488+ 6915 C9                   ret
2489+ 6916
2490+ 6916              DIR128_INC_CROSS:
2491+ 6916 D5                   push    de
2492+ 6917 ED 5B F6 BF          ld      de,(fdp_pointer)
2493+ 691B 13                   inc     de
2494+ 691C 1A                   ld      a,(de)
2495+ 691D FE FF                cp      #FF
2496+ 691F 28 0E                jr      z,DIR128_INC_END
2497+ 6921 ED 53 F6 BF          ld      (fdp_pointer),de
2498+ 6925 CD E0 BF             call    PAGE128
2499+ 6928 21 00 C0             ld      hl,ftp_dir_start        ;#C000
2500+ 692B D1                   pop     de
2501+ 692C F1                   pop     af                      ;restore caller's A
2502+ 692D B7                   or      a                       ;NC = OK, A unchanged
2503+ 692E C9                   ret
2504+ 692F              DIR128_INC_END:
2505+ 692F 1B                   dec     de                      ;keep fdp_pointer on last valid page
2506+ 6930 ED 53 F6 BF          ld      (fdp_pointer),de
2507+ 6934 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
2508+ 6937 D1                   pop     de
2509+ 6938 F1                   pop     af                      ;restore caller's A
2510+ 6939 37                   scf                             ;C = no following directory page
2511+ 693A C9                   ret

6004+ 7A1B ED 42        			sbc hl,bc
6005+ 7A1D 30 FA        			jr nc,string_lp2
6006+ 7A1F 09           			add hl,bc
6007+ 7A20 FE 30        			CP '0'
6008+ 7A22 28 04        			JR Z,string_store
6009+ 7A24

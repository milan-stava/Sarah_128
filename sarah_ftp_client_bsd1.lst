1044+ 62DE              ; --- DOKUMENTACE CZ: find_out_speed ---
1045+ 62DE              ; Ucel: Zjistí index aktuální rychlosti UART, případně rychlosti vyzkouší.
1046+ 62DE              ; Vstup: IX = flag1; dostupné služby get_baud/set_baud.
1047+ 62DE              ; Vystup: D = index zjištěné rychlosti při úspěchu.
1048+ 62DE              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
1049+ 62DE              ; Poznamka: Při nepodporovaném get_baud používá switch_speed; jeho neúspěch nepovažujte za
1050+ 62DE              ;   platnou rychlost.
1051+ 62DE              ; --- KONEC DOKUMENTACE CZ ---
1052+ 62DE              find_out_speed
1053+ 62DE CD 8D A5             call get_baud
1054+ 62E1 30 06                jr nc,.known
1055+ 62E3 CD F2 62             call switch_speed
1056+ 62E6 20 08                jr nz,.failed
1057+ 62E8 7A                   ld a,d
1058+ 62E9 FE 18        .known  cp 24
1059+ 62EB 30 03                jr nc,.failed
1060+ 62ED 57                   ld d,a
1061+ 62EE B7                   or a
1062+ 62EF C9                   ret
1063+ 62F0 37           .failed scf
1064+ 62F1 C9                   ret
1065+ 62F2              						;tests speeds <7-0>, then <max-8>
1066+ 62F2              ;switch_speed	ld	a,7			;start with speeds 7-0 (quicker finds the speed)
1067+ 62F2              ;		call	sws2
1068+ 62F2              ;		ret	z			;Z= speed <0,7> found
1069+ 62F2
1070+ 62F2              ; --- DOKUMENTACE CZ: switch_speed ---
1071+ 62F2              ; Ucel: Zkouší rychlosti UART sestupně od maximální až po nulu.
1072+ 62F2              ; Vstup: (IX+8) = nejvyšší zkoušený index rychlosti.
1073+ 62F2              ; Vystup: Z = modul odpověděl OK, D = nalezený index; NZ = nenalezeno.
1074+ 62F2              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
1075+ 62F2              ; Poznamka: Mění UART a (IX+6), vyprazdňuje příjem.
1076+ 62F2              ; --- KONEC DOKUMENTACE CZ ---
1077+ 62F2 DD 7E 08     switch_speed	ld	a,(ix+8)		;try out every speed if you find connection UART+Wifi
1078+ 62F5              						;start with max speed, end with 0
1079+ 62F5 F5           sws2		push	af
1080+ 62F6 CD 9C 7B     		call	set_print_speed
1081+ 62F9 38 1B        		jr c,sws_unsupported ;do not report a UART setting rejected by BIOS
1082+ 62FB
1083+ 62FB F1           		pop	af			;we need to inrease timeout for speeds <3
1084+ 62FC F5           		push	af
1085+ 62FD FE 03        		cp	3
1086+ 62FF DD 36 06 01  		ld	(ix+6),1		;set timeout for 1 for speeds >3
1087+ 6303 30 04        		jr	nc,sws1
1088+ 6305 DD 36 06 0A  		ld	(ix+6),#A		;set tieout for #A for speeds <2
1089+ 6309
1090+ 6309 CD 64 7B     sws1		call	send_at_check_ok
1091+ 630C D1           		pop	de
1092+ 630D C8           		ret	z			;Z=answer found, D= speed set in HW
1093+ 630E 7A           sws_next ld	a,d
1094+ 630F 3D           		dec	a
1095+ 6310 FE FF        		cp	255			;test for 255, so that also speed 0 is tested
1096+ 6312 20 E1        		jr	nz,sws2
1097+ 6314 3D           		dec	a			;NZ=not successfull
1098+ 6315 C9           		ret
1099+ 6316 D1           sws_unsupported pop de
1100+ 6317 18 F5                jr sws_next

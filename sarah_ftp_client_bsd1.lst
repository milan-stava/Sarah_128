2648+ 69D4              ; -----------------------------------------------------------------------------
2649+ 69D4              ; DIR128_COPY_NAME_TO_DE
2650+ 69D4              ; Copy the name returned by get_item_name to fixed RAM.
2651+ 69D4              ; IN:  HL = physical source address in directory window
2652+ 69D4              ;      BC = 16-bit name length
2653+ 69D4              ;      DE = fixed-RAM destination
2654+ 69D4              ;      item_name_page = page-table pointer belonging to HL
2655+ 69D4              ; OUT: DE points behind copied bytes, BC=0
2656+ 69D4              ; The source may cross any #FFFF -> #C000 directory-page boundary.
2657+ 69D4              ; -----------------------------------------------------------------------------
2658+ 69D4              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
2659+ 69D4              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
2660+ 69D4              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
2661+ 69D4              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
2662+ 69D4              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2663+ 69D4              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
2664+ 69D4              ; --- KONEC DOKUMENTACE CZ ---
2665+ 69D4              DIR128_COPY_NAME_TO_DE:
2666+ 69D4 D5                   push    de
2667+ 69D5 ED 5B 22 6F          ld      de,(item_name_page)
2668+ 69D9 CD C9 69             call    DIR128_MAP_DE
2669+ 69DC D1                   pop     de
2670+ 69DD              .dir128_copy_loop:
2671+ 69DD 78                   ld      a,b
2672+ 69DE B1                   or      c
2673+ 69DF C8                   ret     z
2674+ 69E0 7E                   ld      a,(hl)
2675+ 69E1 12                   ld      (de),a
2676+ 69E2 13                   inc     de
2677+ 69E3 0B                   dec     bc
2678+ 69E4 78                   ld      a,b
2679+ 69E5 B1                   or      c
2680+ 69E6 C8                   ret     z
2681+ 69E7 CD 3A 69             call    DIR128_INC_HL
2682+ 69EA D8                   ret     c                       ;should only happen on malformed item
2683+ 69EB 18 F0                jr      .dir128_copy_loop

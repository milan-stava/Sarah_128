2760+ 6ADF              ; -----------------------------------------------------------------------------
2761+ 6ADF              ; search_by_Busy_fast
2762+ 6ADF              ; Fast case-insensitive substring search for a name fully contained in the
2763+ 6ADF              ; currently mapped 16K directory page.
2764+ 6ADF              ;
2765+ 6ADF              ; IN:  HL = name start, BC = 16-bit name length
2766+ 6ADF              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
2767+ 6ADF              ; OUT: Z = found, NZ = not found
2768+ 6ADF              ;
2769+ 6ADF              ; This is deliberately close to the original Busy FIND: the inner compare uses
2770+ 6ADF              ; the Z80 CPI instruction.  The pattern has already been converted to lower
2771+ 6ADF              ; case once by find_items, so only the source character needs convert here.
2772+ 6ADF              ;
2773+ 6ADF              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
2774+ 6ADF              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
2775+ 6ADF              ; matches therefore cannot be skipped.
2776+ 6ADF              ; -----------------------------------------------------------------------------
2777+ 6ADF              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
2778+ 6ADF              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
2779+ 6ADF              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
2780+ 6ADF              ;   délka.
2781+ 6ADF              ; Vystup: Z = shoda, NZ = nenalezeno.
2782+ 6ADF              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2783+ 6ADF              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
2784+ 6ADF              ; --- KONEC DOKUMENTACE CZ ---
2785+ 6ADF              search_by_Busy_fast:
2786+ 6ADF EB                   ex      de,hl                   ;DE=current candidate in file name
2787+ 6AE0
2788+ 6AE0                      ; candidate_count = name_length - pattern_length + 1
2789+ 6AE0 60                   ld      h,b
2790+ 6AE1 69                   ld      l,c
2791+ 6AE2 ED 4B DE 78          ld      bc,(txtlen+1)
2792+ 6AE6 78                   ld      a,b
2793+ 6AE7 B1                   or      c
2794+ 6AE8 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
2795+ 6AEA B7                   or      a
2796+ 6AEB ED 42                sbc     hl,bc
2797+ 6AED 38 25                jr      c,.fast_not_found       ;pattern longer than file name
2798+ 6AEF 23                   inc     hl
2799+ 6AF0
2800+ 6AF0                      ; Keep number of possible candidate starts in alternate BC.
2801+ 6AF0 E5                   push    hl
2802+ 6AF1 D9                   exx
2803+ 6AF2 C1                   pop     bc
2804+ 6AF3 D9                   exx
2805+ 6AF4
2806+ 6AF4              .fast_next_candidate:
2807+ 6AF4 D5                   push    de                      ;remember exact candidate start
2808+ 6AF5 21 35 8E             ld      hl,INPBUFF
2809+ 6AF8 ED 4B DE 78          ld      bc,(txtlen+1)
2810+ 6AFC
2811+ 6AFC              .fast_compare:
2812+ 6AFC 1A                   ld      a,(de)
2813+ 6AFD CD 02 79             call    convert                 ;source char -> lower case
2814+ 6B00 ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
2815+ 6B02 13                   inc     de
2816+ 6B03 20 06                jr      nz,.fast_candidate_failed
2817+ 6B05 EA FC 6A             jp      pe,.fast_compare        ;matched, more pattern bytes remain
2818+ 6B08
2819+ 6B08 D1                   pop     de                      ;discard saved candidate start
2820+ 6B09              .fast_found:
2821+ 6B09 AF                   xor     a                       ;Z = found
2822+ 6B0A C9                   ret
2823+ 6B0B
2824+ 6B0B              .fast_candidate_failed:
2825+ 6B0B D1                   pop     de                      ;restore previous candidate start
2826+ 6B0C 13                   inc     de                      ;next candidate = previous + 1
2827+ 6B0D D9                   exx
2828+ 6B0E 0B                   dec     bc
2829+ 6B0F 78                   ld      a,b
2830+ 6B10 B1                   or      c
2831+ 6B11 D9                   exx
2832+ 6B12 20 E0                jr      nz,.fast_next_candidate
2833+ 6B14
2834+ 6B14              .fast_not_found:
2835+ 6B14 3E 01                ld      a,1
2836+ 6B16 B7                   or      a                       ;NZ = not found
2837+ 6B17 C9                   ret

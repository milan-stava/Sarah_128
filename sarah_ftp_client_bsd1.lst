4198+ 7283              ; -----------------------------------------------------------------------------
4199+ 7283              ; item_add / item_sub - 128K bank-aware directory movement
4200+ 7283              ;
4201+ 7283              ; IN:
4202+ 7283              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
4203+ 7283              ;       DE = address of its 16-bit page-table-pointer companion
4204+ 7283              ;
4205+ 7283              ; Example:
4206+ 7283              ;       ld bc,cur_item_addr
4207+ 7283              ;       ld de,cur_item_addr_page
4208+ 7283              ;       call item_add
4209+ 7283              ;
4210+ 7283              ; OUT:
4211+ 7283              ;       Z  = cannot move (end/start of directory)
4212+ 7283              ;       NZ = pointer + its bank companion were moved to adjacent item
4213+ 7283              ;
4214+ 7283              ; The address variable and page variable deliberately do NOT have to be adjacent.
4215+ 7283              ; This keeps the original IX+... variable layout completely unchanged.
4216+ 7283              ; The two-byte item length at either end of an item may itself cross a bank.
4217+ 7283              ; -----------------------------------------------------------------------------
4218+ 7283              ; --- DOKUMENTACE CZ: item_add ---
4219+ 7283              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
4220+ 7283              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
4221+ 7283              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
4222+ 7283              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
4223+ 7283              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
4224+ 7283              ; --- KONEC DOKUMENTACE CZ ---
4225+ 7283              item_add
4226+ 7283 ED 43 AA 6F  		ld	(dir_op_addr_var),bc
4227+ 7287 ED 53 AC 6F  		ld	(dir_op_page_var),de
4228+ 728B
4229+ 728B              		;Load physical item address from *(BC).
4230+ 728B 60           		ld	h,b
4231+ 728C 69           		ld	l,c
4232+ 728D 5E           		ld	e,(hl)
4233+ 728E 23           		inc	hl
4234+ 728F 56           		ld	d,(hl)
4235+ 7290 ED 53 A2 6F  		ld	(next_item_addr),de	;temporary physical start
4236+ 7294 EB           		ex	de,hl			;HL=current physical item start
4237+ 7295
4238+ 7295              		;Load/map directory page from page companion variable.

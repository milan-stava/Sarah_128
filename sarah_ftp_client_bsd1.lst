  866+61EA              ;speed management 2.0. starts here. Enables to set user_defined speed. Works with every MBFW.
  867+61EA              ;the principle:
  868+61EA              ;are you aligned?
  869+61EA              ;NO: try to align, if not success->error. If sucess, you have AKT (=current alligned speed is ;known). Is user defined speed definied? (IX+2=255 for no user defined speed) yes, END. NO. set ;speed according to ix+2 (max up to MBFW), end
  870+61EA              ;
  871+61EA              ;YES:
  872+61EA              ;is user defined speed set? (ix+2=255 or other?) NO=check if FW is 7/12? YES, align at speed
  873+61EA              ;ix+2, end. FW is higher then 7/12, then check if AKT=IX+2? YES, end, NO, align at ix+2, END.
  874+61EA              ;ix+2 was not 255, is FW 7/12? YES, then set FWmax, end. NO the is AKT=MBFW max? YES, then END
  875+61EA              ;NO, then align at FW max speed, end
  876+61EA              ;output: ix+7= 0-23 if speed set, or 255 if not set
  877+61EA
  878+61EA              ;SM20 uses:
  879+61EA              ;bit 4,(ix+0)	PRINT or not to PRINT
  880+61EA              ;(ix+8)		contains maximum speed by detected MBFW (7, 12 or 23)
  881+61EA              ;(ix+6)		timeout value
  882+61EA              ;bit 6,(ix+0)	state of speed alignment between uart& module, 0 not aligned
  883+61EA              ;bit 5,(ix+0)	state of module connection to AP, 0 not connected to AP
  884+61EA
  885+61EA              ;internal subroutines: switch_speed, print_bauds, find_out_speed
  886+61EA              ;external subroutines: send_at:check_ok, set_ud_speed, set_print_speed, print_speed
  887+61EA
  888+61EA              ; --- DOKUMENTACE CZ: speed_management ---
  889+61EA              ; Ucel: Sjednotí rychlost komunikace UART a Wi-Fi při inicializaci.
  890+61EA              ; Vstup: Inicializovaný BIOS a příznaky na IX.
  891+61EA              ; Vystup: Připravená komunikace nebo obsluha chyby.
  892+61EA              ; Meni: AF, BC, DE, HL, BC'; další změny dle volaných BIOS/DOS a tiskových služeb.
  893+61EA              ; Poznamka: Pracuje s konfigurací rychlosti, příjmovým bufferem a stavovým výpisem.
  894+61EA              ; --- KONEC DOKUMENTACE CZ ---
  895+61EA              speed_management
  896+61EA DD 36 07 FF  		ld	(ix+7),#FF		;reset currently set speed status
  897+61EE DD CB 00 B6  		res	6,(ix+0)		;set signal UART and module speed not aligned
  898+61F2
  899+61F2              ;;		ld	hl,#4300
  900+61F2              ;;		ld	de,wifi_on_off
  901+61F2              ;;		call	PRINTHL

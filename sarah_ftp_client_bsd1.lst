 6044+78EC              ;16)
 6045+78EC              ; --- DOKUMENTACE CZ: ConvRStr16 ---
 6046+78EC              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
 6047+78EC              ; Vstup: DE = začátek číslic.
 6048+78EC              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
 6049+78EC              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 6050+78EC              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
 6051+78EC              ;   přetečení; Z nemá pevný význam.
 6052+78EC              ; --- KONEC DOKUMENTACE CZ ---
 6053+78EC              ConvRStr16
 6054+78EC              ;===============================================================
 6055+78EC              ;http://z80-heaven.wikidot.com/math#toc32
 6056+78EC              ;Input:
 6057+78EC              ;     DE points to the base 10 number string in RAM.
 6058+78EC              ;Outputs:
 6059+78EC              ;     HL is the 16-bit value of the number
 6060+78EC              ;     DE points to the byte after the number
 6061+78EC              ;     BC is HL/10
 6062+78EC              ;     z flag reset (nz)
 6063+78EC              ;     c flag reset (nc)
 6064+78EC              ;Destroys:
 6065+78EC              ;     A (actually, add 30h and you get the ending token)
 6066+78EC              ;Size:  23 bytes
 6067+78EC              ;Speed: 104n+42+11c
 6068+78EC              ;       n is the number of digits
 6069+78EC              ;       c is at most n-2
 6070+78EC              ;       at most 595 cycles for any 16-bit decimal value
 6071+78EC              ;===============================================================
 6072+78EC
 6073+78EC 21 00 00          ld hl,0          ;  10 : 210000
 6074+78EF              ConvLoop:             ;
 6075+78EF 1A                ld a,(de)        ;   7 : 1A
 6076+78F0 D6 30             sub 30h          ;   7 : D630
 6077+78F2 FE 0A             cp 10            ;   7 : FE0A
 6078+78F4 D0                ret nc           ;5|11 : D0
 6079+78F5 13                inc de           ;   6 : 13
 6080+78F6                                    ;
 6081+78F6 44                ld b,h           ;   4 : 44
 6082+78F7 4D                ld c,l           ;   4 : 4D
 6083+78F8 29                add hl,hl        ;  11 : 29
 6084+78F9 29                add hl,hl        ;  11 : 29
 6085+78FA 09                add hl,bc        ;  11 : 09
 6086+78FB 29                add hl,hl        ;  11 : 29
 6087+78FC                                    ;
 6088+78FC 85                add a,l          ;   4 : 85
 6089+78FD 6F                ld l,a           ;   4 : 6F
 6090+78FE 30 EF             jr nc,ConvLoop   ;12|23: 30EE
 6091+7900 24                inc h            ; --- : 24
 6092+7901 18 EC             jr ConvLoop      ; --- : 18EB

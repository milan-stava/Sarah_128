 2851+6AAF              ; -----------------------------------------------------------------------------
 2852+6AAF              ; search_by_Busy_fast
 2853+6AAF              ; Fast case-insensitive substring search for a name fully contained in the
 2854+6AAF              ; currently mapped 16K directory page.
 2855+6AAF              ;
 2856+6AAF              ; IN:  HL = name start, BC = 16-bit name length
 2857+6AAF              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
 2858+6AAF              ; OUT: Z = found, NZ = not found
 2859+6AAF              ;
 2860+6AAF              ; This is deliberately close to the original Busy FIND: the inner compare uses
 2861+6AAF              ; the Z80 CPI instruction.  The pattern has already been converted to lower
 2862+6AAF              ; case once by find_items, so only the source character needs convert here.
 2863+6AAF              ;
 2864+6AAF              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
 2865+6AAF              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
 2866+6AAF              ; matches therefore cannot be skipped.
 2867+6AAF              ; -----------------------------------------------------------------------------
 2868+6AAF              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
 2869+6AAF              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
 2870+6AAF              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
 2871+6AAF              ;   délka.
 2872+6AAF              ; Vystup: Z = shoda, NZ = nenalezeno.
 2873+6AAF              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 2874+6AAF              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
 2875+6AAF              ; --- KONEC DOKUMENTACE CZ ---
 2876+6AAF              search_by_Busy_fast:
 2877+6AAF EB                   ex      de,hl                   ;DE=current candidate in file name
 2878+6AB0
 2879+6AB0                      ; candidate_count = name_length - pattern_length + 1
 2880+6AB0 60                   ld      h,b
 2881+6AB1 69                   ld      l,c
 2882+6AB2 ED 4B 66 79          ld      bc,(txtlen+1)
 2883+6AB6 78                   ld      a,b
 2884+6AB7 B1                   or      c
 2885+6AB8 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
 2886+6ABA B7                   or      a
 2887+6ABB ED 42                sbc     hl,bc
 2888+6ABD 38 25                jr      c,.fast_not_found       ;pattern longer than file name
 2889+6ABF 23                   inc     hl
 2890+6AC0
 2891+6AC0                      ; Keep number of possible candidate starts in alternate BC.
 2892+6AC0 E5                   push    hl
 2893+6AC1 D9                   exx
 2894+6AC2 C1                   pop     bc
 2895+6AC3 D9                   exx
 2896+6AC4
 2897+6AC4              .fast_next_candidate:
 2898+6AC4 D5                   push    de                      ;remember exact candidate start
 2899+6AC5 21 9B 8F             ld      hl,INPBUFF
 2900+6AC8 ED 4B 66 79          ld      bc,(txtlen+1)
 2901+6ACC
 2902+6ACC              .fast_compare:
 2903+6ACC 1A                   ld      a,(de)
 2904+6ACD CD 8A 79             call    convert                 ;source char -> lower case
 2905+6AD0 ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
 2906+6AD2 13                   inc     de
 2907+6AD3 20 06                jr      nz,.fast_candidate_failed
 2908+6AD5 EA CC 6A             jp      pe,.fast_compare        ;matched, more pattern bytes remain
 2909+6AD8
 2910+6AD8 D1                   pop     de                      ;discard saved candidate start
 2911+6AD9              .fast_found:
 2912+6AD9 AF                   xor     a                       ;Z = found
 2913+6ADA C9                   ret
 2914+6ADB
 2915+6ADB              .fast_candidate_failed:
 2916+6ADB D1                   pop     de                      ;restore previous candidate start
 2917+6ADC 13                   inc     de                      ;next candidate = previous + 1
 2918+6ADD D9                   exx
 2919+6ADE 0B                   dec     bc
 2920+6ADF 78                   ld      a,b
 2921+6AE0 B1                   or      c
 2922+6AE1 D9                   exx
 2923+6AE2 20 E0                jr      nz,.fast_next_candidate
 2924+6AE4
 2925+6AE4              .fast_not_found:
 2926+6AE4 3E 01                ld      a,1
 2927+6AE6 B7                   or      a                       ;NZ = not found
 2928+6AE7 C9                   ret

 2778+6A3C 57                   ld      d,a
 2779+6A3D 3A C2 8E             ld      a,(INPBUFF)             ;already normalized by find_items
 2780+6A40 BA                   cp      d                       ;Z=first character matches
 2781+6A41 C9                   ret

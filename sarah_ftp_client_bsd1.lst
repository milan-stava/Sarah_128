    1+A5BB              ; Fixed-RAM recovery. One reconnect attempt per failure, never replay the upload.
    2+A5BB              ; error_recovering: 0=normal, 1=plain-error cleanup, 2=reconnecting.
    3+A5BB              ftp_recover_session:
    4+A5BB 0E 24                ld      c,36            ; orphaned socket detected before NOOP/LIST
    5+A5BD C3 D3 7E             jp      error_handler
    6+A5C0
    7+A5C0              ftp_recovery_begin:
    8+A5C0 3E 02                ld      a,2
    9+A5C2 32 2E 7F             ld      (error_recovering),a
   10+A5C5 C5                   push    bc
   11+A5C6 CD 35 7D             call    wifi_unwait
   12+A5C9 C1                   pop     bc
   13+A5CA DD CB 00 76          bit     6,(ix+0)
   14+A5CE CA 25 A6             jp      z,ftp_recovery_failed ; never send AT at an unknown baud
   15+A5D1 CD 30 A6             call    ftp_mark_disconnected
   16+A5D4 CD E7 A4             call    at_reset_stream
   17+A5D7 CD F5 A0             call    at_probe_drain   ; bounded discard of replies from the old session
   18+A5DA 21 5C 89             ld      hl,at_cipclose5  ; drop BOTH old data and control connections
   19+A5DD CD D7 A0             call    at_send_ok
   20+A5E0 30 24                jr      nc,.closed
   21+A5E2 FE 02                cp      AT_ERROR
   22+A5E4 0E 2B                ld      c,43
   23+A5E6 C2 25 A6             jp      nz,ftp_recovery_failed
   24+A5E9                      ; ERROR may mean all sockets were already closed. Verify, never assume.
   25+A5E9 21 00 89             ld      hl,cipstatus
   26+A5EC CD BB 79             call    send_string
   27+A5EF 0E 2B                ld      c,43
   28+A5F1 C2 25 A6             jp      nz,ftp_recovery_failed
   29+A5F4 CD F8 A4             call    at_status_response
   30+A5F7 0E 2B                ld      c,43
   31+A5F9 DA 25 A6             jp      c,ftp_recovery_failed
   32+A5FC 3A B8 A5             ld      a,(at_status_haslink)
   33+A5FF 21 B5 A5             ld      hl,at_status_data
   34+A602 B6                   or      (hl)
   35+A603 C2 25 A6             jp      nz,ftp_recovery_failed
   36+A606              .closed:
   37+A606 CD F5 A0             call    at_probe_drain
   38+A609 0E 31                ld      c,49
   39+A60B DA 25 A6             jp      c,ftp_recovery_failed
   40+A60E CD E7 A4             call    at_reset_stream
   41+A611 CD 0F 84             call    passive_receive_off
   42+A614 31 FE 5F             ld      sp,basic_end-2  ; discard calls belonging to the failed operation
   43+A617 21 1E A6             ld      hl,ftp_recovery_done
   44+A61A E5                   push    hl
   45+A61B C3 12 69             jp      auto_login      ; configured host/user/password; fresh listing on success
   46+A61E
   47+A61E              ftp_recovery_done:
   48+A61E AF                   xor     a
   49+A61F 32 2E 7F             ld      (error_recovering),a
   50+A622 C3 FC 60             jp      key_loop
   51+A625
   52+A625              ftp_recovery_failed:
   53+A625 C5                   push    bc
   54+A626 CD 30 A6             call    ftp_mark_disconnected
   55+A629 C1                   pop     bc

7573+ 7D9A CD 47 82                call passive_receive_off ;one best-effort cleanup attempt only
7574+ 7D9D              error_handler_exit
7575+ 7D9D AF                      xor a
7576+ 7D9E 32 AC 7D                ld (error_recovering),a
7577+ 7DA1 DD CB 00 76             bit 6,(ix+0)
7578+ 7DA5 CA 07 77                jp z,quit_keep_directory
7579+ 7DA8 31 FE 5F                ld sp,basic_end-2
7580+ 7DAB C9                      ret
7581+ 7DAC 00           error_recovering db 0

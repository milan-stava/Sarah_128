2762+ 6AE4              ; -----------------------------------------------------------------------------
2763+ 6AE4              ; search_by_Busy_fast
2764+ 6AE4              ; Fast case-insensitive substring search for a name fully contained in the
2765+ 6AE4              ; currently mapped 16K directory page.
2766+ 6AE4              ;
2767+ 6AE4              ; IN:  HL = name start, BC = 16-bit name length
2768+ 6AE4              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
2769+ 6AE4              ; OUT: Z = found, NZ = not found
2770+ 6AE4              ;
2771+ 6AE4              ; This is deliberately close to the original Busy FIND: the inner compare uses
2772+ 6AE4              ; the Z80 CPI instruction.  The pattern has already been converted to lower
2773+ 6AE4              ; case once by find_items, so only the source character needs convert here.
2774+ 6AE4              ;
2775+ 6AE4              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
2776+ 6AE4              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
2777+ 6AE4              ; matches therefore cannot be skipped.
2778+ 6AE4              ; -----------------------------------------------------------------------------
2779+ 6AE4              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
2780+ 6AE4              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
2781+ 6AE4              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
2782+ 6AE4              ;   délka.
2783+ 6AE4              ; Vystup: Z = shoda, NZ = nenalezeno.
2784+ 6AE4              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2785+ 6AE4              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
2786+ 6AE4              ; --- KONEC DOKUMENTACE CZ ---
2787+ 6AE4              search_by_Busy_fast:
2788+ 6AE4 EB                   ex      de,hl                   ;DE=current candidate in file name
2789+ 6AE5
2790+ 6AE5                      ; candidate_count = name_length - pattern_length + 1
2791+ 6AE5 60                   ld      h,b
2792+ 6AE6 69                   ld      l,c
2793+ 6AE7 ED 4B 29 79          ld      bc,(txtlen+1)
2794+ 6AEB 78                   ld      a,b
2795+ 6AEC B1                   or      c
2796+ 6AED 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
2797+ 6AEF B7                   or      a
2798+ 6AF0 ED 42                sbc     hl,bc
2799+ 6AF2 38 25                jr      c,.fast_not_found       ;pattern longer than file name
2800+ 6AF4 23                   inc     hl
2801+ 6AF5
2802+ 6AF5                      ; Keep number of possible candidate starts in alternate BC.
2803+ 6AF5 E5                   push    hl
2804+ 6AF6 D9                   exx
2805+ 6AF7 C1                   pop     bc
2806+ 6AF8 D9                   exx
2807+ 6AF9
2808+ 6AF9              .fast_next_candidate:
2809+ 6AF9 D5                   push    de                      ;remember exact candidate start
2810+ 6AFA 21 80 8E             ld      hl,INPBUFF
2811+ 6AFD ED 4B 29 79          ld      bc,(txtlen+1)
2812+ 6B01
2813+ 6B01              .fast_compare:
2814+ 6B01 1A                   ld      a,(de)
2815+ 6B02 CD 4D 79             call    convert                 ;source char -> lower case
2816+ 6B05 ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
2817+ 6B07 13                   inc     de
2818+ 6B08 20 06                jr      nz,.fast_candidate_failed
2819+ 6B0A EA 01 6B             jp      pe,.fast_compare        ;matched, more pattern bytes remain
2820+ 6B0D
2821+ 6B0D D1                   pop     de                      ;discard saved candidate start
2822+ 6B0E              .fast_found:
2823+ 6B0E AF                   xor     a                       ;Z = found
2824+ 6B0F C9                   ret
2825+ 6B10
2826+ 6B10              .fast_candidate_failed:
2827+ 6B10 D1                   pop     de                      ;restore previous candidate start
2828+ 6B11 13                   inc     de                      ;next candidate = previous + 1
2829+ 6B12 D9                   exx
2830+ 6B13 0B                   dec     bc
2831+ 6B14 78                   ld      a,b
2832+ 6B15 B1                   or      c
2833+ 6B16 D9                   exx
2834+ 6B17 20 E0                jr      nz,.fast_next_candidate
2835+ 6B19
2836+ 6B19              .fast_not_found:
2837+ 6B19 3E 01                ld      a,1
2838+ 6B1B B7                   or      a                       ;NZ = not found
2839+ 6B1C C9                   ret

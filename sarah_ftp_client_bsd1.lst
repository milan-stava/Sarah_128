 9041+84DB E1                   pop     hl
 9042+84DC 20 19                jr      nz,gfn_not_first
 9043+84DE
 9044+84DE                      ;Skip mark/info byte. The synthetic item contains exactly "..".
 9045+84DE CD 9A 85             call    gfn_next
 9046+84E1 DA 90 85             jp      c,gfn_bad

2541+ 69A6              ; -----------------------------------------------------------------------------
2542+ 69A6              ; FTP DIRECTORY BANK API
2543+ 69A6              ;
2544+ 69A6              ; fdp_pointer always points to the table byte of the CURRENT directory page.
2545+ 69A6              ; ftp_dir_page has #FF sentinels on both sides:
2546+ 69A6              ;       #FF, 0, 1, 3, 7, #FF
2547+ 69A6              ;
2548+ 69A6              ; HL is always a physical address in the banked window #C000-#FFFF.
2549+ 69A6              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
2550+ 69A6              ;
2551+ 69A6              ; OUT for INC/DEC:
2552+ 69A6              ;       NC = movement succeeded
2553+ 69A6              ;       C  = no next/previous directory page (64 KB boundary)
2554+ 69A6              ;
2555+ 69A6              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
2556+ 69A6              ; which preserves AF/BC/DE/IX/IY exactly.
2557+ 69A6              ; -----------------------------------------------------------------------------
2558+ 69A6
2559+ 69A6              ; --- DOKUMENTACE CZ: DIR128_MAP_CURRENT ---
2560+ 69A6              ; Ucel: Namapuje aktuální banku adresáře do #C000–#FFFF.
2561+ 69A6              ; Vstup: fdp_pointer ukazuje do tabulky ftp_dir_page.
2562+ 69A6              ; Vystup: NC = platná banka, C = sentinel #FF.
2563+ 69A6              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
2564+ 69A6              ; Poznamka: Mění PAGE128_STATE a port #7FFD.
2565+ 69A6              ; --- KONEC DOKUMENTACE CZ ---
2566+ 69A6              DIR128_MAP_CURRENT:
2567+ 69A6 E5                   push    hl
2568+ 69A7 D5                   push    de
2569+ 69A8 ED 5B F6 BF          ld      de,(fdp_pointer)
2570+ 69AC 1A                   ld      a,(de)
2571+ 69AD FE FF                cp      #FF
2572+ 69AF 28 07                jr      z,DIR128_MAP_BAD
2573+ 69B1 CD E0 BF             call    PAGE128
2574+ 69B4 D1                   pop     de
2575+ 69B5 E1                   pop     hl
2576+ 69B6 B7                   or      a                       ;NC = valid page
2577+ 69B7 C9                   ret
2578+ 69B8              DIR128_MAP_BAD:
2579+ 69B8 D1                   pop     de
2580+ 69B9 E1                   pop     hl
2581+ 69BA 37                   scf
2582+ 69BB C9                   ret
2583+ 69BC
2584+ 69BC              ;Select first FTP directory page (page 0).
2585+ 69BC              ; --- DOKUMENTACE CZ: DIR128_FIRST_PAGE ---
2586+ 69BC              ; Ucel: Vybere první banku adresáře (RAM 0).
2587+ 69BC              ; Vstup: Bez parametrů.
2588+ 69BC              ; Vystup: fdp_pointer = ftp_dir_page+1; NC.
2589+ 69BC              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
2590+ 69BC              ; Poznamka: Mění mapování RAM a PAGE128_STATE.
2591+ 69BC              ; --- KONEC DOKUMENTACE CZ ---
2592+ 69BC              DIR128_FIRST_PAGE:
2593+ 69BC E5                   push    hl
2594+ 69BD 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
2595+ 69C0 22 F6 BF             ld      (fdp_pointer),hl
2596+ 69C3 7E                   ld      a,(hl)
2597+ 69C4 CD E0 BF             call    PAGE128
2598+ 69C7 E1                   pop     hl
2599+ 69C8 B7                   or      a
2600+ 69C9 C9                   ret
2601+ 69CA
2602+ 69CA              ;HL++ across #FFFF -> #C000 of the next directory page.
2603+ 69CA              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
2604+ 69CA              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
2605+ 69CA              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
2606+ 69CA              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2607+ 69CA              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
2608+ 69CA              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2609+ 69CA              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2610+ 69CA              ; --- KONEC DOKUMENTACE CZ ---
2611+ 69CA              DIR128_INC_HL:
2612+ 69CA F5                   push    af                      ;old INC HL never changed A - preserve it here too
2613+ 69CB 23                   inc     hl
2614+ 69CC 7C                   ld      a,h
2615+ 69CD B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
2616+ 69CE 28 03                jr      z,DIR128_INC_CROSS
2617+ 69D0 F1                   pop     af
2618+ 69D1 B7                   or      a                       ;restore A and return NC = OK
2619+ 69D2 C9                   ret
2620+ 69D3
2621+ 69D3              DIR128_INC_CROSS:
2622+ 69D3 D5                   push    de
2623+ 69D4 ED 5B F6 BF          ld      de,(fdp_pointer)
2624+ 69D8 13                   inc     de
2625+ 69D9 1A                   ld      a,(de)
2626+ 69DA FE FF                cp      #FF
2627+ 69DC 28 0E                jr      z,DIR128_INC_END
2628+ 69DE ED 53 F6 BF          ld      (fdp_pointer),de
2629+ 69E2 CD E0 BF             call    PAGE128
2630+ 69E5 21 00 C0             ld      hl,ftp_dir_start        ;#C000
2631+ 69E8 D1                   pop     de
2632+ 69E9 F1                   pop     af                      ;restore caller's A
2633+ 69EA B7                   or      a                       ;NC = OK, A unchanged
2634+ 69EB C9                   ret
2635+ 69EC              DIR128_INC_END:
2636+ 69EC 1B                   dec     de                      ;keep fdp_pointer on last valid page
2637+ 69ED ED 53 F6 BF          ld      (fdp_pointer),de
2638+ 69F1 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
2639+ 69F4 D1                   pop     de
2640+ 69F5 F1                   pop     af                      ;restore caller's A
2641+ 69F6 37                   scf                             ;C = no following directory page
2642+ 69F7 C9                   ret
2643+ 69F8
2644+ 69F8              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
2645+ 69F8              ;Unlike the general helper, this preserves the COMPLETE parser state:
2646+ 69F8              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
2647+ 69F8              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
2648+ 69F8              ;  dir128_parser_status = 0  OK
2649+ 69F8              ;  dir128_parser_status = 1  no next directory page
2650+ 69F8              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
2651+ 69F8              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
2652+ 69F8              ; Vstup: HL = adresa v aktuální bance adresáře.
2653+ 69F8              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
2654+ 69F8              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
2655+ 69F8              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
2656+ 69F8              ; --- KONEC DOKUMENTACE CZ ---
2657+ 69F8              DIR128_INC_HL_PARSER:
2658+ 69F8 F5                   push    af
2659+ 69F9 D5                   push    de
2660+ 69FA AF                   xor     a
2661+ 69FB 32 33 88             ld      (dir128_parser_status),a
2662+ 69FE 23                   inc     hl
2663+ 69FF 7C                   ld      a,h
2664+ 6A00 B7                   or      a
2665+ 6A01 20 14                jr      nz,.ok
2666+ 6A03 ED 5B F6 BF          ld      de,(fdp_pointer)
2667+ 6A07 13                   inc     de
2668+ 6A08 1A                   ld      a,(de)
2669+ 6A09 FE FF                cp      #FF
2670+ 6A0B 28 0D                jr      z,.full
2671+ 6A0D ED 53 F6 BF          ld      (fdp_pointer),de
2672+ 6A11 CD E0 BF             call    PAGE128
2673+ 6A14 21 00 C0             ld      hl,ftp_dir_start
2674+ 6A17              .ok:
2675+ 6A17 D1                   pop     de
2676+ 6A18 F1                   pop     af
2677+ 6A19 C9                   ret
2678+ 6A1A              .full:
2679+ 6A1A 1B                   dec     de
2680+ 6A1B ED 53 F6 BF          ld      (fdp_pointer),de
2681+ 6A1F 21 FF FF             ld      hl,#FFFF
2682+ 6A22 3E 01                ld      a,1
2683+ 6A24 32 33 88             ld      (dir128_parser_status),a
2684+ 6A27 D1                   pop     de
2685+ 6A28 F1                   pop     af
2686+ 6A29 C9                   ret
2687+ 6A2A
2688+ 6A2A              ;HL-- across #C000 -> #FFFF of the previous directory page.
2689+ 6A2A              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
2690+ 6A2A              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
2691+ 6A2A              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
2692+ 6A2A              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2693+ 6A2A              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
2694+ 6A2A              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2695+ 6A2A              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2696+ 6A2A              ; --- KONEC DOKUMENTACE CZ ---
2697+ 6A2A              DIR128_DEC_HL:
2698+ 6A2A F5                   push    af                      ;old DEC HL never changed A - preserve it here too
2699+ 6A2B 2B                   dec     hl
2700+ 6A2C 7C                   ld      a,h
2701+ 6A2D FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
2702+ 6A2F 28 03                jr      z,DIR128_DEC_CROSS
2703+ 6A31 F1                   pop     af
2704+ 6A32 B7                   or      a                       ;restore A and return NC = OK
2705+ 6A33 C9                   ret
2706+ 6A34
2707+ 6A34              DIR128_DEC_CROSS:
2708+ 6A34 D5                   push    de
2709+ 6A35 ED 5B F6 BF          ld      de,(fdp_pointer)
2710+ 6A39 1B                   dec     de
2711+ 6A3A 1A                   ld      a,(de)
2712+ 6A3B FE FF                cp      #FF
2713+ 6A3D 28 0E                jr      z,DIR128_DEC_START
2714+ 6A3F ED 53 F6 BF          ld      (fdp_pointer),de
2715+ 6A43 CD E0 BF             call    PAGE128
2716+ 6A46 21 FF FF             ld      hl,#FFFF
2717+ 6A49 D1                   pop     de
2718+ 6A4A F1                   pop     af                      ;restore caller's A
2719+ 6A4B B7                   or      a                       ;NC = OK, A unchanged
2720+ 6A4C C9                   ret
2721+ 6A4D              DIR128_DEC_START:
2722+ 6A4D 13                   inc     de                      ;keep fdp_pointer on first valid page
2723+ 6A4E ED 53 F6 BF          ld      (fdp_pointer),de
2724+ 6A52 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
2725+ 6A55 D1                   pop     de
2726+ 6A56 F1                   pop     af                      ;restore caller's A
2727+ 6A57 37                   scf                             ;C = no previous directory page
2728+ 6A58 C9                   ret
2729+ 6A59
2730+ 6A59              ;Map page-table pointer stored in DE. HL is preserved.
2731+ 6A59              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
2732+ 6A59              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
2733+ 6A59              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
2734+ 6A59              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
2735+ 6A59              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
2736+ 6A59              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
2737+ 6A59              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
2738+ 6A59              ; --- KONEC DOKUMENTACE CZ ---
2739+ 6A59              DIR128_MAP_DE:
2740+ 6A59 F5                   push    af
2741+ 6A5A ED 53 F6 BF          ld      (fdp_pointer),de
2742+ 6A5E 1A                   ld      a,(de)
2743+ 6A5F CD E0 BF             call    PAGE128
2744+ 6A62 F1                   pop     af
2745+ 6A63 C9                   ret

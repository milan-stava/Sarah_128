   1++9F77              ; Shared ESP-AT framing above the unchanged Wi-Fi BIOS.
   2++9F77              ; Firmware dialect retained: +CIPRECVDATA,<length>:<binary>.
   3++9F77              ; Events: 1 OK, 2 ERROR, 3 prompt, 4 SEND OK, 5 SEND FAIL,
   4++9F77              ;         6 busy, 7 active IPD header, 8 receive-data header, 0 other.
   5++9F77              ; Binary payload is never searched for AT result strings.
   6++9F77              AT_OK equ 1

 9570+86CF              ; Vystup: HL=jméno, BC=délka, item_name_page=banka; DE=16bitová velikost u zkráceného LIST.
 9571+86CF              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 9572+86CF              ; Poznamka: A: 0 adresář, 1 soubor, 2 NLST (typ neznámý), 3 plný LIST/chybná položka, 4
 9573+86CF              ;   syntetické ..; pro A=3 nejsou HL/BC obecně platné.
 9574+86CF              ; --- KONEC DOKUMENTACE CZ ---
 9575+86CF              get_item_name
 9576+86CF              ;128K bank-safe parser.
 9577+86CF              ;IN: callers currently use SCF; C/NC is kept only for source compatibility.
 9578+86CF              ;OUT=HL=name start in banked directory RAM
 9579+86CF              ;    BC=16-bit name length
 9580+86CF              ;    DE=16-bit file length for LIST abbreviated (0 for NLST/"..")
 9581+86CF              ;    item_name_page=page-table pointer belonging to returned HL
 9582+86CF              ;OUT=A=0 directory, A=1 file, A=2 NLST unknown type,
 9583+86CF              ;      A=3 LIST full/malformed, A=4 synthetic ".."
 9584+86CF              ;
 9585+86CF              ;No temporary zero is written into the directory. The parser uses the stored
 9586+86CF              ;16-bit item length as its boundary, so an item/name may cross 16K pages and
 9587+86CF              ;may also be longer than 255 bytes.

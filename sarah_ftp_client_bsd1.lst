 2905+6AB5              ; -----------------------------------------------------------------------------
 2906+6AB5              ; search_by_Busy_dir_slow
 2907+6AB5              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
 2908+6AB5              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
 2909+6AB5              ; no longer slows down every ordinary FIND operation.
 2910+6AB5              ;
 2911+6AB5              ; One-character FIND is handled before this fallback and compares only the
 2912+6AB5              ; first character.  This slow path therefore normally handles 2+ character
 2913+6AB5              ; substring searches whose source name crosses a directory-bank boundary.
 2914+6AB5              ; -----------------------------------------------------------------------------
 2915+6AB5              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
 2916+6AB5              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
 2917+6AB5              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
 2918+6AB5              ;   a délka.
 2919+6AB5              ; Vystup: Z = shoda, NZ = nenalezeno.
 2920+6AB5              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 2921+6AB5              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
 2922+6AB5              ; --- KONEC DOKUMENTACE CZ ---
 2923+6AB5              search_by_Busy_dir_slow:
 2924+6AB5 22 86 6F             ld      (dir_search_addr),hl
 2925+6AB8 ED 43 8A 6F          ld      (dir_search_remaining),bc
 2926+6ABC ED 5B 7F 6F          ld      de,(item_name_page)
 2927+6AC0 ED 53 88 6F          ld      (dir_search_page),de
 2928+6AC4 2A 2E 79             ld      hl,(txtlen+1)
 2929+6AC7 22 8C 6F             ld      (dir_search_patlen),hl
 2930+6ACA 7C                   ld      a,h
 2931+6ACB B5                   or      l
 2932+6ACC 28 56                jr      z,.dir_search_found
 2933+6ACE
 2934+6ACE              .dir_search_outer:
 2935+6ACE                      ;If remaining source length < pattern length, no further match exists.
 2936+6ACE 2A 8A 6F             ld      hl,(dir_search_remaining)
 2937+6AD1 ED 5B 8C 6F          ld      de,(dir_search_patlen)
 2938+6AD5 B7                   or      a
 2939+6AD6 ED 52                sbc     hl,de
 2940+6AD8 38 4C                jr      c,.dir_search_not_found
 2941+6ADA
 2942+6ADA                      ;Start one comparison at current candidate address/page.
 2943+6ADA 2A 86 6F             ld      hl,(dir_search_addr)
 2944+6ADD ED 5B 88 6F          ld      de,(dir_search_page)
 2945+6AE1 CD 26 6A             call    DIR128_MAP_DE
 2946+6AE4 11 B9 8F             ld      de,INPBUFF
 2947+6AE7 ED 4B 8C 6F          ld      bc,(dir_search_patlen)
 2948+6AEB
 2949+6AEB              .dir_search_cmp:
 2950+6AEB 7E                   ld      a,(hl)
 2951+6AEC CD 52 79             call    convert                 ;source char -> lower case
 2952+6AEF EB                   ex      de,hl
 2953+6AF0 BE                   cp      (hl)                    ;pattern already normalized by FIND
 2954+6AF1 EB                   ex      de,hl
 2955+6AF2 20 0D                jr      nz,.dir_search_advance_candidate
 2956+6AF4
 2957+6AF4 13                   inc     de
 2958+6AF5 0B                   dec     bc
 2959+6AF6 78                   ld      a,b
 2960+6AF7 B1                   or      c
 2961+6AF8 28 2A                jr      z,.dir_search_found
 2962+6AFA CD 97 69             call    DIR128_INC_HL
 2963+6AFD 38 27                jr      c,.dir_search_not_found
 2964+6AFF 18 EA                jr      .dir_search_cmp
 2965+6B01
 2966+6B01              .dir_search_advance_candidate:
 2967+6B01                      ;Always advance by exactly ONE source character.  This fixes both the
 2968+6B01                      ;old overlapping-match bug and the old one-character special case.
 2969+6B01 2A 86 6F             ld      hl,(dir_search_addr)
 2970+6B04 ED 5B 88 6F          ld      de,(dir_search_page)
 2971+6B08 CD 26 6A             call    DIR128_MAP_DE
 2972+6B0B CD 97 69             call    DIR128_INC_HL
 2973+6B0E 38 16                jr      c,.dir_search_not_found
 2974+6B10 22 86 6F             ld      (dir_search_addr),hl
 2975+6B13 ED 5B F6 BF          ld      de,(fdp_pointer)
 2976+6B17 ED 53 88 6F          ld      (dir_search_page),de
 2977+6B1B 2A 8A 6F             ld      hl,(dir_search_remaining)
 2978+6B1E 2B                   dec     hl
 2979+6B1F 22 8A 6F             ld      (dir_search_remaining),hl
 2980+6B22 18 AA                jr      .dir_search_outer
 2981+6B24
 2982+6B24              .dir_search_found:
 2983+6B24 AF                   xor     a                       ;Z
 2984+6B25 C9                   ret
 2985+6B26              .dir_search_not_found:
 2986+6B26 3E 01                ld      a,1
 2987+6B28 B7                   or      a                       ;NZ
 2988+6B29 C9                   ret

 4166+713D CD 6D 69     		call	DIR128_INC_HL
 4167+7140 38 34        		jr	c,item_add_end
 4168+7142 1B           		dec	de
 4169+7143 18 F4        		jr	item_add_lenloop
 4170+7145
 4171+7145              item_add_at_next
 4172+7145              		;Save exact candidate next-item position and its bank before peeking
 4173+7145              		;at its 00 00 / length header.
 4174+7145 22 41 6F     		ld	(next_item_addr),hl
 4175+7148 ED 5B F6 BF  		ld	de,(fdp_pointer)

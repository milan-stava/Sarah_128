 8990+84A1              ; Vystup: HL=jméno, BC=délka, item_name_page=banka; DE=16bitová velikost u zkráceného LIST.
 8991+84A1              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 8992+84A1              ; Poznamka: A: 0 adresář, 1 soubor, 2 NLST (typ neznámý), 3 plný LIST/chybná položka, 4
 8993+84A1              ;   syntetické ..; pro A=3 nejsou HL/BC obecně platné.
 8994+84A1              ; --- KONEC DOKUMENTACE CZ ---
 8995+84A1              get_item_name
 8996+84A1              ;128K bank-safe parser.
 8997+84A1              ;IN: callers currently use SCF; C/NC is kept only for source compatibility.
 8998+84A1              ;OUT=HL=name start in banked directory RAM
 8999+84A1              ;    BC=16-bit name length
 9000+84A1              ;    DE=16-bit file length for LIST abbreviated (0 for NLST/"..")
 9001+84A1              ;    item_name_page=page-table pointer belonging to returned HL
 9002+84A1              ;OUT=A=0 directory, A=1 file, A=2 NLST unknown type,
 9003+84A1              ;      A=3 LIST full/malformed, A=4 synthetic ".."
 9004+84A1              ;
 9005+84A1              ;No temporary zero is written into the directory. The parser uses the stored
 9006+84A1              ;16-bit item length as its boundary, so an item/name may cross 16K pages and
 9007+84A1              ;may also be longer than 255 bytes.
 9008+84A1 2A 89 8E             ld      hl,(cur_item_addr)
 9009+84A4 ED 5B F4 88          ld      de,(cur_item_addr_page)
 9010+84A8 CD 59 6A             call    DIR128_MAP_DE
 9011+84AB
 9012+84AB                      ;Read item length LOW/HIGH. Even the length field may cross a page.
 9013+84AB 7E                   ld      a,(hl)
 9014+84AC 4F                   ld      c,a
 9015+84AD CD CA 69             call    DIR128_INC_HL
 9016+84B0 DA 90 85             jp      c,gfn_bad
 9017+84B3 7E                   ld      a,(hl)
 9018+84B4 47                   ld      b,a
 9019+84B5 78                   ld      a,b
 9020+84B6 B1                   or      c
 9021+84B7 CA 90 85             jp      z,gfn_bad
 9022+84BA ED 43 B8 6F          ld      (gfn_remaining),bc      ;includes mark/info byte + stored data
 9023+84BE
 9024+84BE                      ;Move from header HIGH to mark/info byte (item+2).
 9025+84BE CD CA 69             call    DIR128_INC_HL
 9026+84C1 DA 90 85             jp      c,gfn_bad
 9027+84C4
 9028+84C4                      ;Synthetic first item ".." is always page 0:#C000.
 9029+84C4 E5                   push    hl
 9030+84C5 2A F4 88             ld      hl,(cur_item_addr_page)
 9031+84C8 11 F1 BF             ld      de,ftp_dir_page+1

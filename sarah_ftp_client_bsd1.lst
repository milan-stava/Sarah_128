5934+ 7958              ;16)
5935+ 7958              ; --- DOKUMENTACE CZ: ConvRStr16 ---
5936+ 7958              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
5937+ 7958              ; Vstup: DE = začátek číslic.
5938+ 7958              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
5939+ 7958              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
5940+ 7958              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
5941+ 7958              ;   přetečení; Z nemá pevný význam.
5942+ 7958              ; --- KONEC DOKUMENTACE CZ ---
5943+ 7958              ConvRStr16
5944+ 7958              ;===============================================================
5945+ 7958              ;http://z80-heaven.wikidot.com/math#toc32
5946+ 7958              ;Input:
5947+ 7958              ;     DE points to the base 10 number string in RAM.
5948+ 7958              ;Outputs:
5949+ 7958              ;     HL is the 16-bit value of the number
5950+ 7958              ;     DE points to the byte after the number
5951+ 7958              ;     BC is HL/10
5952+ 7958              ;     z flag reset (nz)
5953+ 7958              ;     c flag reset (nc)
5954+ 7958              ;Destroys:
5955+ 7958              ;     A (actually, add 30h and you get the ending token)
5956+ 7958              ;Size:  23 bytes
5957+ 7958              ;Speed: 104n+42+11c
5958+ 7958              ;       n is the number of digits
5959+ 7958              ;       c is at most n-2
5960+ 7958              ;       at most 595 cycles for any 16-bit decimal value
5961+ 7958              ;===============================================================
5962+ 7958
5963+ 7958 21 00 00          ld hl,0          ;  10 : 210000
5964+ 795B              ConvLoop:             ;
5965+ 795B 1A                ld a,(de)        ;   7 : 1A
5966+ 795C D6 30             sub 30h          ;   7 : D630
5967+ 795E FE 0A             cp 10            ;   7 : FE0A
5968+ 7960 D0                ret nc           ;5|11 : D0
5969+ 7961 13                inc de           ;   6 : 13
5970+ 7962                                    ;
5971+ 7962 44                ld b,h           ;   4 : 44
5972+ 7963 4D                ld c,l           ;   4 : 4D
5973+ 7964 29                add hl,hl        ;  11 : 29
5974+ 7965 29                add hl,hl        ;  11 : 29
5975+ 7966 09                add hl,bc        ;  11 : 09
5976+ 7967 29                add hl,hl        ;  11 : 29
5977+ 7968                                    ;
5978+ 7968 85                add a,l          ;   4 : 85
5979+ 7969 6F                ld l,a           ;   4 : 6F
5980+ 796A 30 EF             jr nc,ConvLoop   ;12|23: 30EE
5981+ 796C 24                inc h            ; --- : 24
5982+ 796D 18 EC             jr ConvLoop      ; --- : 18EB
5983+ 796F
5984+ 796F
5985+ 796F

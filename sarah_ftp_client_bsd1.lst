2588+ 699A              ;HL-- across #C000 -> #FFFF of the previous directory page.
2589+ 699A              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
2590+ 699A              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
2591+ 699A              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
2592+ 699A              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2593+ 699A              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
2594+ 699A              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2595+ 699A              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2596+ 699A              ; --- KONEC DOKUMENTACE CZ ---
2597+ 699A              DIR128_DEC_HL:
2598+ 699A F5                   push    af                      ;old DEC HL never changed A - preserve it here too
2599+ 699B 2B                   dec     hl
2600+ 699C 7C                   ld      a,h
2601+ 699D FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
2602+ 699F 28 03                jr      z,DIR128_DEC_CROSS
2603+ 69A1 F1                   pop     af
2604+ 69A2 B7                   or      a                       ;restore A and return NC = OK
2605+ 69A3 C9                   ret
2606+ 69A4
2607+ 69A4              DIR128_DEC_CROSS:
2608+ 69A4 D5                   push    de
2609+ 69A5 ED 5B F6 BF          ld      de,(fdp_pointer)
2610+ 69A9 1B                   dec     de
2611+ 69AA 1A                   ld      a,(de)
2612+ 69AB FE FF                cp      #FF
2613+ 69AD 28 0E                jr      z,DIR128_DEC_START
2614+ 69AF ED 53 F6 BF          ld      (fdp_pointer),de
2615+ 69B3 CD E0 BF             call    PAGE128
2616+ 69B6 21 FF FF             ld      hl,#FFFF
2617+ 69B9 D1                   pop     de
2618+ 69BA F1                   pop     af                      ;restore caller's A
2619+ 69BB B7                   or      a                       ;NC = OK, A unchanged
2620+ 69BC C9                   ret
2621+ 69BD              DIR128_DEC_START:
2622+ 69BD 13                   inc     de                      ;keep fdp_pointer on first valid page
2623+ 69BE ED 53 F6 BF          ld      (fdp_pointer),de
2624+ 69C2 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
2625+ 69C5 D1                   pop     de
2626+ 69C6 F1                   pop     af                      ;restore caller's A
2627+ 69C7 37                   scf                             ;C = no previous directory page
2628+ 69C8 C9                   ret

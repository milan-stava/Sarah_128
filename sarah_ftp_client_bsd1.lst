6020+ 789D              ; Ucel: Vstup do převodu od řádu desetitisíců, resp. stovek.
6021+ 789D              ; Vstup: HL = číslo, DE = cíl; bit 7 v (IX+0) řídí tisk úvodních nul.
6022+ 789D              ; Vystup: DE za poslední číslicí, bez nulového terminátoru.
6023+ 789D              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
6024+ 789D              ; Poznamka: Na rozdíl od HL2ASCII nenuluje bit 7. Pro pevnou šířku jej nastavte před voláním.
6025+ 789D              ; --- KONEC DOKUMENTACE CZ ---
6026+ 789D 01 64 00     HL2ASCII_000		ld bc,100

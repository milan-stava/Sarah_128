  890+620E              ;speed management 2.0. starts here. Enables to set user_defined speed. Works with every MBFW.
  891+620E              ;the principle:
  892+620E              ;are you aligned?
  893+620E              ;NO: try to align, if not success->error. If sucess, you have AKT (=current alligned speed is ;known). Is user defined speed definied? (IX+2=255 for no user defined speed) yes, END. NO. set ;speed according to ix+2 (max up to MBFW), end
  894+620E              ;
  895+620E              ;YES:
  896+620E              ;is user defined speed set? (ix+2=255 or other?) NO=check if FW is 7/12? YES, align at speed
  897+620E              ;ix+2, end. FW is higher then 7/12, then check if AKT=IX+2? YES, end, NO, align at ix+2, END.
  898+620E              ;ix+2 was not 255, is FW 7/12? YES, then set FWmax, end. NO the is AKT=MBFW max? YES, then END
  899+620E              ;NO, then align at FW max speed, end
  900+620E              ;output: ix+7= 0-23 if speed set, or 255 if not set
  901+620E
  902+620E              ;SM20 uses:
  903+620E              ;bit 4,(ix+0)	PRINT or not to PRINT
  904+620E              ;(ix+8)		contains maximum speed by detected MBFW (7, 12 or 23)
  905+620E              ;(ix+6)		timeout value
  906+620E              ;bit 6,(ix+0)	state of speed alignment between uart& module, 0 not aligned
  907+620E              ;bit 5,(ix+0)	state of module connection to AP, 0 not connected to AP
  908+620E
  909+620E              ;internal subroutines: switch_speed, find_out_speed
  910+620E              ;external subroutines: send_at:check_ok, set_ud_speed, set_print_speed, print_speed
  911+620E
  912+620E              ; --- DOKUMENTACE CZ: speed_management ---
  913+620E              ; Ucel: Sjednotí rychlost komunikace UART a Wi-Fi při inicializaci.
  914+620E              ; Vstup: Inicializovaný BIOS a příznaky na IX.
  915+620E              ; Vystup: Připravená komunikace nebo obsluha chyby.
  916+620E              ; Meni: AF, BC, DE, HL, BC'; další změny dle volaných BIOS/DOS a tiskových služeb.
  917+620E              ; Poznamka: Pracuje s konfigurací rychlosti, příjmovým bufferem a stavovým výpisem.
  918+620E              ; --- KONEC DOKUMENTACE CZ ---
  919+620E              speed_management
  920+620E DD 36 07 FF  		ld	(ix+7),#FF		;reset currently set speed status
  921+6212 DD CB 00 B6  		res	6,(ix+0)		;set signal UART and module speed not aligned
  922+6216
  923+6216              ;;		ld	hl,#4300
  924+6216              ;;		ld	de,wifi_on_off
  925+6216              ;;		call	PRINTHL
  926+6216
  927+6216 37           		scf				;power on wifi
  928+6217 CD 69 A5     		call	wifi_on
  929+621A
  930+621A
  931+621A 21 00 02     		ld	hl,txt_adr_speed_login	;print "Speed" text
  932+621D 11 D4 89     		ld	de,speed
  933+6220 CD 7A 90     		call	PRINTHL
  934+6223
  935+6223 01 3B 78     		ld	bc,#783B		;set CPU to 3,5 MHz
  936+6226 3E 30        		ld	a,#30
  937+6228 ED 79        		out	(c),a
  938+622A 04           		inc	b
  939+622B AF           		xor	a
  940+622C ED 79        		out	(c),a
  941+622E
  942+622E DD E5        		push	ix
  943+6230 CD 65 A5     		call	gver_inst
  944+6233 DD E1        		pop	ix			;A= max MBFW speed= 7 or 12 or 23
  945+6235 DD 77 08     		ld	(ix+8),a		;save max possible speed for given FW
  946+6238
  947+6238 DD 36 06 01  		ld	(ix+6),1		;timeout for quick AT check, 1 should be ok.
  948+623C CD 72 7A     		call	send_at_check_ok
  949+623F 28 1F        		jr	z,speed_aligned		;Z= speed aligned (UART<-> module)
  950+6241

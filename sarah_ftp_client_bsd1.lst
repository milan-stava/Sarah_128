2663+ 69CC              ; -----------------------------------------------------------------------------
2664+ 69CC              ; search_by_Busy_dir
2665+ 69CC              ; Bank-safe replacement used by FIND for names returned by get_item_name.
2666+ 69CC              ; IN:  HL = physical name start, BC = 16-bit name length
2667+ 69CC              ;      item_name_page = bank companion for HL
2668+ 69CC              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
2669+ 69CC              ; OUT: Z=pattern found, NZ=not found
2670+ 69CC              ; One-character input matches only the FIRST character of a name (quick jump).
2671+ 69CC              ; Two or more characters use normal case-insensitive substring search. There is
2672+ 69CC              ; no 255-byte directory-name limit; directory page crossings are transparent.
2673+ 69CC              ; -----------------------------------------------------------------------------
2674+ 69CC              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
2675+ 69CC              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
2676+ 69CC              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
2677+ 69CC              ;   = délka vzoru.
2678+ 69CC              ; Vystup: Z = shoda, NZ = nenalezeno.
2679+ 69CC              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2680+ 69CC              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
2681+ 69CC              ; --- KONEC DOKUMENTACE CZ ---
2682+ 69CC              search_by_Busy_dir:
2683+ 69CC                      ; Empty name cannot contain a non-empty search pattern.
2684+ 69CC 78                   ld      a,b
2685+ 69CD B1                   or      c
2686+ 69CE 28 2A                jr      z,.dir_search_not_found_fast
2687+ 69D0
2688+ 69D0                      ; Map the directory bank containing the first byte of the name ONCE.
2689+ 69D0                      ; For the normal case the whole name is inside this one 16K bank and
2690+ 69D0                      ; no further paging is needed during FIND.
2691+ 69D0 ED 5B 01 6F          ld      de,(item_name_page)
2692+ 69D4 CD A8 69             call    DIR128_MAP_DE
2693+ 69D7
2694+ 69D7                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
2695+ 69D7                      ; the first character of the file name.  Thus FIND "S" selects names
2696+ 69D7                      ; beginning with S, while 2+ characters remain a substring search.
2697+ 69D7                      ; This is also much faster for the common one-letter jump.
2698+ 69D7 ED 5B A9 77          ld      de,(txtlen+1)
2699+ 69DB 7A                   ld      a,d
2700+ 69DC B7                   or      a
2701+ 69DD 20 0F                jr      nz,.dir_search_len_ge2
2702+ 69DF 7B                   ld      a,e
2703+ 69E0 FE 01                cp      1
2704+ 69E2 20 0A                jr      nz,.dir_search_len_ge2
2705+ 69E4 7E                   ld      a,(hl)
2706+ 69E5 CD CD 77             call    convert
2707+ 69E8 57                   ld      d,a
2708+ 69E9 3A 34 8D             ld      a,(INPBUFF)             ;already normalized by find_items
2709+ 69EC BA                   cp      d                       ;Z=first character matches
2710+ 69ED C9                   ret
2711+ 69EE
2712+ 69EE              .dir_search_len_ge2:
2713+ 69EE                      ; Is the LAST byte of the name still inside the same physical window?
2714+ 69EE                      ; last = HL + BC - 1
2715+ 69EE                      ; Carry means that the name crosses #FFFF -> #C000, therefore use the
2716+ 69EE                      ; fully bank-safe (but slower) routine below.
2717+ 69EE E5                   push    hl
2718+ 69EF C5                   push    bc
2719+ 69F0 0B                   dec     bc
2720+ 69F1 09                   add     hl,bc
2721+ 69F2 C1                   pop     bc
2722+ 69F3 E1                   pop     hl
2723+ 69F4 DA 37 6A             jp      c,search_by_Busy_dir_slow
2724+ 69F7
2725+ 69F7 C3 FE 69             jp      search_by_Busy_fast
2726+ 69FA
2727+ 69FA              .dir_search_not_found_fast:
2728+ 69FA 3E 01                ld      a,1
2729+ 69FC B7                   or      a                       ;NZ
2730+ 69FD C9                   ret
2731+ 69FE
2732+ 69FE
2733+ 69FE              ; -----------------------------------------------------------------------------
2734+ 69FE              ; search_by_Busy_fast
2735+ 69FE              ; Fast case-insensitive substring search for a name fully contained in the
2736+ 69FE              ; currently mapped 16K directory page.
2737+ 69FE              ;
2738+ 69FE              ; IN:  HL = name start, BC = 16-bit name length
2739+ 69FE              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
2740+ 69FE              ; OUT: Z = found, NZ = not found
2741+ 69FE              ;
2742+ 69FE              ; This is deliberately close to the original Busy FIND: the inner compare uses
2743+ 69FE              ; the Z80 CPI instruction.  The pattern has already been converted to lower
2744+ 69FE              ; case once by find_items, so only the source character needs convert here.
2745+ 69FE              ;
2746+ 69FE              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
2747+ 69FE              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
2748+ 69FE              ; matches therefore cannot be skipped.
2749+ 69FE              ; -----------------------------------------------------------------------------
2750+ 69FE              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
2751+ 69FE              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
2752+ 69FE              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
2753+ 69FE              ;   délka.
2754+ 69FE              ; Vystup: Z = shoda, NZ = nenalezeno.

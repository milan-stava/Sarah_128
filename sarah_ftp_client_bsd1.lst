5435+ 78BB              ConvRStr16
5436+ 78BB              ;===============================================================
5437+ 78BB              ;http://z80-heaven.wikidot.com/math#toc32
5438+ 78BB              ;Input:
5439+ 78BB              ;     DE points to the base 10 number string in RAM.
5440+ 78BB              ;Outputs:
5441+ 78BB              ;     HL is the 16-bit value of the number
5442+ 78BB              ;     DE points to the byte after the number
5443+ 78BB              ;     BC is HL/10
5444+ 78BB              ;     z flag reset (nz)
5445+ 78BB              ;     c flag reset (nc)
5446+ 78BB              ;Destroys:
5447+ 78BB              ;     A (actually, add 30h and you get the ending token)
5448+ 78BB              ;Size:  23 bytes
5449+ 78BB              ;Speed: 104n+42+11c
5450+ 78BB              ;       n is the number of digits
5451+ 78BB              ;       c is at most n-2
5452+ 78BB              ;       at most 595 cycles for any 16-bit decimal value
5453+ 78BB              ;===============================================================
5454+ 78BB
5455+ 78BB 21 00 00          ld hl,0          ;  10 : 210000
5456+ 78BE              ConvLoop:             ;
5457+ 78BE 1A                ld a,(de)        ;   7 : 1A
5458+ 78BF D6 30             sub 30h          ;   7 : D630
5459+ 78C1 FE 0A             cp 10            ;   7 : FE0A
5460+ 78C3 D0                ret nc           ;5|11 : D0
5461+ 78C4 13                inc de           ;   6 : 13
5462+ 78C5                                    ;
5463+ 78C5 44                ld b,h           ;   4 : 44
5464+ 78C6 4D                ld c,l           ;   4 : 4D
5465+ 78C7 29                add hl,hl        ;  11 : 29
5466+ 78C8 29                add hl,hl        ;  11 : 29
5467+ 78C9 09                add hl,bc        ;  11 : 09
5468+ 78CA 29                add hl,hl        ;  11 : 29
5469+ 78CB                                    ;
5470+ 78CB 85                add a,l          ;   4 : 85
5471+ 78CC 6F                ld l,a           ;   4 : 6F
5472+ 78CD 30 EF             jr nc,ConvLoop   ;12|23: 30EE
5473+ 78CF 24                inc h            ; --- : 24
5474+ 78D0 18 EC             jr ConvLoop      ; --- : 18EB

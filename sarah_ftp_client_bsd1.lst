 4121+71FD              ; -----------------------------------------------------------------------------
 4122+71FD              ; item_add / item_sub - 128K bank-aware directory movement
 4123+71FD              ;
 4124+71FD              ; IN:
 4125+71FD              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
 4126+71FD              ;       DE = address of its 16-bit page-table-pointer companion
 4127+71FD              ;
 4128+71FD              ; Example:
 4129+71FD              ;       ld bc,cur_item_addr
 4130+71FD              ;       ld de,cur_item_addr_page
 4131+71FD              ;       call item_add
 4132+71FD              ;
 4133+71FD              ; OUT:
 4134+71FD              ;       Z  = cannot move (end/start of directory)
 4135+71FD              ;       NZ = pointer + its bank companion were moved to adjacent item
 4136+71FD              ;
 4137+71FD              ; The address variable and page variable deliberately do NOT have to be adjacent.
 4138+71FD              ; This keeps the original IX+... variable layout completely unchanged.
 4139+71FD              ; The two-byte item length at either end of an item may itself cross a bank.
 4140+71FD              ; -----------------------------------------------------------------------------
 4141+71FD              ; --- DOKUMENTACE CZ: item_add ---
 4142+71FD              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
 4143+71FD              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
 4144+71FD              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
 4145+71FD              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
 4146+71FD              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
 4147+71FD              ; --- KONEC DOKUMENTACE CZ ---
 4148+71FD              item_add
 4149+71FD ED 43 73 6F  		ld	(dir_op_addr_var),bc
 4150+7201 ED 53 75 6F  		ld	(dir_op_page_var),de
 4151+7205
 4152+7205              		;Load physical item address from *(BC).
 4153+7205 60           		ld	h,b
 4154+7206 69           		ld	l,c
 4155+7207 5E           		ld	e,(hl)
 4156+7208 23           		inc	hl
 4157+7209 56           		ld	d,(hl)
 4158+720A ED 53 6B 6F  		ld	(next_item_addr),de	;temporary physical start
 4159+720E EB           		ex	de,hl			;HL=current physical item start
 4160+720F
 4161+720F              		;Load/map directory page from page companion variable.
 4162+720F E5           		push	hl
 4163+7210 2A 75 6F     		ld	hl,(dir_op_page_var)
 4164+7213 5E           		ld	e,(hl)
 4165+7214 23           		inc	hl
 4166+7215 56           		ld	d,(hl)
 4167+7216 E1           		pop	hl
 4168+7217 CD 26 6A     		call	DIR128_MAP_DE
 4169+721A
 4170+721A              		;Read item length LOW/HIGH. Header itself may cross #FFFF/#C000.
 4171+721A 7E           		ld	a,(hl)
 4172+721B 5F           		ld	e,a			;E=length LOW
 4173+721C CD 97 69     		call	DIR128_INC_HL
 4174+721F 38 4C        		jr	c,item_add_end
 4175+7221 7E           		ld	a,(hl)
 4176+7222 57           		ld	d,a			;DE=item length
 4177+7223 B3           		or	e
 4178+7224 28 47        		jr	z,item_add_end		;00 00 = real end of directory
 4179+7226
 4180+7226              		;We are at item_start+1.

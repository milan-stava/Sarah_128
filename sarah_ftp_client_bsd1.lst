 2779+6A74              ; -----------------------------------------------------------------------------
 2780+6A74              ; search_by_Busy_dir
 2781+6A74              ; Bank-safe replacement used by FIND for names returned by get_item_name.
 2782+6A74              ; IN:  HL = physical name start, BC = 16-bit name length
 2783+6A74              ;      item_name_page = bank companion for HL
 2784+6A74              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
 2785+6A74              ; OUT: Z=pattern found, NZ=not found
 2786+6A74              ; One-character input matches only the FIRST character of a name (quick jump).
 2787+6A74              ; Two or more characters use normal case-insensitive substring search. There is
 2788+6A74              ; no 255-byte directory-name limit; directory page crossings are transparent.
 2789+6A74              ; -----------------------------------------------------------------------------
 2790+6A74              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
 2791+6A74              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
 2792+6A74              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
 2793+6A74              ;   = délka vzoru.
 2794+6A74              ; Vystup: Z = shoda, NZ = nenalezeno.
 2795+6A74              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 2796+6A74              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
 2797+6A74              ; --- KONEC DOKUMENTACE CZ ---
 2798+6A74              search_by_Busy_dir:
 2799+6A74                      ; Empty name cannot contain a non-empty search pattern.
 2800+6A74 78                   ld      a,b
 2801+6A75 B1                   or      c
 2802+6A76 28 2A                jr      z,.dir_search_not_found_fast
 2803+6A78
 2804+6A78                      ; Map the directory bank containing the first byte of the name ONCE.
 2805+6A78                      ; For the normal case the whole name is inside this one 16K bank and
 2806+6A78                      ; no further paging is needed during FIND.
 2807+6A78 ED 5B AD 6F          ld      de,(item_name_page)
 2808+6A7C CD 50 6A             call    DIR128_MAP_DE
 2809+6A7F
 2810+6A7F                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
 2811+6A7F                      ; the first character of the file name.  Thus FIND "S" selects names
 2812+6A7F                      ; beginning with S, while 2+ characters remain a substring search.
 2813+6A7F                      ; This is also much faster for the common one-letter jump.
 2814+6A7F ED 5B 5D 79          ld      de,(txtlen+1)
 2815+6A83 7A                   ld      a,d
 2816+6A84 B7                   or      a
 2817+6A85 20 0F                jr      nz,.dir_search_len_ge2
 2818+6A87 7B                   ld      a,e
 2819+6A88 FE 01                cp      1
 2820+6A8A 20 0A                jr      nz,.dir_search_len_ge2
 2821+6A8C 7E                   ld      a,(hl)
 2822+6A8D CD 81 79             call    convert
 2823+6A90 57                   ld      d,a
 2824+6A91 3A 8A 8F             ld      a,(INPBUFF)             ;already normalized by find_items
 2825+6A94 BA                   cp      d                       ;Z=first character matches
 2826+6A95 C9                   ret
 2827+6A96
 2828+6A96              .dir_search_len_ge2:
 2829+6A96                      ; Is the LAST byte of the name still inside the same physical window?
 2830+6A96                      ; last = HL + BC - 1
 2831+6A96                      ; Carry means that the name crosses #FFFF -> #C000, therefore use the
 2832+6A96                      ; fully bank-safe (but slower) routine below.
 2833+6A96 E5                   push    hl
 2834+6A97 C5                   push    bc
 2835+6A98 0B                   dec     bc
 2836+6A99 09                   add     hl,bc
 2837+6A9A C1                   pop     bc
 2838+6A9B E1                   pop     hl

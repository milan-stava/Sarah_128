 959+ 6258              ; --- DOKUMENTACE CZ: speed_management ---
 960+ 6258              ; Ucel: Sjednotí rychlost komunikace UART a Wi-Fi při inicializaci.
 961+ 6258              ; Vstup: Inicializovaný BIOS a příznaky na IX.
 962+ 6258              ; Vystup: Připravená komunikace nebo obsluha chyby.
 963+ 6258              ; Meni: AF, BC, DE, HL, BC'; další změny dle volaných BIOS/DOS a tiskových služeb.
 964+ 6258              ; Poznamka: Pracuje s konfigurací rychlosti, příjmovým bufferem a stavovým výpisem.
 965+ 6258              ; --- KONEC DOKUMENTACE CZ ---
 966+ 6258              speed_management
 967+ 6258 DD 36 07 FF  		ld	(ix+7),#FF		;reset currently set speed status
 968+ 625C DD CB 00 B6  		res	6,(ix+0)		;set signal UART and module speed not aligned

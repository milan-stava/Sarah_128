2856+ 6AAF              ; -----------------------------------------------------------------------------
2857+ 6AAF              ; search_by_Busy_fast
2858+ 6AAF              ; Fast case-insensitive substring search for a name fully contained in the
2859+ 6AAF              ; currently mapped 16K directory page.
2860+ 6AAF              ;
2861+ 6AAF              ; IN:  HL = name start, BC = 16-bit name length
2862+ 6AAF              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
2863+ 6AAF              ; OUT: Z = found, NZ = not found
2864+ 6AAF              ;
2865+ 6AAF              ; This is deliberately close to the original Busy FIND: the inner compare uses
2866+ 6AAF              ; the Z80 CPI instruction.  The pattern has already been converted to lower
2867+ 6AAF              ; case once by find_items, so only the source character needs convert here.
2868+ 6AAF              ;
2869+ 6AAF              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
2870+ 6AAF              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
2871+ 6AAF              ; matches therefore cannot be skipped.
2872+ 6AAF              ; -----------------------------------------------------------------------------
2873+ 6AAF              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
2874+ 6AAF              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
2875+ 6AAF              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
2876+ 6AAF              ;   délka.
2877+ 6AAF              ; Vystup: Z = shoda, NZ = nenalezeno.
2878+ 6AAF              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2879+ 6AAF              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
2880+ 6AAF              ; --- KONEC DOKUMENTACE CZ ---
2881+ 6AAF              search_by_Busy_fast:
2882+ 6AAF EB                   ex      de,hl                   ;DE=current candidate in file name
2883+ 6AB0
2884+ 6AB0                      ; candidate_count = name_length - pattern_length + 1
2885+ 6AB0 60                   ld      h,b
2886+ 6AB1 69                   ld      l,c
2887+ 6AB2 ED 4B A3 78          ld      bc,(txtlen+1)
2888+ 6AB6 78                   ld      a,b
2889+ 6AB7 B1                   or      c
2890+ 6AB8 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
2891+ 6ABA B7                   or      a
2892+ 6ABB ED 42                sbc     hl,bc
2893+ 6ABD 38 25                jr      c,.fast_not_found       ;pattern longer than file name
2894+ 6ABF 23                   inc     hl
2895+ 6AC0
2896+ 6AC0                      ; Keep number of possible candidate starts in alternate BC.
2897+ 6AC0 E5                   push    hl
2898+ 6AC1 D9                   exx
2899+ 6AC2 C1                   pop     bc
2900+ 6AC3 D9                   exx
2901+ 6AC4
2902+ 6AC4              .fast_next_candidate:
2903+ 6AC4 D5                   push    de                      ;remember exact candidate start
2904+ 6AC5 21 D8 8E             ld      hl,INPBUFF
2905+ 6AC8 ED 4B A3 78          ld      bc,(txtlen+1)
2906+ 6ACC
2907+ 6ACC              .fast_compare:
2908+ 6ACC 1A                   ld      a,(de)
2909+ 6ACD CD C7 78             call    convert                 ;source char -> lower case
2910+ 6AD0 ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
2911+ 6AD2 13                   inc     de
2912+ 6AD3 20 06                jr      nz,.fast_candidate_failed
2913+ 6AD5 EA CC 6A             jp      pe,.fast_compare        ;matched, more pattern bytes remain
2914+ 6AD8
2915+ 6AD8 D1                   pop     de                      ;discard saved candidate start
2916+ 6AD9              .fast_found:
2917+ 6AD9 AF                   xor     a                       ;Z = found
2918+ 6ADA C9                   ret
2919+ 6ADB
2920+ 6ADB              .fast_candidate_failed:
2921+ 6ADB D1                   pop     de                      ;restore previous candidate start
2922+ 6ADC 13                   inc     de                      ;next candidate = previous + 1
2923+ 6ADD D9                   exx
2924+ 6ADE 0B                   dec     bc
2925+ 6ADF 78                   ld      a,b
2926+ 6AE0 B1                   or      c
2927+ 6AE1 D9                   exx
2928+ 6AE2 20 E0                jr      nz,.fast_next_candidate
2929+ 6AE4
2930+ 6AE4              .fast_not_found:
2931+ 6AE4 3E 01                ld      a,1
2932+ 6AE6 B7                   or      a                       ;NZ = not found
2933+ 6AE7 C9                   ret
2934+ 6AE8

6061+ 78C3 30 FA        			jr nc,string_lp2
6062+ 78C5 09           			add hl,bc
6063+ 78C6 FE 30        			CP '0'
6064+ 78C8 28 04        			JR Z,string_store
6065+ 78CA
6066+ 78CA DD CB 00 FE  			SET 7,(IX+0)		;Had something other than zero
6067+ 78CE
6068+ 78CE DD CB 00 7E  string_store:		BIT 7,(IX+0)		;Test if still leading zeros
6069+ 78D2 C8           			RET Z
6070+ 78D3 12           			LD (DE),A		;If not store it
6071+ 78D4 13           			INC DE

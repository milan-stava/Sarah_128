 7171+7DF2              ;NZ=4= TCP or UDP disconnected
 7172+7DF2              ;NZ=3= TCP or UDP connected, but not ftp (only internal state of routine), routine will change it to status 4, NZ)
 7173+7DF2              ;OUT="current_host" either X, if not connected to ftp server, or host name if connected
 7174+7DF2              ;OUT=Z=HL=code returned by NOOP, NZ=HL=0

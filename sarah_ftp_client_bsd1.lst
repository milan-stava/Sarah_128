 265+ 0000              ;- ver 0.1	- login to ftp server (login+ pasword), done
 266+ 0000              ;		- find out file size, done
 267+ 0000              ;		- quit ftp connection, done
 268+ 0000              ;		- download file, in process
 269+ 0000              ;		- upload file, done
 270+ 0000
 271+ 0000              ;	output "zx_ftp_client"
 272+ 0000
 273+ 0000              ;set C=		SCF
 274+ 0000              ;set NC=	AND A, if Z needs to be preserved, then SCF:CCF

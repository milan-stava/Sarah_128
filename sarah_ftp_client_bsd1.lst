2625+ 6A89 FE FF                cp      #FF
2626+ 6A8B 28 0E                jr      z,DIR128_DEC_START
2627+ 6A8D ED 53 F6 BF          ld      (fdp_pointer),de
2628+ 6A91 CD E0 BF             call    PAGE128

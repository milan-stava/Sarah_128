2844+ 6971              ; -----------------------------------------------------------------------------
2845+ 6971              ; DIR128_COPY_NAME_TO_DE
2846+ 6971              ; Copy the name returned by get_item_name to fixed RAM.
2847+ 6971              ; IN:  HL = physical source address in directory window
2848+ 6971              ;      BC = 16-bit name length
2849+ 6971              ;      DE = fixed-RAM destination
2850+ 6971              ;      item_name_page = page-table pointer belonging to HL
2851+ 6971              ; OUT: DE points behind copied bytes, BC=0
2852+ 6971              ; The source may cross any #FFFF -> #C000 directory-page boundary.
2853+ 6971              ; -----------------------------------------------------------------------------
2854+ 6971              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
2855+ 6971              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
2856+ 6971              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
2857+ 6971              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
2858+ 6971              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2859+ 6971              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
2860+ 6971              ; --- KONEC DOKUMENTACE CZ ---
2861+ 6971              DIR128_COPY_NAME_TO_DE:
2862+ 6971 D5                   push    de
2863+ 6972 ED 5B 54 6E          ld      de,(item_name_page)
2864+ 6976 CD 66 69             call    DIR128_MAP_DE
2865+ 6979 D1                   pop     de

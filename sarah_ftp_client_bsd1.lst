 2817+6A75 C3 7C 6A             jp      search_by_Busy_fast
 2818+6A78
 2819+6A78              .dir_search_not_found_fast:
 2820+6A78 3E 01                ld      a,1
 2821+6A7A B7                   or      a                       ;NZ
 2822+6A7B C9                   ret

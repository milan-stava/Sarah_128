5973+ 7889              ; --- DOKUMENTACE CZ: ConvRStr16 ---
5974+ 7889              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
5975+ 7889              ; Vstup: DE = začátek číslic.
5976+ 7889              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
5977+ 7889              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
5978+ 7889              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
5979+ 7889              ;   přetečení; Z nemá pevný význam.
5980+ 7889              ; --- KONEC DOKUMENTACE CZ ---
5981+ 7889              ConvRStr16
5982+ 7889              ;===============================================================
5983+ 7889              ;http://z80-heaven.wikidot.com/math#toc32
5984+ 7889              ;Input:
5985+ 7889              ;     DE points to the base 10 number string in RAM.
5986+ 7889              ;Outputs:
5987+ 7889              ;     HL is the 16-bit value of the number
5988+ 7889              ;     DE points to the byte after the number
5989+ 7889              ;     BC is HL/10
5990+ 7889              ;     z flag reset (nz)
5991+ 7889              ;     c flag reset (nc)
5992+ 7889              ;Destroys:
5993+ 7889              ;     A (actually, add 30h and you get the ending token)
5994+ 7889              ;Size:  23 bytes
5995+ 7889              ;Speed: 104n+42+11c
5996+ 7889              ;       n is the number of digits
5997+ 7889              ;       c is at most n-2
5998+ 7889              ;       at most 595 cycles for any 16-bit decimal value
5999+ 7889              ;===============================================================
6000+ 7889
6001+ 7889 21 00 00          ld hl,0          ;  10 : 210000
6002+ 788C              ConvLoop:             ;
6003+ 788C 1A                ld a,(de)        ;   7 : 1A
6004+ 788D D6 30             sub 30h          ;   7 : D630
6005+ 788F FE 0A             cp 10            ;   7 : FE0A
6006+ 7891 D0                ret nc           ;5|11 : D0
6007+ 7892 13                inc de           ;   6 : 13
6008+ 7893                                    ;
6009+ 7893 44                ld b,h           ;   4 : 44
6010+ 7894 4D                ld c,l           ;   4 : 4D
6011+ 7895 29                add hl,hl        ;  11 : 29
6012+ 7896 29                add hl,hl        ;  11 : 29
6013+ 7897 09                add hl,bc        ;  11 : 09
6014+ 7898 29                add hl,hl        ;  11 : 29
6015+ 7899                                    ;
6016+ 7899 85                add a,l          ;   4 : 85
6017+ 789A 6F                ld l,a           ;   4 : 6F
6018+ 789B 30 EF             jr nc,ConvLoop   ;12|23: 30EE
6019+ 789D 24                inc h            ; --- : 24
6020+ 789E 18 EC             jr ConvLoop      ; --- : 18EB

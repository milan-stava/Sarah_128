2639+ 69C9
2640+ 69C9              ; -----------------------------------------------------------------------------
2641+ 69C9              ; DIR128_COPY_NAME_TO_DE
2642+ 69C9              ; Copy the name returned by get_item_name to fixed RAM.
2643+ 69C9              ; IN:  HL = physical source address in directory window
2644+ 69C9              ;      BC = 16-bit name length
2645+ 69C9              ;      DE = fixed-RAM destination
2646+ 69C9              ;      item_name_page = page-table pointer belonging to HL
2647+ 69C9              ; OUT: DE points behind copied bytes, BC=0
2648+ 69C9              ; The source may cross any #FFFF -> #C000 directory-page boundary.
2649+ 69C9              ; -----------------------------------------------------------------------------
2650+ 69C9              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
2651+ 69C9              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
2652+ 69C9              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
2653+ 69C9              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
2654+ 69C9              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2655+ 69C9              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
2656+ 69C9              ; --- KONEC DOKUMENTACE CZ ---
2657+ 69C9              DIR128_COPY_NAME_TO_DE:
2658+ 69C9 D5                   push    de
2659+ 69CA ED 5B 19 6F          ld      de,(item_name_page)
2660+ 69CE CD BE 69             call    DIR128_MAP_DE
2661+ 69D1 D1                   pop     de
2662+ 69D2              .dir128_copy_loop:
2663+ 69D2 78                   ld      a,b
2664+ 69D3 B1                   or      c
2665+ 69D4 C8                   ret     z
2666+ 69D5 7E                   ld      a,(hl)
2667+ 69D6 12                   ld      (de),a
2668+ 69D7 13                   inc     de
2669+ 69D8 0B                   dec     bc
2670+ 69D9 78                   ld      a,b
2671+ 69DA B1                   or      c
2672+ 69DB C8                   ret     z
2673+ 69DC CD 2F 69             call    DIR128_INC_HL
2674+ 69DF D8                   ret     c                       ;should only happen on malformed item
2675+ 69E0 18 F0                jr      .dir128_copy_loop

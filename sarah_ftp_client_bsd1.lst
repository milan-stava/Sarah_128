2901+ 6B64              .dir_search_advance_candidate:
2902+ 6B64                      ;Always advance by exactly ONE source character.  This fixes both the
2903+ 6B64                      ;old overlapping-match bug and the old one-character special case.
2904+ 6B64 2A E7 6F             ld      hl,(dir_search_addr)
2905+ 6B67 ED 5B E9 6F          ld      de,(dir_search_page)
2906+ 6B6B CD 89 6A             call    DIR128_MAP_DE
2907+ 6B6E CD FA 69             call    DIR128_INC_HL
2908+ 6B71 38 16                jr      c,.dir_search_not_found
2909+ 6B73 22 E7 6F             ld      (dir_search_addr),hl
2910+ 6B76 ED 5B F6 BF          ld      de,(fdp_pointer)
2911+ 6B7A ED 53 E9 6F          ld      (dir_search_page),de
2912+ 6B7E 2A EB 6F             ld      hl,(dir_search_remaining)
2913+ 6B81 2B                   dec     hl
2914+ 6B82 22 EB 6F             ld      (dir_search_remaining),hl
2915+ 6B85 18 AA                jr      .dir_search_outer
2916+ 6B87
2917+ 6B87              .dir_search_found:
2918+ 6B87 AF                   xor     a                       ;Z
2919+ 6B88 C9                   ret
2920+ 6B89              .dir_search_not_found:
2921+ 6B89 3E 01                ld      a,1

2842+ 6B1D              ; -----------------------------------------------------------------------------
2843+ 6B1D              ; search_by_Busy_dir_slow
2844+ 6B1D              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
2845+ 6B1D              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
2846+ 6B1D              ; no longer slows down every ordinary FIND operation.
2847+ 6B1D              ;
2848+ 6B1D              ; One-character FIND is handled before this fallback and compares only the
2849+ 6B1D              ; first character.  This slow path therefore normally handles 2+ character
2850+ 6B1D              ; substring searches whose source name crosses a directory-bank boundary.
2851+ 6B1D              ; -----------------------------------------------------------------------------
2852+ 6B1D              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
2853+ 6B1D              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
2854+ 6B1D              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
2855+ 6B1D              ;   a délka.
2856+ 6B1D              ; Vystup: Z = shoda, NZ = nenalezeno.
2857+ 6B1D              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2858+ 6B1D              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
2859+ 6B1D              ; --- KONEC DOKUMENTACE CZ ---
2860+ 6B1D              search_by_Busy_dir_slow:
2861+ 6B1D 22 EF 6F             ld      (dir_search_addr),hl

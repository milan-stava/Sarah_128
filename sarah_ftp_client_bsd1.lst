2544+ 6968              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
2545+ 6968              ;Unlike the general helper, this preserves the COMPLETE parser state:
2546+ 6968              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
2547+ 6968              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
2548+ 6968              ;  dir128_parser_status = 0  OK
2549+ 6968              ;  dir128_parser_status = 1  no next directory page
2550+ 6968              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
2551+ 6968              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
2552+ 6968              ; Vstup: HL = adresa v aktuální bance adresáře.
2553+ 6968              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
2554+ 6968              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
2555+ 6968              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
2556+ 6968              ; --- KONEC DOKUMENTACE CZ ---
2557+ 6968              DIR128_INC_HL_PARSER:
2558+ 6968 F5                   push    af
2559+ 6969 D5                   push    de
2560+ 696A AF                   xor     a
2561+ 696B 32 9E 86             ld      (dir128_parser_status),a
2562+ 696E 23                   inc     hl
2563+ 696F 7C                   ld      a,h
2564+ 6970 B7                   or      a
2565+ 6971 20 14                jr      nz,.ok
2566+ 6973 ED 5B F6 BF          ld      de,(fdp_pointer)
2567+ 6977 13                   inc     de
2568+ 6978 1A                   ld      a,(de)
2569+ 6979 FE FF                cp      #FF
2570+ 697B 28 0D                jr      z,.full
2571+ 697D ED 53 F6 BF          ld      (fdp_pointer),de
2572+ 6981 CD E0 BF             call    PAGE128
2573+ 6984 21 00 C0             ld      hl,ftp_dir_start
2574+ 6987              .ok:
2575+ 6987 D1                   pop     de
2576+ 6988 F1                   pop     af
2577+ 6989 C9                   ret
2578+ 698A              .full:
2579+ 698A 1B                   dec     de
2580+ 698B ED 53 F6 BF          ld      (fdp_pointer),de
2581+ 698F 21 FF FF             ld      hl,#FFFF
2582+ 6992 3E 01                ld      a,1
2583+ 6994 32 9E 86             ld      (dir128_parser_status),a
2584+ 6997 D1                   pop     de
2585+ 6998 F1                   pop     af
2586+ 6999 C9                   ret

2653+ 6A99
2654+ 6A99              ; -----------------------------------------------------------------------------
2655+ 6A99              ; DIR128_COPY_NAME_TO_DE
2656+ 6A99              ; Copy the name returned by get_item_name to fixed RAM.
2657+ 6A99              ; IN:  HL = physical source address in directory window
2658+ 6A99              ;      BC = 16-bit name length
2659+ 6A99              ;      DE = fixed-RAM destination
2660+ 6A99              ;      item_name_page = page-table pointer belonging to HL
2661+ 6A99              ; OUT: DE points behind copied bytes, BC=0
2662+ 6A99              ; The source may cross any #FFFF -> #C000 directory-page boundary.
2663+ 6A99              ; -----------------------------------------------------------------------------
2664+ 6A99              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
2665+ 6A99              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
2666+ 6A99              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
2667+ 6A99              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
2668+ 6A99              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2669+ 6A99              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
2670+ 6A99              ; --- KONEC DOKUMENTACE CZ ---
2671+ 6A99              DIR128_COPY_NAME_TO_DE:
2672+ 6A99 D5                   push    de
2673+ 6A9A ED 5B E8 6F          ld      de,(item_name_page)
2674+ 6A9E CD 8E 6A             call    DIR128_MAP_DE
2675+ 6AA1 D1                   pop     de
2676+ 6AA2              .dir128_copy_loop:
2677+ 6AA2 78                   ld      a,b
2678+ 6AA3 B1                   or      c
2679+ 6AA4 C8                   ret     z
2680+ 6AA5 7E                   ld      a,(hl)
2681+ 6AA6 12                   ld      (de),a
2682+ 6AA7 13                   inc     de
2683+ 6AA8 0B                   dec     bc
2684+ 6AA9 78                   ld      a,b
2685+ 6AAA B1                   or      c
2686+ 6AAB C8                   ret     z
2687+ 6AAC CD FF 69             call    DIR128_INC_HL
2688+ 6AAF D8                   ret     c                       ;should only happen on malformed item
2689+ 6AB0 18 F0                jr      .dir128_copy_loop

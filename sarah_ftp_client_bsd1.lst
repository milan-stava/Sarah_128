 263+ 0000              ;ZX FTP client for MB03+
 264+ 0000              ;Hood
 265+ 0000
 266+ 0000              ;- ver 0.1	- login to ftp server (login+ pasword), done
 267+ 0000              ;		- find out file size, done
 268+ 0000              ;		- quit ftp connection, done
 269+ 0000              ;		- download file, in process
 270+ 0000              ;		- upload file, done
 271+ 0000
 272+ 0000              ;	output "zx_ftp_client"
 273+ 0000
 274+ 0000              ;set C=		SCF
 275+ 0000              ;set NC=	AND A, if Z needs to be preserved, then SCF:CCF

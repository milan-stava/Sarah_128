2689+ 6AAD
2690+ 6AAD              ; -----------------------------------------------------------------------------
2691+ 6AAD              ; search_by_Busy_dir
2692+ 6AAD              ; Bank-safe replacement used by FIND for names returned by get_item_name.
2693+ 6AAD              ; IN:  HL = physical name start, BC = 16-bit name length
2694+ 6AAD              ;      item_name_page = bank companion for HL
2695+ 6AAD              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
2696+ 6AAD              ; OUT: Z=pattern found, NZ=not found
2697+ 6AAD              ; One-character input matches only the FIRST character of a name (quick jump).
2698+ 6AAD              ; Two or more characters use normal case-insensitive substring search. There is
2699+ 6AAD              ; no 255-byte directory-name limit; directory page crossings are transparent.
2700+ 6AAD              ; -----------------------------------------------------------------------------
2701+ 6AAD              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
2702+ 6AAD              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
2703+ 6AAD              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
2704+ 6AAD              ;   = délka vzoru.
2705+ 6AAD              ; Vystup: Z = shoda, NZ = nenalezeno.
2706+ 6AAD              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2707+ 6AAD              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
2708+ 6AAD              ; --- KONEC DOKUMENTACE CZ ---
2709+ 6AAD              search_by_Busy_dir:
2710+ 6AAD                      ; Empty name cannot contain a non-empty search pattern.
2711+ 6AAD 78                   ld      a,b
2712+ 6AAE B1                   or      c
2713+ 6AAF 28 2A                jr      z,.dir_search_not_found_fast
2714+ 6AB1
2715+ 6AB1                      ; Map the directory bank containing the first byte of the name ONCE.
2716+ 6AB1                      ; For the normal case the whole name is inside this one 16K bank and
2717+ 6AB1                      ; no further paging is needed during FIND.
2718+ 6AB1 ED 5B E0 6F          ld      de,(item_name_page)
2719+ 6AB5 CD 89 6A             call    DIR128_MAP_DE
2720+ 6AB8
2721+ 6AB8                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
2722+ 6AB8                      ; the first character of the file name.  Thus FIND "S" selects names
2723+ 6AB8                      ; beginning with S, while 2+ characters remain a substring search.
2724+ 6AB8                      ; This is also much faster for the common one-letter jump.
2725+ 6AB8 ED 5B DE 78          ld      de,(txtlen+1)
2726+ 6ABC 7A                   ld      a,d
2727+ 6ABD B7                   or      a
2728+ 6ABE 20 0F                jr      nz,.dir_search_len_ge2
2729+ 6AC0 7B                   ld      a,e
2730+ 6AC1 FE 01                cp      1
2731+ 6AC3 20 0A                jr      nz,.dir_search_len_ge2
2732+ 6AC5 7E                   ld      a,(hl)

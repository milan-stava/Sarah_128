2478+ 69F1              ; -----------------------------------------------------------------------------
2479+ 69F1              ; FTP DIRECTORY BANK API
2480+ 69F1              ;
2481+ 69F1              ; fdp_pointer always points to the table byte of the CURRENT directory page.
2482+ 69F1              ; ftp_dir_page has #FF sentinels on both sides:
2483+ 69F1              ;       #FF, 0, 1, 3, 7, #FF
2484+ 69F1              ;
2485+ 69F1              ; HL is always a physical address in the banked window #C000-#FFFF.
2486+ 69F1              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
2487+ 69F1              ;
2488+ 69F1              ; OUT for INC/DEC:
2489+ 69F1              ;       NC = movement succeeded
2490+ 69F1              ;       C  = no next/previous directory page (64 KB boundary)
2491+ 69F1              ;
2492+ 69F1              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
2493+ 69F1              ; which preserves AF/BC/DE/IX/IY exactly.
2494+ 69F1              ; -----------------------------------------------------------------------------
2495+ 69F1
2496+ 69F1
2497+ 69F1              ; Select first FTP directory page (page 0); preserve caller's pointer.
2498+ 69F1              DIR128_FIRST_PAGE:
2499+ 69F1 E5                   push    hl
2500+ 69F2 21 F1 BF             ld      hl,ftp_dir_page+1
2501+ 69F5 22 F6 BF             ld      (fdp_pointer),hl
2502+ 69F8 7E                   ld      a,(hl)
2503+ 69F9 CD E0 BF             call    PAGE128
2504+ 69FC E1                   pop     hl
2505+ 69FD B7                   or      a
2506+ 69FE C9                   ret
2507+ 69FF
2508+ 69FF              ;HL++ across #FFFF -> #C000 of the next directory page.
2509+ 69FF              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
2510+ 69FF              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
2511+ 69FF              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
2512+ 69FF              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2513+ 69FF              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
2514+ 69FF              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2515+ 69FF              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2516+ 69FF              ; --- KONEC DOKUMENTACE CZ ---
2517+ 69FF              DIR128_INC_HL:
2518+ 69FF F5                   push    af                      ;old INC HL never changed A - preserve it here too
2519+ 6A00 23                   inc     hl
2520+ 6A01 7C                   ld      a,h
2521+ 6A02 B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
2522+ 6A03 28 03                jr      z,DIR128_INC_CROSS
2523+ 6A05 F1                   pop     af
2524+ 6A06 B7                   or      a                       ;restore A and return NC = OK
2525+ 6A07 C9                   ret
2526+ 6A08
2527+ 6A08              DIR128_INC_CROSS:
2528+ 6A08 D5                   push    de
2529+ 6A09 ED 5B F6 BF          ld      de,(fdp_pointer)
2530+ 6A0D 13                   inc     de
2531+ 6A0E 1A                   ld      a,(de)
2532+ 6A0F FE FF                cp      #FF
2533+ 6A11 28 0E                jr      z,DIR128_INC_END
2534+ 6A13 ED 53 F6 BF          ld      (fdp_pointer),de
2535+ 6A17 CD E0 BF             call    PAGE128
2536+ 6A1A 21 00 C0             ld      hl,ftp_dir_start        ;#C000
2537+ 6A1D D1                   pop     de
2538+ 6A1E F1                   pop     af                      ;restore caller's A
2539+ 6A1F B7                   or      a                       ;NC = OK, A unchanged
2540+ 6A20 C9                   ret
2541+ 6A21              DIR128_INC_END:
2542+ 6A21 1B                   dec     de                      ;keep fdp_pointer on last valid page
2543+ 6A22 ED 53 F6 BF          ld      (fdp_pointer),de
2544+ 6A26 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
2545+ 6A29 D1                   pop     de
2546+ 6A2A F1                   pop     af                      ;restore caller's A
2547+ 6A2B 37                   scf                             ;C = no following directory page
2548+ 6A2C C9                   ret
2549+ 6A2D
2550+ 6A2D              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
2551+ 6A2D              ;Unlike the general helper, this preserves the COMPLETE parser state:
2552+ 6A2D              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
2553+ 6A2D              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
2554+ 6A2D              ;  dir128_parser_status = 0  OK
2555+ 6A2D              ;  dir128_parser_status = 1  no next directory page
2556+ 6A2D              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
2557+ 6A2D              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
2558+ 6A2D              ; Vstup: HL = adresa v aktuální bance adresáře.
2559+ 6A2D              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
2560+ 6A2D              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
2561+ 6A2D              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
2562+ 6A2D              ; --- KONEC DOKUMENTACE CZ ---
2563+ 6A2D              DIR128_INC_HL_PARSER:
2564+ 6A2D F5                   push    af
2565+ 6A2E D5                   push    de
2566+ 6A2F AF                   xor     a
2567+ 6A30 32 96 88             ld      (dir128_parser_status),a
2568+ 6A33 23                   inc     hl
2569+ 6A34 7C                   ld      a,h
2570+ 6A35 B7                   or      a
2571+ 6A36 20 14                jr      nz,.ok
2572+ 6A38 ED 5B F6 BF          ld      de,(fdp_pointer)
2573+ 6A3C 13                   inc     de
2574+ 6A3D 1A                   ld      a,(de)
2575+ 6A3E FE FF                cp      #FF
2576+ 6A40 28 0D                jr      z,.full
2577+ 6A42 ED 53 F6 BF          ld      (fdp_pointer),de
2578+ 6A46 CD E0 BF             call    PAGE128
2579+ 6A49 21 00 C0             ld      hl,ftp_dir_start
2580+ 6A4C              .ok:
2581+ 6A4C D1                   pop     de
2582+ 6A4D F1                   pop     af
2583+ 6A4E C9                   ret
2584+ 6A4F              .full:
2585+ 6A4F 1B                   dec     de
2586+ 6A50 ED 53 F6 BF          ld      (fdp_pointer),de
2587+ 6A54 21 FF FF             ld      hl,#FFFF
2588+ 6A57 3E 01                ld      a,1
2589+ 6A59 32 96 88             ld      (dir128_parser_status),a
2590+ 6A5C D1                   pop     de
2591+ 6A5D F1                   pop     af
2592+ 6A5E C9                   ret
2593+ 6A5F
2594+ 6A5F              ;HL-- across #C000 -> #FFFF of the previous directory page.
2595+ 6A5F              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
2596+ 6A5F              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
2597+ 6A5F              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
2598+ 6A5F              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2599+ 6A5F              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
2600+ 6A5F              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2601+ 6A5F              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2602+ 6A5F              ; --- KONEC DOKUMENTACE CZ ---
2603+ 6A5F              DIR128_DEC_HL:
2604+ 6A5F F5                   push    af                      ;old DEC HL never changed A - preserve it here too
2605+ 6A60 2B                   dec     hl
2606+ 6A61 7C                   ld      a,h
2607+ 6A62 FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
2608+ 6A64 28 03                jr      z,DIR128_DEC_CROSS
2609+ 6A66 F1                   pop     af
2610+ 6A67 B7                   or      a                       ;restore A and return NC = OK
2611+ 6A68 C9                   ret
2612+ 6A69
2613+ 6A69              DIR128_DEC_CROSS:
2614+ 6A69 D5                   push    de
2615+ 6A6A ED 5B F6 BF          ld      de,(fdp_pointer)
2616+ 6A6E 1B                   dec     de
2617+ 6A6F 1A                   ld      a,(de)
2618+ 6A70 FE FF                cp      #FF
2619+ 6A72 28 0E                jr      z,DIR128_DEC_START
2620+ 6A74 ED 53 F6 BF          ld      (fdp_pointer),de
2621+ 6A78 CD E0 BF             call    PAGE128
2622+ 6A7B 21 FF FF             ld      hl,#FFFF
2623+ 6A7E D1                   pop     de
2624+ 6A7F F1                   pop     af                      ;restore caller's A
2625+ 6A80 B7                   or      a                       ;NC = OK, A unchanged
2626+ 6A81 C9                   ret
2627+ 6A82              DIR128_DEC_START:
2628+ 6A82 13                   inc     de                      ;keep fdp_pointer on first valid page
2629+ 6A83 ED 53 F6 BF          ld      (fdp_pointer),de
2630+ 6A87 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
2631+ 6A8A D1                   pop     de
2632+ 6A8B F1                   pop     af                      ;restore caller's A
2633+ 6A8C 37                   scf                             ;C = no previous directory page
2634+ 6A8D C9                   ret
2635+ 6A8E
2636+ 6A8E              ;Map page-table pointer stored in DE. HL is preserved.
2637+ 6A8E              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
2638+ 6A8E              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
2639+ 6A8E              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
2640+ 6A8E              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
2641+ 6A8E              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
2642+ 6A8E              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
2643+ 6A8E              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
2644+ 6A8E              ; --- KONEC DOKUMENTACE CZ ---
2645+ 6A8E              DIR128_MAP_DE:
2646+ 6A8E F5                   push    af
2647+ 6A8F ED 53 F6 BF          ld      (fdp_pointer),de
2648+ 6A93 1A                   ld      a,(de)
2649+ 6A94 CD E0 BF             call    PAGE128
2650+ 6A97 F1                   pop     af
2651+ 6A98 C9                   ret

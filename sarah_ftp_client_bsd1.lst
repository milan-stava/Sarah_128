   1++9ED4              ; Shared ESP-AT framing above the unchanged Wi-Fi BIOS.
   2++9ED4              ; Firmware dialect retained: +CIPRECVDATA,<length>:<binary>.
   3++9ED4              ; Events: 1 OK, 2 ERROR, 3 prompt, 4 SEND OK, 5 SEND FAIL,
   4++9ED4              ;         6 busy, 7 active IPD header, 8 receive-data header, 0 other.
   5++9ED4              ; Binary payload is never searched for AT result strings.
   6++9ED4              AT_OK equ 1
   7++9ED4              AT_ERROR equ 2
   8++9ED4              AT_PROMPT equ 3
   9++9ED4              AT_SEND_OK equ 4
  10++9ED4              AT_SEND_FAIL equ 5
  11++9ED4              AT_BUSY equ 6
  12++9ED4              AT_IPD equ 7

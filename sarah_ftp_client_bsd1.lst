 9151+8589              ;Move parser HL to next stored item byte and decrement gfn_remaining.
 9152+8589              ;C means there is no further byte inside this item.
 9153+8589              gfn_next:
 9154+8589 D5                   push    de
 9155+858A ED 5B AF 6F          ld      de,(gfn_remaining)
 9156+858E 7A                   ld      a,d
 9157+858F B3                   or      e

 4093+7106              ; -----------------------------------------------------------------------------
 4094+7106              ; item_add / item_sub - 128K bank-aware directory movement
 4095+7106              ;
 4096+7106              ; IN:
 4097+7106              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
 4098+7106              ;       DE = address of its 16-bit page-table-pointer companion
 4099+7106              ;
 4100+7106              ; Example:
 4101+7106              ;       ld bc,cur_item_addr
 4102+7106              ;       ld de,cur_item_addr_page
 4103+7106              ;       call item_add
 4104+7106              ;
 4105+7106              ; OUT:
 4106+7106              ;       Z  = cannot move (end/start of directory)
 4107+7106              ;       NZ = pointer + its bank companion were moved to adjacent item
 4108+7106              ;
 4109+7106              ; The address variable and page variable deliberately do NOT have to be adjacent.
 4110+7106              ; This keeps the original IX+... variable layout completely unchanged.
 4111+7106              ; The two-byte item length at either end of an item may itself cross a bank.
 4112+7106              ; -----------------------------------------------------------------------------
 4113+7106              ; --- DOKUMENTACE CZ: item_add ---
 4114+7106              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
 4115+7106              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
 4116+7106              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
 4117+7106              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
 4118+7106              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
 4119+7106              ; --- KONEC DOKUMENTACE CZ ---
 4120+7106              item_add
 4121+7106 ED 43 49 6F  		ld	(dir_op_addr_var),bc
 4122+710A ED 53 4B 6F  		ld	(dir_op_page_var),de

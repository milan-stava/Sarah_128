 9159+8592 1B                   dec     de
 9160+8593 7A                   ld      a,d
 9161+8594 B3                   or      e
 9162+8595 28 09                jr      z,gfn_next_end
 9163+8597 ED 53 AF 6F          ld      (gfn_remaining),de
 9164+859B D1                   pop     de

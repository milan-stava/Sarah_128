3838+ 70AC              ; -----------------------------------------------------------------------------
3839+ 70AC              ; item_add / item_sub - 128K bank-aware directory movement
3840+ 70AC              ;
3841+ 70AC              ; IN:
3842+ 70AC              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
3843+ 70AC              ;       DE = address of its 16-bit page-table-pointer companion
3844+ 70AC              ;
3845+ 70AC              ; Example:
3846+ 70AC              ;       ld bc,cur_item_addr
3847+ 70AC              ;       ld de,cur_item_addr_page
3848+ 70AC              ;       call item_add
3849+ 70AC              ;
3850+ 70AC              ; OUT:
3851+ 70AC              ;       Z  = cannot move (end/start of directory)
3852+ 70AC              ;       NZ = pointer + its bank companion were moved to adjacent item
3853+ 70AC              ;
3854+ 70AC              ; The address variable and page variable deliberately do NOT have to be adjacent.
3855+ 70AC              ; This keeps the original IX+... variable layout completely unchanged.
3856+ 70AC              ; The two-byte item length at either end of an item may itself cross a bank.
3857+ 70AC              ; -----------------------------------------------------------------------------
3858+ 70AC              item_add

2905+ 6AA3              .dir_search_advance_candidate:
2906+ 6AA3                      ;Always advance by exactly ONE source character.  This fixes both the
2907+ 6AA3                      ;old overlapping-match bug and the old one-character special case.
2908+ 6AA3 2A 28 6F             ld      hl,(dir_search_addr)
2909+ 6AA6 ED 5B 2A 6F          ld      de,(dir_search_page)
2910+ 6AAA CD C8 69             call    DIR128_MAP_DE
2911+ 6AAD CD 39 69             call    DIR128_INC_HL
2912+ 6AB0 38 16                jr      c,.dir_search_not_found
2913+ 6AB2 22 28 6F             ld      (dir_search_addr),hl
2914+ 6AB5 ED 5B F6 BF          ld      de,(fdp_pointer)
2915+ 6AB9 ED 53 2A 6F          ld      (dir_search_page),de
2916+ 6ABD 2A 2C 6F             ld      hl,(dir_search_remaining)
2917+ 6AC0 2B                   dec     hl
2918+ 6AC1 22 2C 6F             ld      (dir_search_remaining),hl
2919+ 6AC4 18 AA                jr      .dir_search_outer
2920+ 6AC6
2921+ 6AC6              .dir_search_found:
2922+ 6AC6 AF                   xor     a                       ;Z
2923+ 6AC7 C9                   ret
2924+ 6AC8              .dir_search_not_found:
2925+ 6AC8 3E 01                ld      a,1

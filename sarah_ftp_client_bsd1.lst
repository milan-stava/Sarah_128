2844+ 6A57              ; -----------------------------------------------------------------------------
2845+ 6A57              ; search_by_Busy_dir_slow
2846+ 6A57              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
2847+ 6A57              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
2848+ 6A57              ; no longer slows down every ordinary FIND operation.
2849+ 6A57              ;
2850+ 6A57              ; One-character FIND is handled before this fallback and compares only the
2851+ 6A57              ; first character.  This slow path therefore normally handles 2+ character
2852+ 6A57              ; substring searches whose source name crosses a directory-bank boundary.
2853+ 6A57              ; -----------------------------------------------------------------------------
2854+ 6A57              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
2855+ 6A57              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
2856+ 6A57              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
2857+ 6A57              ;   a délka.
2858+ 6A57              ; Vystup: Z = shoda, NZ = nenalezeno.
2859+ 6A57              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2860+ 6A57              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
2861+ 6A57              ; --- KONEC DOKUMENTACE CZ ---
2862+ 6A57              search_by_Busy_dir_slow:
2863+ 6A57 22 28 6F             ld      (dir_search_addr),hl
2864+ 6A5A ED 43 2C 6F          ld      (dir_search_remaining),bc
2865+ 6A5E ED 5B 21 6F          ld      de,(item_name_page)
2866+ 6A62 ED 53 2A 6F          ld      (dir_search_page),de
2867+ 6A66 2A D4 77             ld      hl,(txtlen+1)
2868+ 6A69 22 2E 6F             ld      (dir_search_patlen),hl
2869+ 6A6C 7C                   ld      a,h
2870+ 6A6D B5                   or      l
2871+ 6A6E 28 56                jr      z,.dir_search_found
2872+ 6A70
2873+ 6A70              .dir_search_outer:
2874+ 6A70                      ;If remaining source length < pattern length, no further match exists.
2875+ 6A70 2A 2C 6F             ld      hl,(dir_search_remaining)
2876+ 6A73 ED 5B 2E 6F          ld      de,(dir_search_patlen)
2877+ 6A77 B7                   or      a
2878+ 6A78 ED 52                sbc     hl,de
2879+ 6A7A 38 4C                jr      c,.dir_search_not_found
2880+ 6A7C
2881+ 6A7C                      ;Start one comparison at current candidate address/page.
2882+ 6A7C 2A 28 6F             ld      hl,(dir_search_addr)
2883+ 6A7F ED 5B 2A 6F          ld      de,(dir_search_page)
2884+ 6A83 CD C8 69             call    DIR128_MAP_DE
2885+ 6A86 11 B9 8D             ld      de,INPBUFF
2886+ 6A89 ED 4B 2E 6F          ld      bc,(dir_search_patlen)
2887+ 6A8D
2888+ 6A8D              .dir_search_cmp:
2889+ 6A8D 7E                   ld      a,(hl)
2890+ 6A8E CD F8 77             call    convert                 ;source char -> lower case
2891+ 6A91 EB                   ex      de,hl
2892+ 6A92 BE                   cp      (hl)                    ;pattern already normalized by FIND
2893+ 6A93 EB                   ex      de,hl
2894+ 6A94 20 0D                jr      nz,.dir_search_advance_candidate
2895+ 6A96
2896+ 6A96 13                   inc     de
2897+ 6A97 0B                   dec     bc
2898+ 6A98 78                   ld      a,b
2899+ 6A99 B1                   or      c
2900+ 6A9A 28 2A                jr      z,.dir_search_found
2901+ 6A9C CD 39 69             call    DIR128_INC_HL
2902+ 6A9F 38 27                jr      c,.dir_search_not_found
2903+ 6AA1 18 EA                jr      .dir_search_cmp

 3131+6E98              ; -----------------------------------------------------------------------------
 3132+6E98              ; DIR128_COPY_NAME_TO_DE
 3133+6E98              ; Copy the name returned by get_item_name to fixed RAM.
 3134+6E98              ; IN:  HL = physical source address in directory window
 3135+6E98              ;      BC = 16-bit name length
 3136+6E98              ;      DE = fixed-RAM destination
 3137+6E98              ;      item_name_page = page-table pointer belonging to HL
 3138+6E98              ; OUT: DE points behind copied bytes, BC=0
 3139+6E98              ; The source may cross any #FFFF -> #C000 directory-page boundary.
 3140+6E98              ; -----------------------------------------------------------------------------
 3141+6E98              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
 3142+6E98              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
 3143+6E98              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
 3144+6E98              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
 3145+6E98              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 3146+6E98              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
 3147+6E98              ; --- KONEC DOKUMENTACE CZ ---
 3148+6E98              DIR128_COPY_NAME_TO_DE:
 3149+6E98 D5                   push    de
 3150+6E99 ED 5B 1F 73          ld      de,(item_name_page)
 3151+6E9D CD 8D 6E             call    DIR128_MAP_DE
 3152+6EA0 D1                   pop     de
 3153+6EA1              .dir128_copy_loop:
 3154+6EA1 78                   ld      a,b
 3155+6EA2 B1                   or      c
 3156+6EA3 C8                   ret     z
 3157+6EA4 7E                   ld      a,(hl)
 3158+6EA5 12                   ld      (de),a
 3159+6EA6 13                   inc     de
 3160+6EA7 0B                   dec     bc
 3161+6EA8 78                   ld      a,b
 3162+6EA9 B1                   or      c
 3163+6EAA C8                   ret     z
 3164+6EAB CD FE 6D             call    DIR128_INC_HL
 3165+6EAE D8                   ret     c                       ;should only happen on malformed item
 3166+6EAF 18 F0                jr      .dir128_copy_loop

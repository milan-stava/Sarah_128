 2782+6A89              ; search_by_Busy_dir
 2783+6A89              ; Bank-safe replacement used by FIND for names returned by get_item_name.
 2784+6A89              ; IN:  HL = physical name start, BC = 16-bit name length
 2785+6A89              ;      item_name_page = bank companion for HL
 2786+6A89              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
 2787+6A89              ; OUT: Z=pattern found, NZ=not found
 2788+6A89              ; One-character input matches only the FIRST character of a name (quick jump).
 2789+6A89              ; Two or more characters use normal case-insensitive substring search. There is
 2790+6A89              ; no 255-byte directory-name limit; directory page crossings are transparent.
 2791+6A89              ; -----------------------------------------------------------------------------
 2792+6A89              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
 2793+6A89              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
 2794+6A89              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
 2795+6A89              ;   = délka vzoru.
 2796+6A89              ; Vystup: Z = shoda, NZ = nenalezeno.
 2797+6A89              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 2798+6A89              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
 2799+6A89              ; --- KONEC DOKUMENTACE CZ ---
 2800+6A89              search_by_Busy_dir:
 2801+6A89                      ; Empty name cannot contain a non-empty search pattern.
 2802+6A89 78                   ld      a,b
 2803+6A8A B1                   or      c
 2804+6A8B 28 2A                jr      z,.dir_search_not_found_fast
 2805+6A8D
 2806+6A8D                      ; Map the directory bank containing the first byte of the name ONCE.
 2807+6A8D                      ; For the normal case the whole name is inside this one 16K bank and
 2808+6A8D                      ; no further paging is needed during FIND.
 2809+6A8D ED 5B C2 6F          ld      de,(item_name_page)
 2810+6A91 CD 65 6A             call    DIR128_MAP_DE
 2811+6A94
 2812+6A94                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
 2813+6A94                      ; the first character of the file name.  Thus FIND "S" selects names
 2814+6A94                      ; beginning with S, while 2+ characters remain a substring search.
 2815+6A94                      ; This is also much faster for the common one-letter jump.
 2816+6A94 ED 5B 4C 79          ld      de,(txtlen+1)
 2817+6A98 7A                   ld      a,d
 2818+6A99 B7                   or      a
 2819+6A9A 20 0F                jr      nz,.dir_search_len_ge2
 2820+6A9C 7B                   ld      a,e
 2821+6A9D FE 01                cp      1
 2822+6A9F 20 0A                jr      nz,.dir_search_len_ge2
 2823+6AA1 7E                   ld      a,(hl)
 2824+6AA2 CD 70 79             call    convert
 2825+6AA5 57                   ld      d,a
 2826+6AA6 3A 81 8F             ld      a,(INPBUFF)             ;already normalized by find_items
 2827+6AA9 BA                   cp      d                       ;Z=first character matches
 2828+6AAA C9                   ret

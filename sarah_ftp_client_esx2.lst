 2883+6ABC
 2884+6ABC              ; -----------------------------------------------------------------------------
 2885+6ABC              ; search_by_Busy_dir_slow
 2886+6ABC              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
 2887+6ABC              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
 2888+6ABC              ; no longer slows down every ordinary FIND operation.
 2889+6ABC              ;
 2890+6ABC              ; One-character FIND is handled before this fallback and compares only the
 2891+6ABC              ; first character.  This slow path therefore normally handles 2+ character
 2892+6ABC              ; substring searches whose source name crosses a directory-bank boundary.
 2893+6ABC              ; -----------------------------------------------------------------------------
 2894+6ABC              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
 2895+6ABC              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
 2896+6ABC              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
 2897+6ABC              ;   a délka.
 2898+6ABC              ; Vystup: Z = shoda, NZ = nenalezeno.
 2899+6ABC              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 2900+6ABC              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
 2901+6ABC              ; --- KONEC DOKUMENTACE CZ ---
 2902+6ABC              search_by_Busy_dir_slow:
 2903+6ABC 22 8D 6F             ld      (dir_search_addr),hl
 2904+6ABF ED 43 91 6F          ld      (dir_search_remaining),bc
 2905+6AC3 ED 5B 86 6F          ld      de,(item_name_page)
 2906+6AC7 ED 53 8F 6F          ld      (dir_search_page),de
 2907+6ACB 2A 42 78             ld      hl,(txtlen+1)
 2908+6ACE 22 93 6F             ld      (dir_search_patlen),hl
 2909+6AD1 7C                   ld      a,h
 2910+6AD2 B5                   or      l
 2911+6AD3 28 56                jr      z,.dir_search_found
 2912+6AD5
 2913+6AD5              .dir_search_outer:
 2914+6AD5                      ;If remaining source length < pattern length, no further match exists.
 2915+6AD5 2A 91 6F             ld      hl,(dir_search_remaining)
 2916+6AD8 ED 5B 93 6F          ld      de,(dir_search_patlen)
 2917+6ADC B7                   or      a
 2918+6ADD ED 52                sbc     hl,de
 2919+6ADF 38 4C                jr      c,.dir_search_not_found
 2920+6AE1
 2921+6AE1                      ;Start one comparison at current candidate address/page.
 2922+6AE1 2A 8D 6F             ld      hl,(dir_search_addr)
 2923+6AE4 ED 5B 8F 6F          ld      de,(dir_search_page)
 2924+6AE8 CD 2D 6A             call    DIR128_MAP_DE
 2925+6AEB 11 CD 8E             ld      de,INPBUFF
 2926+6AEE ED 4B 93 6F          ld      bc,(dir_search_patlen)
 2927+6AF2
 2928+6AF2              .dir_search_cmp:
 2929+6AF2 7E                   ld      a,(hl)
 2930+6AF3 CD 66 78             call    convert                 ;source char -> lower case
 2931+6AF6 EB                   ex      de,hl
 2932+6AF7 BE                   cp      (hl)                    ;pattern already normalized by FIND
 2933+6AF8 EB                   ex      de,hl
 2934+6AF9 20 0D                jr      nz,.dir_search_advance_candidate
 2935+6AFB
 2936+6AFB 13                   inc     de
 2937+6AFC 0B                   dec     bc
 2938+6AFD 78                   ld      a,b
 2939+6AFE B1                   or      c
 2940+6AFF 28 2A                jr      z,.dir_search_found
 2941+6B01 CD 9E 69             call    DIR128_INC_HL
 2942+6B04 38 27                jr      c,.dir_search_not_found
 2943+6B06 18 EA                jr      .dir_search_cmp
 2944+6B08
 2945+6B08              .dir_search_advance_candidate:
 2946+6B08                      ;Always advance by exactly ONE source character.  This fixes both the
 2947+6B08                      ;old overlapping-match bug and the old one-character special case.
 2948+6B08 2A 8D 6F             ld      hl,(dir_search_addr)
 2949+6B0B ED 5B 8F 6F          ld      de,(dir_search_page)
 2950+6B0F CD 2D 6A             call    DIR128_MAP_DE
 2951+6B12 CD 9E 69             call    DIR128_INC_HL
 2952+6B15 38 16                jr      c,.dir_search_not_found
 2953+6B17 22 8D 6F             ld      (dir_search_addr),hl
 2954+6B1A ED 5B F6 BF          ld      de,(fdp_pointer)
 2955+6B1E ED 53 8F 6F          ld      (dir_search_page),de
 2956+6B22 2A 91 6F             ld      hl,(dir_search_remaining)
 2957+6B25 2B                   dec     hl
 2958+6B26 22 91 6F             ld      (dir_search_remaining),hl
 2959+6B29 18 AA                jr      .dir_search_outer
 2960+6B2B
 2961+6B2B              .dir_search_found:
 2962+6B2B AF                   xor     a                       ;Z
 2963+6B2C C9                   ret
 2964+6B2D              .dir_search_not_found:
 2965+6B2D 3E 01                ld      a,1
 2966+6B2F B7                   or      a                       ;NZ
 2967+6B30 C9                   ret

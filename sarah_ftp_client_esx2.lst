1048+ 628A              ; --- DOKUMENTACE CZ: find_out_speed ---
1049+ 628A              ; Ucel: Zjistí index aktuální rychlosti UART, případně rychlosti vyzkouší.
1050+ 628A              ; Vstup: IX = flag1; dostupné služby get_baud/set_baud.
1051+ 628A              ; Vystup: D = index zjištěné rychlosti při úspěchu.
1052+ 628A              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
1053+ 628A              ; Poznamka: Při nepodporovaném get_baud používá switch_speed; jeho neúspěch nepovažujte za
1054+ 628A              ;   platnou rychlost.
1055+ 628A              ; --- KONEC DOKUMENTACE CZ ---
1056+ 628A              find_out_speed
1057+ 628A CD CA A5             call get_baud
1058+ 628D 30 06                jr nc,.known
1059+ 628F CD 9E 62             call switch_speed
1060+ 6292 20 08                jr nz,.failed
1061+ 6294 7A                   ld a,d
1062+ 6295 FE 18        .known  cp 24
1063+ 6297 30 03                jr nc,.failed
1064+ 6299 57                   ld d,a
1065+ 629A B7                   or a
1066+ 629B C9                   ret
1067+ 629C 37           .failed scf
1068+ 629D C9                   ret
1069+ 629E              						;tests speeds <7-0>, then <max-8>
1070+ 629E              ;switch_speed	ld	a,7			;start with speeds 7-0 (quicker finds the speed)
1071+ 629E              ;		call	sws2
1072+ 629E              ;		ret	z			;Z= speed <0,7> found
1073+ 629E
1074+ 629E              ; --- DOKUMENTACE CZ: switch_speed ---
1075+ 629E              ; Ucel: Zkouší rychlosti UART sestupně od maximální až po nulu.
1076+ 629E              ; Vstup: (IX+8) = nejvyšší zkoušený index rychlosti.
1077+ 629E              ; Vystup: Z = modul odpověděl OK, D = nalezený index; NZ = nenalezeno.
1078+ 629E              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
1079+ 629E              ; Poznamka: Mění UART a (IX+6), vyprazdňuje příjem.
1080+ 629E              ; --- KONEC DOKUMENTACE CZ ---
1081+ 629E DD 7E 08     switch_speed	ld	a,(ix+8)		;try out every speed if you find connection UART+Wifi
1082+ 62A1              						;start with max speed, end with 0
1083+ 62A1 F5           sws2		push	af
1084+ 62A2 CD CA 7A     		call	set_print_speed
1085+ 62A5 38 1B        		jr c,sws_unsupported ;do not report a UART setting rejected by BIOS
1086+ 62A7
1087+ 62A7 F1           		pop	af			;we need to inrease timeout for speeds <3
1088+ 62A8 F5           		push	af
1089+ 62A9 FE 03        		cp	3
1090+ 62AB DD 36 06 01  		ld	(ix+6),1		;set timeout for 1 for speeds >3
1091+ 62AF 30 04        		jr	nc,sws1
1092+ 62B1 DD 36 06 0A  		ld	(ix+6),#A		;set tieout for #A for speeds <2
1093+ 62B5
1094+ 62B5 CD 92 7A     sws1		call	send_at_check_ok
1095+ 62B8 D1           		pop	de
1096+ 62B9 C8           		ret	z			;Z=answer found, D= speed set in HW
1097+ 62BA 7A           sws_next ld	a,d
1098+ 62BB 3D           		dec	a
1099+ 62BC FE FF        		cp	255			;test for 255, so that also speed 0 is tested
1100+ 62BE 20 E1        		jr	nz,sws2
1101+ 62C0 3D           		dec	a			;NZ=not successfull
1102+ 62C1 C9           		ret
1103+ 62C2 D1           sws_unsupported pop de
1104+ 62C3 18 F5                jr sws_next

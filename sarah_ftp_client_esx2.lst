2541+ 69B2              ; -----------------------------------------------------------------------------
2542+ 69B2              ; FTP DIRECTORY BANK API
2543+ 69B2              ;
2544+ 69B2              ; fdp_pointer always points to the table byte of the CURRENT directory page.
2545+ 69B2              ; ftp_dir_page has #FF sentinels on both sides:
2546+ 69B2              ;       #FF, 0, 1, 3, 7, #FF
2547+ 69B2              ;
2548+ 69B2              ; HL is always a physical address in the banked window #C000-#FFFF.
2549+ 69B2              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
2550+ 69B2              ;
2551+ 69B2              ; OUT for INC/DEC:
2552+ 69B2              ;       NC = movement succeeded
2553+ 69B2              ;       C  = no next/previous directory page (64 KB boundary)
2554+ 69B2              ;
2555+ 69B2              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
2556+ 69B2              ; which preserves AF/BC/DE/IX/IY exactly.
2557+ 69B2              ; -----------------------------------------------------------------------------
2558+ 69B2
2559+ 69B2              ; --- DOKUMENTACE CZ: DIR128_MAP_CURRENT ---
2560+ 69B2              ; Ucel: Namapuje aktuální banku adresáře do #C000–#FFFF.
2561+ 69B2              ; Vstup: fdp_pointer ukazuje do tabulky ftp_dir_page.
2562+ 69B2              ; Vystup: NC = platná banka, C = sentinel #FF.
2563+ 69B2              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
2564+ 69B2              ; Poznamka: Mění PAGE128_STATE a port #7FFD.
2565+ 69B2              ; --- KONEC DOKUMENTACE CZ ---
2566+ 69B2              DIR128_MAP_CURRENT:
2567+ 69B2 E5                   push    hl
2568+ 69B3 D5                   push    de
2569+ 69B4 ED 5B F6 BF          ld      de,(fdp_pointer)
2570+ 69B8 1A                   ld      a,(de)
2571+ 69B9 FE FF                cp      #FF
2572+ 69BB 28 07                jr      z,DIR128_MAP_BAD
2573+ 69BD CD E0 BF             call    PAGE128
2574+ 69C0 D1                   pop     de
2575+ 69C1 E1                   pop     hl
2576+ 69C2 B7                   or      a                       ;NC = valid page
2577+ 69C3 C9                   ret
2578+ 69C4              DIR128_MAP_BAD:
2579+ 69C4 D1                   pop     de
2580+ 69C5 E1                   pop     hl
2581+ 69C6 37                   scf
2582+ 69C7 C9                   ret
2583+ 69C8
2584+ 69C8              ;Select first FTP directory page (page 0).
2585+ 69C8              ; --- DOKUMENTACE CZ: DIR128_FIRST_PAGE ---
2586+ 69C8              ; Ucel: Vybere první banku adresáře (RAM 0).
2587+ 69C8              ; Vstup: Bez parametrů.
2588+ 69C8              ; Vystup: fdp_pointer = ftp_dir_page+1; NC.
2589+ 69C8              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
2590+ 69C8              ; Poznamka: Mění mapování RAM a PAGE128_STATE.
2591+ 69C8              ; --- KONEC DOKUMENTACE CZ ---
2592+ 69C8              DIR128_FIRST_PAGE:
2593+ 69C8 E5                   push    hl
2594+ 69C9 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
2595+ 69CC 22 F6 BF             ld      (fdp_pointer),hl
2596+ 69CF 7E                   ld      a,(hl)
2597+ 69D0 CD E0 BF             call    PAGE128
2598+ 69D3 E1                   pop     hl
2599+ 69D4 B7                   or      a
2600+ 69D5 C9                   ret
2601+ 69D6
2602+ 69D6              ;HL++ across #FFFF -> #C000 of the next directory page.
2603+ 69D6              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
2604+ 69D6              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
2605+ 69D6              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
2606+ 69D6              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2607+ 69D6              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
2608+ 69D6              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2609+ 69D6              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2610+ 69D6              ; --- KONEC DOKUMENTACE CZ ---
2611+ 69D6              DIR128_INC_HL:
2612+ 69D6 F5                   push    af                      ;old INC HL never changed A - preserve it here too
2613+ 69D7 23                   inc     hl
2614+ 69D8 7C                   ld      a,h
2615+ 69D9 B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
2616+ 69DA 28 03                jr      z,DIR128_INC_CROSS
2617+ 69DC F1                   pop     af
2618+ 69DD B7                   or      a                       ;restore A and return NC = OK
2619+ 69DE C9                   ret
2620+ 69DF
2621+ 69DF              DIR128_INC_CROSS:
2622+ 69DF D5                   push    de
2623+ 69E0 ED 5B F6 BF          ld      de,(fdp_pointer)
2624+ 69E4 13                   inc     de
2625+ 69E5 1A                   ld      a,(de)
2626+ 69E6 FE FF                cp      #FF
2627+ 69E8 28 0E                jr      z,DIR128_INC_END
2628+ 69EA ED 53 F6 BF          ld      (fdp_pointer),de
2629+ 69EE CD E0 BF             call    PAGE128
2630+ 69F1 21 00 C0             ld      hl,ftp_dir_start        ;#C000
2631+ 69F4 D1                   pop     de
2632+ 69F5 F1                   pop     af                      ;restore caller's A
2633+ 69F6 B7                   or      a                       ;NC = OK, A unchanged
2634+ 69F7 C9                   ret
2635+ 69F8              DIR128_INC_END:
2636+ 69F8 1B                   dec     de                      ;keep fdp_pointer on last valid page
2637+ 69F9 ED 53 F6 BF          ld      (fdp_pointer),de
2638+ 69FD 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
2639+ 6A00 D1                   pop     de
2640+ 6A01 F1                   pop     af                      ;restore caller's A
2641+ 6A02 37                   scf                             ;C = no following directory page
2642+ 6A03 C9                   ret
2643+ 6A04
2644+ 6A04              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
2645+ 6A04              ;Unlike the general helper, this preserves the COMPLETE parser state:
2646+ 6A04              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
2647+ 6A04              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
2648+ 6A04              ;  dir128_parser_status = 0  OK
2649+ 6A04              ;  dir128_parser_status = 1  no next directory page
2650+ 6A04              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
2651+ 6A04              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
2652+ 6A04              ; Vstup: HL = adresa v aktuální bance adresáře.
2653+ 6A04              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
2654+ 6A04              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
2655+ 6A04              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
2656+ 6A04              ; --- KONEC DOKUMENTACE CZ ---
2657+ 6A04              DIR128_INC_HL_PARSER:
2658+ 6A04 F5                   push    af
2659+ 6A05 D5                   push    de
2660+ 6A06 AF                   xor     a
2661+ 6A07 32 E7 87             ld      (dir128_parser_status),a
2662+ 6A0A 23                   inc     hl
2663+ 6A0B 7C                   ld      a,h
2664+ 6A0C B7                   or      a
2665+ 6A0D 20 14                jr      nz,.ok
2666+ 6A0F ED 5B F6 BF          ld      de,(fdp_pointer)
2667+ 6A13 13                   inc     de
2668+ 6A14 1A                   ld      a,(de)
2669+ 6A15 FE FF                cp      #FF
2670+ 6A17 28 0D                jr      z,.full
2671+ 6A19 ED 53 F6 BF          ld      (fdp_pointer),de
2672+ 6A1D CD E0 BF             call    PAGE128
2673+ 6A20 21 00 C0             ld      hl,ftp_dir_start
2674+ 6A23              .ok:
2675+ 6A23 D1                   pop     de
2676+ 6A24 F1                   pop     af
2677+ 6A25 C9                   ret
2678+ 6A26              .full:
2679+ 6A26 1B                   dec     de
2680+ 6A27 ED 53 F6 BF          ld      (fdp_pointer),de
2681+ 6A2B 21 FF FF             ld      hl,#FFFF
2682+ 6A2E 3E 01                ld      a,1
2683+ 6A30 32 E7 87             ld      (dir128_parser_status),a
2684+ 6A33 D1                   pop     de
2685+ 6A34 F1                   pop     af
2686+ 6A35 C9                   ret
2687+ 6A36
2688+ 6A36              ;HL-- across #C000 -> #FFFF of the previous directory page.
2689+ 6A36              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
2690+ 6A36              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
2691+ 6A36              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
2692+ 6A36              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2693+ 6A36              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
2694+ 6A36              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2695+ 6A36              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2696+ 6A36              ; --- KONEC DOKUMENTACE CZ ---
2697+ 6A36              DIR128_DEC_HL:
2698+ 6A36 F5                   push    af                      ;old DEC HL never changed A - preserve it here too
2699+ 6A37 2B                   dec     hl
2700+ 6A38 7C                   ld      a,h
2701+ 6A39 FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
2702+ 6A3B 28 03                jr      z,DIR128_DEC_CROSS
2703+ 6A3D F1                   pop     af
2704+ 6A3E B7                   or      a                       ;restore A and return NC = OK
2705+ 6A3F C9                   ret
2706+ 6A40
2707+ 6A40              DIR128_DEC_CROSS:
2708+ 6A40 D5                   push    de
2709+ 6A41 ED 5B F6 BF          ld      de,(fdp_pointer)
2710+ 6A45 1B                   dec     de
2711+ 6A46 1A                   ld      a,(de)
2712+ 6A47 FE FF                cp      #FF
2713+ 6A49 28 0E                jr      z,DIR128_DEC_START
2714+ 6A4B ED 53 F6 BF          ld      (fdp_pointer),de
2715+ 6A4F CD E0 BF             call    PAGE128
2716+ 6A52 21 FF FF             ld      hl,#FFFF
2717+ 6A55 D1                   pop     de
2718+ 6A56 F1                   pop     af                      ;restore caller's A
2719+ 6A57 B7                   or      a                       ;NC = OK, A unchanged
2720+ 6A58 C9                   ret
2721+ 6A59              DIR128_DEC_START:
2722+ 6A59 13                   inc     de                      ;keep fdp_pointer on first valid page
2723+ 6A5A ED 53 F6 BF          ld      (fdp_pointer),de
2724+ 6A5E 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
2725+ 6A61 D1                   pop     de
2726+ 6A62 F1                   pop     af                      ;restore caller's A
2727+ 6A63 37                   scf                             ;C = no previous directory page
2728+ 6A64 C9                   ret
2729+ 6A65
2730+ 6A65              ;Map page-table pointer stored in DE. HL is preserved.
2731+ 6A65              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
2732+ 6A65              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
2733+ 6A65              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
2734+ 6A65              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
2735+ 6A65              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
2736+ 6A65              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
2737+ 6A65              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
2738+ 6A65              ; --- KONEC DOKUMENTACE CZ ---
2739+ 6A65              DIR128_MAP_DE:
2740+ 6A65 F5                   push    af
2741+ 6A66 ED 53 F6 BF          ld      (fdp_pointer),de
2742+ 6A6A 1A                   ld      a,(de)
2743+ 6A6B CD E0 BF             call    PAGE128
2744+ 6A6E F1                   pop     af
2745+ 6A6F C9                   ret

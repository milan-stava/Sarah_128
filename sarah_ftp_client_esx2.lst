   1++9FEA              ; Shared ESP-AT framing above the unchanged Wi-Fi BIOS.
   2++9FEA              ; Firmware dialect retained: +CIPRECVDATA,<length>:<binary>.
   3++9FEA              ; Events: 1 OK, 2 ERROR, 3 prompt, 4 SEND OK, 5 SEND FAIL,
   4++9FEA              ;         6 busy, 7 active IPD header, 8 receive-data header, 0 other.
   5++9FEA              ; Binary payload is never searched for AT result strings.
   6++9FEA              AT_OK equ 1
   7++9FEA              AT_ERROR equ 2
   8++9FEA              AT_PROMPT equ 3
   9++9FEA              AT_SEND_OK equ 4
  10++9FEA              AT_SEND_FAIL equ 5
  11++9FEA              AT_BUSY equ 6
  12++9FEA              AT_IPD equ 7
  13++9FEA              AT_DATA equ 8

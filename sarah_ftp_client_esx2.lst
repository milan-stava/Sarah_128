 2905+6AC1              ; -----------------------------------------------------------------------------
 2906+6AC1              ; search_by_Busy_dir_slow
 2907+6AC1              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
 2908+6AC1              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
 2909+6AC1              ; no longer slows down every ordinary FIND operation.
 2910+6AC1              ;
 2911+6AC1              ; One-character FIND is handled before this fallback and compares only the
 2912+6AC1              ; first character.  This slow path therefore normally handles 2+ character
 2913+6AC1              ; substring searches whose source name crosses a directory-bank boundary.
 2914+6AC1              ; -----------------------------------------------------------------------------
 2915+6AC1              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
 2916+6AC1              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
 2917+6AC1              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
 2918+6AC1              ;   a délka.
 2919+6AC1              ; Vystup: Z = shoda, NZ = nenalezeno.
 2920+6AC1              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 2921+6AC1              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
 2922+6AC1              ; --- KONEC DOKUMENTACE CZ ---
 2923+6AC1              search_by_Busy_dir_slow:
 2924+6AC1 22 92 6F             ld      (dir_search_addr),hl
 2925+6AC4 ED 43 96 6F          ld      (dir_search_remaining),bc
 2926+6AC8 ED 5B 8B 6F          ld      de,(item_name_page)
 2927+6ACC ED 53 94 6F          ld      (dir_search_page),de
 2928+6AD0 2A 14 79             ld      hl,(txtlen+1)
 2929+6AD3 22 98 6F             ld      (dir_search_patlen),hl
 2930+6AD6 7C                   ld      a,h
 2931+6AD7 B5                   or      l
 2932+6AD8 28 56                jr      z,.dir_search_found
 2933+6ADA
 2934+6ADA              .dir_search_outer:
 2935+6ADA                      ;If remaining source length < pattern length, no further match exists.
 2936+6ADA 2A 96 6F             ld      hl,(dir_search_remaining)
 2937+6ADD ED 5B 98 6F          ld      de,(dir_search_patlen)
 2938+6AE1 B7                   or      a
 2939+6AE2 ED 52                sbc     hl,de
 2940+6AE4 38 4C                jr      c,.dir_search_not_found
 2941+6AE6
 2942+6AE6                      ;Start one comparison at current candidate address/page.
 2943+6AE6 2A 92 6F             ld      hl,(dir_search_addr)
 2944+6AE9 ED 5B 94 6F          ld      de,(dir_search_page)
 2945+6AED CD 32 6A             call    DIR128_MAP_DE
 2946+6AF0 11 9F 8F             ld      de,INPBUFF
 2947+6AF3 ED 4B 98 6F          ld      bc,(dir_search_patlen)
 2948+6AF7
 2949+6AF7              .dir_search_cmp:
 2950+6AF7 7E                   ld      a,(hl)
 2951+6AF8 CD 38 79             call    convert                 ;source char -> lower case
 2952+6AFB EB                   ex      de,hl
 2953+6AFC BE                   cp      (hl)                    ;pattern already normalized by FIND
 2954+6AFD EB                   ex      de,hl
 2955+6AFE 20 0D                jr      nz,.dir_search_advance_candidate
 2956+6B00
 2957+6B00 13                   inc     de
 2958+6B01 0B                   dec     bc
 2959+6B02 78                   ld      a,b
 2960+6B03 B1                   or      c
 2961+6B04 28 2A                jr      z,.dir_search_found
 2962+6B06 CD A3 69             call    DIR128_INC_HL
 2963+6B09 38 27                jr      c,.dir_search_not_found
 2964+6B0B 18 EA                jr      .dir_search_cmp
 2965+6B0D
 2966+6B0D              .dir_search_advance_candidate:
 2967+6B0D                      ;Always advance by exactly ONE source character.  This fixes both the
 2968+6B0D                      ;old overlapping-match bug and the old one-character special case.
 2969+6B0D 2A 92 6F             ld      hl,(dir_search_addr)
 2970+6B10 ED 5B 94 6F          ld      de,(dir_search_page)
 2971+6B14 CD 32 6A             call    DIR128_MAP_DE
 2972+6B17 CD A3 69             call    DIR128_INC_HL
 2973+6B1A 38 16                jr      c,.dir_search_not_found
 2974+6B1C 22 92 6F             ld      (dir_search_addr),hl
 2975+6B1F ED 5B F6 BF          ld      de,(fdp_pointer)
 2976+6B23 ED 53 94 6F          ld      (dir_search_page),de
 2977+6B27 2A 96 6F             ld      hl,(dir_search_remaining)
 2978+6B2A 2B                   dec     hl
 2979+6B2B 22 96 6F             ld      (dir_search_remaining),hl
 2980+6B2E 18 AA                jr      .dir_search_outer
 2981+6B30
 2982+6B30              .dir_search_found:
 2983+6B30 AF                   xor     a                       ;Z
 2984+6B31 C9                   ret
 2985+6B32              .dir_search_not_found:

 7559+7FCB              ;58) sends abort command (in order to abort existing command and get unstuck)
 7560+7FCB              ;send_ftp_command is the main routine that sends command+ string if needed and returns ftp answer code
 7561+7FCB              ;IN=A=0=command only (eg. "ABORT"). A=1=comamnd+prepared string from INPUT (eg. "STOR filename"), A=2=command+new INPUT
 7562+7FCB              ;OUT=A=0=NC=sent ok, awaited ftp code returned correctly
 7563+7FCB              ;A=1=C=c=1=error sending string
 7564+7FCB              ;A=2=C=c=11=error in module answer (expected answer ">" not returned)
 7565+7FCB              ;A=3=C=c=4=sent ok, but return code other than expected

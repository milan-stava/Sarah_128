2476+ 6A1E              ; -----------------------------------------------------------------------------
2477+ 6A1E              ; FTP DIRECTORY BANK API
2478+ 6A1E              ;
2479+ 6A1E              ; fdp_pointer always points to the table byte of the CURRENT directory page.
2480+ 6A1E              ; ftp_dir_page has #FF sentinels on both sides:
2481+ 6A1E              ;       #FF, 0, 1, 3, 7, #FF
2482+ 6A1E              ;
2483+ 6A1E              ; HL is always a physical address in the banked window #C000-#FFFF.
2484+ 6A1E              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
2485+ 6A1E              ;
2486+ 6A1E              ; OUT for INC/DEC:
2487+ 6A1E              ;       NC = movement succeeded
2488+ 6A1E              ;       C  = no next/previous directory page (64 KB boundary)
2489+ 6A1E              ;
2490+ 6A1E              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
2491+ 6A1E              ; which preserves AF/BC/DE/IX/IY exactly.
2492+ 6A1E              ; -----------------------------------------------------------------------------
2493+ 6A1E
2494+ 6A1E
2495+ 6A1E              ; Select first FTP directory page (page 0); preserve caller's pointer.
2496+ 6A1E              DIR128_FIRST_PAGE:
2497+ 6A1E E5                   push    hl
2498+ 6A1F 21 F1 BF             ld      hl,ftp_dir_page+1
2499+ 6A22 22 F6 BF             ld      (fdp_pointer),hl
2500+ 6A25 7E                   ld      a,(hl)
2501+ 6A26 CD E0 BF             call    PAGE128
2502+ 6A29 E1                   pop     hl
2503+ 6A2A B7                   or      a
2504+ 6A2B C9                   ret
2505+ 6A2C
2506+ 6A2C              ;HL++ across #FFFF -> #C000 of the next directory page.
2507+ 6A2C              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
2508+ 6A2C              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
2509+ 6A2C              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
2510+ 6A2C              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2511+ 6A2C              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
2512+ 6A2C              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2513+ 6A2C              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2514+ 6A2C              ; --- KONEC DOKUMENTACE CZ ---
2515+ 6A2C              DIR128_INC_HL:
2516+ 6A2C F5                   push    af                      ;old INC HL never changed A - preserve it here too
2517+ 6A2D 23                   inc     hl
2518+ 6A2E 7C                   ld      a,h
2519+ 6A2F B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
2520+ 6A30 28 03                jr      z,DIR128_INC_CROSS
2521+ 6A32 F1                   pop     af
2522+ 6A33 B7                   or      a                       ;restore A and return NC = OK
2523+ 6A34 C9                   ret
2524+ 6A35
2525+ 6A35              DIR128_INC_CROSS:
2526+ 6A35 D5                   push    de
2527+ 6A36 ED 5B F6 BF          ld      de,(fdp_pointer)
2528+ 6A3A 13                   inc     de
2529+ 6A3B 1A                   ld      a,(de)
2530+ 6A3C FE FF                cp      #FF
2531+ 6A3E 28 0E                jr      z,DIR128_INC_END
2532+ 6A40 ED 53 F6 BF          ld      (fdp_pointer),de
2533+ 6A44 CD E0 BF             call    PAGE128
2534+ 6A47 21 00 C0             ld      hl,ftp_dir_start        ;#C000
2535+ 6A4A D1                   pop     de
2536+ 6A4B F1                   pop     af                      ;restore caller's A
2537+ 6A4C B7                   or      a                       ;NC = OK, A unchanged
2538+ 6A4D C9                   ret
2539+ 6A4E              DIR128_INC_END:
2540+ 6A4E 1B                   dec     de                      ;keep fdp_pointer on last valid page
2541+ 6A4F ED 53 F6 BF          ld      (fdp_pointer),de
2542+ 6A53 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
2543+ 6A56 D1                   pop     de
2544+ 6A57 F1                   pop     af                      ;restore caller's A
2545+ 6A58 37                   scf                             ;C = no following directory page
2546+ 6A59 C9                   ret
2547+ 6A5A
2548+ 6A5A              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
2549+ 6A5A              ;Unlike the general helper, this preserves the COMPLETE parser state:
2550+ 6A5A              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
2551+ 6A5A              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
2552+ 6A5A              ;  dir128_parser_status = 0  OK
2553+ 6A5A              ;  dir128_parser_status = 1  no next directory page
2554+ 6A5A              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
2555+ 6A5A              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
2556+ 6A5A              ; Vstup: HL = adresa v aktuální bance adresáře.
2557+ 6A5A              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
2558+ 6A5A              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
2559+ 6A5A              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
2560+ 6A5A              ; --- KONEC DOKUMENTACE CZ ---
2561+ 6A5A              DIR128_INC_HL_PARSER:
2562+ 6A5A F5                   push    af
2563+ 6A5B D5                   push    de
2564+ 6A5C AF                   xor     a
2565+ 6A5D 32 B2 88             ld      (dir128_parser_status),a
2566+ 6A60 23                   inc     hl
2567+ 6A61 7C                   ld      a,h
2568+ 6A62 B7                   or      a
2569+ 6A63 20 14                jr      nz,.ok
2570+ 6A65 ED 5B F6 BF          ld      de,(fdp_pointer)
2571+ 6A69 13                   inc     de
2572+ 6A6A 1A                   ld      a,(de)
2573+ 6A6B FE FF                cp      #FF
2574+ 6A6D 28 0D                jr      z,.full
2575+ 6A6F ED 53 F6 BF          ld      (fdp_pointer),de
2576+ 6A73 CD E0 BF             call    PAGE128
2577+ 6A76 21 00 C0             ld      hl,ftp_dir_start
2578+ 6A79              .ok:
2579+ 6A79 D1                   pop     de
2580+ 6A7A F1                   pop     af
2581+ 6A7B C9                   ret
2582+ 6A7C              .full:
2583+ 6A7C 1B                   dec     de
2584+ 6A7D ED 53 F6 BF          ld      (fdp_pointer),de
2585+ 6A81 21 FF FF             ld      hl,#FFFF
2586+ 6A84 3E 01                ld      a,1
2587+ 6A86 32 B2 88             ld      (dir128_parser_status),a
2588+ 6A89 D1                   pop     de
2589+ 6A8A F1                   pop     af
2590+ 6A8B C9                   ret
2591+ 6A8C
2592+ 6A8C              ;HL-- across #C000 -> #FFFF of the previous directory page.
2593+ 6A8C              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
2594+ 6A8C              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
2595+ 6A8C              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
2596+ 6A8C              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2597+ 6A8C              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
2598+ 6A8C              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2599+ 6A8C              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2600+ 6A8C              ; --- KONEC DOKUMENTACE CZ ---
2601+ 6A8C              DIR128_DEC_HL:
2602+ 6A8C F5                   push    af                      ;old DEC HL never changed A - preserve it here too
2603+ 6A8D 2B                   dec     hl
2604+ 6A8E 7C                   ld      a,h
2605+ 6A8F FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
2606+ 6A91 28 03                jr      z,DIR128_DEC_CROSS
2607+ 6A93 F1                   pop     af
2608+ 6A94 B7                   or      a                       ;restore A and return NC = OK
2609+ 6A95 C9                   ret
2610+ 6A96
2611+ 6A96              DIR128_DEC_CROSS:
2612+ 6A96 D5                   push    de
2613+ 6A97 ED 5B F6 BF          ld      de,(fdp_pointer)
2614+ 6A9B 1B                   dec     de
2615+ 6A9C 1A                   ld      a,(de)
2616+ 6A9D FE FF                cp      #FF
2617+ 6A9F 28 0E                jr      z,DIR128_DEC_START
2618+ 6AA1 ED 53 F6 BF          ld      (fdp_pointer),de
2619+ 6AA5 CD E0 BF             call    PAGE128
2620+ 6AA8 21 FF FF             ld      hl,#FFFF
2621+ 6AAB D1                   pop     de
2622+ 6AAC F1                   pop     af                      ;restore caller's A
2623+ 6AAD B7                   or      a                       ;NC = OK, A unchanged
2624+ 6AAE C9                   ret
2625+ 6AAF              DIR128_DEC_START:
2626+ 6AAF 13                   inc     de                      ;keep fdp_pointer on first valid page
2627+ 6AB0 ED 53 F6 BF          ld      (fdp_pointer),de
2628+ 6AB4 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
2629+ 6AB7 D1                   pop     de
2630+ 6AB8 F1                   pop     af                      ;restore caller's A
2631+ 6AB9 37                   scf                             ;C = no previous directory page
2632+ 6ABA C9                   ret
2633+ 6ABB
2634+ 6ABB              ;Map page-table pointer stored in DE. HL is preserved.
2635+ 6ABB              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
2636+ 6ABB              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
2637+ 6ABB              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
2638+ 6ABB              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
2639+ 6ABB              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
2640+ 6ABB              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
2641+ 6ABB              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
2642+ 6ABB              ; --- KONEC DOKUMENTACE CZ ---
2643+ 6ABB              DIR128_MAP_DE:
2644+ 6ABB F5                   push    af
2645+ 6ABC ED 53 F6 BF          ld      (fdp_pointer),de
2646+ 6AC0 1A                   ld      a,(de)
2647+ 6AC1 CD E0 BF             call    PAGE128
2648+ 6AC4 F1                   pop     af
2649+ 6AC5 C9                   ret
2650+ 6AC6
2651+ 6AC6
2652+ 6AC6              ; -----------------------------------------------------------------------------
2653+ 6AC6              ; DIR128_COPY_NAME_TO_DE
2654+ 6AC6              ; Copy the name returned by get_item_name to fixed RAM.
2655+ 6AC6              ; IN:  HL = physical source address in directory window
2656+ 6AC6              ;      BC = 16-bit name length
2657+ 6AC6              ;      DE = fixed-RAM destination
2658+ 6AC6              ;      item_name_page = page-table pointer belonging to HL
2659+ 6AC6              ; OUT: DE points behind copied bytes, BC=0
2660+ 6AC6              ; The source may cross any #FFFF -> #C000 directory-page boundary.
2661+ 6AC6              ; -----------------------------------------------------------------------------
2662+ 6AC6              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
2663+ 6AC6              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
2664+ 6AC6              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
2665+ 6AC6              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
2666+ 6AC6              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2667+ 6AC6              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
2668+ 6AC6              ; --- KONEC DOKUMENTACE CZ ---
2669+ 6AC6              DIR128_COPY_NAME_TO_DE:
2670+ 6AC6 D5                   push    de
2671+ 6AC7 ED 5B 12 70          ld      de,(item_name_page)
2672+ 6ACB CD BB 6A             call    DIR128_MAP_DE
2673+ 6ACE D1                   pop     de
2674+ 6ACF              .dir128_copy_loop:
2675+ 6ACF 78                   ld      a,b
2676+ 6AD0 B1                   or      c
2677+ 6AD1 C8                   ret     z
2678+ 6AD2 7E                   ld      a,(hl)
2679+ 6AD3 12                   ld      (de),a
2680+ 6AD4 13                   inc     de
2681+ 6AD5 0B                   dec     bc
2682+ 6AD6 78                   ld      a,b
2683+ 6AD7 B1                   or      c
2684+ 6AD8 C8                   ret     z
2685+ 6AD9 CD 2C 6A             call    DIR128_INC_HL
2686+ 6ADC D8                   ret     c                       ;should only happen on malformed item
2687+ 6ADD 18 F0                jr      .dir128_copy_loop

  968+622F CD AE 75     		call	wind_cls
  969+6232 CD 1F 7B     		call	clear_edit_zone
  970+6235 C9           		ret
  971+6236              ;zde konci vetev, kdy na pocatku SM2.0 nebylo nalezeno slazeni rychlosti
  972+6236
  973+6236              ;zde jsme ze zacatku rychlost nasli a zkoumame, zda je to ta, kterou chceme, pokud ne, tak ji nastav
  974+6236 CD 65 62     speed_aligned	call	find_out_speed		;output: D= currently aligned speed
  975+6239 DA 1F 62             jp c,speed_uart_err
  976+623C CD 16 7C     align_success	call	set_ud_speed
  977+623F
  978+623F              ;ve speed_we_want vyhodnotit, zda je odezva na AT prikaz. Pokud ne, neznamená to, e
  979+623F              ;rychlosti nebyly slazeny, ale ze nektere z rychlosti 0-23 nekomunikuji s modulem.
  980+623F DD 36 06 0A  speed_we_want	ld	(ix+6),#A
  981+6243 CD 7D 7A     		call	send_at_check_ok
  982+6246 20 D7        		jr	nz,speed_uart_err
  983+6248
  984+6248              wifi_cont					;we are at speed we want. Final steps... print UART speed+ Baud speed
  985+6248              ;Alignment is recorded only after the final ATE0 acknowledgement.
  986+6248
  987+6248              ;		call	get_baud
  988+6248 CD 65 62     		call	find_out_speed
  989+624B DA 1F 62             jp c,speed_uart_err
  990+624E 7A           		ld	a,d			;A=aligned speed we ended with
  991+624F DD 77 07     		ld	(ix+7),a		;save it
  992+6252 CD BC 7A     		call	print_speed
  993+6255
  994+6255 21 16 88             ld hl,ate0
  995+6258 CD E4 A0             call at_send_ok
  996+625B 0E 33                ld c,51
  997+625D DA 19 7E             jp c,error_handler
  998+6260 DD CB 00 F6          set 6,(ix+0)

2747+ 6B58              ; -----------------------------------------------------------------------------
2748+ 6B58              ; search_by_Busy_fast
2749+ 6B58              ; Fast case-insensitive substring search for a name fully contained in the
2750+ 6B58              ; currently mapped 16K directory page.
2751+ 6B58              ;
2752+ 6B58              ; IN:  HL = name start, BC = 16-bit name length
2753+ 6B58              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
2754+ 6B58              ; OUT: Z = found, NZ = not found
2755+ 6B58              ;
2756+ 6B58              ; This is deliberately close to the original Busy FIND: the inner compare uses
2757+ 6B58              ; the Z80 CPI instruction.  The pattern has already been converted to lower
2758+ 6B58              ; case once by find_items, so only the source character needs convert here.
2759+ 6B58              ;
2760+ 6B58              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
2761+ 6B58              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
2762+ 6B58              ; matches therefore cannot be skipped.
2763+ 6B58              ; -----------------------------------------------------------------------------
2764+ 6B58              search_by_Busy_fast:
2765+ 6B58 EB                   ex      de,hl                   ;DE=current candidate in file name
2766+ 6B59
2767+ 6B59                      ; candidate_count = name_length - pattern_length + 1
2768+ 6B59 60                   ld      h,b
2769+ 6B5A 69                   ld      l,c
2770+ 6B5B ED 4B 5B 78          ld      bc,(txtlen+1)
2771+ 6B5F 78                   ld      a,b
2772+ 6B60 B1                   or      c
2773+ 6B61 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
2774+ 6B63 B7                   or      a
2775+ 6B64 ED 42                sbc     hl,bc
2776+ 6B66 38 25                jr      c,.fast_not_found       ;pattern longer than file name
2777+ 6B68 23                   inc     hl
2778+ 6B69
2779+ 6B69                      ; Keep number of possible candidate starts in alternate BC.
2780+ 6B69 E5                   push    hl
2781+ 6B6A D9                   exx
2782+ 6B6B C1                   pop     bc
2783+ 6B6C D9                   exx
2784+ 6B6D
2785+ 6B6D              .fast_next_candidate:
2786+ 6B6D D5                   push    de                      ;remember exact candidate start
2787+ 6B6E 21 4E 8E             ld      hl,INPBUFF
2788+ 6B71 ED 4B 5B 78          ld      bc,(txtlen+1)
2789+ 6B75
2790+ 6B75              .fast_compare:
2791+ 6B75 1A                   ld      a,(de)
2792+ 6B76 CD 7F 78             call    convert                 ;source char -> lower case
2793+ 6B79 ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
2794+ 6B7B 13                   inc     de
2795+ 6B7C 20 06                jr      nz,.fast_candidate_failed
2796+ 6B7E EA 75 6B             jp      pe,.fast_compare        ;matched, more pattern bytes remain
2797+ 6B81
2798+ 6B81 D1                   pop     de                      ;discard saved candidate start
2799+ 6B82              .fast_found:
2800+ 6B82 AF                   xor     a                       ;Z = found
2801+ 6B83 C9                   ret
2802+ 6B84

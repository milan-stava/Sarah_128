4538+ 71EA CD C4 69     		call	DIR128_MAP_DE
4539+ 71ED 7E           		ld	a,(hl)
4540+ 71EE 5F           		ld	e,a
4541+ 71EF CD 35 69     		call	DIR128_INC_HL
4542+ 71F2 38 04        		jr	c,DIR128_CUR_LENGTH_ZERO
4543+ 71F4 7E           		ld	a,(hl)
4544+ 71F5 57           		ld	d,a

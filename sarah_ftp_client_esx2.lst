 2929+6AEB              ; -----------------------------------------------------------------------------
 2930+6AEB              ; search_by_Busy_dir_slow
 2931+6AEB              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
 2932+6AEB              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
 2933+6AEB              ; no longer slows down every ordinary FIND operation.
 2934+6AEB              ;
 2935+6AEB              ; One-character FIND is handled before this fallback and compares only the
 2936+6AEB              ; first character.  This slow path therefore normally handles 2+ character
 2937+6AEB              ; substring searches whose source name crosses a directory-bank boundary.
 2938+6AEB              ; -----------------------------------------------------------------------------
 2939+6AEB              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
 2940+6AEB              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
 2941+6AEB              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
 2942+6AEB              ;   a délka.
 2943+6AEB              ; Vystup: Z = shoda, NZ = nenalezeno.
 2944+6AEB              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 2945+6AEB              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
 2946+6AEB              ; --- KONEC DOKUMENTACE CZ ---
 2947+6AEB              search_by_Busy_dir_slow:
 2948+6AEB 22 C0 6F             ld      (dir_search_addr),hl
 2949+6AEE ED 43 C4 6F          ld      (dir_search_remaining),bc
 2950+6AF2 ED 5B B9 6F          ld      de,(item_name_page)
 2951+6AF6 ED 53 C2 6F          ld      (dir_search_page),de
 2952+6AFA 2A 43 79             ld      hl,(txtlen+1)
 2953+6AFD 22 C6 6F             ld      (dir_search_patlen),hl
 2954+6B00 7C                   ld      a,h
 2955+6B01 B5                   or      l
 2956+6B02 28 56                jr      z,.dir_search_found
 2957+6B04
 2958+6B04              .dir_search_outer:
 2959+6B04                      ;If remaining source length < pattern length, no further match exists.
 2960+6B04 2A C4 6F             ld      hl,(dir_search_remaining)
 2961+6B07 ED 5B C6 6F          ld      de,(dir_search_patlen)
 2962+6B0B B7                   or      a
 2963+6B0C ED 52                sbc     hl,de
 2964+6B0E 38 4C                jr      c,.dir_search_not_found
 2965+6B10
 2966+6B10                      ;Start one comparison at current candidate address/page.
 2967+6B10 2A C0 6F             ld      hl,(dir_search_addr)
 2968+6B13 ED 5B C2 6F          ld      de,(dir_search_page)
 2969+6B17 CD 5C 6A             call    DIR128_MAP_DE
 2970+6B1A 11 70 8F             ld      de,INPBUFF
 2971+6B1D ED 4B C6 6F          ld      bc,(dir_search_patlen)
 2972+6B21
 2973+6B21              .dir_search_cmp:
 2974+6B21 7E                   ld      a,(hl)
 2975+6B22 CD 67 79             call    convert                 ;source char -> lower case
 2976+6B25 EB                   ex      de,hl
 2977+6B26 BE                   cp      (hl)                    ;pattern already normalized by FIND
 2978+6B27 EB                   ex      de,hl
 2979+6B28 20 0D                jr      nz,.dir_search_advance_candidate
 2980+6B2A
 2981+6B2A 13                   inc     de
 2982+6B2B 0B                   dec     bc
 2983+6B2C 78                   ld      a,b
 2984+6B2D B1                   or      c
 2985+6B2E 28 2A                jr      z,.dir_search_found
 2986+6B30 CD CD 69             call    DIR128_INC_HL
 2987+6B33 38 27                jr      c,.dir_search_not_found
 2988+6B35 18 EA                jr      .dir_search_cmp
 2989+6B37

 3238+6EE3
 3239+6EE3              ; -----------------------------------------------------------------------------
 3240+6EE3              ; search_by_Busy_fast
 3241+6EE3              ; Fast case-insensitive substring search for a name fully contained in the
 3242+6EE3              ; currently mapped 16K directory page.
 3243+6EE3              ;
 3244+6EE3              ; IN:  HL = name start, BC = 16-bit name length
 3245+6EE3              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
 3246+6EE3              ; OUT: Z = found, NZ = not found
 3247+6EE3              ;
 3248+6EE3              ; This is deliberately close to the original Busy FIND: the inner compare uses
 3249+6EE3              ; the Z80 CPI instruction.  The pattern has already been converted to lower
 3250+6EE3              ; case once by find_items, so only the source character needs convert here.
 3251+6EE3              ;
 3252+6EE3              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
 3253+6EE3              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
 3254+6EE3              ; matches therefore cannot be skipped.
 3255+6EE3              ; -----------------------------------------------------------------------------
 3256+6EE3              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
 3257+6EE3              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
 3258+6EE3              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
 3259+6EE3              ;   délka.
 3260+6EE3              ; Vystup: Z = shoda, NZ = nenalezeno.
 3261+6EE3              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 3262+6EE3              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
 3263+6EE3              ; --- KONEC DOKUMENTACE CZ ---
 3264+6EE3              search_by_Busy_fast:
 3265+6EE3 EB                   ex      de,hl                   ;DE=current candidate in file name
 3266+6EE4
 3267+6EE4                      ; candidate_count = name_length - pattern_length + 1
 3268+6EE4 60                   ld      h,b
 3269+6EE5 69                   ld      l,c
 3270+6EE6 ED 4B 9A 7B          ld      bc,(txtlen+1)
 3271+6EEA 78                   ld      a,b
 3272+6EEB B1                   or      c
 3273+6EEC 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
 3274+6EEE B7                   or      a
 3275+6EEF ED 42                sbc     hl,bc
 3276+6EF1 38 25                jr      c,.fast_not_found       ;pattern longer than file name
 3277+6EF3 23                   inc     hl
 3278+6EF4
 3279+6EF4                      ; Keep number of possible candidate starts in alternate BC.
 3280+6EF4 E5                   push    hl
 3281+6EF5 D9                   exx
 3282+6EF6 C1                   pop     bc
 3283+6EF7 D9                   exx
 3284+6EF8
 3285+6EF8              .fast_next_candidate:
 3286+6EF8 D5                   push    de                      ;remember exact candidate start
 3287+6EF9 21 30 91             ld      hl,INPBUFF
 3288+6EFC ED 4B 9A 7B          ld      bc,(txtlen+1)
 3289+6F00
 3290+6F00              .fast_compare:
 3291+6F00 1A                   ld      a,(de)
 3292+6F01 CD BE 7B             call    convert                 ;source char -> lower case
 3293+6F04 ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
 3294+6F06 13                   inc     de
 3295+6F07 20 06                jr      nz,.fast_candidate_failed
 3296+6F09 EA 00 6F             jp      pe,.fast_compare        ;matched, more pattern bytes remain
 3297+6F0C
 3298+6F0C D1                   pop     de                      ;discard saved candidate start
 3299+6F0D              .fast_found:
 3300+6F0D AF                   xor     a                       ;Z = found
 3301+6F0E C9                   ret
 3302+6F0F
 3303+6F0F              .fast_candidate_failed:
 3304+6F0F D1                   pop     de                      ;restore previous candidate start
 3305+6F10 13                   inc     de                      ;next candidate = previous + 1
 3306+6F11 D9                   exx
 3307+6F12 0B                   dec     bc
 3308+6F13 78                   ld      a,b
 3309+6F14 B1                   or      c
 3310+6F15 D9                   exx
 3311+6F16 20 E0                jr      nz,.fast_next_candidate
 3312+6F18
 3313+6F18              .fast_not_found:
 3314+6F18 3E 01                ld      a,1
 3315+6F1A B7                   or      a                       ;NZ = not found
 3316+6F1B C9                   ret

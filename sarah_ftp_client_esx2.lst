1038+ 6274 DD 77 07     		ld	(ix+7),a		;save it
1039+ 6277 CD D1 7A     		call	print_speed
1040+ 627A
1041+ 627A 21 ED 87             ld hl,ate0
1042+ 627D CD FF 9F             call at_send_ok
1043+ 6280 0E 33                ld c,51

 955+ 6260              ; --- DOKUMENTACE CZ: speed_management ---
 956+ 6260              ; Ucel: Sjednotí rychlost komunikace UART a Wi-Fi při inicializaci.
 957+ 6260              ; Vstup: Inicializovaný BIOS a příznaky na IX.
 958+ 6260              ; Vystup: Připravená komunikace nebo obsluha chyby.
 959+ 6260              ; Meni: AF, BC, DE, HL, BC'; další změny dle volaných BIOS/DOS a tiskových služeb.
 960+ 6260              ; Poznamka: Pracuje s konfigurací rychlosti, příjmovým bufferem a stavovým výpisem.
 961+ 6260              ; --- KONEC DOKUMENTACE CZ ---
 962+ 6260              speed_management
 963+ 6260 DD 36 07 FF  		ld	(ix+7),#FF		;reset currently set speed status
 964+ 6264 DD CB 00 B6  		res	6,(ix+0)		;set signal UART and module speed not aligned

  911+61E9              ;speed management 2.0. starts here. Enables to set user_defined speed. Works with every MBFW.
  912+61E9              ;the principle:
  913+61E9              ;are you aligned?
  914+61E9              ;NO: try to align, if not success->error. If sucess, you have AKT (=current alligned speed is ;known). Is user defined speed definied? (IX+2=255 for no user defined speed) yes, END. NO. set ;speed according to ix+2 (max up to MBFW), end
  915+61E9              ;
  916+61E9              ;YES:
  917+61E9              ;is user defined speed set? (ix+2=255 or other?) NO=check if FW is 7/12? YES, align at speed
  918+61E9              ;ix+2, end. FW is higher then 7/12, then check if AKT=IX+2? YES, end, NO, align at ix+2, END.
  919+61E9              ;ix+2 was not 255, is FW 7/12? YES, then set FWmax, end. NO the is AKT=MBFW max? YES, then END
  920+61E9              ;NO, then align at FW max speed, end
  921+61E9              ;output: ix+7= 0-23 if speed set, or 255 if not set
  922+61E9
  923+61E9              ;SM20 uses:
  924+61E9              ;bit 4,(ix+0)	PRINT or not to PRINT
  925+61E9              ;(ix+8)		contains maximum speed by detected MBFW (7, 12 or 23)
  926+61E9              ;(ix+6)		timeout value
  927+61E9              ;bit 6,(ix+0)	state of speed alignment between uart& module, 0 not aligned
  928+61E9              ;bit 5,(ix+0)	state of module connection to AP, 0 not connected to AP
  929+61E9
  930+61E9              ;internal subroutines: switch_speed, find_out_speed
  931+61E9              ;external subroutines: send_at:check_ok, set_ud_speed, set_print_speed, print_speed
  932+61E9
  933+61E9              ; --- DOKUMENTACE CZ: speed_management ---
  934+61E9              ; Ucel: Sjednotí rychlost komunikace UART a Wi-Fi při inicializaci.
  935+61E9              ; Vstup: Inicializovaný BIOS a příznaky na IX.
  936+61E9              ; Vystup: Připravená komunikace nebo obsluha chyby.
  937+61E9              ; Meni: AF, BC, DE, HL, BC'; další změny dle volaných BIOS/DOS a tiskových služeb.
  938+61E9              ; Poznamka: Pracuje s konfigurací rychlosti, příjmovým bufferem a stavovým výpisem.
  939+61E9              ; --- KONEC DOKUMENTACE CZ ---
  940+61E9              speed_management
  941+61E9 DD 36 07 FF  		ld	(ix+7),#FF		;reset currently set speed status
  942+61ED DD CB 00 B6  		res	6,(ix+0)		;set signal UART and module speed not aligned
  943+61F1
  944+61F1              ;;		ld	hl,#4300
  945+61F1              ;;		ld	de,wifi_on_off
  946+61F1              ;;		call	PRINTHL
  947+61F1
  948+61F1 37           		scf				;power on wifi
  949+61F2 CD 6F A6     		call	wifi_on
  950+61F5
  951+61F5
  952+61F5 21 00 02     		ld	hl,txt_adr_speed_login	;print "Speed" text
  953+61F8 11 B1 8A     		ld	de,speed
  954+61FB CD 57 91     		call	PRINTHL
  955+61FE
  956+61FE 01 3B 78     		ld	bc,#783B		;set CPU to 3,5 MHz
  957+6201 3E 30        		ld	a,#30
  958+6203 ED 79        		out	(c),a
  959+6205 04           		inc	b
  960+6206 AF           		xor	a
  961+6207 ED 79        		out	(c),a

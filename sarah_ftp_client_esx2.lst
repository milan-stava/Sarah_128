2804+ 6B84 D1                   pop     de                      ;restore previous candidate start
2805+ 6B85 13                   inc     de                      ;next candidate = previous + 1
2806+ 6B86 D9                   exx
2807+ 6B87 0B                   dec     bc
2808+ 6B88 78                   ld      a,b
2809+ 6B89 B1                   or      c
2810+ 6B8A D9                   exx
2811+ 6B8B 20 E0                jr      nz,.fast_next_candidate
2812+ 6B8D
2813+ 6B8D              .fast_not_found:

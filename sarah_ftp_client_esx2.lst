    1+A0E4              ; Shared ESP-AT framing above the unchanged Wi-Fi BIOS.
    2+A0E4              ; Firmware dialect retained: +CIPRECVDATA,<length>:<binary>.
    3+A0E4              ; Events: 1 OK, 2 ERROR, 3 prompt, 4 SEND OK, 5 SEND FAIL,
    4+A0E4              ;         6 busy, 7 active IPD header, 8 receive-data header, 0 other.
    5+A0E4              ; Binary payload is never searched for AT result strings.
    6+A0E4              AT_OK equ 1
    7+A0E4              AT_ERROR equ 2
    8+A0E4              AT_PROMPT equ 3
    9+A0E4              AT_SEND_OK equ 4
   10+A0E4              AT_SEND_FAIL equ 5
   11+A0E4              AT_BUSY equ 6
   12+A0E4              AT_IPD equ 7
   13+A0E4              AT_DATA equ 8
   14+A0E4
   15+A0E4              ; HL=AT command, NC=exact final OK. Sending failures keep the common handler.

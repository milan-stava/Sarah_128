2828+ 69C4              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
2829+ 69C4              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
2830+ 69C4              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
2831+ 69C4              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
2832+ 69C4              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
2833+ 69C4              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
2834+ 69C4              ; --- KONEC DOKUMENTACE CZ ---
2835+ 69C4              DIR128_MAP_DE:
2836+ 69C4 F5                   push    af
2837+ 69C5 ED 53 F6 BF          ld      (fdp_pointer),de
2838+ 69C9 1A                   ld      a,(de)
2839+ 69CA CD E0 BF             call    PAGE128
2840+ 69CD F1                   pop     af
2841+ 69CE C9                   ret

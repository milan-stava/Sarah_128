 2510+697F              ; -----------------------------------------------------------------------------
 2511+697F              ; FTP DIRECTORY BANK API
 2512+697F              ;
 2513+697F              ; fdp_pointer always points to the table byte of the CURRENT directory page.
 2514+697F              ; ftp_dir_page has #FF sentinels on both sides:
 2515+697F              ;       #FF, 0, 1, 3, 7, #FF
 2516+697F              ;
 2517+697F              ; HL is always a physical address in the banked window #C000-#FFFF.
 2518+697F              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
 2519+697F              ;
 2520+697F              ; OUT for INC/DEC:
 2521+697F              ;       NC = movement succeeded
 2522+697F              ;       C  = no next/previous directory page (64 KB boundary)
 2523+697F              ;
 2524+697F              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
 2525+697F              ; which preserves AF/BC/DE/IX/IY exactly.
 2526+697F              ; -----------------------------------------------------------------------------
 2527+697F
 2528+697F              ; --- DOKUMENTACE CZ: DIR128_MAP_CURRENT ---
 2529+697F              ; Ucel: Namapuje aktuální banku adresáře do #C000–#FFFF.
 2530+697F              ; Vstup: fdp_pointer ukazuje do tabulky ftp_dir_page.
 2531+697F              ; Vystup: NC = platná banka, C = sentinel #FF.
 2532+697F              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
 2533+697F              ; Poznamka: Mění PAGE128_STATE a port #7FFD.
 2534+697F              ; --- KONEC DOKUMENTACE CZ ---
 2535+697F              DIR128_MAP_CURRENT:
 2536+697F E5                   push    hl
 2537+6980 D5                   push    de
 2538+6981 ED 5B F6 BF          ld      de,(fdp_pointer)
 2539+6985 1A                   ld      a,(de)
 2540+6986 FE FF                cp      #FF
 2541+6988 28 07                jr      z,DIR128_MAP_BAD
 2542+698A CD E0 BF             call    PAGE128
 2543+698D D1                   pop     de
 2544+698E E1                   pop     hl
 2545+698F B7                   or      a                       ;NC = valid page
 2546+6990 C9                   ret
 2547+6991              DIR128_MAP_BAD:
 2548+6991 D1                   pop     de
 2549+6992 E1                   pop     hl
 2550+6993 37                   scf
 2551+6994 C9                   ret
 2552+6995
 2553+6995              ;Select first FTP directory page (page 0).
 2554+6995              ; --- DOKUMENTACE CZ: DIR128_FIRST_PAGE ---
 2555+6995              ; Ucel: Vybere první banku adresáře (RAM 0).
 2556+6995              ; Vstup: Bez parametrů.
 2557+6995              ; Vystup: fdp_pointer = ftp_dir_page+1; NC.
 2558+6995              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
 2559+6995              ; Poznamka: Mění mapování RAM a PAGE128_STATE.
 2560+6995              ; --- KONEC DOKUMENTACE CZ ---
 2561+6995              DIR128_FIRST_PAGE:
 2562+6995 E5                   push    hl
 2563+6996 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
 2564+6999 22 F6 BF             ld      (fdp_pointer),hl
 2565+699C 7E                   ld      a,(hl)
 2566+699D CD E0 BF             call    PAGE128
 2567+69A0 E1                   pop     hl
 2568+69A1 B7                   or      a
 2569+69A2 C9                   ret
 2570+69A3
 2571+69A3              ;HL++ across #FFFF -> #C000 of the next directory page.
 2572+69A3              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
 2573+69A3              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
 2574+69A3              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
 2575+69A3              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
 2576+69A3              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
 2577+69A3              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
 2578+69A3              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
 2579+69A3              ; --- KONEC DOKUMENTACE CZ ---
 2580+69A3              DIR128_INC_HL:
 2581+69A3 F5                   push    af                      ;old INC HL never changed A - preserve it here too
 2582+69A4 23                   inc     hl
 2583+69A5 7C                   ld      a,h
 2584+69A6 B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
 2585+69A7 28 03                jr      z,DIR128_INC_CROSS
 2586+69A9 F1                   pop     af
 2587+69AA B7                   or      a                       ;restore A and return NC = OK
 2588+69AB C9                   ret
 2589+69AC
 2590+69AC              DIR128_INC_CROSS:
 2591+69AC D5                   push    de
 2592+69AD ED 5B F6 BF          ld      de,(fdp_pointer)
 2593+69B1 13                   inc     de
 2594+69B2 1A                   ld      a,(de)
 2595+69B3 FE FF                cp      #FF
 2596+69B5 28 0E                jr      z,DIR128_INC_END
 2597+69B7 ED 53 F6 BF          ld      (fdp_pointer),de
 2598+69BB CD E0 BF             call    PAGE128
 2599+69BE 21 00 C0             ld      hl,ftp_dir_start        ;#C000
 2600+69C1 D1                   pop     de
 2601+69C2 F1                   pop     af                      ;restore caller's A
 2602+69C3 B7                   or      a                       ;NC = OK, A unchanged
 2603+69C4 C9                   ret
 2604+69C5              DIR128_INC_END:
 2605+69C5 1B                   dec     de                      ;keep fdp_pointer on last valid page
 2606+69C6 ED 53 F6 BF          ld      (fdp_pointer),de
 2607+69CA 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
 2608+69CD D1                   pop     de
 2609+69CE F1                   pop     af                      ;restore caller's A
 2610+69CF 37                   scf                             ;C = no following directory page
 2611+69D0 C9                   ret
 2612+69D1
 2613+69D1              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
 2614+69D1              ;Unlike the general helper, this preserves the COMPLETE parser state:
 2615+69D1              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
 2616+69D1              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
 2617+69D1              ;  dir128_parser_status = 0  OK
 2618+69D1              ;  dir128_parser_status = 1  no next directory page
 2619+69D1              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
 2620+69D1              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
 2621+69D1              ; Vstup: HL = adresa v aktuální bance adresáře.
 2622+69D1              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
 2623+69D1              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
 2624+69D1              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
 2625+69D1              ; --- KONEC DOKUMENTACE CZ ---
 2626+69D1              DIR128_INC_HL_PARSER:
 2627+69D1 F5                   push    af
 2628+69D2 D5                   push    de
 2629+69D3 AF                   xor     a
 2630+69D4 32 E2 88             ld      (dir128_parser_status),a
 2631+69D7 23                   inc     hl
 2632+69D8 7C                   ld      a,h
 2633+69D9 B7                   or      a
 2634+69DA 20 14                jr      nz,.ok
 2635+69DC ED 5B F6 BF          ld      de,(fdp_pointer)
 2636+69E0 13                   inc     de
 2637+69E1 1A                   ld      a,(de)
 2638+69E2 FE FF                cp      #FF
 2639+69E4 28 0D                jr      z,.full
 2640+69E6 ED 53 F6 BF          ld      (fdp_pointer),de
 2641+69EA CD E0 BF             call    PAGE128
 2642+69ED 21 00 C0             ld      hl,ftp_dir_start
 2643+69F0              .ok:
 2644+69F0 D1                   pop     de
 2645+69F1 F1                   pop     af
 2646+69F2 C9                   ret
 2647+69F3              .full:
 2648+69F3 1B                   dec     de
 2649+69F4 ED 53 F6 BF          ld      (fdp_pointer),de
 2650+69F8 21 FF FF             ld      hl,#FFFF
 2651+69FB 3E 01                ld      a,1
 2652+69FD 32 E2 88             ld      (dir128_parser_status),a
 2653+6A00 D1                   pop     de
 2654+6A01 F1                   pop     af
 2655+6A02 C9                   ret
 2656+6A03
 2657+6A03              ;HL-- across #C000 -> #FFFF of the previous directory page.
 2658+6A03              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
 2659+6A03              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
 2660+6A03              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
 2661+6A03              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
 2662+6A03              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
 2663+6A03              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
 2664+6A03              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
 2665+6A03              ; --- KONEC DOKUMENTACE CZ ---
 2666+6A03              DIR128_DEC_HL:
 2667+6A03 F5                   push    af                      ;old DEC HL never changed A - preserve it here too
 2668+6A04 2B                   dec     hl
 2669+6A05 7C                   ld      a,h
 2670+6A06 FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
 2671+6A08 28 03                jr      z,DIR128_DEC_CROSS
 2672+6A0A F1                   pop     af
 2673+6A0B B7                   or      a                       ;restore A and return NC = OK
 2674+6A0C C9                   ret
 2675+6A0D
 2676+6A0D              DIR128_DEC_CROSS:
 2677+6A0D D5                   push    de
 2678+6A0E ED 5B F6 BF          ld      de,(fdp_pointer)
 2679+6A12 1B                   dec     de
 2680+6A13 1A                   ld      a,(de)
 2681+6A14 FE FF                cp      #FF
 2682+6A16 28 0E                jr      z,DIR128_DEC_START
 2683+6A18 ED 53 F6 BF          ld      (fdp_pointer),de
 2684+6A1C CD E0 BF             call    PAGE128
 2685+6A1F 21 FF FF             ld      hl,#FFFF
 2686+6A22 D1                   pop     de
 2687+6A23 F1                   pop     af                      ;restore caller's A
 2688+6A24 B7                   or      a                       ;NC = OK, A unchanged
 2689+6A25 C9                   ret
 2690+6A26              DIR128_DEC_START:
 2691+6A26 13                   inc     de                      ;keep fdp_pointer on first valid page
 2692+6A27 ED 53 F6 BF          ld      (fdp_pointer),de
 2693+6A2B 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
 2694+6A2E D1                   pop     de
 2695+6A2F F1                   pop     af                      ;restore caller's A
 2696+6A30 37                   scf                             ;C = no previous directory page
 2697+6A31 C9                   ret
 2698+6A32
 2699+6A32              ;Map page-table pointer stored in DE. HL is preserved.
 2700+6A32              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
 2701+6A32              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
 2702+6A32              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
 2703+6A32              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
 2704+6A32              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
 2705+6A32              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
 2706+6A32              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
 2707+6A32              ; --- KONEC DOKUMENTACE CZ ---
 2708+6A32              DIR128_MAP_DE:
 2709+6A32 F5                   push    af
 2710+6A33 ED 53 F6 BF          ld      (fdp_pointer),de
 2711+6A37 1A                   ld      a,(de)
 2712+6A38 CD E0 BF             call    PAGE128
 2713+6A3B F1                   pop     af
 2714+6A3C C9                   ret
 2715+6A3D
 2716+6A3D
 2717+6A3D              ; -----------------------------------------------------------------------------
 2718+6A3D              ; DIR128_COPY_NAME_TO_DE
 2719+6A3D              ; Copy the name returned by get_item_name to fixed RAM.
 2720+6A3D              ; IN:  HL = physical source address in directory window
 2721+6A3D              ;      BC = 16-bit name length
 2722+6A3D              ;      DE = fixed-RAM destination
 2723+6A3D              ;      item_name_page = page-table pointer belonging to HL
 2724+6A3D              ; OUT: DE points behind copied bytes, BC=0
 2725+6A3D              ; The source may cross any #FFFF -> #C000 directory-page boundary.
 2726+6A3D              ; -----------------------------------------------------------------------------
 2727+6A3D              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
 2728+6A3D              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
 2729+6A3D              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
 2730+6A3D              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
 2731+6A3D              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 2732+6A3D              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
 2733+6A3D              ; --- KONEC DOKUMENTACE CZ ---
 2734+6A3D              DIR128_COPY_NAME_TO_DE:
 2735+6A3D D5                   push    de
 2736+6A3E ED 5B 8B 6F          ld      de,(item_name_page)
 2737+6A42 CD 32 6A             call    DIR128_MAP_DE
 2738+6A45 D1                   pop     de
 2739+6A46              .dir128_copy_loop:
 2740+6A46 78                   ld      a,b
 2741+6A47 B1                   or      c

3001+ 6B43 ED 5B CB 6F          ld      de,(dir_search_page)
3002+ 6B47 CD 65 6A             call    DIR128_MAP_DE
3003+ 6B4A CD D6 69             call    DIR128_INC_HL
3004+ 6B4D 38 16                jr      c,.dir_search_not_found
3005+ 6B4F 22 C9 6F             ld      (dir_search_addr),hl
3006+ 6B52 ED 5B F6 BF          ld      de,(fdp_pointer)
3007+ 6B56 ED 53 CB 6F          ld      (dir_search_page),de
3008+ 6B5A 2A CD 6F             ld      hl,(dir_search_remaining)
3009+ 6B5D 2B                   dec     hl
3010+ 6B5E 22 CD 6F             ld      (dir_search_remaining),hl
3011+ 6B61 18 AA                jr      .dir_search_outer

2637+ 6911              ; -----------------------------------------------------------------------------
2638+ 6911              ; FTP DIRECTORY BANK API
2639+ 6911              ;
2640+ 6911              ; fdp_pointer always points to the table byte of the CURRENT directory page.
2641+ 6911              ; ftp_dir_page has #FF sentinels on both sides:
2642+ 6911              ;       #FF, 0, 1, 3, 7, #FF
2643+ 6911              ;
2644+ 6911              ; HL is always a physical address in the banked window #C000-#FFFF.
2645+ 6911              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
2646+ 6911              ;
2647+ 6911              ; OUT for INC/DEC:
2648+ 6911              ;       NC = movement succeeded
2649+ 6911              ;       C  = no next/previous directory page (64 KB boundary)
2650+ 6911              ;
2651+ 6911              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
2652+ 6911              ; which preserves AF/BC/DE/IX/IY exactly.
2653+ 6911              ; -----------------------------------------------------------------------------
2654+ 6911
2655+ 6911              ; --- DOKUMENTACE CZ: DIR128_MAP_CURRENT ---
2656+ 6911              ; Ucel: Namapuje aktuální banku adresáře do #C000–#FFFF.
2657+ 6911              ; Vstup: fdp_pointer ukazuje do tabulky ftp_dir_page.
2658+ 6911              ; Vystup: NC = platná banka, C = sentinel #FF.
2659+ 6911              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
2660+ 6911              ; Poznamka: Mění PAGE128_STATE a port #7FFD.
2661+ 6911              ; --- KONEC DOKUMENTACE CZ ---
2662+ 6911              DIR128_MAP_CURRENT:
2663+ 6911 E5                   push    hl
2664+ 6912 D5                   push    de
2665+ 6913 ED 5B F6 BF          ld      de,(fdp_pointer)
2666+ 6917 1A                   ld      a,(de)
2667+ 6918 FE FF                cp      #FF
2668+ 691A 28 07                jr      z,DIR128_MAP_BAD
2669+ 691C CD E0 BF             call    PAGE128
2670+ 691F D1                   pop     de
2671+ 6920 E1                   pop     hl
2672+ 6921 B7                   or      a                       ;NC = valid page
2673+ 6922 C9                   ret
2674+ 6923              DIR128_MAP_BAD:
2675+ 6923 D1                   pop     de
2676+ 6924 E1                   pop     hl
2677+ 6925 37                   scf
2678+ 6926 C9                   ret
2679+ 6927
2680+ 6927              ;Select first FTP directory page (page 0).
2681+ 6927              ; --- DOKUMENTACE CZ: DIR128_FIRST_PAGE ---
2682+ 6927              ; Ucel: Vybere první banku adresáře (RAM 0).
2683+ 6927              ; Vstup: Bez parametrů.
2684+ 6927              ; Vystup: fdp_pointer = ftp_dir_page+1; NC.
2685+ 6927              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
2686+ 6927              ; Poznamka: Mění mapování RAM a PAGE128_STATE.
2687+ 6927              ; --- KONEC DOKUMENTACE CZ ---
2688+ 6927              DIR128_FIRST_PAGE:
2689+ 6927 E5                   push    hl
2690+ 6928 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
2691+ 692B 22 F6 BF             ld      (fdp_pointer),hl
2692+ 692E 7E                   ld      a,(hl)
2693+ 692F CD E0 BF             call    PAGE128
2694+ 6932 E1                   pop     hl
2695+ 6933 B7                   or      a
2696+ 6934 C9                   ret
2697+ 6935
2698+ 6935              ;HL++ across #FFFF -> #C000 of the next directory page.
2699+ 6935              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
2700+ 6935              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
2701+ 6935              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
2702+ 6935              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2703+ 6935              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
2704+ 6935              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2705+ 6935              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2706+ 6935              ; --- KONEC DOKUMENTACE CZ ---
2707+ 6935              DIR128_INC_HL:
2708+ 6935 F5                   push    af                      ;old INC HL never changed A - preserve it here too
2709+ 6936 23                   inc     hl
2710+ 6937 7C                   ld      a,h
2711+ 6938 B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
2712+ 6939 28 03                jr      z,DIR128_INC_CROSS
2713+ 693B F1                   pop     af
2714+ 693C B7                   or      a                       ;restore A and return NC = OK
2715+ 693D C9                   ret
2716+ 693E
2717+ 693E              DIR128_INC_CROSS:
2718+ 693E D5                   push    de
2719+ 693F ED 5B F6 BF          ld      de,(fdp_pointer)
2720+ 6943 13                   inc     de
2721+ 6944 1A                   ld      a,(de)
2722+ 6945 FE FF                cp      #FF
2723+ 6947 28 0E                jr      z,DIR128_INC_END
2724+ 6949 ED 53 F6 BF          ld      (fdp_pointer),de
2725+ 694D CD E0 BF             call    PAGE128
2726+ 6950 21 00 C0             ld      hl,ftp_dir_start        ;#C000
2727+ 6953 D1                   pop     de
2728+ 6954 F1                   pop     af                      ;restore caller's A
2729+ 6955 B7                   or      a                       ;NC = OK, A unchanged
2730+ 6956 C9                   ret
2731+ 6957              DIR128_INC_END:
2732+ 6957 1B                   dec     de                      ;keep fdp_pointer on last valid page
2733+ 6958 ED 53 F6 BF          ld      (fdp_pointer),de
2734+ 695C 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
2735+ 695F D1                   pop     de
2736+ 6960 F1                   pop     af                      ;restore caller's A
2737+ 6961 37                   scf                             ;C = no following directory page
2738+ 6962 C9                   ret
2739+ 6963
2740+ 6963              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
2741+ 6963              ;Unlike the general helper, this preserves the COMPLETE parser state:
2742+ 6963              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
2743+ 6963              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
2744+ 6963              ;  dir128_parser_status = 0  OK
2745+ 6963              ;  dir128_parser_status = 1  no next directory page
2746+ 6963              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
2747+ 6963              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
2748+ 6963              ; Vstup: HL = adresa v aktuální bance adresáře.
2749+ 6963              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
2750+ 6963              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
2751+ 6963              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
2752+ 6963              ; --- KONEC DOKUMENTACE CZ ---
2753+ 6963              DIR128_INC_HL_PARSER:
2754+ 6963 F5                   push    af
2755+ 6964 D5                   push    de
2756+ 6965 AF                   xor     a
2757+ 6966 32 28 85             ld      (dir128_parser_status),a
2758+ 6969 23                   inc     hl
2759+ 696A 7C                   ld      a,h
2760+ 696B B7                   or      a
2761+ 696C 20 14                jr      nz,.ok
2762+ 696E ED 5B F6 BF          ld      de,(fdp_pointer)
2763+ 6972 13                   inc     de
2764+ 6973 1A                   ld      a,(de)
2765+ 6974 FE FF                cp      #FF
2766+ 6976 28 0D                jr      z,.full
2767+ 6978 ED 53 F6 BF          ld      (fdp_pointer),de
2768+ 697C CD E0 BF             call    PAGE128
2769+ 697F 21 00 C0             ld      hl,ftp_dir_start
2770+ 6982              .ok:
2771+ 6982 D1                   pop     de
2772+ 6983 F1                   pop     af
2773+ 6984 C9                   ret
2774+ 6985              .full:
2775+ 6985 1B                   dec     de
2776+ 6986 ED 53 F6 BF          ld      (fdp_pointer),de
2777+ 698A 21 FF FF             ld      hl,#FFFF
2778+ 698D 3E 01                ld      a,1
2779+ 698F 32 28 85             ld      (dir128_parser_status),a
2780+ 6992 D1                   pop     de
2781+ 6993 F1                   pop     af
2782+ 6994 C9                   ret
2783+ 6995
2784+ 6995              ;HL-- across #C000 -> #FFFF of the previous directory page.
2785+ 6995              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
2786+ 6995              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
2787+ 6995              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
2788+ 6995              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2789+ 6995              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
2790+ 6995              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2791+ 6995              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2792+ 6995              ; --- KONEC DOKUMENTACE CZ ---
2793+ 6995              DIR128_DEC_HL:
2794+ 6995 F5                   push    af                      ;old DEC HL never changed A - preserve it here too
2795+ 6996 2B                   dec     hl
2796+ 6997 7C                   ld      a,h
2797+ 6998 FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
2798+ 699A 28 03                jr      z,DIR128_DEC_CROSS
2799+ 699C F1                   pop     af
2800+ 699D B7                   or      a                       ;restore A and return NC = OK
2801+ 699E C9                   ret

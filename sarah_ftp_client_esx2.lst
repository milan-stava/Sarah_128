 6072+79F8              ;16)
 6073+79F8              ; --- DOKUMENTACE CZ: ConvRStr16 ---
 6074+79F8              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
 6075+79F8              ; Vstup: DE = začátek číslic.
 6076+79F8              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
 6077+79F8              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 6078+79F8              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
 6079+79F8              ;   přetečení; Z nemá pevný význam.
 6080+79F8              ; --- KONEC DOKUMENTACE CZ ---
 6081+79F8              ConvRStr16
 6082+79F8              ;===============================================================
 6083+79F8              ;http://z80-heaven.wikidot.com/math#toc32
 6084+79F8              ;Input:
 6085+79F8              ;     DE points to the base 10 number string in RAM.
 6086+79F8              ;Outputs:
 6087+79F8              ;     HL is the 16-bit value of the number
 6088+79F8              ;     DE points to the byte after the number
 6089+79F8              ;     BC is HL/10
 6090+79F8              ;     z flag reset (nz)
 6091+79F8              ;     c flag reset (nc)
 6092+79F8              ;Destroys:
 6093+79F8              ;     A (actually, add 30h and you get the ending token)
 6094+79F8              ;Size:  23 bytes
 6095+79F8              ;Speed: 104n+42+11c
 6096+79F8              ;       n is the number of digits
 6097+79F8              ;       c is at most n-2
 6098+79F8              ;       at most 595 cycles for any 16-bit decimal value
 6099+79F8              ;===============================================================
 6100+79F8
 6101+79F8 21 00 00          ld hl,0          ;  10 : 210000
 6102+79FB              ConvLoop:             ;
 6103+79FB 1A                ld a,(de)        ;   7 : 1A
 6104+79FC D6 30             sub 30h          ;   7 : D630
 6105+79FE FE 0A             cp 10            ;   7 : FE0A
 6106+7A00 D0                ret nc           ;5|11 : D0
 6107+7A01 13                inc de           ;   6 : 13
 6108+7A02                                    ;
 6109+7A02 44                ld b,h           ;   4 : 44
 6110+7A03 4D                ld c,l           ;   4 : 4D
 6111+7A04 29                add hl,hl        ;  11 : 29
 6112+7A05 29                add hl,hl        ;  11 : 29
 6113+7A06 09                add hl,bc        ;  11 : 09
 6114+7A07 29                add hl,hl        ;  11 : 29
 6115+7A08                                    ;
 6116+7A08 85                add a,l          ;   4 : 85
 6117+7A09 6F                ld l,a           ;   4 : 6F
 6118+7A0A 30 EF             jr nc,ConvLoop   ;12|23: 30EE
 6119+7A0C 24                inc h            ; --- : 24
 6120+7A0D 18 EC             jr ConvLoop      ; --- : 18EB
 6121+7A0F
 6122+7A0F
 6123+7A0F
 6124+7A0F              ;17)
 6125+7A0F              ;IN=HL=number, OUT=DE=address with the string
 6126+7A0F              ; --- DOKUMENTACE CZ: HL2ASCII ---
 6127+7A0F              ; Ucel: Zapíše 16bitové číslo jako desetinný text bez úvodních nul.
 6128+7A0F              ; Vstup: HL = číslo, DE = cílový buffer; IX = flag1.
 6129+7A0F              ; Vystup: DE za poslední číslicí; HL = zbytek jednotek.
 6130+7A0F              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 6131+7A0F              ; Poznamka: Mění bit 7 v (IX+0); nepřidává nulový terminátor.
 6132+7A0F              ; --- KONEC DOKUMENTACE CZ ---
 6133+7A0F DD CB 00 BE  HL2ASCII		res 7,(IX+0)		;Leading zero suppression
 6134+7A13              ; --- DOKUMENTACE CZ: HL2ASCII_00000 ---
 6135+7A13              ; Ucel: Vstup do převodu od řádu desetitisíců, resp. stovek.

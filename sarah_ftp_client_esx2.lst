5977+ 7A6D              ; Ucel: Vstup do převodu od řádu desetitisíců, resp. stovek.
5978+ 7A6D              ; Vstup: HL = číslo, DE = cíl; bit 7 v (IX+0) řídí tisk úvodních nul.
5979+ 7A6D              ; Vystup: DE za poslední číslicí, bez nulového terminátoru.
5980+ 7A6D              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
5981+ 7A6D              ; Poznamka: Na rozdíl od HL2ASCII nenuluje bit 7. Pro pevnou šířku jej nastavte před voláním.
5982+ 7A6D              ; --- KONEC DOKUMENTACE CZ ---
5983+ 7A6D 01 64 00     HL2ASCII_000		ld bc,100
5984+ 7A70 CD 7F 7A     			call string_dl
5985+ 7A73 01 0A 00     			ld bc,10
5986+ 7A76 CD 7F 7A     			call string_dl
5987+ 7A79 7D           			ld a,l
5988+ 7A7A C6 30        			add a,'0'
5989+ 7A7C 12           			LD (DE),A

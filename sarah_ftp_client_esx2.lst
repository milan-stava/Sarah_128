4227+ 7070 7E           		ld	a,(hl)
4228+ 7071 B3           		or	e
4229+ 7072 28 1B        		jr	z,item_add_end		;next item begins 00 00 = end of directory
4230+ 7074
4231+ 7074              		;Commit candidate address.
4232+ 7074 2A A6 6E     		ld	hl,(dir_op_addr_var)
4233+ 7077 ED 5B 9E 6E  		ld	de,(next_item_addr)
4234+ 707B 73           		ld	(hl),e

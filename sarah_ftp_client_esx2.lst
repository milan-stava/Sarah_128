    1+A1B9              ; Shared ESP-AT framing above the unchanged Wi-Fi BIOS.
    2+A1B9              ; Firmware dialect retained: +CIPRECVDATA,<length>:<binary>.
    3+A1B9              ; Events: 1 OK, 2 ERROR, 3 prompt, 4 SEND OK, 5 SEND FAIL,
    4+A1B9              ;         6 busy, 7 active IPD header, 8 receive-data header, 0 other.
    5+A1B9              ; Binary payload is never searched for AT result strings.
    6+A1B9              AT_OK equ 1
    7+A1B9              AT_ERROR equ 2
    8+A1B9              AT_PROMPT equ 3
    9+A1B9              AT_SEND_OK equ 4
   10+A1B9              AT_SEND_FAIL equ 5
   11+A1B9              AT_BUSY equ 6
   12+A1B9              AT_IPD equ 7
   13+A1B9              AT_DATA equ 8

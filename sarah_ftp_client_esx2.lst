10036+BFE0
10037+BFE0              ; Vstup:
10038+BFE0              ;   A = cislo RAM stranky 0-7
10039+BFE0              ;
10040+BFE0              ; Vystup:
10041+BFE0              ;   zvolena stranka je namapovana do #C000-#FFFF
10042+BFE0              ;
10043+BFE0              ; Nastaveni #7FFD:
10044+BFE0              ;   bity 0-2 = RAM page
10045+BFE0              ;   bit 3    = screen 0  (RAM 5)
10046+BFE0              ;   bit 4    = 48K ROM
10047+BFE0              ;   bit 5    = paging enabled
10048+BFE0              ;
10049+BFE0              ; Pozor:
10050+BFE0              ;   bit 5 musi zustat 0, jinak se strankovani zamkne
10051+BFE0              ; ------------------------------------------------------------
10052+BFE0
10053+BFE0              ; --- DOKUMENTACE CZ: PAGE128 ---
10054+BFE0              ; Ucel: Přepne horní 16KB okno paměti ZX Spectrum 128.
10055+BFE0              ; Vstup: A = číslo banky 0–7 (použijí se spodní tři bity).
10056+BFE0              ; Vystup: A = hodnota zapsaná na #7FFD a do PAGE128_STATE.
10057+BFE0              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
10058+BFE0              ; Poznamka: Volí 48K ROM, obrazovku v RAM 5; bit zámku stránkování nechává nulový.
10059+BFE0              ; --- KONEC DOKUMENTACE CZ ---
10060+BFE0              PAGE128:
10061+BFE0 E6 07                and     %00000111
10062+BFE2 F6 10                or      %00010000
10063+BFE4 32 EF BF             ld      (PAGE128_STATE),a
10064+BFE7 C5           	push	bc
10065+BFE8 01 FD 7F             ld      bc,#7FFD
10066+BFEB ED 79                out     (c),a
10067+BFED C1           	pop	bc
10068+BFEE C9                   ret
10069+BFEF
10070+BFEF              PAGE128_STATE:
10071+BFEF 00                   db 0
10072+BFF0
10073+BFF0
10074+BFF0              PAGE128_RESTORE:
10075+BFF0

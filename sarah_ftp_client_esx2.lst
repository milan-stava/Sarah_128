 8725+8355 3A EA A4             ld      a,(at_closed)
 8726+8358 E6 03                and     3
 8727+835A 20 0D                jr      nz,.file_closed ; real closure plus empty buffer, not a Wi-Fi pause
 8728+835C CD 2D 9F             call    ftp_poll_delay
 8729+835F CD 3E 9E             call    ftp_poll_cancel
 8730+8362 38 0E                jr      c,.file_cancel
 8731+8364 18 E8                jr      .file_wait

2771+ 6A79 78                   ld      a,b
2772+ 6A7A B1                   or      c
2773+ 6A7B C8                   ret     z
2774+ 6A7C 7E                   ld      a,(hl)
2775+ 6A7D 12                   ld      (de),a
2776+ 6A7E 13                   inc     de
2777+ 6A7F 0B                   dec     bc
2778+ 6A80 78                   ld      a,b
2779+ 6A81 B1                   or      c
2780+ 6A82 C8                   ret     z

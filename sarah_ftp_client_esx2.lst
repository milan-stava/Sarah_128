6008+ 7A8A 28 04        			JR Z,string_store
6009+ 7A8C
6010+ 7A8C DD CB 00 FE  			SET 7,(IX+0)		;Had something other than zero
6011+ 7A90
6012+ 7A90 DD CB 00 7E  string_store:		BIT 7,(IX+0)		;Test if still leading zeros
6013+ 7A94 C8           			RET Z

2856+ 6ABB              ; -----------------------------------------------------------------------------
2857+ 6ABB              ; search_by_Busy_fast
2858+ 6ABB              ; Fast case-insensitive substring search for a name fully contained in the
2859+ 6ABB              ; currently mapped 16K directory page.
2860+ 6ABB              ;
2861+ 6ABB              ; IN:  HL = name start, BC = 16-bit name length
2862+ 6ABB              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
2863+ 6ABB              ; OUT: Z = found, NZ = not found
2864+ 6ABB              ;
2865+ 6ABB              ; This is deliberately close to the original Busy FIND: the inner compare uses
2866+ 6ABB              ; the Z80 CPI instruction.  The pattern has already been converted to lower
2867+ 6ABB              ; case once by find_items, so only the source character needs convert here.
2868+ 6ABB              ;
2869+ 6ABB              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
2870+ 6ABB              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
2871+ 6ABB              ; matches therefore cannot be skipped.
2872+ 6ABB              ; -----------------------------------------------------------------------------
2873+ 6ABB              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
2874+ 6ABB              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
2875+ 6ABB              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
2876+ 6ABB              ;   délka.
2877+ 6ABB              ; Vystup: Z = shoda, NZ = nenalezeno.
2878+ 6ABB              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2879+ 6ABB              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
2880+ 6ABB              ; --- KONEC DOKUMENTACE CZ ---
2881+ 6ABB              search_by_Busy_fast:
2882+ 6ABB EB                   ex      de,hl                   ;DE=current candidate in file name
2883+ 6ABC
2884+ 6ABC                      ; candidate_count = name_length - pattern_length + 1
2885+ 6ABC 60                   ld      h,b
2886+ 6ABD 69                   ld      l,c
2887+ 6ABE ED 4B 57 78          ld      bc,(txtlen+1)
2888+ 6AC2 78                   ld      a,b
2889+ 6AC3 B1                   or      c
2890+ 6AC4 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
2891+ 6AC6 B7                   or      a
2892+ 6AC7 ED 42                sbc     hl,bc
2893+ 6AC9 38 25                jr      c,.fast_not_found       ;pattern longer than file name
2894+ 6ACB 23                   inc     hl
2895+ 6ACC
2896+ 6ACC                      ; Keep number of possible candidate starts in alternate BC.
2897+ 6ACC E5                   push    hl
2898+ 6ACD D9                   exx
2899+ 6ACE C1                   pop     bc
2900+ 6ACF D9                   exx
2901+ 6AD0
2902+ 6AD0              .fast_next_candidate:
2903+ 6AD0 D5                   push    de                      ;remember exact candidate start
2904+ 6AD1 21 8C 8E             ld      hl,INPBUFF
2905+ 6AD4 ED 4B 57 78          ld      bc,(txtlen+1)
2906+ 6AD8
2907+ 6AD8              .fast_compare:
2908+ 6AD8 1A                   ld      a,(de)
2909+ 6AD9 CD 7B 78             call    convert                 ;source char -> lower case
2910+ 6ADC ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
2911+ 6ADE 13                   inc     de
2912+ 6ADF 20 06                jr      nz,.fast_candidate_failed
2913+ 6AE1 EA D8 6A             jp      pe,.fast_compare        ;matched, more pattern bytes remain
2914+ 6AE4
2915+ 6AE4 D1                   pop     de                      ;discard saved candidate start
2916+ 6AE5              .fast_found:
2917+ 6AE5 AF                   xor     a                       ;Z = found
2918+ 6AE6 C9                   ret
2919+ 6AE7
2920+ 6AE7              .fast_candidate_failed:
2921+ 6AE7 D1                   pop     de                      ;restore previous candidate start
2922+ 6AE8 13                   inc     de                      ;next candidate = previous + 1
2923+ 6AE9 D9                   exx
2924+ 6AEA 0B                   dec     bc
2925+ 6AEB 78                   ld      a,b
2926+ 6AEC B1                   or      c
2927+ 6AED D9                   exx
2928+ 6AEE 20 E0                jr      nz,.fast_next_candidate
2929+ 6AF0
2930+ 6AF0              .fast_not_found:
2931+ 6AF0 3E 01                ld      a,1
2932+ 6AF2 B7                   or      a                       ;NZ = not found
2933+ 6AF3 C9                   ret

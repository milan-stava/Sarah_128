2702+ 6B2A                      ; Map the directory bank containing the first byte of the name ONCE.
2703+ 6B2A                      ; For the normal case the whole name is inside this one 16K bank and
2704+ 6B2A                      ; no further paging is needed during FIND.
2705+ 6B2A ED 5B 94 6F          ld      de,(item_name_page)
2706+ 6B2E CD 02 6B             call    DIR128_MAP_DE
2707+ 6B31
2708+ 6B31                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
2709+ 6B31                      ; the first character of the file name.  Thus FIND "S" selects names
2710+ 6B31                      ; beginning with S, while 2+ characters remain a substring search.
2711+ 6B31                      ; This is also much faster for the common one-letter jump.
2712+ 6B31 ED 5B 5B 78          ld      de,(txtlen+1)
2713+ 6B35 7A                   ld      a,d
2714+ 6B36 B7                   or      a
2715+ 6B37 20 0F                jr      nz,.dir_search_len_ge2
2716+ 6B39 7B                   ld      a,e
2717+ 6B3A FE 01                cp      1
2718+ 6B3C 20 0A                jr      nz,.dir_search_len_ge2
2719+ 6B3E 7E                   ld      a,(hl)
2720+ 6B3F CD 7F 78             call    convert
2721+ 6B42 57                   ld      d,a
2722+ 6B43 3A 4E 8E             ld      a,(INPBUFF)             ;already normalized by find_items
2723+ 6B46 BA                   cp      d                       ;Z=first character matches

 3113+6E8D              ;Map page-table pointer stored in DE. HL is preserved.
 3114+6E8D              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
 3115+6E8D              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
 3116+6E8D              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
 3117+6E8D              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
 3118+6E8D              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
 3119+6E8D              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
 3120+6E8D              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
 3121+6E8D              ; --- KONEC DOKUMENTACE CZ ---
 3122+6E8D              DIR128_MAP_DE:
 3123+6E8D F5                   push    af
 3124+6E8E ED 53 F6 BF          ld      (fdp_pointer),de
 3125+6E92 1A                   ld      a,(de)
 3126+6E93 CD E0 BF             call    PAGE128
 3127+6E96 F1                   pop     af
 3128+6E97 C9                   ret

2571+ 6AA1              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
2572+ 6AA1              ;Unlike the general helper, this preserves the COMPLETE parser state:
2573+ 6AA1              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
2574+ 6AA1              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
2575+ 6AA1              ;  dir128_parser_status = 0  OK
2576+ 6AA1              ;  dir128_parser_status = 1  no next directory page
2577+ 6AA1              DIR128_INC_HL_PARSER:
2578+ 6AA1 F5                   push    af
2579+ 6AA2 D5                   push    de
2580+ 6AA3 AF                   xor     a
2581+ 6AA4 32 9F 87             ld      (dir128_parser_status),a
2582+ 6AA7 23                   inc     hl
2583+ 6AA8 7C                   ld      a,h
2584+ 6AA9 B7                   or      a

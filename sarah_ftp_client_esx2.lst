  866+61ED              ;speed management 2.0. starts here. Enables to set user_defined speed. Works with every MBFW.
  867+61ED              ;the principle:
  868+61ED              ;are you aligned?
  869+61ED              ;NO: try to align, if not success->error. If sucess, you have AKT (=current alligned speed is ;known). Is user defined speed definied? (IX+2=255 for no user defined speed) yes, END. NO. set ;speed according to ix+2 (max up to MBFW), end
  870+61ED              ;
  871+61ED              ;YES:
  872+61ED              ;is user defined speed set? (ix+2=255 or other?) NO=check if FW is 7/12? YES, align at speed
  873+61ED              ;ix+2, end. FW is higher then 7/12, then check if AKT=IX+2? YES, end, NO, align at ix+2, END.
  874+61ED              ;ix+2 was not 255, is FW 7/12? YES, then set FWmax, end. NO the is AKT=MBFW max? YES, then END
  875+61ED              ;NO, then align at FW max speed, end
  876+61ED              ;output: ix+7= 0-23 if speed set, or 255 if not set
  877+61ED
  878+61ED              ;SM20 uses:
  879+61ED              ;bit 4,(ix+0)	PRINT or not to PRINT
  880+61ED              ;(ix+8)		contains maximum speed by detected MBFW (7, 12 or 23)
  881+61ED              ;(ix+6)		timeout value
  882+61ED              ;bit 6,(ix+0)	state of speed alignment between uart& module, 0 not aligned
  883+61ED              ;bit 5,(ix+0)	state of module connection to AP, 0 not connected to AP
  884+61ED
  885+61ED              ;internal subroutines: switch_speed, print_bauds, find_out_speed
  886+61ED              ;external subroutines: send_at:check_ok, set_ud_speed, set_print_speed, print_speed
  887+61ED
  888+61ED              ; --- DOKUMENTACE CZ: speed_management ---
  889+61ED              ; Ucel: Sjednotí rychlost komunikace UART a Wi-Fi při inicializaci.
  890+61ED              ; Vstup: Inicializovaný BIOS a příznaky na IX.
  891+61ED              ; Vystup: Připravená komunikace nebo obsluha chyby.
  892+61ED              ; Meni: AF, BC, DE, HL, BC'; další změny dle volaných BIOS/DOS a tiskových služeb.
  893+61ED              ; Poznamka: Pracuje s konfigurací rychlosti, příjmovým bufferem a stavovým výpisem.
  894+61ED              ; --- KONEC DOKUMENTACE CZ ---
  895+61ED              speed_management
  896+61ED DD 36 07 FF  		ld	(ix+7),#FF		;reset currently set speed status
  897+61F1 DD CB 00 B6  		res	6,(ix+0)		;set signal UART and module speed not aligned
  898+61F5

2891+ 6B8B EB                   ex      de,hl
2892+ 6B8C 20 0D                jr      nz,.dir_search_advance_candidate
2893+ 6B8E
2894+ 6B8E 13                   inc     de
2895+ 6B8F 0B                   dec     bc
2896+ 6B90 78                   ld      a,b

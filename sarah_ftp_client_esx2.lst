 2733+6A51
 2734+6A51              ; -----------------------------------------------------------------------------
 2735+6A51              ; search_by_Busy_dir
 2736+6A51              ; Bank-safe replacement used by FIND for names returned by get_item_name.
 2737+6A51              ; IN:  HL = physical name start, BC = 16-bit name length
 2738+6A51              ;      item_name_page = bank companion for HL
 2739+6A51              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
 2740+6A51              ; OUT: Z=pattern found, NZ=not found
 2741+6A51              ; One-character input matches only the FIRST character of a name (quick jump).
 2742+6A51              ; Two or more characters use normal case-insensitive substring search. There is
 2743+6A51              ; no 255-byte directory-name limit; directory page crossings are transparent.
 2744+6A51              ; -----------------------------------------------------------------------------
 2745+6A51              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
 2746+6A51              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
 2747+6A51              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
 2748+6A51              ;   = délka vzoru.
 2749+6A51              ; Vystup: Z = shoda, NZ = nenalezeno.
 2750+6A51              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 2751+6A51              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
 2752+6A51              ; --- KONEC DOKUMENTACE CZ ---
 2753+6A51              search_by_Busy_dir:
 2754+6A51                      ; Empty name cannot contain a non-empty search pattern.
 2755+6A51 78                   ld      a,b
 2756+6A52 B1                   or      c
 2757+6A53 28 2A                jr      z,.dir_search_not_found_fast
 2758+6A55
 2759+6A55                      ; Map the directory bank containing the first byte of the name ONCE.
 2760+6A55                      ; For the normal case the whole name is inside this one 16K bank and
 2761+6A55                      ; no further paging is needed during FIND.
 2762+6A55 ED 5B 86 6F          ld      de,(item_name_page)
 2763+6A59 CD 2D 6A             call    DIR128_MAP_DE
 2764+6A5C
 2765+6A5C                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
 2766+6A5C                      ; the first character of the file name.  Thus FIND "S" selects names
 2767+6A5C                      ; beginning with S, while 2+ characters remain a substring search.
 2768+6A5C                      ; This is also much faster for the common one-letter jump.
 2769+6A5C ED 5B 42 78          ld      de,(txtlen+1)
 2770+6A60 7A                   ld      a,d
 2771+6A61 B7                   or      a

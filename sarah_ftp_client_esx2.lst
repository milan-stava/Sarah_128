8550+ 83A2 20 0D                jr      nz,.file_closed ; real closure plus empty buffer, not a Wi-Fi pause
8551+ 83A4 CD 7F 9E             call    ftp_poll_delay
8552+ 83A7 CD 90 9D             call    ftp_poll_cancel
8553+ 83AA 38 0E                jr      c,.file_cancel
8554+ 83AC 18 E8                jr      .file_wait
8555+ 83AE              .file_data:
8556+ 83AE C3 C7 83             jp      dam_available
8557+ 83B1              .file_closed:

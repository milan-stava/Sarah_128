6125+ 77FD              ; --- DOKUMENTACE CZ: HL2ASCII ---
6126+ 77FD              ; Ucel: Zapíše 16bitové číslo jako desetinný text bez úvodních nul.
6127+ 77FD              ; Vstup: HL = číslo, DE = cílový buffer; IX = flag1.
6128+ 77FD              ; Vystup: DE za poslední číslicí; HL = zbytek jednotek.
6129+ 77FD              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
6130+ 77FD              ; Poznamka: Mění bit 7 v (IX+0); nepřidává nulový terminátor.
6131+ 77FD              ; --- KONEC DOKUMENTACE CZ ---
6132+ 77FD DD CB 00 BE  HL2ASCII		res 7,(IX+0)		;Leading zero suppression

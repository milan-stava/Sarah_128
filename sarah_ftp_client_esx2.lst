5904+ 7A46              ; --- DOKUMENTACE CZ: ConvRStr16 ---
5905+ 7A46              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
5906+ 7A46              ; Vstup: DE = začátek číslic.
5907+ 7A46              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
5908+ 7A46              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
5909+ 7A46              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
5910+ 7A46              ;   přetečení; Z nemá pevný význam.
5911+ 7A46              ; --- KONEC DOKUMENTACE CZ ---
5912+ 7A46              ConvRStr16
5913+ 7A46              ;===============================================================
5914+ 7A46              ;http://z80-heaven.wikidot.com/math#toc32
5915+ 7A46              ;Input:
5916+ 7A46              ;     DE points to the base 10 number string in RAM.
5917+ 7A46              ;Outputs:
5918+ 7A46              ;     HL is the 16-bit value of the number
5919+ 7A46              ;     DE points to the byte after the number
5920+ 7A46              ;     BC is HL/10
5921+ 7A46              ;     z flag reset (nz)
5922+ 7A46              ;     c flag reset (nc)
5923+ 7A46              ;Destroys:
5924+ 7A46              ;     A (actually, add 30h and you get the ending token)
5925+ 7A46              ;Size:  23 bytes
5926+ 7A46              ;Speed: 104n+42+11c
5927+ 7A46              ;       n is the number of digits
5928+ 7A46              ;       c is at most n-2
5929+ 7A46              ;       at most 595 cycles for any 16-bit decimal value
5930+ 7A46              ;===============================================================
5931+ 7A46
5932+ 7A46 21 00 00          ld hl,0          ;  10 : 210000
5933+ 7A49              ConvLoop:             ;
5934+ 7A49 1A                ld a,(de)        ;   7 : 1A
5935+ 7A4A D6 30             sub 30h          ;   7 : D630
5936+ 7A4C FE 0A             cp 10            ;   7 : FE0A
5937+ 7A4E D0                ret nc           ;5|11 : D0
5938+ 7A4F 13                inc de           ;   6 : 13
5939+ 7A50                                    ;
5940+ 7A50 44                ld b,h           ;   4 : 44
5941+ 7A51 4D                ld c,l           ;   4 : 4D
5942+ 7A52 29                add hl,hl        ;  11 : 29
5943+ 7A53 29                add hl,hl        ;  11 : 29
5944+ 7A54 09                add hl,bc        ;  11 : 09
5945+ 7A55 29                add hl,hl        ;  11 : 29
5946+ 7A56                                    ;
5947+ 7A56 85                add a,l          ;   4 : 85
5948+ 7A57 6F                ld l,a           ;   4 : 6F
5949+ 7A58 30 EF             jr nc,ConvLoop   ;12|23: 30EE
5950+ 7A5A 24                inc h            ; --- : 24
5951+ 7A5B 18 EC             jr ConvLoop      ; --- : 18EB
5952+ 7A5D
5953+ 7A5D
5954+ 7A5D

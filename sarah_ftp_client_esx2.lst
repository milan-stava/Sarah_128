2478+ 6A23              ; -----------------------------------------------------------------------------
2479+ 6A23              ; FTP DIRECTORY BANK API
2480+ 6A23              ;
2481+ 6A23              ; fdp_pointer always points to the table byte of the CURRENT directory page.
2482+ 6A23              ; ftp_dir_page has #FF sentinels on both sides:
2483+ 6A23              ;       #FF, 0, 1, 3, 7, #FF
2484+ 6A23              ;
2485+ 6A23              ; HL is always a physical address in the banked window #C000-#FFFF.
2486+ 6A23              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
2487+ 6A23              ;
2488+ 6A23              ; OUT for INC/DEC:
2489+ 6A23              ;       NC = movement succeeded
2490+ 6A23              ;       C  = no next/previous directory page (64 KB boundary)
2491+ 6A23              ;
2492+ 6A23              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
2493+ 6A23              ; which preserves AF/BC/DE/IX/IY exactly.
2494+ 6A23              ; -----------------------------------------------------------------------------
2495+ 6A23
2496+ 6A23
2497+ 6A23              ; Select first FTP directory page (page 0); preserve caller's pointer.
2498+ 6A23              DIR128_FIRST_PAGE:
2499+ 6A23 E5                   push    hl
2500+ 6A24 21 F1 BF             ld      hl,ftp_dir_page+1
2501+ 6A27 22 F6 BF             ld      (fdp_pointer),hl
2502+ 6A2A 7E                   ld      a,(hl)
2503+ 6A2B CD E0 BF             call    PAGE128
2504+ 6A2E E1                   pop     hl
2505+ 6A2F B7                   or      a
2506+ 6A30 C9                   ret
2507+ 6A31
2508+ 6A31              ;HL++ across #FFFF -> #C000 of the next directory page.
2509+ 6A31              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
2510+ 6A31              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
2511+ 6A31              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
2512+ 6A31              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2513+ 6A31              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
2514+ 6A31              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2515+ 6A31              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2516+ 6A31              ; --- KONEC DOKUMENTACE CZ ---
2517+ 6A31              DIR128_INC_HL:
2518+ 6A31 F5                   push    af                      ;old INC HL never changed A - preserve it here too
2519+ 6A32 23                   inc     hl
2520+ 6A33 7C                   ld      a,h
2521+ 6A34 B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
2522+ 6A35 28 03                jr      z,DIR128_INC_CROSS
2523+ 6A37 F1                   pop     af
2524+ 6A38 B7                   or      a                       ;restore A and return NC = OK
2525+ 6A39 C9                   ret
2526+ 6A3A
2527+ 6A3A              DIR128_INC_CROSS:
2528+ 6A3A D5                   push    de
2529+ 6A3B ED 5B F6 BF          ld      de,(fdp_pointer)
2530+ 6A3F 13                   inc     de
2531+ 6A40 1A                   ld      a,(de)
2532+ 6A41 FE FF                cp      #FF
2533+ 6A43 28 0E                jr      z,DIR128_INC_END
2534+ 6A45 ED 53 F6 BF          ld      (fdp_pointer),de
2535+ 6A49 CD E0 BF             call    PAGE128
2536+ 6A4C 21 00 C0             ld      hl,ftp_dir_start        ;#C000
2537+ 6A4F D1                   pop     de
2538+ 6A50 F1                   pop     af                      ;restore caller's A
2539+ 6A51 B7                   or      a                       ;NC = OK, A unchanged
2540+ 6A52 C9                   ret
2541+ 6A53              DIR128_INC_END:
2542+ 6A53 1B                   dec     de                      ;keep fdp_pointer on last valid page
2543+ 6A54 ED 53 F6 BF          ld      (fdp_pointer),de
2544+ 6A58 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
2545+ 6A5B D1                   pop     de
2546+ 6A5C F1                   pop     af                      ;restore caller's A
2547+ 6A5D 37                   scf                             ;C = no following directory page
2548+ 6A5E C9                   ret
2549+ 6A5F
2550+ 6A5F              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
2551+ 6A5F              ;Unlike the general helper, this preserves the COMPLETE parser state:
2552+ 6A5F              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
2553+ 6A5F              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
2554+ 6A5F              ;  dir128_parser_status = 0  OK
2555+ 6A5F              ;  dir128_parser_status = 1  no next directory page
2556+ 6A5F              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
2557+ 6A5F              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
2558+ 6A5F              ; Vstup: HL = adresa v aktuální bance adresáře.
2559+ 6A5F              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
2560+ 6A5F              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
2561+ 6A5F              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
2562+ 6A5F              ; --- KONEC DOKUMENTACE CZ ---
2563+ 6A5F              DIR128_INC_HL_PARSER:
2564+ 6A5F F5                   push    af
2565+ 6A60 D5                   push    de
2566+ 6A61 AF                   xor     a
2567+ 6A62 32 FD 88             ld      (dir128_parser_status),a
2568+ 6A65 23                   inc     hl
2569+ 6A66 7C                   ld      a,h
2570+ 6A67 B7                   or      a
2571+ 6A68 20 14                jr      nz,.ok
2572+ 6A6A ED 5B F6 BF          ld      de,(fdp_pointer)
2573+ 6A6E 13                   inc     de
2574+ 6A6F 1A                   ld      a,(de)
2575+ 6A70 FE FF                cp      #FF
2576+ 6A72 28 0D                jr      z,.full
2577+ 6A74 ED 53 F6 BF          ld      (fdp_pointer),de
2578+ 6A78 CD E0 BF             call    PAGE128
2579+ 6A7B 21 00 C0             ld      hl,ftp_dir_start
2580+ 6A7E              .ok:
2581+ 6A7E D1                   pop     de
2582+ 6A7F F1                   pop     af
2583+ 6A80 C9                   ret
2584+ 6A81              .full:
2585+ 6A81 1B                   dec     de
2586+ 6A82 ED 53 F6 BF          ld      (fdp_pointer),de
2587+ 6A86 21 FF FF             ld      hl,#FFFF
2588+ 6A89 3E 01                ld      a,1
2589+ 6A8B 32 FD 88             ld      (dir128_parser_status),a
2590+ 6A8E D1                   pop     de
2591+ 6A8F F1                   pop     af
2592+ 6A90 C9                   ret
2593+ 6A91
2594+ 6A91              ;HL-- across #C000 -> #FFFF of the previous directory page.
2595+ 6A91              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
2596+ 6A91              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
2597+ 6A91              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
2598+ 6A91              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
2599+ 6A91              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
2600+ 6A91              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
2601+ 6A91              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
2602+ 6A91              ; --- KONEC DOKUMENTACE CZ ---
2603+ 6A91              DIR128_DEC_HL:
2604+ 6A91 F5                   push    af                      ;old DEC HL never changed A - preserve it here too
2605+ 6A92 2B                   dec     hl
2606+ 6A93 7C                   ld      a,h
2607+ 6A94 FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
2608+ 6A96 28 03                jr      z,DIR128_DEC_CROSS
2609+ 6A98 F1                   pop     af
2610+ 6A99 B7                   or      a                       ;restore A and return NC = OK
2611+ 6A9A C9                   ret
2612+ 6A9B
2613+ 6A9B              DIR128_DEC_CROSS:
2614+ 6A9B D5                   push    de
2615+ 6A9C ED 5B F6 BF          ld      de,(fdp_pointer)
2616+ 6AA0 1B                   dec     de
2617+ 6AA1 1A                   ld      a,(de)
2618+ 6AA2 FE FF                cp      #FF
2619+ 6AA4 28 0E                jr      z,DIR128_DEC_START
2620+ 6AA6 ED 53 F6 BF          ld      (fdp_pointer),de
2621+ 6AAA CD E0 BF             call    PAGE128
2622+ 6AAD 21 FF FF             ld      hl,#FFFF
2623+ 6AB0 D1                   pop     de
2624+ 6AB1 F1                   pop     af                      ;restore caller's A
2625+ 6AB2 B7                   or      a                       ;NC = OK, A unchanged
2626+ 6AB3 C9                   ret
2627+ 6AB4              DIR128_DEC_START:
2628+ 6AB4 13                   inc     de                      ;keep fdp_pointer on first valid page
2629+ 6AB5 ED 53 F6 BF          ld      (fdp_pointer),de
2630+ 6AB9 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
2631+ 6ABC D1                   pop     de
2632+ 6ABD F1                   pop     af                      ;restore caller's A
2633+ 6ABE 37                   scf                             ;C = no previous directory page
2634+ 6ABF C9                   ret
2635+ 6AC0
2636+ 6AC0              ;Map page-table pointer stored in DE. HL is preserved.
2637+ 6AC0              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
2638+ 6AC0              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
2639+ 6AC0              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
2640+ 6AC0              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
2641+ 6AC0              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
2642+ 6AC0              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
2643+ 6AC0              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
2644+ 6AC0              ; --- KONEC DOKUMENTACE CZ ---
2645+ 6AC0              DIR128_MAP_DE:
2646+ 6AC0 F5                   push    af
2647+ 6AC1 ED 53 F6 BF          ld      (fdp_pointer),de
2648+ 6AC5 1A                   ld      a,(de)
2649+ 6AC6 CD E0 BF             call    PAGE128
2650+ 6AC9 F1                   pop     af
2651+ 6ACA C9                   ret
2652+ 6ACB
2653+ 6ACB
2654+ 6ACB              ; -----------------------------------------------------------------------------
2655+ 6ACB              ; DIR128_COPY_NAME_TO_DE
2656+ 6ACB              ; Copy the name returned by get_item_name to fixed RAM.
2657+ 6ACB              ; IN:  HL = physical source address in directory window
2658+ 6ACB              ;      BC = 16-bit name length
2659+ 6ACB              ;      DE = fixed-RAM destination
2660+ 6ACB              ;      item_name_page = page-table pointer belonging to HL
2661+ 6ACB              ; OUT: DE points behind copied bytes, BC=0
2662+ 6ACB              ; The source may cross any #FFFF -> #C000 directory-page boundary.
2663+ 6ACB              ; -----------------------------------------------------------------------------
2664+ 6ACB              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
2665+ 6ACB              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
2666+ 6ACB              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
2667+ 6ACB              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
2668+ 6ACB              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2669+ 6ACB              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
2670+ 6ACB              ; --- KONEC DOKUMENTACE CZ ---
2671+ 6ACB              DIR128_COPY_NAME_TO_DE:
2672+ 6ACB D5                   push    de
2673+ 6ACC ED 5B 1A 70          ld      de,(item_name_page)
2674+ 6AD0 CD C0 6A             call    DIR128_MAP_DE
2675+ 6AD3 D1                   pop     de
2676+ 6AD4              .dir128_copy_loop:
2677+ 6AD4 78                   ld      a,b
2678+ 6AD5 B1                   or      c
2679+ 6AD6 C8                   ret     z
2680+ 6AD7 7E                   ld      a,(hl)
2681+ 6AD8 12                   ld      (de),a
2682+ 6AD9 13                   inc     de
2683+ 6ADA 0B                   dec     bc
2684+ 6ADB 78                   ld      a,b
2685+ 6ADC B1                   or      c
2686+ 6ADD C8                   ret     z
2687+ 6ADE CD 31 6A             call    DIR128_INC_HL
2688+ 6AE1 D8                   ret     c                       ;should only happen on malformed item
2689+ 6AE2 18 F0                jr      .dir128_copy_loop

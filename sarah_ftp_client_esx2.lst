2848+ 6BB6                      ;Start one comparison at current candidate address/page.
2849+ 6BB6 2A 9B 6F             ld      hl,(dir_search_addr)
2850+ 6BB9 ED 5B 9D 6F          ld      de,(dir_search_page)

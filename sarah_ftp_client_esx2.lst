6173+ 7825 30 FA        			jr nc,string_lp2
6174+ 7827 09           			add hl,bc
6175+ 7828 FE 30        			CP '0'
6176+ 782A 28 04        			JR Z,string_store
6177+ 782C
6178+ 782C DD CB 00 FE  			SET 7,(IX+0)		;Had something other than zero
6179+ 7830
6180+ 7830 DD CB 00 7E  string_store:		BIT 7,(IX+0)		;Test if still leading zeros
6181+ 7834 C8           			RET Z

 2851+6ABB              ; -----------------------------------------------------------------------------
 2852+6ABB              ; search_by_Busy_fast
 2853+6ABB              ; Fast case-insensitive substring search for a name fully contained in the
 2854+6ABB              ; currently mapped 16K directory page.
 2855+6ABB              ;
 2856+6ABB              ; IN:  HL = name start, BC = 16-bit name length
 2857+6ABB              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
 2858+6ABB              ; OUT: Z = found, NZ = not found
 2859+6ABB              ;
 2860+6ABB              ; This is deliberately close to the original Busy FIND: the inner compare uses
 2861+6ABB              ; the Z80 CPI instruction.  The pattern has already been converted to lower
 2862+6ABB              ; case once by find_items, so only the source character needs convert here.
 2863+6ABB              ;
 2864+6ABB              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
 2865+6ABB              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
 2866+6ABB              ; matches therefore cannot be skipped.
 2867+6ABB              ; -----------------------------------------------------------------------------
 2868+6ABB              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
 2869+6ABB              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
 2870+6ABB              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
 2871+6ABB              ;   délka.
 2872+6ABB              ; Vystup: Z = shoda, NZ = nenalezeno.
 2873+6ABB              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 2874+6ABB              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
 2875+6ABB              ; --- KONEC DOKUMENTACE CZ ---
 2876+6ABB              search_by_Busy_fast:
 2877+6ABB EB                   ex      de,hl                   ;DE=current candidate in file name
 2878+6ABC
 2879+6ABC                      ; candidate_count = name_length - pattern_length + 1
 2880+6ABC 60                   ld      h,b
 2881+6ABD 69                   ld      l,c
 2882+6ABE ED 4B 4C 79          ld      bc,(txtlen+1)
 2883+6AC2 78                   ld      a,b
 2884+6AC3 B1                   or      c
 2885+6AC4 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
 2886+6AC6 B7                   or      a
 2887+6AC7 ED 42                sbc     hl,bc
 2888+6AC9 38 25                jr      c,.fast_not_found       ;pattern longer than file name
 2889+6ACB 23                   inc     hl
 2890+6ACC
 2891+6ACC                      ; Keep number of possible candidate starts in alternate BC.
 2892+6ACC E5                   push    hl
 2893+6ACD D9                   exx
 2894+6ACE C1                   pop     bc
 2895+6ACF D9                   exx
 2896+6AD0
 2897+6AD0              .fast_next_candidate:
 2898+6AD0 D5                   push    de                      ;remember exact candidate start
 2899+6AD1 21 81 8F             ld      hl,INPBUFF
 2900+6AD4 ED 4B 4C 79          ld      bc,(txtlen+1)
 2901+6AD8
 2902+6AD8              .fast_compare:
 2903+6AD8 1A                   ld      a,(de)
 2904+6AD9 CD 70 79             call    convert                 ;source char -> lower case
 2905+6ADC ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
 2906+6ADE 13                   inc     de
 2907+6ADF 20 06                jr      nz,.fast_candidate_failed
 2908+6AE1 EA D8 6A             jp      pe,.fast_compare        ;matched, more pattern bytes remain
 2909+6AE4
 2910+6AE4 D1                   pop     de                      ;discard saved candidate start
 2911+6AE5              .fast_found:
 2912+6AE5 AF                   xor     a                       ;Z = found
 2913+6AE6 C9                   ret
 2914+6AE7
 2915+6AE7              .fast_candidate_failed:
 2916+6AE7 D1                   pop     de                      ;restore previous candidate start
 2917+6AE8 13                   inc     de                      ;next candidate = previous + 1
 2918+6AE9 D9                   exx
 2919+6AEA 0B                   dec     bc
 2920+6AEB 78                   ld      a,b
 2921+6AEC B1                   or      c
 2922+6AED D9                   exx
 2923+6AEE 20 E0                jr      nz,.fast_next_candidate
 2924+6AF0
 2925+6AF0              .fast_not_found:
 2926+6AF0 3E 01                ld      a,1
 2927+6AF2 B7                   or      a                       ;NZ = not found
 2928+6AF3 C9                   ret

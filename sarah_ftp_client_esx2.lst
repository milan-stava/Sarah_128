 9023+83BB              ;89) get_item_name	;get file name under cursor
 9024+83BB              ;IN: current active callers use SCF. 128K parser always returns full info.
 9025+83BB              ;OUT=HL=name start, BC= name length, DE= file length
 9026+83BB              ;OUT=A=0= item is a directory+ HL, BC
 9027+83BB              ;OUT=A=1=item is a file+ HL, BC
 9028+83BB              ;OUT=A=2=item type cannot be determined (because of NLST command)+ HL, BC
 9029+83BB              ;OUT=A=3= item not parsed (for the moment) bacause it is LIST in full, HL, BC irrelevant
 9030+83BB              ;OUT=A=4= starting item ".."
 9031+83BB              ;bits 1 (items 0=abbreviated, 1= full) and 3 (current command type 0=LIST, 1=NLST) from flag_dir are of interest here
 9032+83BB              ; --- DOKUMENTACE CZ: get_item_name ---
 9033+83BB              ; Ucel: Rozebere aktuální položku adresáře a vrátí jméno a typ.
 9034+83BB              ; Vstup: cur_item_addr/cur_item_addr_page; IX=flag1; vstupní Carry se nevyužívá.
 9035+83BB              ; Vystup: HL=jméno, BC=délka, item_name_page=banka; DE=16bitová velikost u zkráceného LIST.
 9036+83BB              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 9037+83BB              ; Poznamka: A: 0 adresář, 1 soubor, 2 NLST (typ neznámý), 3 plný LIST/chybná položka, 4
 9038+83BB              ;   syntetické ..; pro A=3 nejsou HL/BC obecně platné.
 9039+83BB              ; --- KONEC DOKUMENTACE CZ ---
 9040+83BB              get_item_name
 9041+83BB              ;128K bank-safe parser.
 9042+83BB              ;IN: callers currently use SCF; C/NC is kept only for source compatibility.
 9043+83BB              ;OUT=HL=name start in banked directory RAM
 9044+83BB              ;    BC=16-bit name length
 9045+83BB              ;    DE=16-bit file length for LIST abbreviated (0 for NLST/"..")
 9046+83BB              ;    item_name_page=page-table pointer belonging to returned HL
 9047+83BB              ;OUT=A=0 directory, A=1 file, A=2 NLST unknown type,
 9048+83BB              ;      A=3 LIST full/malformed, A=4 synthetic ".."
 9049+83BB              ;
 9050+83BB              ;No temporary zero is written into the directory. The parser uses the stored
 9051+83BB              ;16-bit item length as its boundary, so an item/name may cross 16K pages and
 9052+83BB              ;may also be longer than 255 bytes.
 9053+83BB 2A BB 8D             ld      hl,(cur_item_addr)
 9054+83BE ED 5B 0E 88          ld      de,(cur_item_addr_page)
 9055+83C2 CD 2D 6A             call    DIR128_MAP_DE
 9056+83C5
 9057+83C5                      ;Read item length LOW/HIGH. Even the length field may cross a page.
 9058+83C5 7E                   ld      a,(hl)
 9059+83C6 4F                   ld      c,a
 9060+83C7 CD 9E 69             call    DIR128_INC_HL
 9061+83CA DA AA 84             jp      c,gfn_bad
 9062+83CD 7E                   ld      a,(hl)
 9063+83CE 47                   ld      b,a
 9064+83CF 78                   ld      a,b
 9065+83D0 B1                   or      c
 9066+83D1 CA AA 84             jp      z,gfn_bad
 9067+83D4 ED 43 88 6F          ld      (gfn_remaining),bc      ;includes mark/info byte + stored data
 9068+83D8
 9069+83D8                      ;Move from header HIGH to mark/info byte (item+2).
 9070+83D8 CD 9E 69             call    DIR128_INC_HL
 9071+83DB DA AA 84             jp      c,gfn_bad
 9072+83DE
 9073+83DE                      ;Synthetic first item ".." is always page 0:#C000.
 9074+83DE E5                   push    hl
 9075+83DF 2A 0E 88             ld      hl,(cur_item_addr_page)
 9076+83E2 11 F1 BF             ld      de,ftp_dir_page+1

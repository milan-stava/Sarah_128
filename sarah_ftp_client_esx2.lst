2882+ 69E8              ; -----------------------------------------------------------------------------
2883+ 69E8              ; search_by_Busy_dir
2884+ 69E8              ; Bank-safe replacement used by FIND for names returned by get_item_name.
2885+ 69E8              ; IN:  HL = physical name start, BC = 16-bit name length
2886+ 69E8              ;      item_name_page = bank companion for HL
2887+ 69E8              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
2888+ 69E8              ; OUT: Z=pattern found, NZ=not found
2889+ 69E8              ; One-character input matches only the FIRST character of a name (quick jump).
2890+ 69E8              ; Two or more characters use normal case-insensitive substring search. There is
2891+ 69E8              ; no 255-byte directory-name limit; directory page crossings are transparent.
2892+ 69E8              ; -----------------------------------------------------------------------------
2893+ 69E8              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
2894+ 69E8              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
2895+ 69E8              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
2896+ 69E8              ;   = délka vzoru.
2897+ 69E8              ; Vystup: Z = shoda, NZ = nenalezeno.
2898+ 69E8              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2899+ 69E8              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
2900+ 69E8              ; --- KONEC DOKUMENTACE CZ ---
2901+ 69E8              search_by_Busy_dir:
2902+ 69E8                      ; Empty name cannot contain a non-empty search pattern.
2903+ 69E8 78                   ld      a,b
2904+ 69E9 B1                   or      c
2905+ 69EA 28 2A                jr      z,.dir_search_not_found_fast
2906+ 69EC
2907+ 69EC                      ; Map the directory bank containing the first byte of the name ONCE.
2908+ 69EC                      ; For the normal case the whole name is inside this one 16K bank and
2909+ 69EC                      ; no further paging is needed during FIND.
2910+ 69EC ED 5B B2 6E          ld      de,(item_name_page)
2911+ 69F0 CD C4 69             call    DIR128_MAP_DE
2912+ 69F3
2913+ 69F3                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
2914+ 69F3                      ; the first character of the file name.  Thus FIND "S" selects names
2915+ 69F3                      ; beginning with S, while 2+ characters remain a substring search.
2916+ 69F3                      ; This is also much faster for the common one-letter jump.
2917+ 69F3 ED 5B 31 77          ld      de,(txtlen+1)
2918+ 69F7 7A                   ld      a,d
2919+ 69F8 B7                   or      a
2920+ 69F9 20 0F                jr      nz,.dir_search_len_ge2
2921+ 69FB 7B                   ld      a,e
2922+ 69FC FE 01                cp      1
2923+ 69FE 20 0A                jr      nz,.dir_search_len_ge2
2924+ 6A00 7E                   ld      a,(hl)
2925+ 6A01 CD 55 77             call    convert
2926+ 6A04 57                   ld      d,a
2927+ 6A05 3A DA 8B             ld      a,(INPBUFF)             ;already normalized by find_items
2928+ 6A08 BA                   cp      d                       ;Z=first character matches
2929+ 6A09 C9                   ret

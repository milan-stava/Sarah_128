3838+ 7107              ; -----------------------------------------------------------------------------
3839+ 7107              ; item_add / item_sub - 128K bank-aware directory movement
3840+ 7107              ;
3841+ 7107              ; IN:
3842+ 7107              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
3843+ 7107              ;       DE = address of its 16-bit page-table-pointer companion
3844+ 7107              ;
3845+ 7107              ; Example:
3846+ 7107              ;       ld bc,cur_item_addr
3847+ 7107              ;       ld de,cur_item_addr_page
3848+ 7107              ;       call item_add
3849+ 7107              ;
3850+ 7107              ; OUT:
3851+ 7107              ;       Z  = cannot move (end/start of directory)
3852+ 7107              ;       NZ = pointer + its bank companion were moved to adjacent item
3853+ 7107              ;
3854+ 7107              ; The address variable and page variable deliberately do NOT have to be adjacent.
3855+ 7107              ; This keeps the original IX+... variable layout completely unchanged.
3856+ 7107              ; The two-byte item length at either end of an item may itself cross a bank.
3857+ 7107              ; -----------------------------------------------------------------------------
3858+ 7107              item_add
3859+ 7107 ED 43 88 6F  		ld	(dir_op_addr_var),bc
3860+ 710B ED 53 8A 6F  		ld	(dir_op_page_var),de

5862+ 79FB              ; --- DOKUMENTACE CZ: ConvRStr16 ---
5863+ 79FB              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
5864+ 79FB              ; Vstup: DE = začátek číslic.
5865+ 79FB              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
5866+ 79FB              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
5867+ 79FB              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
5868+ 79FB              ;   přetečení; Z nemá pevný význam.
5869+ 79FB              ; --- KONEC DOKUMENTACE CZ ---
5870+ 79FB              ConvRStr16
5871+ 79FB              ;===============================================================
5872+ 79FB              ;http://z80-heaven.wikidot.com/math#toc32
5873+ 79FB              ;Input:
5874+ 79FB              ;     DE points to the base 10 number string in RAM.
5875+ 79FB              ;Outputs:
5876+ 79FB              ;     HL is the 16-bit value of the number
5877+ 79FB              ;     DE points to the byte after the number
5878+ 79FB              ;     BC is HL/10
5879+ 79FB              ;     z flag reset (nz)
5880+ 79FB              ;     c flag reset (nc)
5881+ 79FB              ;Destroys:
5882+ 79FB              ;     A (actually, add 30h and you get the ending token)
5883+ 79FB              ;Size:  23 bytes
5884+ 79FB              ;Speed: 104n+42+11c
5885+ 79FB              ;       n is the number of digits
5886+ 79FB              ;       c is at most n-2
5887+ 79FB              ;       at most 595 cycles for any 16-bit decimal value
5888+ 79FB              ;===============================================================
5889+ 79FB
5890+ 79FB 21 00 00          ld hl,0          ;  10 : 210000
5891+ 79FE              ConvLoop:             ;
5892+ 79FE 1A                ld a,(de)        ;   7 : 1A
5893+ 79FF D6 30             sub 30h          ;   7 : D630
5894+ 7A01 FE 0A             cp 10            ;   7 : FE0A
5895+ 7A03 D0                ret nc           ;5|11 : D0
5896+ 7A04 13                inc de           ;   6 : 13
5897+ 7A05                                    ;
5898+ 7A05 44                ld b,h           ;   4 : 44
5899+ 7A06 4D                ld c,l           ;   4 : 4D
5900+ 7A07 29                add hl,hl        ;  11 : 29
5901+ 7A08 29                add hl,hl        ;  11 : 29
5902+ 7A09 09                add hl,bc        ;  11 : 09
5903+ 7A0A 29                add hl,hl        ;  11 : 29
5904+ 7A0B                                    ;
5905+ 7A0B 85                add a,l          ;   4 : 85
5906+ 7A0C 6F                ld l,a           ;   4 : 6F
5907+ 7A0D 30 EF             jr nc,ConvLoop   ;12|23: 30EE
5908+ 7A0F 24                inc h            ; --- : 24
5909+ 7A10 18 EC             jr ConvLoop      ; --- : 18EB
5910+ 7A12
5911+ 7A12
5912+ 7A12

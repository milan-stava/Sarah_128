4198+ 7237              ; -----------------------------------------------------------------------------
4199+ 7237              ; item_add / item_sub - 128K bank-aware directory movement
4200+ 7237              ;
4201+ 7237              ; IN:
4202+ 7237              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
4203+ 7237              ;       DE = address of its 16-bit page-table-pointer companion
4204+ 7237              ;
4205+ 7237              ; Example:
4206+ 7237              ;       ld bc,cur_item_addr
4207+ 7237              ;       ld de,cur_item_addr_page
4208+ 7237              ;       call item_add
4209+ 7237              ;
4210+ 7237              ; OUT:
4211+ 7237              ;       Z  = cannot move (end/start of directory)
4212+ 7237              ;       NZ = pointer + its bank companion were moved to adjacent item
4213+ 7237              ;
4214+ 7237              ; The address variable and page variable deliberately do NOT have to be adjacent.
4215+ 7237              ; This keeps the original IX+... variable layout completely unchanged.
4216+ 7237              ; The two-byte item length at either end of an item may itself cross a bank.
4217+ 7237              ; -----------------------------------------------------------------------------
4218+ 7237              ; --- DOKUMENTACE CZ: item_add ---
4219+ 7237              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
4220+ 7237              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
4221+ 7237              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
4222+ 7237              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
4223+ 7237              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
4224+ 7237              ; --- KONEC DOKUMENTACE CZ ---
4225+ 7237              item_add
4226+ 7237 ED 43 B6 6F  		ld	(dir_op_addr_var),bc
4227+ 723B ED 53 B8 6F  		ld	(dir_op_page_var),de
4228+ 723F
4229+ 723F              		;Load physical item address from *(BC).
4230+ 723F 60           		ld	h,b
4231+ 7240 69           		ld	l,c
4232+ 7241 5E           		ld	e,(hl)

  986+622E              ;		jp	error
  987+622E CD B8 7C     sme1		call	akey
  988+6231 CD 5D 76     		call	undraw_cursor		;return from AP selection
  989+6234 CD 80 76     		call	wind_cls
  990+6237 CD F1 7B     		call	clear_edit_zone

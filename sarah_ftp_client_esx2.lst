 2756+6A56              ; search_by_Busy_dir
 2757+6A56              ; Bank-safe replacement used by FIND for names returned by get_item_name.
 2758+6A56              ; IN:  HL = physical name start, BC = 16-bit name length
 2759+6A56              ;      item_name_page = bank companion for HL
 2760+6A56              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
 2761+6A56              ; OUT: Z=pattern found, NZ=not found
 2762+6A56              ; One-character input matches only the FIRST character of a name (quick jump).
 2763+6A56              ; Two or more characters use normal case-insensitive substring search. There is
 2764+6A56              ; no 255-byte directory-name limit; directory page crossings are transparent.
 2765+6A56              ; -----------------------------------------------------------------------------
 2766+6A56              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
 2767+6A56              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
 2768+6A56              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
 2769+6A56              ;   = délka vzoru.
 2770+6A56              ; Vystup: Z = shoda, NZ = nenalezeno.
 2771+6A56              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 2772+6A56              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
 2773+6A56              ; --- KONEC DOKUMENTACE CZ ---
 2774+6A56              search_by_Busy_dir:
 2775+6A56                      ; Empty name cannot contain a non-empty search pattern.
 2776+6A56 78                   ld      a,b
 2777+6A57 B1                   or      c
 2778+6A58 28 2A                jr      z,.dir_search_not_found_fast
 2779+6A5A
 2780+6A5A                      ; Map the directory bank containing the first byte of the name ONCE.
 2781+6A5A                      ; For the normal case the whole name is inside this one 16K bank and
 2782+6A5A                      ; no further paging is needed during FIND.
 2783+6A5A ED 5B 8B 6F          ld      de,(item_name_page)
 2784+6A5E CD 32 6A             call    DIR128_MAP_DE
 2785+6A61
 2786+6A61                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
 2787+6A61                      ; the first character of the file name.  Thus FIND "S" selects names
 2788+6A61                      ; beginning with S, while 2+ characters remain a substring search.
 2789+6A61                      ; This is also much faster for the common one-letter jump.
 2790+6A61 ED 5B 14 79          ld      de,(txtlen+1)
 2791+6A65 7A                   ld      a,d
 2792+6A66 B7                   or      a
 2793+6A67 20 0F                jr      nz,.dir_search_len_ge2
 2794+6A69 7B                   ld      a,e
 2795+6A6A FE 01                cp      1
 2796+6A6C 20 0A                jr      nz,.dir_search_len_ge2
 2797+6A6E 7E                   ld      a,(hl)
 2798+6A6F CD 38 79             call    convert
 2799+6A72 57                   ld      d,a
 2800+6A73 3A 9F 8F             ld      a,(INPBUFF)             ;already normalized by find_items
 2801+6A76 BA                   cp      d                       ;Z=first character matches
 2802+6A77 C9                   ret

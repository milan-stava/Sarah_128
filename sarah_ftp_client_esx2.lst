 3169+6EB1              ; -----------------------------------------------------------------------------
 3170+6EB1              ; search_by_Busy_dir
 3171+6EB1              ; Bank-safe replacement used by FIND for names returned by get_item_name.
 3172+6EB1              ; IN:  HL = physical name start, BC = 16-bit name length
 3173+6EB1              ;      item_name_page = bank companion for HL
 3174+6EB1              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
 3175+6EB1              ; OUT: Z=pattern found, NZ=not found
 3176+6EB1              ; One-character input matches only the FIRST character of a name (quick jump).
 3177+6EB1              ; Two or more characters use normal case-insensitive substring search. There is
 3178+6EB1              ; no 255-byte directory-name limit; directory page crossings are transparent.
 3179+6EB1              ; -----------------------------------------------------------------------------
 3180+6EB1              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
 3181+6EB1              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
 3182+6EB1              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
 3183+6EB1              ;   = délka vzoru.
 3184+6EB1              ; Vystup: Z = shoda, NZ = nenalezeno.
 3185+6EB1              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 3186+6EB1              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
 3187+6EB1              ; --- KONEC DOKUMENTACE CZ ---
 3188+6EB1              search_by_Busy_dir:
 3189+6EB1                      ; Empty name cannot contain a non-empty search pattern.
 3190+6EB1 78                   ld      a,b
 3191+6EB2 B1                   or      c
 3192+6EB3 28 2A                jr      z,.dir_search_not_found_fast
 3193+6EB5
 3194+6EB5                      ; Map the directory bank containing the first byte of the name ONCE.
 3195+6EB5                      ; For the normal case the whole name is inside this one 16K bank and
 3196+6EB5                      ; no further paging is needed during FIND.
 3197+6EB5 ED 5B 1F 73          ld      de,(item_name_page)
 3198+6EB9 CD 8D 6E             call    DIR128_MAP_DE
 3199+6EBC
 3200+6EBC                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
 3201+6EBC                      ; the first character of the file name.  Thus FIND "S" selects names
 3202+6EBC                      ; beginning with S, while 2+ characters remain a substring search.
 3203+6EBC                      ; This is also much faster for the common one-letter jump.
 3204+6EBC ED 5B 9A 7B          ld      de,(txtlen+1)
 3205+6EC0 7A                   ld      a,d
 3206+6EC1 B7                   or      a
 3207+6EC2 20 0F                jr      nz,.dir_search_len_ge2
 3208+6EC4 7B                   ld      a,e
 3209+6EC5 FE 01                cp      1
 3210+6EC7 20 0A                jr      nz,.dir_search_len_ge2
 3211+6EC9 7E                   ld      a,(hl)
 3212+6ECA CD BE 7B             call    convert
 3213+6ECD 57                   ld      d,a
 3214+6ECE 3A 30 91             ld      a,(INPBUFF)             ;already normalized by find_items
 3215+6ED1 BA                   cp      d                       ;Z=first character matches
 3216+6ED2 C9                   ret
 3217+6ED3
 3218+6ED3              .dir_search_len_ge2:
 3219+6ED3                      ; Is the LAST byte of the name still inside the same physical window?
 3220+6ED3                      ; last = HL + BC - 1
 3221+6ED3                      ; Carry means that the name crosses #FFFF -> #C000, therefore use the
 3222+6ED3                      ; fully bank-safe (but slower) routine below.
 3223+6ED3 E5                   push    hl
 3224+6ED4 C5                   push    bc
 3225+6ED5 0B                   dec     bc
 3226+6ED6 09                   add     hl,bc
 3227+6ED7 C1                   pop     bc
 3228+6ED8 E1                   pop     hl
 3229+6ED9 DA 1C 6F             jp      c,search_by_Busy_dir_slow
 3230+6EDC
 3231+6EDC C3 E3 6E             jp      search_by_Busy_fast
 3232+6EDF
 3233+6EDF              .dir_search_not_found_fast:
 3234+6EDF 3E 01                ld      a,1
 3235+6EE1 B7                   or      a                       ;NZ
 3236+6EE2 C9                   ret

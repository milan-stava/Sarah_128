 4162+722E              ; -----------------------------------------------------------------------------
 4163+722E              ; item_add / item_sub - 128K bank-aware directory movement
 4164+722E              ;
 4165+722E              ; IN:
 4166+722E              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
 4167+722E              ;       DE = address of its 16-bit page-table-pointer companion
 4168+722E              ;
 4169+722E              ; Example:
 4170+722E              ;       ld bc,cur_item_addr
 4171+722E              ;       ld de,cur_item_addr_page
 4172+722E              ;       call item_add
 4173+722E              ;
 4174+722E              ; OUT:
 4175+722E              ;       Z  = cannot move (end/start of directory)
 4176+722E              ;       NZ = pointer + its bank companion were moved to adjacent item
 4177+722E              ;
 4178+722E              ; The address variable and page variable deliberately do NOT have to be adjacent.
 4179+722E              ; This keeps the original IX+... variable layout completely unchanged.
 4180+722E              ; The two-byte item length at either end of an item may itself cross a bank.
 4181+722E              ; -----------------------------------------------------------------------------
 4182+722E              ; --- DOKUMENTACE CZ: item_add ---
 4183+722E              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
 4184+722E              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
 4185+722E              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
 4186+722E              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
 4187+722E              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
 4188+722E              ; --- KONEC DOKUMENTACE CZ ---
 4189+722E              item_add
 4190+722E ED 43 AD 6F  		ld	(dir_op_addr_var),bc
 4191+7232 ED 53 AF 6F  		ld	(dir_op_page_var),de
 4192+7236
 4193+7236              		;Load physical item address from *(BC).
 4194+7236 60           		ld	h,b
 4195+7237 69           		ld	l,c
 4196+7238 5E           		ld	e,(hl)
 4197+7239 23           		inc	hl
 4198+723A 56           		ld	d,(hl)
 4199+723B ED 53 A5 6F  		ld	(next_item_addr),de	;temporary physical start
 4200+723F EB           		ex	de,hl			;HL=current physical item start
 4201+7240
 4202+7240              		;Load/map directory page from page companion variable.
 4203+7240 E5           		push	hl
 4204+7241 2A AF 6F     		ld	hl,(dir_op_page_var)
 4205+7244 5E           		ld	e,(hl)
 4206+7245 23           		inc	hl
 4207+7246 56           		ld	d,(hl)
 4208+7247 E1           		pop	hl
 4209+7248 CD 5C 6A     		call	DIR128_MAP_DE

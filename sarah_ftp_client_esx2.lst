 2489+697A              ; -----------------------------------------------------------------------------
 2490+697A              ; FTP DIRECTORY BANK API
 2491+697A              ;
 2492+697A              ; fdp_pointer always points to the table byte of the CURRENT directory page.
 2493+697A              ; ftp_dir_page has #FF sentinels on both sides:
 2494+697A              ;       #FF, 0, 1, 3, 7, #FF
 2495+697A              ;
 2496+697A              ; HL is always a physical address in the banked window #C000-#FFFF.
 2497+697A              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
 2498+697A              ;
 2499+697A              ; OUT for INC/DEC:
 2500+697A              ;       NC = movement succeeded
 2501+697A              ;       C  = no next/previous directory page (64 KB boundary)
 2502+697A              ;
 2503+697A              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
 2504+697A              ; which preserves AF/BC/DE/IX/IY exactly.
 2505+697A              ; -----------------------------------------------------------------------------
 2506+697A
 2507+697A              ; --- DOKUMENTACE CZ: DIR128_MAP_CURRENT ---
 2508+697A              ; Ucel: Namapuje aktuální banku adresáře do #C000–#FFFF.
 2509+697A              ; Vstup: fdp_pointer ukazuje do tabulky ftp_dir_page.
 2510+697A              ; Vystup: NC = platná banka, C = sentinel #FF.
 2511+697A              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
 2512+697A              ; Poznamka: Mění PAGE128_STATE a port #7FFD.
 2513+697A              ; --- KONEC DOKUMENTACE CZ ---
 2514+697A              DIR128_MAP_CURRENT:
 2515+697A E5                   push    hl
 2516+697B D5                   push    de
 2517+697C ED 5B F6 BF          ld      de,(fdp_pointer)
 2518+6980 1A                   ld      a,(de)
 2519+6981 FE FF                cp      #FF
 2520+6983 28 07                jr      z,DIR128_MAP_BAD
 2521+6985 CD E0 BF             call    PAGE128
 2522+6988 D1                   pop     de
 2523+6989 E1                   pop     hl
 2524+698A B7                   or      a                       ;NC = valid page
 2525+698B C9                   ret
 2526+698C              DIR128_MAP_BAD:
 2527+698C D1                   pop     de
 2528+698D E1                   pop     hl
 2529+698E 37                   scf
 2530+698F C9                   ret
 2531+6990
 2532+6990              ;Select first FTP directory page (page 0).
 2533+6990              ; --- DOKUMENTACE CZ: DIR128_FIRST_PAGE ---
 2534+6990              ; Ucel: Vybere první banku adresáře (RAM 0).
 2535+6990              ; Vstup: Bez parametrů.
 2536+6990              ; Vystup: fdp_pointer = ftp_dir_page+1; NC.
 2537+6990              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
 2538+6990              ; Poznamka: Mění mapování RAM a PAGE128_STATE.
 2539+6990              ; --- KONEC DOKUMENTACE CZ ---
 2540+6990              DIR128_FIRST_PAGE:
 2541+6990 E5                   push    hl
 2542+6991 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
 2543+6994 22 F6 BF             ld      (fdp_pointer),hl
 2544+6997 7E                   ld      a,(hl)
 2545+6998 CD E0 BF             call    PAGE128
 2546+699B E1                   pop     hl
 2547+699C B7                   or      a
 2548+699D C9                   ret
 2549+699E
 2550+699E              ;HL++ across #FFFF -> #C000 of the next directory page.
 2551+699E              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
 2552+699E              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
 2553+699E              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
 2554+699E              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
 2555+699E              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
 2556+699E              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
 2557+699E              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
 2558+699E              ; --- KONEC DOKUMENTACE CZ ---
 2559+699E              DIR128_INC_HL:
 2560+699E F5                   push    af                      ;old INC HL never changed A - preserve it here too
 2561+699F 23                   inc     hl
 2562+69A0 7C                   ld      a,h
 2563+69A1 B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
 2564+69A2 28 03                jr      z,DIR128_INC_CROSS
 2565+69A4 F1                   pop     af
 2566+69A5 B7                   or      a                       ;restore A and return NC = OK
 2567+69A6 C9                   ret
 2568+69A7
 2569+69A7              DIR128_INC_CROSS:
 2570+69A7 D5                   push    de
 2571+69A8 ED 5B F6 BF          ld      de,(fdp_pointer)
 2572+69AC 13                   inc     de
 2573+69AD 1A                   ld      a,(de)
 2574+69AE FE FF                cp      #FF
 2575+69B0 28 0E                jr      z,DIR128_INC_END
 2576+69B2 ED 53 F6 BF          ld      (fdp_pointer),de
 2577+69B6 CD E0 BF             call    PAGE128
 2578+69B9 21 00 C0             ld      hl,ftp_dir_start        ;#C000
 2579+69BC D1                   pop     de
 2580+69BD F1                   pop     af                      ;restore caller's A
 2581+69BE B7                   or      a                       ;NC = OK, A unchanged
 2582+69BF C9                   ret
 2583+69C0              DIR128_INC_END:
 2584+69C0 1B                   dec     de                      ;keep fdp_pointer on last valid page
 2585+69C1 ED 53 F6 BF          ld      (fdp_pointer),de
 2586+69C5 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
 2587+69C8 D1                   pop     de
 2588+69C9 F1                   pop     af                      ;restore caller's A
 2589+69CA 37                   scf                             ;C = no following directory page
 2590+69CB C9                   ret
 2591+69CC
 2592+69CC              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
 2593+69CC              ;Unlike the general helper, this preserves the COMPLETE parser state:
 2594+69CC              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
 2595+69CC              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
 2596+69CC              ;  dir128_parser_status = 0  OK
 2597+69CC              ;  dir128_parser_status = 1  no next directory page
 2598+69CC              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
 2599+69CC              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
 2600+69CC              ; Vstup: HL = adresa v aktuální bance adresáře.
 2601+69CC              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
 2602+69CC              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
 2603+69CC              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
 2604+69CC              ; --- KONEC DOKUMENTACE CZ ---
 2605+69CC              DIR128_INC_HL_PARSER:
 2606+69CC F5                   push    af
 2607+69CD D5                   push    de
 2608+69CE AF                   xor     a
 2609+69CF 32 10 88             ld      (dir128_parser_status),a
 2610+69D2 23                   inc     hl
 2611+69D3 7C                   ld      a,h
 2612+69D4 B7                   or      a
 2613+69D5 20 14                jr      nz,.ok
 2614+69D7 ED 5B F6 BF          ld      de,(fdp_pointer)
 2615+69DB 13                   inc     de
 2616+69DC 1A                   ld      a,(de)
 2617+69DD FE FF                cp      #FF
 2618+69DF 28 0D                jr      z,.full
 2619+69E1 ED 53 F6 BF          ld      (fdp_pointer),de
 2620+69E5 CD E0 BF             call    PAGE128
 2621+69E8 21 00 C0             ld      hl,ftp_dir_start
 2622+69EB              .ok:
 2623+69EB D1                   pop     de
 2624+69EC F1                   pop     af
 2625+69ED C9                   ret
 2626+69EE              .full:
 2627+69EE 1B                   dec     de
 2628+69EF ED 53 F6 BF          ld      (fdp_pointer),de
 2629+69F3 21 FF FF             ld      hl,#FFFF
 2630+69F6 3E 01                ld      a,1
 2631+69F8 32 10 88             ld      (dir128_parser_status),a
 2632+69FB D1                   pop     de
 2633+69FC F1                   pop     af
 2634+69FD C9                   ret
 2635+69FE
 2636+69FE              ;HL-- across #C000 -> #FFFF of the previous directory page.
 2637+69FE              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
 2638+69FE              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
 2639+69FE              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
 2640+69FE              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
 2641+69FE              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
 2642+69FE              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
 2643+69FE              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
 2644+69FE              ; --- KONEC DOKUMENTACE CZ ---
 2645+69FE              DIR128_DEC_HL:
 2646+69FE F5                   push    af                      ;old DEC HL never changed A - preserve it here too
 2647+69FF 2B                   dec     hl
 2648+6A00 7C                   ld      a,h
 2649+6A01 FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
 2650+6A03 28 03                jr      z,DIR128_DEC_CROSS
 2651+6A05 F1                   pop     af
 2652+6A06 B7                   or      a                       ;restore A and return NC = OK
 2653+6A07 C9                   ret
 2654+6A08
 2655+6A08              DIR128_DEC_CROSS:
 2656+6A08 D5                   push    de
 2657+6A09 ED 5B F6 BF          ld      de,(fdp_pointer)
 2658+6A0D 1B                   dec     de
 2659+6A0E 1A                   ld      a,(de)
 2660+6A0F FE FF                cp      #FF
 2661+6A11 28 0E                jr      z,DIR128_DEC_START
 2662+6A13 ED 53 F6 BF          ld      (fdp_pointer),de
 2663+6A17 CD E0 BF             call    PAGE128
 2664+6A1A 21 FF FF             ld      hl,#FFFF
 2665+6A1D D1                   pop     de
 2666+6A1E F1                   pop     af                      ;restore caller's A
 2667+6A1F B7                   or      a                       ;NC = OK, A unchanged
 2668+6A20 C9                   ret
 2669+6A21              DIR128_DEC_START:
 2670+6A21 13                   inc     de                      ;keep fdp_pointer on first valid page
 2671+6A22 ED 53 F6 BF          ld      (fdp_pointer),de
 2672+6A26 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
 2673+6A29 D1                   pop     de
 2674+6A2A F1                   pop     af                      ;restore caller's A
 2675+6A2B 37                   scf                             ;C = no previous directory page
 2676+6A2C C9                   ret
 2677+6A2D
 2678+6A2D              ;Map page-table pointer stored in DE. HL is preserved.
 2679+6A2D              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
 2680+6A2D              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
 2681+6A2D              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
 2682+6A2D              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
 2683+6A2D              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
 2684+6A2D              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
 2685+6A2D              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
 2686+6A2D              ; --- KONEC DOKUMENTACE CZ ---
 2687+6A2D              DIR128_MAP_DE:
 2688+6A2D F5                   push    af
 2689+6A2E ED 53 F6 BF          ld      (fdp_pointer),de
 2690+6A32 1A                   ld      a,(de)
 2691+6A33 CD E0 BF             call    PAGE128
 2692+6A36 F1                   pop     af
 2693+6A37 C9                   ret
 2694+6A38
 2695+6A38
 2696+6A38              ; -----------------------------------------------------------------------------
 2697+6A38              ; DIR128_COPY_NAME_TO_DE
 2698+6A38              ; Copy the name returned by get_item_name to fixed RAM.
 2699+6A38              ; IN:  HL = physical source address in directory window
 2700+6A38              ;      BC = 16-bit name length
 2701+6A38              ;      DE = fixed-RAM destination
 2702+6A38              ;      item_name_page = page-table pointer belonging to HL
 2703+6A38              ; OUT: DE points behind copied bytes, BC=0
 2704+6A38              ; The source may cross any #FFFF -> #C000 directory-page boundary.
 2705+6A38              ; -----------------------------------------------------------------------------
 2706+6A38              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
 2707+6A38              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
 2708+6A38              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
 2709+6A38              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
 2710+6A38              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 2711+6A38              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
 2712+6A38              ; --- KONEC DOKUMENTACE CZ ---
 2713+6A38              DIR128_COPY_NAME_TO_DE:
 2714+6A38 D5                   push    de
 2715+6A39 ED 5B 86 6F          ld      de,(item_name_page)
 2716+6A3D CD 2D 6A             call    DIR128_MAP_DE
 2717+6A40 D1                   pop     de
 2718+6A41              .dir128_copy_loop:
 2719+6A41 78                   ld      a,b
 2720+6A42 B1                   or      c
 2721+6A43 C8                   ret     z
 2722+6A44 7E                   ld      a,(hl)
 2723+6A45 12                   ld      (de),a
 2724+6A46 13                   inc     de
 2725+6A47 0B                   dec     bc
 2726+6A48 78                   ld      a,b
 2727+6A49 B1                   or      c
 2728+6A4A C8                   ret     z
 2729+6A4B CD 9E 69             call    DIR128_INC_HL
 2730+6A4E D8                   ret     c                       ;should only happen on malformed item
 2731+6A4F 18 F0                jr      .dir128_copy_loop

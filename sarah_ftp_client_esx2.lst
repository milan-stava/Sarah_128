5993+ 7A7F              ; --- DOKUMENTACE CZ: string_dl ---
5994+ 7A7F              ; Ucel: Vypočítá a případně zapíše jednu desetinnou číslici.
5995+ 7A7F              ; Vstup: HL = zbytek čísla, BC = desítkový řád, DE = cíl; IX = flag1.
5996+ 7A7F              ; Vystup: HL = zbytek po odečtení řádu; DE posunut pouze při zápisu číslice.
5997+ 7A7F              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
5998+ 7A7F              ; Poznamka: Používá a nastavuje bit 7 v (IX+0) pro potlačení úvodních nul.
5999+ 7A7F              ; --- KONEC DOKUMENTACE CZ ---
6000+ 7A7F 3E 2F        string_dl:		ld a,'0'-1
6001+ 7A81
6002+ 7A81 3C           string_lp2:		inc a

 6074+7A01              ;16)
 6075+7A01              ; --- DOKUMENTACE CZ: ConvRStr16 ---
 6076+7A01              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
 6077+7A01              ; Vstup: DE = začátek číslic.
 6078+7A01              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
 6079+7A01              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 6080+7A01              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
 6081+7A01              ;   přetečení; Z nemá pevný význam.
 6082+7A01              ; --- KONEC DOKUMENTACE CZ ---
 6083+7A01              ConvRStr16
 6084+7A01              ;===============================================================
 6085+7A01              ;http://z80-heaven.wikidot.com/math#toc32
 6086+7A01              ;Input:
 6087+7A01              ;     DE points to the base 10 number string in RAM.
 6088+7A01              ;Outputs:
 6089+7A01              ;     HL is the 16-bit value of the number
 6090+7A01              ;     DE points to the byte after the number
 6091+7A01              ;     BC is HL/10
 6092+7A01              ;     z flag reset (nz)
 6093+7A01              ;     c flag reset (nc)
 6094+7A01              ;Destroys:
 6095+7A01              ;     A (actually, add 30h and you get the ending token)
 6096+7A01              ;Size:  23 bytes
 6097+7A01              ;Speed: 104n+42+11c
 6098+7A01              ;       n is the number of digits
 6099+7A01              ;       c is at most n-2
 6100+7A01              ;       at most 595 cycles for any 16-bit decimal value
 6101+7A01              ;===============================================================
 6102+7A01
 6103+7A01 21 00 00          ld hl,0          ;  10 : 210000
 6104+7A04              ConvLoop:             ;
 6105+7A04 1A                ld a,(de)        ;   7 : 1A
 6106+7A05 D6 30             sub 30h          ;   7 : D630
 6107+7A07 FE 0A             cp 10            ;   7 : FE0A
 6108+7A09 D0                ret nc           ;5|11 : D0
 6109+7A0A 13                inc de           ;   6 : 13
 6110+7A0B                                    ;
 6111+7A0B 44                ld b,h           ;   4 : 44
 6112+7A0C 4D                ld c,l           ;   4 : 4D
 6113+7A0D 29                add hl,hl        ;  11 : 29
 6114+7A0E 29                add hl,hl        ;  11 : 29
 6115+7A0F 09                add hl,bc        ;  11 : 09
 6116+7A10 29                add hl,hl        ;  11 : 29
 6117+7A11                                    ;
 6118+7A11 85                add a,l          ;   4 : 85
 6119+7A12 6F                ld l,a           ;   4 : 6F
 6120+7A13 30 EF             jr nc,ConvLoop   ;12|23: 30EE
 6121+7A15 24                inc h            ; --- : 24
 6122+7A16 18 EC             jr ConvLoop      ; --- : 18EB
 6123+7A18
 6124+7A18
 6125+7A18
 6126+7A18              ;17)
 6127+7A18              ;IN=HL=number, OUT=DE=address with the string
 6128+7A18              ; --- DOKUMENTACE CZ: HL2ASCII ---
 6129+7A18              ; Ucel: Zapíše 16bitové číslo jako desetinný text bez úvodních nul.
 6130+7A18              ; Vstup: HL = číslo, DE = cílový buffer; IX = flag1.
 6131+7A18              ; Vystup: DE za poslední číslicí; HL = zbytek jednotek.
 6132+7A18              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 6133+7A18              ; Poznamka: Mění bit 7 v (IX+0); nepřidává nulový terminátor.
 6134+7A18              ; --- KONEC DOKUMENTACE CZ ---
 6135+7A18 DD CB 00 BE  HL2ASCII		res 7,(IX+0)		;Leading zero suppression
 6136+7A1C              ; --- DOKUMENTACE CZ: HL2ASCII_00000 ---
 6137+7A1C              ; Ucel: Vstup do převodu od řádu desetitisíců, resp. stovek.
 6138+7A1C              ; Vstup: HL = číslo, DE = cíl; bit 7 v (IX+0) řídí tisk úvodních nul.

 2825+6A88              ; -----------------------------------------------------------------------------
 2826+6A88              ; search_by_Busy_fast
 2827+6A88              ; Fast case-insensitive substring search for a name fully contained in the
 2828+6A88              ; currently mapped 16K directory page.
 2829+6A88              ;
 2830+6A88              ; IN:  HL = name start, BC = 16-bit name length
 2831+6A88              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
 2832+6A88              ; OUT: Z = found, NZ = not found
 2833+6A88              ;
 2834+6A88              ; This is deliberately close to the original Busy FIND: the inner compare uses
 2835+6A88              ; the Z80 CPI instruction.  The pattern has already been converted to lower
 2836+6A88              ; case once by find_items, so only the source character needs convert here.
 2837+6A88              ;
 2838+6A88              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
 2839+6A88              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
 2840+6A88              ; matches therefore cannot be skipped.
 2841+6A88              ; -----------------------------------------------------------------------------
 2842+6A88              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
 2843+6A88              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
 2844+6A88              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
 2845+6A88              ;   délka.
 2846+6A88              ; Vystup: Z = shoda, NZ = nenalezeno.
 2847+6A88              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 2848+6A88              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
 2849+6A88              ; --- KONEC DOKUMENTACE CZ ---
 2850+6A88              search_by_Busy_fast:
 2851+6A88 EB                   ex      de,hl                   ;DE=current candidate in file name
 2852+6A89
 2853+6A89                      ; candidate_count = name_length - pattern_length + 1
 2854+6A89 60                   ld      h,b
 2855+6A8A 69                   ld      l,c
 2856+6A8B ED 4B 14 79          ld      bc,(txtlen+1)
 2857+6A8F 78                   ld      a,b
 2858+6A90 B1                   or      c
 2859+6A91 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
 2860+6A93 B7                   or      a
 2861+6A94 ED 42                sbc     hl,bc
 2862+6A96 38 25                jr      c,.fast_not_found       ;pattern longer than file name
 2863+6A98 23                   inc     hl
 2864+6A99
 2865+6A99                      ; Keep number of possible candidate starts in alternate BC.
 2866+6A99 E5                   push    hl
 2867+6A9A D9                   exx
 2868+6A9B C1                   pop     bc
 2869+6A9C D9                   exx
 2870+6A9D
 2871+6A9D              .fast_next_candidate:
 2872+6A9D D5                   push    de                      ;remember exact candidate start
 2873+6A9E 21 9F 8F             ld      hl,INPBUFF
 2874+6AA1 ED 4B 14 79          ld      bc,(txtlen+1)
 2875+6AA5
 2876+6AA5              .fast_compare:
 2877+6AA5 1A                   ld      a,(de)
 2878+6AA6 CD 38 79             call    convert                 ;source char -> lower case
 2879+6AA9 ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
 2880+6AAB 13                   inc     de
 2881+6AAC 20 06                jr      nz,.fast_candidate_failed
 2882+6AAE EA A5 6A             jp      pe,.fast_compare        ;matched, more pattern bytes remain
 2883+6AB1
 2884+6AB1 D1                   pop     de                      ;discard saved candidate start
 2885+6AB2              .fast_found:
 2886+6AB2 AF                   xor     a                       ;Z = found
 2887+6AB3 C9                   ret
 2888+6AB4
 2889+6AB4              .fast_candidate_failed:
 2890+6AB4 D1                   pop     de                      ;restore previous candidate start
 2891+6AB5 13                   inc     de                      ;next candidate = previous + 1
 2892+6AB6 D9                   exx
 2893+6AB7 0B                   dec     bc
 2894+6AB8 78                   ld      a,b
 2895+6AB9 B1                   or      c
 2896+6ABA D9                   exx
 2897+6ABB 20 E0                jr      nz,.fast_next_candidate
 2898+6ABD
 2899+6ABD              .fast_not_found:
 2900+6ABD 3E 01                ld      a,1
 2901+6ABF B7                   or      a                       ;NZ = not found
 2902+6AC0 C9                   ret

 3318+6F1C
 3319+6F1C              ; -----------------------------------------------------------------------------
 3320+6F1C              ; search_by_Busy_dir_slow
 3321+6F1C              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
 3322+6F1C              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
 3323+6F1C              ; no longer slows down every ordinary FIND operation.
 3324+6F1C              ;
 3325+6F1C              ; One-character FIND is handled before this fallback and compares only the
 3326+6F1C              ; first character.  This slow path therefore normally handles 2+ character
 3327+6F1C              ; substring searches whose source name crosses a directory-bank boundary.
 3328+6F1C              ; -----------------------------------------------------------------------------
 3329+6F1C              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
 3330+6F1C              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
 3331+6F1C              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
 3332+6F1C              ;   a délka.
 3333+6F1C              ; Vystup: Z = shoda, NZ = nenalezeno.
 3334+6F1C              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 3335+6F1C              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
 3336+6F1C              ; --- KONEC DOKUMENTACE CZ ---
 3337+6F1C              search_by_Busy_dir_slow:
 3338+6F1C 22 26 73             ld      (dir_search_addr),hl
 3339+6F1F ED 43 2A 73          ld      (dir_search_remaining),bc
 3340+6F23 ED 5B 1F 73          ld      de,(item_name_page)
 3341+6F27 ED 53 28 73          ld      (dir_search_page),de
 3342+6F2B 2A 9A 7B             ld      hl,(txtlen+1)
 3343+6F2E 22 2C 73             ld      (dir_search_patlen),hl
 3344+6F31 7C                   ld      a,h
 3345+6F32 B5                   or      l
 3346+6F33 28 56                jr      z,.dir_search_found
 3347+6F35
 3348+6F35              .dir_search_outer:
 3349+6F35                      ;If remaining source length < pattern length, no further match exists.
 3350+6F35 2A 2A 73             ld      hl,(dir_search_remaining)
 3351+6F38 ED 5B 2C 73          ld      de,(dir_search_patlen)
 3352+6F3C B7                   or      a
 3353+6F3D ED 52                sbc     hl,de
 3354+6F3F 38 4C                jr      c,.dir_search_not_found
 3355+6F41
 3356+6F41                      ;Start one comparison at current candidate address/page.
 3357+6F41 2A 26 73             ld      hl,(dir_search_addr)
 3358+6F44 ED 5B 28 73          ld      de,(dir_search_page)
 3359+6F48 CD 8D 6E             call    DIR128_MAP_DE
 3360+6F4B 11 30 91             ld      de,INPBUFF
 3361+6F4E ED 4B 2C 73          ld      bc,(dir_search_patlen)
 3362+6F52
 3363+6F52              .dir_search_cmp:
 3364+6F52 7E                   ld      a,(hl)
 3365+6F53 CD BE 7B             call    convert                 ;source char -> lower case
 3366+6F56 EB                   ex      de,hl
 3367+6F57 BE                   cp      (hl)                    ;pattern already normalized by FIND
 3368+6F58 EB                   ex      de,hl
 3369+6F59 20 0D                jr      nz,.dir_search_advance_candidate
 3370+6F5B
 3371+6F5B 13                   inc     de
 3372+6F5C 0B                   dec     bc
 3373+6F5D 78                   ld      a,b
 3374+6F5E B1                   or      c
 3375+6F5F 28 2A                jr      z,.dir_search_found
 3376+6F61 CD FE 6D             call    DIR128_INC_HL
 3377+6F64 38 27                jr      c,.dir_search_not_found
 3378+6F66 18 EA                jr      .dir_search_cmp
 3379+6F68
 3380+6F68              .dir_search_advance_candidate:
 3381+6F68                      ;Always advance by exactly ONE source character.  This fixes both the
 3382+6F68                      ;old overlapping-match bug and the old one-character special case.
 3383+6F68 2A 26 73             ld      hl,(dir_search_addr)
 3384+6F6B ED 5B 28 73          ld      de,(dir_search_page)
 3385+6F6F CD 8D 6E             call    DIR128_MAP_DE
 3386+6F72 CD FE 6D             call    DIR128_INC_HL
 3387+6F75 38 16                jr      c,.dir_search_not_found
 3388+6F77 22 26 73             ld      (dir_search_addr),hl
 3389+6F7A ED 5B F6 BF          ld      de,(fdp_pointer)
 3390+6F7E ED 53 28 73          ld      (dir_search_page),de
 3391+6F82 2A 2A 73             ld      hl,(dir_search_remaining)
 3392+6F85 2B                   dec     hl
 3393+6F86 22 2A 73             ld      (dir_search_remaining),hl
 3394+6F89 18 AA                jr      .dir_search_outer
 3395+6F8B
 3396+6F8B              .dir_search_found:
 3397+6F8B AF                   xor     a                       ;Z
 3398+6F8C C9                   ret
 3399+6F8D              .dir_search_not_found:
 3400+6F8D 3E 01                ld      a,1
 3401+6F8F B7                   or      a                       ;NZ
 3402+6F90 C9                   ret

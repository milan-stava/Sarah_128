2874+ 6BDD                      ;old overlapping-match bug and the old one-character special case.
2875+ 6BDD 2A 9B 6F             ld      hl,(dir_search_addr)
2876+ 6BE0 ED 5B 9D 6F          ld      de,(dir_search_page)
2877+ 6BE4 CD 02 6B             call    DIR128_MAP_DE
2878+ 6BE7 CD 73 6A             call    DIR128_INC_HL

 3423+6FA9
 3424+6FA9              		;128K: begin every directory transfer on first directory bank (page 0)
 3425+6FA9 CD F0 6D     		call	DIR128_FIRST_PAGE
 3426+6FAC
 3427+6FAC 21 0E 90     		ld	hl,flag_dir

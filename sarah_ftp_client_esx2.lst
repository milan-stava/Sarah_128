 1022+626A              ; --- DOKUMENTACE CZ: find_out_speed ---
 1023+626A              ; Ucel: Zjistí index aktuální rychlosti UART, případně rychlosti vyzkouší.
 1024+626A              ; Vstup: IX = flag1; dostupné služby get_baud/set_baud.
 1025+626A              ; Vystup: D = index zjištěné rychlosti při úspěchu.
 1026+626A              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
 1027+626A              ; Poznamka: Při nepodporovaném get_baud používá switch_speed; jeho neúspěch nepovažujte za
 1028+626A              ;   platnou rychlost.
 1029+626A              ; --- KONEC DOKUMENTACE CZ ---
 1030+626A              find_out_speed
 1031+626A CD 75 A6             call get_baud
 1032+626D 30 06                jr nc,.known
 1033+626F CD 7E 62             call switch_speed
 1034+6272 20 08                jr nz,.failed
 1035+6274 7A                   ld a,d
 1036+6275 FE 18        .known  cp 24
 1037+6277 30 03                jr nc,.failed
 1038+6279 57                   ld d,a
 1039+627A B7                   or a
 1040+627B C9                   ret
 1041+627C 37           .failed scf
 1042+627D C9                   ret
 1043+627E              						;tests speeds <7-0>, then <max-8>
 1044+627E              ;switch_speed	ld	a,7			;start with speeds 7-0 (quicker finds the speed)
 1045+627E              ;		call	sws2
 1046+627E              ;		ret	z			;Z= speed <0,7> found
 1047+627E
 1048+627E              ; --- DOKUMENTACE CZ: switch_speed ---
 1049+627E              ; Ucel: Zkouší rychlosti UART sestupně od maximální až po nulu.
 1050+627E              ; Vstup: (IX+8) = nejvyšší zkoušený index rychlosti.
 1051+627E              ; Vystup: Z = modul odpověděl OK, D = nalezený index; NZ = nenalezeno.
 1052+627E              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
 1053+627E              ; Poznamka: Mění UART a (IX+6), vyprazdňuje příjem.
 1054+627E              ; --- KONEC DOKUMENTACE CZ ---
 1055+627E DD 7E 08     switch_speed	ld	a,(ix+8)		;try out every speed if you find connection UART+Wifi
 1056+6281              						;start with max speed, end with 0
 1057+6281 F5           sws2		push	af
 1058+6282 CD 87 7B     		call	set_print_speed
 1059+6285 38 1B        		jr c,sws_unsupported ;do not report a UART setting rejected by BIOS
 1060+6287
 1061+6287 F1           		pop	af			;we need to inrease timeout for speeds <3
 1062+6288 F5           		push	af
 1063+6289 FE 03        		cp	3
 1064+628B DD 36 06 01  		ld	(ix+6),1		;set timeout for 1 for speeds >3
 1065+628F 30 04        		jr	nc,sws1
 1066+6291 DD 36 06 0A  		ld	(ix+6),#A		;set tieout for #A for speeds <2
 1067+6295
 1068+6295 CD 4F 7B     sws1		call	send_at_check_ok
 1069+6298 D1           		pop	de
 1070+6299 C8           		ret	z			;Z=answer found, D= speed set in HW
 1071+629A 7A           sws_next ld	a,d

 6044+78F7              ;16)
 6045+78F7              ; --- DOKUMENTACE CZ: ConvRStr16 ---
 6046+78F7              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
 6047+78F7              ; Vstup: DE = začátek číslic.
 6048+78F7              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
 6049+78F7              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 6050+78F7              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
 6051+78F7              ;   přetečení; Z nemá pevný význam.
 6052+78F7              ; --- KONEC DOKUMENTACE CZ ---
 6053+78F7              ConvRStr16
 6054+78F7              ;===============================================================
 6055+78F7              ;http://z80-heaven.wikidot.com/math#toc32
 6056+78F7              ;Input:
 6057+78F7              ;     DE points to the base 10 number string in RAM.
 6058+78F7              ;Outputs:
 6059+78F7              ;     HL is the 16-bit value of the number
 6060+78F7              ;     DE points to the byte after the number
 6061+78F7              ;     BC is HL/10
 6062+78F7              ;     z flag reset (nz)
 6063+78F7              ;     c flag reset (nc)
 6064+78F7              ;Destroys:
 6065+78F7              ;     A (actually, add 30h and you get the ending token)
 6066+78F7              ;Size:  23 bytes
 6067+78F7              ;Speed: 104n+42+11c
 6068+78F7              ;       n is the number of digits
 6069+78F7              ;       c is at most n-2
 6070+78F7              ;       at most 595 cycles for any 16-bit decimal value
 6071+78F7              ;===============================================================
 6072+78F7
 6073+78F7 21 00 00          ld hl,0          ;  10 : 210000
 6074+78FA              ConvLoop:             ;
 6075+78FA 1A                ld a,(de)        ;   7 : 1A
 6076+78FB D6 30             sub 30h          ;   7 : D630
 6077+78FD FE 0A             cp 10            ;   7 : FE0A
 6078+78FF D0                ret nc           ;5|11 : D0
 6079+7900 13                inc de           ;   6 : 13
 6080+7901                                    ;
 6081+7901 44                ld b,h           ;   4 : 44
 6082+7902 4D                ld c,l           ;   4 : 4D
 6083+7903 29                add hl,hl        ;  11 : 29
 6084+7904 29                add hl,hl        ;  11 : 29
 6085+7905 09                add hl,bc        ;  11 : 09
 6086+7906 29                add hl,hl        ;  11 : 29
 6087+7907                                    ;
 6088+7907 85                add a,l          ;   4 : 85
 6089+7908 6F                ld l,a           ;   4 : 6F
 6090+7909 30 EF             jr nc,ConvLoop   ;12|23: 30EE
 6091+790B 24                inc h            ; --- : 24
 6092+790C 18 EC             jr ConvLoop      ; --- : 18EB
 6093+790E
 6094+790E

 6072+79C9              ;16)
 6073+79C9              ; --- DOKUMENTACE CZ: ConvRStr16 ---
 6074+79C9              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
 6075+79C9              ; Vstup: DE = začátek číslic.
 6076+79C9              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
 6077+79C9              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 6078+79C9              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
 6079+79C9              ;   přetečení; Z nemá pevný význam.
 6080+79C9              ; --- KONEC DOKUMENTACE CZ ---
 6081+79C9              ConvRStr16
 6082+79C9              ;===============================================================
 6083+79C9              ;http://z80-heaven.wikidot.com/math#toc32
 6084+79C9              ;Input:
 6085+79C9              ;     DE points to the base 10 number string in RAM.
 6086+79C9              ;Outputs:
 6087+79C9              ;     HL is the 16-bit value of the number
 6088+79C9              ;     DE points to the byte after the number
 6089+79C9              ;     BC is HL/10
 6090+79C9              ;     z flag reset (nz)
 6091+79C9              ;     c flag reset (nc)
 6092+79C9              ;Destroys:
 6093+79C9              ;     A (actually, add 30h and you get the ending token)
 6094+79C9              ;Size:  23 bytes
 6095+79C9              ;Speed: 104n+42+11c
 6096+79C9              ;       n is the number of digits
 6097+79C9              ;       c is at most n-2
 6098+79C9              ;       at most 595 cycles for any 16-bit decimal value
 6099+79C9              ;===============================================================
 6100+79C9
 6101+79C9 21 00 00          ld hl,0          ;  10 : 210000
 6102+79CC              ConvLoop:             ;
 6103+79CC 1A                ld a,(de)        ;   7 : 1A
 6104+79CD D6 30             sub 30h          ;   7 : D630
 6105+79CF FE 0A             cp 10            ;   7 : FE0A
 6106+79D1 D0                ret nc           ;5|11 : D0
 6107+79D2 13                inc de           ;   6 : 13
 6108+79D3                                    ;
 6109+79D3 44                ld b,h           ;   4 : 44
 6110+79D4 4D                ld c,l           ;   4 : 4D
 6111+79D5 29                add hl,hl        ;  11 : 29
 6112+79D6 29                add hl,hl        ;  11 : 29
 6113+79D7 09                add hl,bc        ;  11 : 09
 6114+79D8 29                add hl,hl        ;  11 : 29
 6115+79D9                                    ;
 6116+79D9 85                add a,l          ;   4 : 85

4110+ 730F              ; item_add / item_sub - 128K bank-aware directory movement
4111+ 730F              ;
4112+ 730F              ; IN:
4113+ 730F              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
4114+ 730F              ;       DE = address of its 16-bit page-table-pointer companion
4115+ 730F              ;
4116+ 730F              ; Example:
4117+ 730F              ;       ld bc,cur_item_addr
4118+ 730F              ;       ld de,cur_item_addr_page
4119+ 730F              ;       call item_add

 6502+7B52 DD 7E 06             ld a,(ix+6)
 6503+7B55 B7                   or a
 6504+7B56 20 03                jr nz,.attempt
 6505+7B58 DD 34 06             inc (ix+6)
 6506+7B5B CD D7 A1     .attempt call at_probe_drain
 6507+7B5E 38 19                jr c,.failed
 6508+7B60 21 E3 88             ld hl,at
 6509+7B63 CD 72 79             call send_string
 6510+7B66 0E 1C                ld c,28
 6511+7B68 C2 EB 7E             jp nz,error_handler
 6512+7B6B CD E9 A1             call at_probe_ok
 6513+7B6E 28 0C                jr z,.done
 6514+7B70 FE 06                cp AT_BUSY
 6515+7B72 28 0E                jr z,.busy
 6516+7B74 DD 35 06             dec (ix+6)
 6517+7B77 20 E2                jr nz,.attempt
 6518+7B79 3E 01        .failed ld a,1
 6519+7B7B B7                   or a
 6520+7B7C F5           .done   push af
 6521+7B7D CD E0 7C             call wifi_unwait
 6522+7B80 F1                   pop af
 6523+7B81 C9                   ret
 6524+7B82 0E 32        .busy   ld c,50
 6525+7B84 C3 EB 7E             jp error_handler

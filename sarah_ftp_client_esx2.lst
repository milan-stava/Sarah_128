    1+A0F4              ; Shared ESP-AT framing above the unchanged Wi-Fi BIOS.
    2+A0F4              ; Firmware dialect retained: +CIPRECVDATA,<length>:<binary>.
    3+A0F4              ; Events: 1 OK, 2 ERROR, 3 prompt, 4 SEND OK, 5 SEND FAIL,
    4+A0F4              ;         6 busy, 7 active IPD header, 8 receive-data header, 0 other.
    5+A0F4              ; Binary payload is never searched for AT result strings.
    6+A0F4              AT_OK equ 1
    7+A0F4              AT_ERROR equ 2
    8+A0F4              AT_PROMPT equ 3
    9+A0F4              AT_SEND_OK equ 4

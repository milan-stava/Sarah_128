 1069+629E              ; --- DOKUMENTACE CZ: switch_speed ---
 1070+629E              ; Ucel: Zkouší rychlosti UART sestupně od maximální až po nulu.
 1071+629E              ; Vstup: (IX+8) = nejvyšší zkoušený index rychlosti.
 1072+629E              ; Vystup: Z = modul odpověděl OK, D = nalezený index; NZ = nenalezeno.
 1073+629E              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
 1074+629E              ; Poznamka: Mění UART a (IX+6), vyprazdňuje příjem.
 1075+629E              ; --- KONEC DOKUMENTACE CZ ---
 1076+629E DD 7E 08     switch_speed	ld	a,(ix+8)		;try out every speed if you find connection UART+Wifi

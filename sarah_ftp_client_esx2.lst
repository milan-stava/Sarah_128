5934+ 790C              ;16)
5935+ 790C              ; --- DOKUMENTACE CZ: ConvRStr16 ---
5936+ 790C              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
5937+ 790C              ; Vstup: DE = začátek číslic.
5938+ 790C              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
5939+ 790C              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
5940+ 790C              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
5941+ 790C              ;   přetečení; Z nemá pevný význam.
5942+ 790C              ; --- KONEC DOKUMENTACE CZ ---
5943+ 790C              ConvRStr16
5944+ 790C              ;===============================================================
5945+ 790C              ;http://z80-heaven.wikidot.com/math#toc32
5946+ 790C              ;Input:
5947+ 790C              ;     DE points to the base 10 number string in RAM.
5948+ 790C              ;Outputs:
5949+ 790C              ;     HL is the 16-bit value of the number
5950+ 790C              ;     DE points to the byte after the number
5951+ 790C              ;     BC is HL/10
5952+ 790C              ;     z flag reset (nz)
5953+ 790C              ;     c flag reset (nc)
5954+ 790C              ;Destroys:
5955+ 790C              ;     A (actually, add 30h and you get the ending token)
5956+ 790C              ;Size:  23 bytes
5957+ 790C              ;Speed: 104n+42+11c
5958+ 790C              ;       n is the number of digits
5959+ 790C              ;       c is at most n-2
5960+ 790C              ;       at most 595 cycles for any 16-bit decimal value
5961+ 790C              ;===============================================================
5962+ 790C
5963+ 790C 21 00 00          ld hl,0          ;  10 : 210000
5964+ 790F              ConvLoop:             ;
5965+ 790F 1A                ld a,(de)        ;   7 : 1A
5966+ 7910 D6 30             sub 30h          ;   7 : D630
5967+ 7912 FE 0A             cp 10            ;   7 : FE0A
5968+ 7914 D0                ret nc           ;5|11 : D0
5969+ 7915 13                inc de           ;   6 : 13
5970+ 7916                                    ;
5971+ 7916 44                ld b,h           ;   4 : 44
5972+ 7917 4D                ld c,l           ;   4 : 4D
5973+ 7918 29                add hl,hl        ;  11 : 29
5974+ 7919 29                add hl,hl        ;  11 : 29
5975+ 791A 09                add hl,bc        ;  11 : 09
5976+ 791B 29                add hl,hl        ;  11 : 29
5977+ 791C                                    ;
5978+ 791C 85                add a,l          ;   4 : 85
5979+ 791D 6F                ld l,a           ;   4 : 6F
5980+ 791E 30 EF             jr nc,ConvLoop   ;12|23: 30EE
5981+ 7920 24                inc h            ; --- : 24
5982+ 7921 18 EC             jr ConvLoop      ; --- : 18EB
5983+ 7923
5984+ 7923
5985+ 7923

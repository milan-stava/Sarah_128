9746+ 8AB7 08           flag1		db 8		;see start of the code, 2=SSL connection,0=TCP
9747+ 8AB8 00           flag_dir	db 0		;IX+1, flag related to dir
9748+ 8AB9              				;bit 0=dir already read?, 0=no, 1=yes
9749+ 8AB9              				;bit 1=current items in memory, 0=abbreviated, 1=full
9750+ 8AB9              				;bit 2=user wished items in memory, 0=abbreviated, 1=full

 8729+8364 20 11                jr      nz,.file_data
 8730+8366 3A FB A4             ld      a,(at_closed)
 8731+8369 E6 03                and     3
 8732+836B 20 0D                jr      nz,.file_closed ; real closure plus empty buffer, not a Wi-Fi pause
 8733+836D CD 3E 9F             call    ftp_poll_delay
 8734+8370 CD 4F 9E             call    ftp_poll_cancel
 8735+8373 38 0E                jr      c,.file_cancel
 8736+8375 18 E8                jr      .file_wait
 8737+8377              .file_data:
 8738+8377 C3 90 83             jp      dam_available
 8739+837A              .file_closed:
 8740+837A CD 47 9F             call    ftp_query_lengths ; recheck after closure notice: final bytes may be queued
 8741+837D 7C                   ld      a,h
 8742+837E B5                   or      l
 8743+837F 20 F6                jr      nz,.file_data
 8744+8381 AF                   xor     a

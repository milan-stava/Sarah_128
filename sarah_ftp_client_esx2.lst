  278+0000              ;FTP commands of interest:
  279+0000              ;done	USER		username
  280+0000              ;done	PASS		password
  281+0000              ;done	PASV		enter passive mode
  282+0000              ;done	QUIT		quit ftp connection
  283+0000              ;done	STOR		upload file		;max transfer block allowed by ESP modele= 2048 bytes, top speed is 2,53 kb/sec
  284+0000              ;done	RETR		download file
  285+0000              ;done	SIZE		return file size
  286+0000              ;done	ABOR		abort command		;in case we got stuck, ABOR will return us
  287+0000              ;done	APPE		append file		;if uploaded file exist, you may choose to overwrite it or append
  288+0000              ;done	NOOP					;check if ftp connection is alive (ver 0.7.)
  289+0000              ;done	STOU					;new from 0.8 up
  290+0000              ;done	LIST
  291+0000              ;done	NLST
  292+0000              ;done	PWD
  293+0000              ;done	CWD
  294+0000              ;done	CDUP
  295+0000              ;done	DELE
  296+0000              ;done	MKD
  297+0000              ;done	RMD
  298+0000              ;done	RNFR+RNTO

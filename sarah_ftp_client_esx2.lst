6071+ 77E6              ;16)
6072+ 77E6              ; --- DOKUMENTACE CZ: ConvRStr16 ---
6073+ 77E6              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
6074+ 77E6              ; Vstup: DE = začátek číslic.
6075+ 77E6              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
6076+ 77E6              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
6077+ 77E6              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
6078+ 77E6              ;   přetečení; Z nemá pevný význam.
6079+ 77E6              ; --- KONEC DOKUMENTACE CZ ---
6080+ 77E6              ConvRStr16
6081+ 77E6              ;===============================================================
6082+ 77E6              ;http://z80-heaven.wikidot.com/math#toc32
6083+ 77E6              ;Input:
6084+ 77E6              ;     DE points to the base 10 number string in RAM.
6085+ 77E6              ;Outputs:
6086+ 77E6              ;     HL is the 16-bit value of the number
6087+ 77E6              ;     DE points to the byte after the number
6088+ 77E6              ;     BC is HL/10
6089+ 77E6              ;     z flag reset (nz)
6090+ 77E6              ;     c flag reset (nc)
6091+ 77E6              ;Destroys:
6092+ 77E6              ;     A (actually, add 30h and you get the ending token)
6093+ 77E6              ;Size:  23 bytes
6094+ 77E6              ;Speed: 104n+42+11c
6095+ 77E6              ;       n is the number of digits
6096+ 77E6              ;       c is at most n-2
6097+ 77E6              ;       at most 595 cycles for any 16-bit decimal value
6098+ 77E6              ;===============================================================
6099+ 77E6
6100+ 77E6 21 00 00          ld hl,0          ;  10 : 210000
6101+ 77E9              ConvLoop:             ;
6102+ 77E9 1A                ld a,(de)        ;   7 : 1A
6103+ 77EA D6 30             sub 30h          ;   7 : D630
6104+ 77EC FE 0A             cp 10            ;   7 : FE0A
6105+ 77EE D0                ret nc           ;5|11 : D0
6106+ 77EF 13                inc de           ;   6 : 13
6107+ 77F0                                    ;
6108+ 77F0 44                ld b,h           ;   4 : 44
6109+ 77F1 4D                ld c,l           ;   4 : 4D
6110+ 77F2 29                add hl,hl        ;  11 : 29
6111+ 77F3 29                add hl,hl        ;  11 : 29
6112+ 77F4 09                add hl,bc        ;  11 : 09
6113+ 77F5 29                add hl,hl        ;  11 : 29
6114+ 77F6                                    ;
6115+ 77F6 85                add a,l          ;   4 : 85
6116+ 77F7 6F                ld l,a           ;   4 : 6F
6117+ 77F8 30 EF             jr nc,ConvLoop   ;12|23: 30EE
6118+ 77FA 24                inc h            ; --- : 24
6119+ 77FB 18 EC             jr ConvLoop      ; --- : 18EB
6120+ 77FD

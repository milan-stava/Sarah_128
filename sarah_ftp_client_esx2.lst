 9592+87AF ~            ; --- DOKUMENTACE CZ: set_fdma_to_fill_len_in_bc_512 ---
 9593+87AF ~            ; Ucel: Nastaví FDMA pro souvislou výplň 512 bajtů.
 9594+87AF ~            ; Vstup: Bez parametru délky: BC se pouze uchovává.
 9595+87AF ~            ; Vystup: FD_Copy=0, FD_Mod=0, F_Len=512; HL=DE=0, A=0, Z, NC.
 9596+87AF ~            ; Meni: AF, DE, HL; BC, IX a IY zachovány.
 9597+87AF ~            ; Poznamka: Přes historický název a komentář se délka z BC nepoužívá.
 9598+87AF ~            ; --- KONEC DOKUMENTACE CZ ---
 9599+87AF ~            set_fdma_to_fill_len_in_bc_512
 9600+87AF ~            ;IN=BC=length
 9601+87AF ~            	push	bc
 9602+87AF ~            	ld	hl,0
 9603+87AF ~            	ld 	d,h
 9604+87AF ~            	ld	e,h
 9605+87AF ~            	ld	bc,512
 9606+87AF ~
 9607+87AF ~            sftc1	ld	(FDMAreg.FD_Copy),hl	;...a 63 pøeskoè.
 9608+87AF ~            	ld	(FDMAreg.FD_Mod),de
 9609+87AF ~            	ld	(FDMAreg.F_Len),bc
 9610+87AF ~            	pop	bc
 9611+87AF ~            	xor	a			;signal key 0 pressed, because of main keyboard routine
 9612+87AF ~            	ret
 9613+87AF ~
 9614+87AF ~            ;97)
 9615+87AF ~            ; --- DOKUMENTACE CZ: set_hgfx_ink_planar ---
 9616+87AF ~            ; Ucel: Obnoví barvu a bitové roviny pro běžný tisk HGFX.
 9617+87AF ~            ; Vstup: Bez parametrů.
 9618+87AF ~            ; Vystup: VIDEO_REGS.COLOR=4, VIDEO_REGS.MASK=planar_pismo.
 9619+87AF ~            ; Meni: A; F, BC, DE, HL, IX a IY zachovány.
 9620+87AF ~            ; --- KONEC DOKUMENTACE CZ ---
 9621+87AF ~            set_hgfx_ink_planar
 9622+87AF ~            		ld 	a,4			;vrat puvodni
 9623+87AF ~            		ld 	(VIDEO_REGS.COLOR),a
 9624+87AF ~            ;		ld	a,63
 9625+87AF ~            		ld	a,planar_pismo
 9626+87AF ~            		ld	(VIDEO_REGS.MASK),a
 9627+87AF ~            		ret
 9628+87AF ~
 9629+87AF              	ENDIF

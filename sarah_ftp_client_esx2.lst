2867+ 69D8 78                   ld      a,b
2868+ 69D9 B1                   or      c
2869+ 69DA C8                   ret     z
2870+ 69DB 7E                   ld      a,(hl)
2871+ 69DC 12                   ld      (de),a
2872+ 69DD 13                   inc     de
2873+ 69DE 0B                   dec     bc
2874+ 69DF 78                   ld      a,b
2875+ 69E0 B1                   or      c
2876+ 69E1 C8                   ret     z
2877+ 69E2 CD 35 69             call    DIR128_INC_HL
2878+ 69E5 D8                   ret     c                       ;should only happen on malformed item
2879+ 69E6 18 F0                jr      .dir128_copy_loop

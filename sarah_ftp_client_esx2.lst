 7279+7CAD              ;58) sends abort command (in order to abort existing command and get unstuck)
 7280+7CAD              ;send_ftp_command is the main routine that sends command+ string if needed and returns ftp answer code
 7281+7CAD              ;IN=A=0=command only (eg. "ABORT"). A=1=comamnd+prepared string from INPUT (eg. "STOR filename"), A=2=command+new INPUT
 7282+7CAD              ;OUT=A=0=NC=sent ok, awaited ftp code returned correctly
 7283+7CAD              ;A=1=C=c=1=error sending string
 7284+7CAD              ;A=2=C=c=11=error in module answer (expected answer ">" not returned)
 7285+7CAD              ;A=3=C=c=4=sent ok, but return code other than expected
 7286+7CAD              ; --- DOKUMENTACE CZ: send_abort ---
 7287+7CAD              ; Ucel: Odešle FTP příkaz ABOR prostřednictvím send_ftp_command.

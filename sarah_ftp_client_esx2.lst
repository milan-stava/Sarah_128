 9592+87C0 ~            	ld	de,63	;...a 63 preskoc
 9593+87C0 ~            	ld	bc,8	;znak ma 8 bajtu
 9594+87C0 ~            	jr	sftc1
 9595+87C0 ~
 9596+87C0 ~            ;96)
 9597+87C0 ~            ; --- DOKUMENTACE CZ: set_fdma_to_fill_len_in_bc_512 ---
 9598+87C0 ~            ; Ucel: Nastaví FDMA pro souvislou výplň 512 bajtů.
 9599+87C0 ~            ; Vstup: Bez parametru délky: BC se pouze uchovává.
 9600+87C0 ~            ; Vystup: FD_Copy=0, FD_Mod=0, F_Len=512; HL=DE=0, A=0, Z, NC.
 9601+87C0 ~            ; Meni: AF, DE, HL; BC, IX a IY zachovány.
 9602+87C0 ~            ; Poznamka: Přes historický název a komentář se délka z BC nepoužívá.
 9603+87C0 ~            ; --- KONEC DOKUMENTACE CZ ---
 9604+87C0 ~            set_fdma_to_fill_len_in_bc_512
 9605+87C0 ~            ;IN=BC=length
 9606+87C0 ~            	push	bc
 9607+87C0 ~            	ld	hl,0
 9608+87C0 ~            	ld 	d,h
 9609+87C0 ~            	ld	e,h
 9610+87C0 ~            	ld	bc,512
 9611+87C0 ~
 9612+87C0 ~            sftc1	ld	(FDMAreg.FD_Copy),hl	;...a 63 pøeskoè.
 9613+87C0 ~            	ld	(FDMAreg.FD_Mod),de
 9614+87C0 ~            	ld	(FDMAreg.F_Len),bc
 9615+87C0 ~            	pop	bc
 9616+87C0 ~            	xor	a			;signal key 0 pressed, because of main keyboard routine
 9617+87C0 ~            	ret
 9618+87C0 ~
 9619+87C0 ~            ;97)
 9620+87C0 ~            ; --- DOKUMENTACE CZ: set_hgfx_ink_planar ---
 9621+87C0 ~            ; Ucel: Obnoví barvu a bitové roviny pro běžný tisk HGFX.
 9622+87C0 ~            ; Vstup: Bez parametrů.
 9623+87C0 ~            ; Vystup: VIDEO_REGS.COLOR=4, VIDEO_REGS.MASK=planar_pismo.
 9624+87C0 ~            ; Meni: A; F, BC, DE, HL, IX a IY zachovány.
 9625+87C0 ~            ; --- KONEC DOKUMENTACE CZ ---
 9626+87C0 ~            set_hgfx_ink_planar
 9627+87C0 ~            		ld 	a,4			;vrat puvodni
 9628+87C0 ~            		ld 	(VIDEO_REGS.COLOR),a
 9629+87C0 ~            ;		ld	a,63
 9630+87C0 ~            		ld	a,planar_pismo
 9631+87C0 ~            		ld	(VIDEO_REGS.MASK),a
 9632+87C0 ~            		ret
 9633+87C0 ~
 9634+87C0              	ENDIF

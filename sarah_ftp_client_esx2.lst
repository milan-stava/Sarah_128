4256+ 7091              ; --- DOKUMENTACE CZ: item_sub ---
4257+ 7091              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
4258+ 7091              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
4259+ 7091              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
4260+ 7091              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
4261+ 7091              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
4262+ 7091              ; --- KONEC DOKUMENTACE CZ ---
4263+ 7091              item_sub
4264+ 7091 ED 43 A6 6E  		ld	(dir_op_addr_var),bc
4265+ 7095 ED 53 A8 6E  		ld	(dir_op_page_var),de

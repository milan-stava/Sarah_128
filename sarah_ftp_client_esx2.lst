  992+623B              ;zde konci vetev, kdy na pocatku SM2.0 nebylo nalezeno slazeni rychlosti
  993+623B
  994+623B              ;zde jsme ze zacatku rychlost nasli a zkoumame, zda je to ta, kterou chceme, pokud ne, tak ji nastav
  995+623B CD 6A 62     speed_aligned	call	find_out_speed		;output: D= currently aligned speed
  996+623E DA 24 62             jp c,speed_uart_err
  997+6241 CD E8 7C     align_success	call	set_ud_speed
  998+6244
  999+6244              ;ve speed_we_want vyhodnotit, zda je odezva na AT prikaz. Pokud ne, neznamená to, e
 1000+6244              ;rychlosti nebyly slazeny, ale ze nektere z rychlosti 0-23 nekomunikuji s modulem.
 1001+6244 DD 36 06 0A  speed_we_want	ld	(ix+6),#A

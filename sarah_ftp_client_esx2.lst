2936+ 6AF4              ; -----------------------------------------------------------------------------
2937+ 6AF4              ; search_by_Busy_dir_slow
2938+ 6AF4              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
2939+ 6AF4              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
2940+ 6AF4              ; no longer slows down every ordinary FIND operation.
2941+ 6AF4              ;
2942+ 6AF4              ; One-character FIND is handled before this fallback and compares only the
2943+ 6AF4              ; first character.  This slow path therefore normally handles 2+ character
2944+ 6AF4              ; substring searches whose source name crosses a directory-bank boundary.
2945+ 6AF4              ; -----------------------------------------------------------------------------
2946+ 6AF4              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
2947+ 6AF4              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
2948+ 6AF4              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
2949+ 6AF4              ;   a délka.
2950+ 6AF4              ; Vystup: Z = shoda, NZ = nenalezeno.
2951+ 6AF4              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2952+ 6AF4              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
2953+ 6AF4              ; --- KONEC DOKUMENTACE CZ ---
2954+ 6AF4              search_by_Busy_dir_slow:
2955+ 6AF4 22 C9 6F             ld      (dir_search_addr),hl
2956+ 6AF7 ED 43 CD 6F          ld      (dir_search_remaining),bc
2957+ 6AFB ED 5B C2 6F          ld      de,(item_name_page)
2958+ 6AFF ED 53 CB 6F          ld      (dir_search_page),de
2959+ 6B03 2A 57 78             ld      hl,(txtlen+1)
2960+ 6B06 22 CF 6F             ld      (dir_search_patlen),hl
2961+ 6B09 7C                   ld      a,h
2962+ 6B0A B5                   or      l
2963+ 6B0B 28 56                jr      z,.dir_search_found
2964+ 6B0D
2965+ 6B0D              .dir_search_outer:
2966+ 6B0D                      ;If remaining source length < pattern length, no further match exists.
2967+ 6B0D 2A CD 6F             ld      hl,(dir_search_remaining)
2968+ 6B10 ED 5B CF 6F          ld      de,(dir_search_patlen)
2969+ 6B14 B7                   or      a
2970+ 6B15 ED 52                sbc     hl,de
2971+ 6B17 38 4C                jr      c,.dir_search_not_found
2972+ 6B19
2973+ 6B19                      ;Start one comparison at current candidate address/page.
2974+ 6B19 2A C9 6F             ld      hl,(dir_search_addr)
2975+ 6B1C ED 5B CB 6F          ld      de,(dir_search_page)
2976+ 6B20 CD 65 6A             call    DIR128_MAP_DE
2977+ 6B23 11 8C 8E             ld      de,INPBUFF
2978+ 6B26 ED 4B CF 6F          ld      bc,(dir_search_patlen)
2979+ 6B2A
2980+ 6B2A              .dir_search_cmp:
2981+ 6B2A 7E                   ld      a,(hl)
2982+ 6B2B CD 7B 78             call    convert                 ;source char -> lower case
2983+ 6B2E EB                   ex      de,hl
2984+ 6B2F BE                   cp      (hl)                    ;pattern already normalized by FIND
2985+ 6B30 EB                   ex      de,hl
2986+ 6B31 20 0D                jr      nz,.dir_search_advance_candidate
2987+ 6B33
2988+ 6B33 13                   inc     de
2989+ 6B34 0B                   dec     bc
2990+ 6B35 78                   ld      a,b
2991+ 6B36 B1                   or      c
2992+ 6B37 28 2A                jr      z,.dir_search_found
2993+ 6B39 CD D6 69             call    DIR128_INC_HL
2994+ 6B3C 38 27                jr      c,.dir_search_not_found
2995+ 6B3E 18 EA                jr      .dir_search_cmp

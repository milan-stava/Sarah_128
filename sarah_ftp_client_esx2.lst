 9022+84A0 ED 43 C4 6F          ld      (gfn_remaining),bc      ;includes mark/info byte + stored data
 9023+84A4
 9024+84A4                      ;Move from header HIGH to mark/info byte (item+2).
 9025+84A4 CD D6 69             call    DIR128_INC_HL
 9026+84A7 DA 76 85             jp      c,gfn_bad
 9027+84AA
 9028+84AA                      ;Synthetic first item ".." is always page 0:#C000.
 9029+84AA E5                   push    hl

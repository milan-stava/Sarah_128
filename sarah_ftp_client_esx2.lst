4138+ 701F              ; -----------------------------------------------------------------------------
4139+ 701F              ; item_add / item_sub - 128K bank-aware directory movement
4140+ 701F              ;
4141+ 701F              ; IN:
4142+ 701F              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
4143+ 701F              ;       DE = address of its 16-bit page-table-pointer companion
4144+ 701F              ;
4145+ 701F              ; Example:
4146+ 701F              ;       ld bc,cur_item_addr
4147+ 701F              ;       ld de,cur_item_addr_page
4148+ 701F              ;       call item_add
4149+ 701F              ;
4150+ 701F              ; OUT:
4151+ 701F              ;       Z  = cannot move (end/start of directory)
4152+ 701F              ;       NZ = pointer + its bank companion were moved to adjacent item
4153+ 701F              ;
4154+ 701F              ; The address variable and page variable deliberately do NOT have to be adjacent.
4155+ 701F              ; This keeps the original IX+... variable layout completely unchanged.
4156+ 701F              ; The two-byte item length at either end of an item may itself cross a bank.
4157+ 701F              ; -----------------------------------------------------------------------------
4158+ 701F              ; --- DOKUMENTACE CZ: item_add ---
4159+ 701F              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
4160+ 701F              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
4161+ 701F              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
4162+ 701F              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
4163+ 701F              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
4164+ 701F              ; --- KONEC DOKUMENTACE CZ ---
4165+ 701F              item_add
4166+ 701F ED 43 A6 6E  		ld	(dir_op_addr_var),bc
4167+ 7023 ED 53 A8 6E  		ld	(dir_op_page_var),de
4168+ 7027
4169+ 7027              		;Load physical item address from *(BC).
4170+ 7027 60           		ld	h,b
4171+ 7028 69           		ld	l,c
4172+ 7029 5E           		ld	e,(hl)
4173+ 702A 23           		inc	hl
4174+ 702B 56           		ld	d,(hl)
4175+ 702C ED 53 9E 6E  		ld	(next_item_addr),de	;temporary physical start
4176+ 7030 EB           		ex	de,hl			;HL=current physical item start
4177+ 7031
4178+ 7031              		;Load/map directory page from page companion variable.
4179+ 7031 E5           		push	hl
4180+ 7032 2A A8 6E     		ld	hl,(dir_op_page_var)
4181+ 7035 5E           		ld	e,(hl)
4182+ 7036 23           		inc	hl
4183+ 7037 56           		ld	d,(hl)
4184+ 7038 E1           		pop	hl
4185+ 7039 CD C4 69     		call	DIR128_MAP_DE
4186+ 703C
4187+ 703C              		;Read item length LOW/HIGH. Header itself may cross #FFFF/#C000.
4188+ 703C 7E           		ld	a,(hl)
4189+ 703D 5F           		ld	e,a			;E=length LOW
4190+ 703E CD 35 69     		call	DIR128_INC_HL
4191+ 7041 38 4C        		jr	c,item_add_end
4192+ 7043 7E           		ld	a,(hl)
4193+ 7044 57           		ld	d,a			;DE=item length
4194+ 7045 B3           		or	e
4195+ 7046 28 47        		jr	z,item_add_end		;00 00 = real end of directory
4196+ 7048
4197+ 7048              		;We are at item_start+1.
4198+ 7048              		;Next item = item_start + item_length + 4.
4199+ 7048              		;Therefore move 3 fixed bytes, then item_length bytes.
4200+ 7048 3E 03        		ld	a,3

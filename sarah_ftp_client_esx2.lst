 2922+6DDA
 2923+6DDA
 2924+6DDA              ; -----------------------------------------------------------------------------
 2925+6DDA              ; FTP DIRECTORY BANK API
 2926+6DDA              ;
 2927+6DDA              ; fdp_pointer always points to the table byte of the CURRENT directory page.
 2928+6DDA              ; ftp_dir_page has #FF sentinels on both sides:
 2929+6DDA              ;       #FF, 0, 1, 3, 7, #FF
 2930+6DDA              ;
 2931+6DDA              ; HL is always a physical address in the banked window #C000-#FFFF.
 2932+6DDA              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
 2933+6DDA              ;
 2934+6DDA              ; OUT for INC/DEC:
 2935+6DDA              ;       NC = movement succeeded
 2936+6DDA              ;       C  = no next/previous directory page (64 KB boundary)
 2937+6DDA              ;
 2938+6DDA              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
 2939+6DDA              ; which preserves AF/BC/DE/IX/IY exactly.
 2940+6DDA              ; -----------------------------------------------------------------------------
 2941+6DDA
 2942+6DDA              ; --- DOKUMENTACE CZ: DIR128_MAP_CURRENT ---
 2943+6DDA              ; Ucel: Namapuje aktuální banku adresáře do #C000–#FFFF.
 2944+6DDA              ; Vstup: fdp_pointer ukazuje do tabulky ftp_dir_page.
 2945+6DDA              ; Vystup: NC = platná banka, C = sentinel #FF.
 2946+6DDA              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
 2947+6DDA              ; Poznamka: Mění PAGE128_STATE a port #7FFD.
 2948+6DDA              ; --- KONEC DOKUMENTACE CZ ---
 2949+6DDA              DIR128_MAP_CURRENT:
 2950+6DDA E5                   push    hl
 2951+6DDB D5                   push    de
 2952+6DDC ED 5B F6 BF          ld      de,(fdp_pointer)
 2953+6DE0 1A                   ld      a,(de)
 2954+6DE1 FE FF                cp      #FF
 2955+6DE3 28 07                jr      z,DIR128_MAP_BAD
 2956+6DE5 CD E0 BF             call    PAGE128
 2957+6DE8 D1                   pop     de
 2958+6DE9 E1                   pop     hl
 2959+6DEA B7                   or      a                       ;NC = valid page
 2960+6DEB C9                   ret
 2961+6DEC              DIR128_MAP_BAD:
 2962+6DEC D1                   pop     de
 2963+6DED E1                   pop     hl
 2964+6DEE 37                   scf
 2965+6DEF C9                   ret
 2966+6DF0
 2967+6DF0              ;Select first FTP directory page (page 0).
 2968+6DF0              ; --- DOKUMENTACE CZ: DIR128_FIRST_PAGE ---
 2969+6DF0              ; Ucel: Vybere první banku adresáře (RAM 0).
 2970+6DF0              ; Vstup: Bez parametrů.
 2971+6DF0              ; Vystup: fdp_pointer = ftp_dir_page+1; NC.
 2972+6DF0              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
 2973+6DF0              ; Poznamka: Mění mapování RAM a PAGE128_STATE.
 2974+6DF0              ; --- KONEC DOKUMENTACE CZ ---
 2975+6DF0              DIR128_FIRST_PAGE:
 2976+6DF0 E5                   push    hl
 2977+6DF1 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
 2978+6DF4 22 F6 BF             ld      (fdp_pointer),hl
 2979+6DF7 7E                   ld      a,(hl)
 2980+6DF8 CD E0 BF             call    PAGE128
 2981+6DFB E1                   pop     hl
 2982+6DFC B7                   or      a
 2983+6DFD C9                   ret
 2984+6DFE
 2985+6DFE              ;HL++ across #FFFF -> #C000 of the next directory page.
 2986+6DFE              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
 2987+6DFE              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
 2988+6DFE              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
 2989+6DFE              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
 2990+6DFE              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
 2991+6DFE              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
 2992+6DFE              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
 2993+6DFE              ; --- KONEC DOKUMENTACE CZ ---
 2994+6DFE              DIR128_INC_HL:
 2995+6DFE F5                   push    af                      ;old INC HL never changed A - preserve it here too
 2996+6DFF 23                   inc     hl
 2997+6E00 7C                   ld      a,h
 2998+6E01 B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
 2999+6E02 28 03                jr      z,DIR128_INC_CROSS
 3000+6E04 F1                   pop     af
 3001+6E05 B7                   or      a                       ;restore A and return NC = OK
 3002+6E06 C9                   ret
 3003+6E07
 3004+6E07              DIR128_INC_CROSS:
 3005+6E07 D5                   push    de
 3006+6E08 ED 5B F6 BF          ld      de,(fdp_pointer)
 3007+6E0C 13                   inc     de
 3008+6E0D 1A                   ld      a,(de)
 3009+6E0E FE FF                cp      #FF
 3010+6E10 28 0E                jr      z,DIR128_INC_END
 3011+6E12 ED 53 F6 BF          ld      (fdp_pointer),de
 3012+6E16 CD E0 BF             call    PAGE128
 3013+6E19 21 00 C0             ld      hl,ftp_dir_start        ;#C000
 3014+6E1C D1                   pop     de
 3015+6E1D F1                   pop     af                      ;restore caller's A
 3016+6E1E B7                   or      a                       ;NC = OK, A unchanged
 3017+6E1F C9                   ret
 3018+6E20              DIR128_INC_END:
 3019+6E20 1B                   dec     de                      ;keep fdp_pointer on last valid page
 3020+6E21 ED 53 F6 BF          ld      (fdp_pointer),de
 3021+6E25 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
 3022+6E28 D1                   pop     de
 3023+6E29 F1                   pop     af                      ;restore caller's A
 3024+6E2A 37                   scf                             ;C = no following directory page
 3025+6E2B C9                   ret
 3026+6E2C
 3027+6E2C              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
 3028+6E2C              ;Unlike the general helper, this preserves the COMPLETE parser state:
 3029+6E2C              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
 3030+6E2C              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
 3031+6E2C              ;  dir128_parser_status = 0  OK
 3032+6E2C              ;  dir128_parser_status = 1  no next directory page
 3033+6E2C              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
 3034+6E2C              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
 3035+6E2C              ; Vstup: HL = adresa v aktuální bance adresáře.
 3036+6E2C              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
 3037+6E2C              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
 3038+6E2C              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
 3039+6E2C              ; --- KONEC DOKUMENTACE CZ ---
 3040+6E2C              DIR128_INC_HL_PARSER:
 3041+6E2C F5                   push    af
 3042+6E2D D5                   push    de
 3043+6E2E AF                   xor     a
 3044+6E2F 32 7C 8A             ld      (dir128_parser_status),a
 3045+6E32 23                   inc     hl
 3046+6E33 7C                   ld      a,h
 3047+6E34 B7                   or      a
 3048+6E35 20 14                jr      nz,.ok
 3049+6E37 ED 5B F6 BF          ld      de,(fdp_pointer)
 3050+6E3B 13                   inc     de
 3051+6E3C 1A                   ld      a,(de)
 3052+6E3D FE FF                cp      #FF
 3053+6E3F 28 0D                jr      z,.full
 3054+6E41 ED 53 F6 BF          ld      (fdp_pointer),de
 3055+6E45 CD E0 BF             call    PAGE128
 3056+6E48 21 00 C0             ld      hl,ftp_dir_start
 3057+6E4B              .ok:
 3058+6E4B D1                   pop     de
 3059+6E4C F1                   pop     af
 3060+6E4D C9                   ret
 3061+6E4E              .full:
 3062+6E4E 1B                   dec     de
 3063+6E4F ED 53 F6 BF          ld      (fdp_pointer),de
 3064+6E53 21 FF FF             ld      hl,#FFFF
 3065+6E56 3E 01                ld      a,1
 3066+6E58 32 7C 8A             ld      (dir128_parser_status),a
 3067+6E5B D1                   pop     de
 3068+6E5C F1                   pop     af
 3069+6E5D C9                   ret
 3070+6E5E
 3071+6E5E              ;HL-- across #C000 -> #FFFF of the previous directory page.
 3072+6E5E              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
 3073+6E5E              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
 3074+6E5E              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
 3075+6E5E              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
 3076+6E5E              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
 3077+6E5E              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
 3078+6E5E              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
 3079+6E5E              ; --- KONEC DOKUMENTACE CZ ---
 3080+6E5E              DIR128_DEC_HL:
 3081+6E5E F5                   push    af                      ;old DEC HL never changed A - preserve it here too
 3082+6E5F 2B                   dec     hl
 3083+6E60 7C                   ld      a,h
 3084+6E61 FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
 3085+6E63 28 03                jr      z,DIR128_DEC_CROSS
 3086+6E65 F1                   pop     af
 3087+6E66 B7                   or      a                       ;restore A and return NC = OK
 3088+6E67 C9                   ret
 3089+6E68
 3090+6E68              DIR128_DEC_CROSS:
 3091+6E68 D5                   push    de
 3092+6E69 ED 5B F6 BF          ld      de,(fdp_pointer)
 3093+6E6D 1B                   dec     de
 3094+6E6E 1A                   ld      a,(de)
 3095+6E6F FE FF                cp      #FF
 3096+6E71 28 0E                jr      z,DIR128_DEC_START
 3097+6E73 ED 53 F6 BF          ld      (fdp_pointer),de
 3098+6E77 CD E0 BF             call    PAGE128
 3099+6E7A 21 FF FF             ld      hl,#FFFF
 3100+6E7D D1                   pop     de
 3101+6E7E F1                   pop     af                      ;restore caller's A
 3102+6E7F B7                   or      a                       ;NC = OK, A unchanged
 3103+6E80 C9                   ret
 3104+6E81              DIR128_DEC_START:
 3105+6E81 13                   inc     de                      ;keep fdp_pointer on first valid page
 3106+6E82 ED 53 F6 BF          ld      (fdp_pointer),de
 3107+6E86 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
 3108+6E89 D1                   pop     de
 3109+6E8A F1                   pop     af                      ;restore caller's A
 3110+6E8B 37                   scf                             ;C = no previous directory page
 3111+6E8C C9                   ret

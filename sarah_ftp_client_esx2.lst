 6322+7C37              ;16)
 6323+7C37              ; --- DOKUMENTACE CZ: ConvRStr16 ---
 6324+7C37              ; Ucel: Převede posloupnost desetinných číslic na 16bitové číslo.
 6325+7C37              ; Vstup: DE = začátek číslic.
 6326+7C37              ; Vystup: HL = hodnota modulo 65536; DE ukazuje na první nečíselný znak, NC.
 6327+7C37              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 6328+7C37              ; Poznamka: BC drží hodnotu před poslední číslicí; bez číslic zůstává původní. Nekontroluje
 6329+7C37              ;   přetečení; Z nemá pevný význam.
 6330+7C37              ; --- KONEC DOKUMENTACE CZ ---
 6331+7C37              ConvRStr16
 6332+7C37              ;===============================================================
 6333+7C37              ;http://z80-heaven.wikidot.com/math#toc32
 6334+7C37              ;Input:
 6335+7C37              ;     DE points to the base 10 number string in RAM.
 6336+7C37              ;Outputs:
 6337+7C37              ;     HL is the 16-bit value of the number
 6338+7C37              ;     DE points to the byte after the number
 6339+7C37              ;     BC is HL/10
 6340+7C37              ;     z flag reset (nz)
 6341+7C37              ;     c flag reset (nc)
 6342+7C37              ;Destroys:
 6343+7C37              ;     A (actually, add 30h and you get the ending token)
 6344+7C37              ;Size:  23 bytes
 6345+7C37              ;Speed: 104n+42+11c
 6346+7C37              ;       n is the number of digits
 6347+7C37              ;       c is at most n-2
 6348+7C37              ;       at most 595 cycles for any 16-bit decimal value
 6349+7C37              ;===============================================================
 6350+7C37
 6351+7C37 21 00 00          ld hl,0          ;  10 : 210000
 6352+7C3A              ConvLoop:             ;
 6353+7C3A 1A                ld a,(de)        ;   7 : 1A
 6354+7C3B D6 30             sub 30h          ;   7 : D630
 6355+7C3D FE 0A             cp 10            ;   7 : FE0A
 6356+7C3F D0                ret nc           ;5|11 : D0
 6357+7C40 13                inc de           ;   6 : 13
 6358+7C41                                    ;
 6359+7C41 44                ld b,h           ;   4 : 44
 6360+7C42 4D                ld c,l           ;   4 : 4D
 6361+7C43 29                add hl,hl        ;  11 : 29
 6362+7C44 29                add hl,hl        ;  11 : 29
 6363+7C45 09                add hl,bc        ;  11 : 09
 6364+7C46 29                add hl,hl        ;  11 : 29
 6365+7C47                                    ;
 6366+7C47 85                add a,l          ;   4 : 85
 6367+7C48 6F                ld l,a           ;   4 : 6F
 6368+7C49 30 EF             jr nc,ConvLoop   ;12|23: 30EE
 6369+7C4B 24                inc h            ; --- : 24
 6370+7C4C 18 EC             jr ConvLoop      ; --- : 18EB

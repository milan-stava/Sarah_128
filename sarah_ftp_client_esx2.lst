10003+896A              	IFDEF hgfx64x24
10004+896A ~            ;95) set_fdma_to_chars
10005+896A ~            ; --- DOKUMENTACE CZ: set_fdma_to_chars ---
10006+896A ~            ; Ucel: Nastaví FDMA pro vykreslování osmibajtových znaků.
10007+896A ~            ; Vstup: Bez parametrů.
10008+896A ~            ; Vystup: FD_Copy=1, FD_Mod=63, F_Len=8; A=0, Z, NC.
10009+896A ~            ; Meni: AF, DE, HL; BC, IX a IY zachovány.
10010+896A ~            ; --- KONEC DOKUMENTACE CZ ---
10011+896A ~            set_fdma_to_chars
10012+896A ~            	push	bc
10013+896A ~            	ld	hl,1	;1 bajt zkopiruj
10014+896A ~            	ld	de,63	;...a 63 preskoc
10015+896A ~            	ld	bc,8	;znak ma 8 bajtu
10016+896A ~            	jr	sftc1
10017+896A ~
10018+896A ~            ;96)
10019+896A ~            ; --- DOKUMENTACE CZ: set_fdma_to_fill_len_in_bc_512 ---
10020+896A ~            ; Ucel: Nastaví FDMA pro souvislou výplň 512 bajtů.
10021+896A ~            ; Vstup: Bez parametru délky: BC se pouze uchovává.
10022+896A ~            ; Vystup: FD_Copy=0, FD_Mod=0, F_Len=512; HL=DE=0, A=0, Z, NC.
10023+896A ~            ; Meni: AF, DE, HL; BC, IX a IY zachovány.
10024+896A ~            ; Poznamka: Přes historický název a komentář se délka z BC nepoužívá.
10025+896A ~            ; --- KONEC DOKUMENTACE CZ ---
10026+896A ~            set_fdma_to_fill_len_in_bc_512
10027+896A ~            ;IN=BC=length
10028+896A ~            	push	bc
10029+896A ~            	ld	hl,0
10030+896A ~            	ld 	d,h
10031+896A ~            	ld	e,h
10032+896A ~            	ld	bc,512
10033+896A ~
10034+896A ~            sftc1	ld	(FDMAreg.FD_Copy),hl	;...a 63 pøeskoè.
10035+896A ~            	ld	(FDMAreg.FD_Mod),de
10036+896A ~            	ld	(FDMAreg.F_Len),bc
10037+896A ~            	pop	bc
10038+896A ~            	xor	a			;signal key 0 pressed, because of main keyboard routine
10039+896A ~            	ret
10040+896A ~
10041+896A ~            ;97)
10042+896A ~            ; --- DOKUMENTACE CZ: set_hgfx_ink_planar ---
10043+896A ~            ; Ucel: Obnoví barvu a bitové roviny pro běžný tisk HGFX.
10044+896A ~            ; Vstup: Bez parametrů.
10045+896A ~            ; Vystup: VIDEO_REGS.COLOR=4, VIDEO_REGS.MASK=planar_pismo.
10046+896A ~            ; Meni: A; F, BC, DE, HL, IX a IY zachovány.
10047+896A ~            ; --- KONEC DOKUMENTACE CZ ---
10048+896A ~            set_hgfx_ink_planar
10049+896A ~            		ld 	a,4			;vrat puvodni
10050+896A ~            		ld 	(VIDEO_REGS.COLOR),a
10051+896A ~            ;		ld	a,63
10052+896A ~            		ld	a,planar_pismo
10053+896A ~            		ld	(VIDEO_REGS.MASK),a
10054+896A ~            		ret
10055+896A ~
10056+896A              	ENDIF

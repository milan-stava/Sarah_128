 9641+86F4 ~            ; --- DOKUMENTACE CZ: set_fdma_to_fill_len_in_bc_512 ---
 9642+86F4 ~            ; Ucel: Nastaví FDMA pro souvislou výplň 512 bajtů.
 9643+86F4 ~            ; Vstup: Bez parametru délky: BC se pouze uchovává.
 9644+86F4 ~            ; Vystup: FD_Copy=0, FD_Mod=0, F_Len=512; HL=DE=0, A=0, Z, NC.
 9645+86F4 ~            ; Meni: AF, DE, HL; BC, IX a IY zachovány.
 9646+86F4 ~            ; Poznamka: Přes historický název a komentář se délka z BC nepoužívá.
 9647+86F4 ~            ; --- KONEC DOKUMENTACE CZ ---
 9648+86F4 ~            set_fdma_to_fill_len_in_bc_512
 9649+86F4 ~            ;IN=BC=length
 9650+86F4 ~            	push	bc
 9651+86F4 ~            	ld	hl,0
 9652+86F4 ~            	ld 	d,h
 9653+86F4 ~            	ld	e,h
 9654+86F4 ~            	ld	bc,512
 9655+86F4 ~
 9656+86F4 ~            sftc1	ld	(FDMAreg.FD_Copy),hl	;...a 63 pøeskoè.
 9657+86F4 ~            	ld	(FDMAreg.FD_Mod),de
 9658+86F4 ~            	ld	(FDMAreg.F_Len),bc
 9659+86F4 ~            	pop	bc
 9660+86F4 ~            	xor	a			;signal key 0 pressed, because of main keyboard routine
 9661+86F4 ~            	ret
 9662+86F4 ~
 9663+86F4 ~            ;97)
 9664+86F4 ~            ; --- DOKUMENTACE CZ: set_hgfx_ink_planar ---
 9665+86F4 ~            ; Ucel: Obnoví barvu a bitové roviny pro běžný tisk HGFX.
 9666+86F4 ~            ; Vstup: Bez parametrů.
 9667+86F4 ~            ; Vystup: VIDEO_REGS.COLOR=4, VIDEO_REGS.MASK=planar_pismo.
 9668+86F4 ~            ; Meni: A; F, BC, DE, HL, IX a IY zachovány.
 9669+86F4 ~            ; --- KONEC DOKUMENTACE CZ ---
 9670+86F4 ~            set_hgfx_ink_planar
 9671+86F4 ~            		ld 	a,4			;vrat puvodni
 9672+86F4 ~            		ld 	(VIDEO_REGS.COLOR),a
 9673+86F4 ~            ;		ld	a,63
 9674+86F4 ~            		ld	a,planar_pismo
 9675+86F4 ~            		ld	(VIDEO_REGS.MASK),a
 9676+86F4 ~            		ret
 9677+86F4 ~
 9678+86F4              	ENDIF

2760+ 6B11              ; -----------------------------------------------------------------------------
2761+ 6B11              ; search_by_Busy_fast
2762+ 6B11              ; Fast case-insensitive substring search for a name fully contained in the
2763+ 6B11              ; currently mapped 16K directory page.
2764+ 6B11              ;
2765+ 6B11              ; IN:  HL = name start, BC = 16-bit name length
2766+ 6B11              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
2767+ 6B11              ; OUT: Z = found, NZ = not found
2768+ 6B11              ;
2769+ 6B11              ; This is deliberately close to the original Busy FIND: the inner compare uses
2770+ 6B11              ; the Z80 CPI instruction.  The pattern has already been converted to lower
2771+ 6B11              ; case once by find_items, so only the source character needs convert here.
2772+ 6B11              ;
2773+ 6B11              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
2774+ 6B11              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
2775+ 6B11              ; matches therefore cannot be skipped.
2776+ 6B11              ; -----------------------------------------------------------------------------
2777+ 6B11              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
2778+ 6B11              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
2779+ 6B11              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
2780+ 6B11              ;   délka.
2781+ 6B11              ; Vystup: Z = shoda, NZ = nenalezeno.
2782+ 6B11              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2783+ 6B11              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
2784+ 6B11              ; --- KONEC DOKUMENTACE CZ ---
2785+ 6B11              search_by_Busy_fast:
2786+ 6B11 EB                   ex      de,hl                   ;DE=current candidate in file name
2787+ 6B12
2788+ 6B12                      ; candidate_count = name_length - pattern_length + 1
2789+ 6B12 60                   ld      h,b
2790+ 6B13 69                   ld      l,c
2791+ 6B14 ED 4B 46 79          ld      bc,(txtlen+1)
2792+ 6B18 78                   ld      a,b
2793+ 6B19 B1                   or      c
2794+ 6B1A 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
2795+ 6B1C B7                   or      a
2796+ 6B1D ED 42                sbc     hl,bc
2797+ 6B1F 38 25                jr      c,.fast_not_found       ;pattern longer than file name
2798+ 6B21 23                   inc     hl
2799+ 6B22
2800+ 6B22                      ; Keep number of possible candidate starts in alternate BC.
2801+ 6B22 E5                   push    hl
2802+ 6B23 D9                   exx
2803+ 6B24 C1                   pop     bc
2804+ 6B25 D9                   exx
2805+ 6B26
2806+ 6B26              .fast_next_candidate:
2807+ 6B26 D5                   push    de                      ;remember exact candidate start
2808+ 6B27 21 9C 8E             ld      hl,INPBUFF
2809+ 6B2A ED 4B 46 79          ld      bc,(txtlen+1)
2810+ 6B2E
2811+ 6B2E              .fast_compare:
2812+ 6B2E 1A                   ld      a,(de)
2813+ 6B2F CD 6A 79             call    convert                 ;source char -> lower case
2814+ 6B32 ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
2815+ 6B34 13                   inc     de
2816+ 6B35 20 06                jr      nz,.fast_candidate_failed
2817+ 6B37 EA 2E 6B             jp      pe,.fast_compare        ;matched, more pattern bytes remain
2818+ 6B3A
2819+ 6B3A D1                   pop     de                      ;discard saved candidate start
2820+ 6B3B              .fast_found:
2821+ 6B3B AF                   xor     a                       ;Z = found
2822+ 6B3C C9                   ret
2823+ 6B3D
2824+ 6B3D              .fast_candidate_failed:
2825+ 6B3D D1                   pop     de                      ;restore previous candidate start
2826+ 6B3E 13                   inc     de                      ;next candidate = previous + 1
2827+ 6B3F D9                   exx
2828+ 6B40 0B                   dec     bc
2829+ 6B41 78                   ld      a,b
2830+ 6B42 B1                   or      c
2831+ 6B43 D9                   exx
2832+ 6B44 20 E0                jr      nz,.fast_next_candidate
2833+ 6B46
2834+ 6B46              .fast_not_found:
2835+ 6B46 3E 01                ld      a,1
2836+ 6B48 B7                   or      a                       ;NZ = not found
2837+ 6B49 C9                   ret

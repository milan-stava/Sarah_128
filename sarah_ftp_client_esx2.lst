 2783+6A73              .dir_search_len_ge2:
 2784+6A73                      ; Is the LAST byte of the name still inside the same physical window?
 2785+6A73                      ; last = HL + BC - 1
 2786+6A73                      ; Carry means that the name crosses #FFFF -> #C000, therefore use the
 2787+6A73                      ; fully bank-safe (but slower) routine below.

2586+ 6AAC ED 5B F6 BF          ld      de,(fdp_pointer)
2587+ 6AB0 13                   inc     de
2588+ 6AB1 1A                   ld      a,(de)
2589+ 6AB2 FE FF                cp      #FF
2590+ 6AB4 28 0D                jr      z,.full
2591+ 6AB6 ED 53 F6 BF          ld      (fdp_pointer),de
2592+ 6ABA CD E0 BF             call    PAGE128
2593+ 6ABD 21 00 C0             ld      hl,ftp_dir_start
2594+ 6AC0              .ok:
2595+ 6AC0 D1                   pop     de
2596+ 6AC1 F1                   pop     af
2597+ 6AC2 C9                   ret
2598+ 6AC3              .full:
2599+ 6AC3 1B                   dec     de
2600+ 6AC4 ED 53 F6 BF          ld      (fdp_pointer),de
2601+ 6AC8 21 FF FF             ld      hl,#FFFF
2602+ 6ACB 3E 01                ld      a,1
2603+ 6ACD 32 9F 87             ld      (dir128_parser_status),a
2604+ 6AD0 D1                   pop     de
2605+ 6AD1 F1                   pop     af
2606+ 6AD2 C9                   ret
2607+ 6AD3
2608+ 6AD3              ;HL-- across #C000 -> #FFFF of the previous directory page.
2609+ 6AD3              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
2610+ 6AD3              DIR128_DEC_HL:
2611+ 6AD3 F5                   push    af                      ;old DEC HL never changed A - preserve it here too
2612+ 6AD4 2B                   dec     hl
2613+ 6AD5 7C                   ld      a,h
2614+ 6AD6 FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
2615+ 6AD8 28 03                jr      z,DIR128_DEC_CROSS
2616+ 6ADA F1                   pop     af
2617+ 6ADB B7                   or      a                       ;restore A and return NC = OK
2618+ 6ADC C9                   ret
2619+ 6ADD
2620+ 6ADD              DIR128_DEC_CROSS:
2621+ 6ADD D5                   push    de
2622+ 6ADE ED 5B F6 BF          ld      de,(fdp_pointer)
2623+ 6AE2 1B                   dec     de
2624+ 6AE3 1A                   ld      a,(de)
2625+ 6AE4 FE FF                cp      #FF
2626+ 6AE6 28 0E                jr      z,DIR128_DEC_START
2627+ 6AE8 ED 53 F6 BF          ld      (fdp_pointer),de
2628+ 6AEC CD E0 BF             call    PAGE128
2629+ 6AEF 21 FF FF             ld      hl,#FFFF
2630+ 6AF2 D1                   pop     de
2631+ 6AF3 F1                   pop     af                      ;restore caller's A
2632+ 6AF4 B7                   or      a                       ;NC = OK, A unchanged
2633+ 6AF5 C9                   ret
2634+ 6AF6              DIR128_DEC_START:
2635+ 6AF6 13                   inc     de                      ;keep fdp_pointer on first valid page
2636+ 6AF7 ED 53 F6 BF          ld      (fdp_pointer),de
2637+ 6AFB 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
2638+ 6AFE D1                   pop     de
2639+ 6AFF F1                   pop     af                      ;restore caller's A
2640+ 6B00 37                   scf                             ;C = no previous directory page
2641+ 6B01 C9                   ret
2642+ 6B02
2643+ 6B02              ;Map page-table pointer stored in DE. HL is preserved.
2644+ 6B02              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
2645+ 6B02              DIR128_MAP_DE:
2646+ 6B02 F5                   push    af
2647+ 6B03 ED 53 F6 BF          ld      (fdp_pointer),de
2648+ 6B07 1A                   ld      a,(de)
2649+ 6B08 CD E0 BF             call    PAGE128
2650+ 6B0B F1                   pop     af
2651+ 6B0C C9                   ret

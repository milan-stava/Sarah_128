 9958+8923              ; Vstup: Aktivní FTP spojení; IX = flag1.
 9959+8923              ; Vystup: Návrat při očekávaném kódu 200; chyba přes error_handler.
 9960+8923              ; Meni: AF, BC, DE, HL, BC' (přes příjem odpovědi); další registry externích služeb viz jejich
 9961+8923              ;   rozhraní.
 9962+8923              ; Poznamka: Přepisuje INPBUFF parametrem A nebo I.
 9963+8923              ; --- KONEC DOKUMENTACE CZ ---
 9964+8923              send_type_command_i
 9965+8923 3E 49        		ld	a,"I"
 9966+8925 CD 3D 82     stc1		call	clear_inp_buf
 9967+8928 32 30 91     		ld	(INPBUFF),a
 9968+892B 3E 01        		ld	a,1
 9969+892D 11 C8 00     		ld	de,200			;200 Switching to mode ASCII
 9970+8930 21 B4 8B     		ld	hl,ftp_type
 9971+8933 CD CF 7F     		call	send_ftp_command
 9972+8936 D0           		ret	nc
 9973+8937 0E 26        		ld	c,38
 9974+8939 C3 29 81     		jp	error_handler
 9975+893C
 9976+893C              ;94)
 9977+893C              ; --- DOKUMENTACE CZ: print_whole_screen ---
 9978+893C              ; Ucel: Překreslí obrazovku včetně menu, nastavení a nadpisu/cesty.
 9979+893C              ; Vstup: IX = flag1; bit 0 v (IX+1) určuje dostupnost adresáře.
 9980+893C              ; Vystup: Obnovené zobrazení; při dostupném adresáři vyžádá cestu pomocí PWD.
 9981+893C              ; Meni: AF, BC, DE, HL, BC'; další změny dle volaných BIOS/DOS a tiskových služeb.
 9982+893C              ; --- KONEC DOKUMENTACE CZ ---
 9983+893C              print_whole_screen
 9984+893C CD 23 7E     		call	cls_4000
 9985+893F
 9986+893F 11 C8 8C     		ld	de,menu1
 9987+8942 21 00 13     		ld	hl,txt_adr_menu1
 9988+8945 CD E8 92     		call	PRINTHL			;print menu line 1
 9989+8948 11 09 8D     		ld	de,menu2
 9990+894B 21 00 14     		ld	hl,txt_adr_menu2
 9991+894E CD E8 92     		call	PRINTHL			;print menu line 2
 9992+8951
 9993+8951 CD 97 79     		call	prn_w_onoff		;print if WIFI should be ON/OFF on quit
 9994+8954 CD B1 79     		call	prn_alogin		;print autologin status
 9995+8957 CD BB 7A     		call	prn_lst_nlst_abbr_ful	;print line 16 with LIST/NLST/full/abbr status
 9996+895A CD EE 79     		call	prn_file_start		;print line 17 with filename and start address
 9997+895D CD 57 7A     		call	prn_host_usr_psw	;print line 18 with host, user, password

4209+ 7053 B3           		or	e
4210+ 7054 28 08        		jr	z,item_add_at_next
4211+ 7056 CD 35 69     		call	DIR128_INC_HL
4212+ 7059 38 34        		jr	c,item_add_end
4213+ 705B 1B           		dec	de
4214+ 705C 18 F4        		jr	item_add_lenloop
4215+ 705E
4216+ 705E              item_add_at_next
4217+ 705E              		;Save exact candidate next-item position and its bank before peeking
4218+ 705E              		;at its 00 00 / length header.
4219+ 705E 22 9E 6E     		ld	(next_item_addr),hl
4220+ 7061 ED 5B F6 BF  		ld	de,(fdp_pointer)

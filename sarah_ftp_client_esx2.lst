 2849+6AB2              ; -----------------------------------------------------------------------------
 2850+6AB2              ; search_by_Busy_fast
 2851+6AB2              ; Fast case-insensitive substring search for a name fully contained in the
 2852+6AB2              ; currently mapped 16K directory page.
 2853+6AB2              ;
 2854+6AB2              ; IN:  HL = name start, BC = 16-bit name length
 2855+6AB2              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
 2856+6AB2              ; OUT: Z = found, NZ = not found
 2857+6AB2              ;
 2858+6AB2              ; This is deliberately close to the original Busy FIND: the inner compare uses
 2859+6AB2              ; the Z80 CPI instruction.  The pattern has already been converted to lower
 2860+6AB2              ; case once by find_items, so only the source character needs convert here.
 2861+6AB2              ;
 2862+6AB2              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
 2863+6AB2              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
 2864+6AB2              ; matches therefore cannot be skipped.
 2865+6AB2              ; -----------------------------------------------------------------------------
 2866+6AB2              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
 2867+6AB2              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
 2868+6AB2              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
 2869+6AB2              ;   délka.
 2870+6AB2              ; Vystup: Z = shoda, NZ = nenalezeno.
 2871+6AB2              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 2872+6AB2              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
 2873+6AB2              ; --- KONEC DOKUMENTACE CZ ---
 2874+6AB2              search_by_Busy_fast:
 2875+6AB2 EB                   ex      de,hl                   ;DE=current candidate in file name
 2876+6AB3
 2877+6AB3                      ; candidate_count = name_length - pattern_length + 1
 2878+6AB3 60                   ld      h,b
 2879+6AB4 69                   ld      l,c
 2880+6AB5 ED 4B 43 79          ld      bc,(txtlen+1)
 2881+6AB9 78                   ld      a,b
 2882+6ABA B1                   or      c
 2883+6ABB 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
 2884+6ABD B7                   or      a
 2885+6ABE ED 42                sbc     hl,bc
 2886+6AC0 38 25                jr      c,.fast_not_found       ;pattern longer than file name
 2887+6AC2 23                   inc     hl
 2888+6AC3
 2889+6AC3                      ; Keep number of possible candidate starts in alternate BC.
 2890+6AC3 E5                   push    hl
 2891+6AC4 D9                   exx
 2892+6AC5 C1                   pop     bc
 2893+6AC6 D9                   exx
 2894+6AC7
 2895+6AC7              .fast_next_candidate:
 2896+6AC7 D5                   push    de                      ;remember exact candidate start
 2897+6AC8 21 70 8F             ld      hl,INPBUFF
 2898+6ACB ED 4B 43 79          ld      bc,(txtlen+1)
 2899+6ACF
 2900+6ACF              .fast_compare:
 2901+6ACF 1A                   ld      a,(de)
 2902+6AD0 CD 67 79             call    convert                 ;source char -> lower case
 2903+6AD3 ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
 2904+6AD5 13                   inc     de
 2905+6AD6 20 06                jr      nz,.fast_candidate_failed
 2906+6AD8 EA CF 6A             jp      pe,.fast_compare        ;matched, more pattern bytes remain
 2907+6ADB
 2908+6ADB D1                   pop     de                      ;discard saved candidate start
 2909+6ADC              .fast_found:
 2910+6ADC AF                   xor     a                       ;Z = found
 2911+6ADD C9                   ret
 2912+6ADE
 2913+6ADE              .fast_candidate_failed:
 2914+6ADE D1                   pop     de                      ;restore previous candidate start
 2915+6ADF 13                   inc     de                      ;next candidate = previous + 1
 2916+6AE0 D9                   exx
 2917+6AE1 0B                   dec     bc
 2918+6AE2 78                   ld      a,b
 2919+6AE3 B1                   or      c
 2920+6AE4 D9                   exx
 2921+6AE5 20 E0                jr      nz,.fast_next_candidate
 2922+6AE7
 2923+6AE7              .fast_not_found:
 2924+6AE7 3E 01                ld      a,1
 2925+6AE9 B7                   or      a                       ;NZ = not found
 2926+6AEA C9                   ret

 2534+69A9              ; -----------------------------------------------------------------------------
 2535+69A9              ; FTP DIRECTORY BANK API
 2536+69A9              ;
 2537+69A9              ; fdp_pointer always points to the table byte of the CURRENT directory page.
 2538+69A9              ; ftp_dir_page has #FF sentinels on both sides:
 2539+69A9              ;       #FF, 0, 1, 3, 7, #FF
 2540+69A9              ;
 2541+69A9              ; HL is always a physical address in the banked window #C000-#FFFF.
 2542+69A9              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
 2543+69A9              ;
 2544+69A9              ; OUT for INC/DEC:
 2545+69A9              ;       NC = movement succeeded
 2546+69A9              ;       C  = no next/previous directory page (64 KB boundary)
 2547+69A9              ;
 2548+69A9              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
 2549+69A9              ; which preserves AF/BC/DE/IX/IY exactly.
 2550+69A9              ; -----------------------------------------------------------------------------
 2551+69A9
 2552+69A9              ; --- DOKUMENTACE CZ: DIR128_MAP_CURRENT ---
 2553+69A9              ; Ucel: Namapuje aktuální banku adresáře do #C000–#FFFF.
 2554+69A9              ; Vstup: fdp_pointer ukazuje do tabulky ftp_dir_page.
 2555+69A9              ; Vystup: NC = platná banka, C = sentinel #FF.
 2556+69A9              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
 2557+69A9              ; Poznamka: Mění PAGE128_STATE a port #7FFD.
 2558+69A9              ; --- KONEC DOKUMENTACE CZ ---
 2559+69A9              DIR128_MAP_CURRENT:
 2560+69A9 E5                   push    hl
 2561+69AA D5                   push    de
 2562+69AB ED 5B F6 BF          ld      de,(fdp_pointer)
 2563+69AF 1A                   ld      a,(de)
 2564+69B0 FE FF                cp      #FF
 2565+69B2 28 07                jr      z,DIR128_MAP_BAD
 2566+69B4 CD E0 BF             call    PAGE128
 2567+69B7 D1                   pop     de
 2568+69B8 E1                   pop     hl
 2569+69B9 B7                   or      a                       ;NC = valid page
 2570+69BA C9                   ret
 2571+69BB              DIR128_MAP_BAD:
 2572+69BB D1                   pop     de
 2573+69BC E1                   pop     hl
 2574+69BD 37                   scf
 2575+69BE C9                   ret
 2576+69BF
 2577+69BF              ;Select first FTP directory page (page 0).
 2578+69BF              ; --- DOKUMENTACE CZ: DIR128_FIRST_PAGE ---
 2579+69BF              ; Ucel: Vybere první banku adresáře (RAM 0).
 2580+69BF              ; Vstup: Bez parametrů.
 2581+69BF              ; Vystup: fdp_pointer = ftp_dir_page+1; NC.
 2582+69BF              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
 2583+69BF              ; Poznamka: Mění mapování RAM a PAGE128_STATE.
 2584+69BF              ; --- KONEC DOKUMENTACE CZ ---
 2585+69BF              DIR128_FIRST_PAGE:
 2586+69BF E5                   push    hl
 2587+69C0 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
 2588+69C3 22 F6 BF             ld      (fdp_pointer),hl
 2589+69C6 7E                   ld      a,(hl)
 2590+69C7 CD E0 BF             call    PAGE128
 2591+69CA E1                   pop     hl
 2592+69CB B7                   or      a
 2593+69CC C9                   ret
 2594+69CD
 2595+69CD              ;HL++ across #FFFF -> #C000 of the next directory page.
 2596+69CD              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
 2597+69CD              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
 2598+69CD              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
 2599+69CD              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
 2600+69CD              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
 2601+69CD              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
 2602+69CD              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
 2603+69CD              ; --- KONEC DOKUMENTACE CZ ---
 2604+69CD              DIR128_INC_HL:
 2605+69CD F5                   push    af                      ;old INC HL never changed A - preserve it here too
 2606+69CE 23                   inc     hl
 2607+69CF 7C                   ld      a,h
 2608+69D0 B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
 2609+69D1 28 03                jr      z,DIR128_INC_CROSS
 2610+69D3 F1                   pop     af
 2611+69D4 B7                   or      a                       ;restore A and return NC = OK
 2612+69D5 C9                   ret
 2613+69D6
 2614+69D6              DIR128_INC_CROSS:
 2615+69D6 D5                   push    de
 2616+69D7 ED 5B F6 BF          ld      de,(fdp_pointer)
 2617+69DB 13                   inc     de
 2618+69DC 1A                   ld      a,(de)
 2619+69DD FE FF                cp      #FF
 2620+69DF 28 0E                jr      z,DIR128_INC_END
 2621+69E1 ED 53 F6 BF          ld      (fdp_pointer),de
 2622+69E5 CD E0 BF             call    PAGE128
 2623+69E8 21 00 C0             ld      hl,ftp_dir_start        ;#C000
 2624+69EB D1                   pop     de
 2625+69EC F1                   pop     af                      ;restore caller's A
 2626+69ED B7                   or      a                       ;NC = OK, A unchanged
 2627+69EE C9                   ret
 2628+69EF              DIR128_INC_END:
 2629+69EF 1B                   dec     de                      ;keep fdp_pointer on last valid page
 2630+69F0 ED 53 F6 BF          ld      (fdp_pointer),de
 2631+69F4 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
 2632+69F7 D1                   pop     de
 2633+69F8 F1                   pop     af                      ;restore caller's A
 2634+69F9 37                   scf                             ;C = no following directory page
 2635+69FA C9                   ret
 2636+69FB
 2637+69FB              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
 2638+69FB              ;Unlike the general helper, this preserves the COMPLETE parser state:
 2639+69FB              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
 2640+69FB              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
 2641+69FB              ;  dir128_parser_status = 0  OK
 2642+69FB              ;  dir128_parser_status = 1  no next directory page
 2643+69FB              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
 2644+69FB              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
 2645+69FB              ; Vstup: HL = adresa v aktuální bance adresáře.
 2646+69FB              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
 2647+69FB              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
 2648+69FB              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
 2649+69FB              ; --- KONEC DOKUMENTACE CZ ---
 2650+69FB              DIR128_INC_HL_PARSER:
 2651+69FB F5                   push    af
 2652+69FC D5                   push    de
 2653+69FD AF                   xor     a
 2654+69FE 32 CB 88             ld      (dir128_parser_status),a
 2655+6A01 23                   inc     hl
 2656+6A02 7C                   ld      a,h
 2657+6A03 B7                   or      a
 2658+6A04 20 14                jr      nz,.ok
 2659+6A06 ED 5B F6 BF          ld      de,(fdp_pointer)
 2660+6A0A 13                   inc     de
 2661+6A0B 1A                   ld      a,(de)
 2662+6A0C FE FF                cp      #FF
 2663+6A0E 28 0D                jr      z,.full
 2664+6A10 ED 53 F6 BF          ld      (fdp_pointer),de
 2665+6A14 CD E0 BF             call    PAGE128
 2666+6A17 21 00 C0             ld      hl,ftp_dir_start
 2667+6A1A              .ok:
 2668+6A1A D1                   pop     de
 2669+6A1B F1                   pop     af
 2670+6A1C C9                   ret
 2671+6A1D              .full:
 2672+6A1D 1B                   dec     de
 2673+6A1E ED 53 F6 BF          ld      (fdp_pointer),de
 2674+6A22 21 FF FF             ld      hl,#FFFF
 2675+6A25 3E 01                ld      a,1
 2676+6A27 32 CB 88             ld      (dir128_parser_status),a
 2677+6A2A D1                   pop     de
 2678+6A2B F1                   pop     af
 2679+6A2C C9                   ret
 2680+6A2D
 2681+6A2D              ;HL-- across #C000 -> #FFFF of the previous directory page.
 2682+6A2D              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
 2683+6A2D              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
 2684+6A2D              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
 2685+6A2D              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
 2686+6A2D              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
 2687+6A2D              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
 2688+6A2D              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
 2689+6A2D              ; --- KONEC DOKUMENTACE CZ ---
 2690+6A2D              DIR128_DEC_HL:
 2691+6A2D F5                   push    af                      ;old DEC HL never changed A - preserve it here too
 2692+6A2E 2B                   dec     hl
 2693+6A2F 7C                   ld      a,h
 2694+6A30 FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
 2695+6A32 28 03                jr      z,DIR128_DEC_CROSS
 2696+6A34 F1                   pop     af
 2697+6A35 B7                   or      a                       ;restore A and return NC = OK
 2698+6A36 C9                   ret
 2699+6A37
 2700+6A37              DIR128_DEC_CROSS:
 2701+6A37 D5                   push    de
 2702+6A38 ED 5B F6 BF          ld      de,(fdp_pointer)
 2703+6A3C 1B                   dec     de
 2704+6A3D 1A                   ld      a,(de)
 2705+6A3E FE FF                cp      #FF
 2706+6A40 28 0E                jr      z,DIR128_DEC_START
 2707+6A42 ED 53 F6 BF          ld      (fdp_pointer),de
 2708+6A46 CD E0 BF             call    PAGE128
 2709+6A49 21 FF FF             ld      hl,#FFFF
 2710+6A4C D1                   pop     de
 2711+6A4D F1                   pop     af                      ;restore caller's A
 2712+6A4E B7                   or      a                       ;NC = OK, A unchanged
 2713+6A4F C9                   ret
 2714+6A50              DIR128_DEC_START:
 2715+6A50 13                   inc     de                      ;keep fdp_pointer on first valid page
 2716+6A51 ED 53 F6 BF          ld      (fdp_pointer),de
 2717+6A55 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
 2718+6A58 D1                   pop     de
 2719+6A59 F1                   pop     af                      ;restore caller's A
 2720+6A5A 37                   scf                             ;C = no previous directory page
 2721+6A5B C9                   ret
 2722+6A5C
 2723+6A5C              ;Map page-table pointer stored in DE. HL is preserved.
 2724+6A5C              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
 2725+6A5C              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
 2726+6A5C              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
 2727+6A5C              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
 2728+6A5C              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
 2729+6A5C              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
 2730+6A5C              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
 2731+6A5C              ; --- KONEC DOKUMENTACE CZ ---
 2732+6A5C              DIR128_MAP_DE:
 2733+6A5C F5                   push    af
 2734+6A5D ED 53 F6 BF          ld      (fdp_pointer),de
 2735+6A61 1A                   ld      a,(de)
 2736+6A62 CD E0 BF             call    PAGE128
 2737+6A65 F1                   pop     af
 2738+6A66 C9                   ret
 2739+6A67
 2740+6A67
 2741+6A67              ; -----------------------------------------------------------------------------
 2742+6A67              ; DIR128_COPY_NAME_TO_DE
 2743+6A67              ; Copy the name returned by get_item_name to fixed RAM.
 2744+6A67              ; IN:  HL = physical source address in directory window
 2745+6A67              ;      BC = 16-bit name length
 2746+6A67              ;      DE = fixed-RAM destination
 2747+6A67              ;      item_name_page = page-table pointer belonging to HL
 2748+6A67              ; OUT: DE points behind copied bytes, BC=0
 2749+6A67              ; The source may cross any #FFFF -> #C000 directory-page boundary.
 2750+6A67              ; -----------------------------------------------------------------------------
 2751+6A67              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
 2752+6A67              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
 2753+6A67              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
 2754+6A67              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
 2755+6A67              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 2756+6A67              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
 2757+6A67              ; --- KONEC DOKUMENTACE CZ ---
 2758+6A67              DIR128_COPY_NAME_TO_DE:
 2759+6A67 D5                   push    de
 2760+6A68 ED 5B B9 6F          ld      de,(item_name_page)
 2761+6A6C CD 5C 6A             call    DIR128_MAP_DE
 2762+6A6F D1                   pop     de

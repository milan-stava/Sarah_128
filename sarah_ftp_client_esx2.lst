2905+ 6B99 ED 5B 1B 70          ld      de,(dir_search_page)
2906+ 6B9D CD BB 6A             call    DIR128_MAP_DE
2907+ 6BA0 CD 2C 6A             call    DIR128_INC_HL
2908+ 6BA3 38 16                jr      c,.dir_search_not_found
2909+ 6BA5 22 19 70             ld      (dir_search_addr),hl
2910+ 6BA8 ED 5B F6 BF          ld      de,(fdp_pointer)
2911+ 6BAC ED 53 1B 70          ld      (dir_search_page),de
2912+ 6BB0 2A 1D 70             ld      hl,(dir_search_remaining)
2913+ 6BB3 2B                   dec     hl
2914+ 6BB4 22 1D 70             ld      (dir_search_remaining),hl

2489+ 6A4F              ; -----------------------------------------------------------------------------
2490+ 6A4F              ; FTP DIRECTORY BANK API
2491+ 6A4F              ;
2492+ 6A4F              ; fdp_pointer always points to the table byte of the CURRENT directory page.
2493+ 6A4F              ; ftp_dir_page has #FF sentinels on both sides:
2494+ 6A4F              ;       #FF, 0, 1, 3, 7, #FF
2495+ 6A4F              ;
2496+ 6A4F              ; HL is always a physical address in the banked window #C000-#FFFF.
2497+ 6A4F              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
2498+ 6A4F              ;
2499+ 6A4F              ; OUT for INC/DEC:
2500+ 6A4F              ;       NC = movement succeeded
2501+ 6A4F              ;       C  = no next/previous directory page (64 KB boundary)
2502+ 6A4F              ;
2503+ 6A4F              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
2504+ 6A4F              ; which preserves AF/BC/DE/IX/IY exactly.
2505+ 6A4F              ; -----------------------------------------------------------------------------
2506+ 6A4F
2507+ 6A4F              DIR128_MAP_CURRENT:
2508+ 6A4F E5                   push    hl
2509+ 6A50 D5                   push    de
2510+ 6A51 ED 5B F6 BF          ld      de,(fdp_pointer)
2511+ 6A55 1A                   ld      a,(de)
2512+ 6A56 FE FF                cp      #FF
2513+ 6A58 28 07                jr      z,DIR128_MAP_BAD
2514+ 6A5A CD E0 BF             call    PAGE128
2515+ 6A5D D1                   pop     de
2516+ 6A5E E1                   pop     hl
2517+ 6A5F B7                   or      a                       ;NC = valid page
2518+ 6A60 C9                   ret
2519+ 6A61              DIR128_MAP_BAD:
2520+ 6A61 D1                   pop     de
2521+ 6A62 E1                   pop     hl
2522+ 6A63 37                   scf
2523+ 6A64 C9                   ret
2524+ 6A65
2525+ 6A65              ;Select first FTP directory page (page 0).
2526+ 6A65              DIR128_FIRST_PAGE:
2527+ 6A65 E5                   push    hl
2528+ 6A66 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
2529+ 6A69 22 F6 BF             ld      (fdp_pointer),hl
2530+ 6A6C 7E                   ld      a,(hl)
2531+ 6A6D CD E0 BF             call    PAGE128
2532+ 6A70 E1                   pop     hl
2533+ 6A71 B7                   or      a
2534+ 6A72 C9                   ret
2535+ 6A73
2536+ 6A73              ;HL++ across #FFFF -> #C000 of the next directory page.
2537+ 6A73              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
2538+ 6A73              DIR128_INC_HL:
2539+ 6A73 F5                   push    af                      ;old INC HL never changed A - preserve it here too
2540+ 6A74 23                   inc     hl
2541+ 6A75 7C                   ld      a,h
2542+ 6A76 B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
2543+ 6A77 28 03                jr      z,DIR128_INC_CROSS
2544+ 6A79 F1                   pop     af
2545+ 6A7A B7                   or      a                       ;restore A and return NC = OK
2546+ 6A7B C9                   ret
2547+ 6A7C
2548+ 6A7C              DIR128_INC_CROSS:
2549+ 6A7C D5                   push    de
2550+ 6A7D ED 5B F6 BF          ld      de,(fdp_pointer)
2551+ 6A81 13                   inc     de
2552+ 6A82 1A                   ld      a,(de)
2553+ 6A83 FE FF                cp      #FF
2554+ 6A85 28 0E                jr      z,DIR128_INC_END
2555+ 6A87 ED 53 F6 BF          ld      (fdp_pointer),de
2556+ 6A8B CD E0 BF             call    PAGE128
2557+ 6A8E 21 00 C0             ld      hl,ftp_dir_start        ;#C000
2558+ 6A91 D1                   pop     de
2559+ 6A92 F1                   pop     af                      ;restore caller's A
2560+ 6A93 B7                   or      a                       ;NC = OK, A unchanged
2561+ 6A94 C9                   ret
2562+ 6A95              DIR128_INC_END:
2563+ 6A95 1B                   dec     de                      ;keep fdp_pointer on last valid page
2564+ 6A96 ED 53 F6 BF          ld      (fdp_pointer),de
2565+ 6A9A 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
2566+ 6A9D D1                   pop     de
2567+ 6A9E F1                   pop     af                      ;restore caller's A
2568+ 6A9F 37                   scf                             ;C = no following directory page
2569+ 6AA0 C9                   ret

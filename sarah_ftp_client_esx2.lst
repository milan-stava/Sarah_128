 2991+6B37                      ;Always advance by exactly ONE source character.  This fixes both the
 2992+6B37                      ;old overlapping-match bug and the old one-character special case.
 2993+6B37 2A C0 6F             ld      hl,(dir_search_addr)
 2994+6B3A ED 5B C2 6F          ld      de,(dir_search_page)
 2995+6B3E CD 5C 6A             call    DIR128_MAP_DE
 2996+6B41 CD CD 69             call    DIR128_INC_HL
 2997+6B44 38 16                jr      c,.dir_search_not_found
 2998+6B46 22 C0 6F             ld      (dir_search_addr),hl
 2999+6B49 ED 5B F6 BF          ld      de,(fdp_pointer)
 3000+6B4D ED 53 C2 6F          ld      (dir_search_page),de
 3001+6B51 2A C4 6F             ld      hl,(dir_search_remaining)
 3002+6B54 2B                   dec     hl
 3003+6B55 22 C4 6F             ld      (dir_search_remaining),hl
 3004+6B58 18 AA                jr      .dir_search_outer

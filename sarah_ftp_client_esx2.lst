2655+ 6B0D              ; DIR128_COPY_NAME_TO_DE
2656+ 6B0D              ; Copy the name returned by get_item_name to fixed RAM.
2657+ 6B0D              ; IN:  HL = physical source address in directory window
2658+ 6B0D              ;      BC = 16-bit name length
2659+ 6B0D              ;      DE = fixed-RAM destination
2660+ 6B0D              ;      item_name_page = page-table pointer belonging to HL
2661+ 6B0D              ; OUT: DE points behind copied bytes, BC=0
2662+ 6B0D              ; The source may cross any #FFFF -> #C000 directory-page boundary.
2663+ 6B0D              ; -----------------------------------------------------------------------------
2664+ 6B0D              DIR128_COPY_NAME_TO_DE:
2665+ 6B0D D5                   push    de

2803+ 699F              DIR128_DEC_CROSS:
2804+ 699F D5                   push    de
2805+ 69A0 ED 5B F6 BF          ld      de,(fdp_pointer)
2806+ 69A4 1B                   dec     de
2807+ 69A5 1A                   ld      a,(de)
2808+ 69A6 FE FF                cp      #FF
2809+ 69A8 28 0E                jr      z,DIR128_DEC_START
2810+ 69AA ED 53 F6 BF          ld      (fdp_pointer),de
2811+ 69AE CD E0 BF             call    PAGE128
2812+ 69B1 21 FF FF             ld      hl,#FFFF
2813+ 69B4 D1                   pop     de
2814+ 69B5 F1                   pop     af                      ;restore caller's A
2815+ 69B6 B7                   or      a                       ;NC = OK, A unchanged
2816+ 69B7 C9                   ret
2817+ 69B8              DIR128_DEC_START:
2818+ 69B8 13                   inc     de                      ;keep fdp_pointer on first valid page
2819+ 69B9 ED 53 F6 BF          ld      (fdp_pointer),de
2820+ 69BD 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
2821+ 69C0 D1                   pop     de
2822+ 69C1 F1                   pop     af                      ;restore caller's A
2823+ 69C2 37                   scf                             ;C = no previous directory page
2824+ 69C3 C9                   ret

 4440+74A9              		;Read item length LOW/HIGH. Header itself may cross #FFFF/#C000.
 4441+74A9 7E           		ld	a,(hl)
 4442+74AA 5F           		ld	e,a			;E=length LOW
 4443+74AB CD FE 6D     		call	DIR128_INC_HL
 4444+74AE 38 4C        		jr	c,item_add_end
 4445+74B0 7E           		ld	a,(hl)
 4446+74B1 57           		ld	d,a			;DE=item length
 4447+74B2 B3           		or	e
 4448+74B3 28 47        		jr	z,item_add_end		;00 00 = real end of directory
 4449+74B5
 4450+74B5              		;We are at item_start+1.
 4451+74B5              		;Next item = item_start + item_length + 4.
 4452+74B5              		;Therefore move 3 fixed bytes, then item_length bytes.
 4453+74B5 3E 03        		ld	a,3
 4454+74B7              item_add_fixed
 4455+74B7 CD FE 6D     		call	DIR128_INC_HL
 4456+74BA 38 40        		jr	c,item_add_end
 4457+74BC 3D           		dec	a
 4458+74BD 20 F8        		jr	nz,item_add_fixed
 4459+74BF
 4460+74BF              item_add_lenloop
 4461+74BF 7A           		ld	a,d
 4462+74C0 B3           		or	e
 4463+74C1 28 08        		jr	z,item_add_at_next
 4464+74C3 CD FE 6D     		call	DIR128_INC_HL
 4465+74C6 38 34        		jr	c,item_add_end
 4466+74C8 1B           		dec	de
 4467+74C9 18 F4        		jr	item_add_lenloop
 4468+74CB
 4469+74CB              item_add_at_next
 4470+74CB              		;Save exact candidate next-item position and its bank before peeking
 4471+74CB              		;at its 00 00 / length header.
 4472+74CB 22 0B 73     		ld	(next_item_addr),hl
 4473+74CE ED 5B F6 BF  		ld	de,(fdp_pointer)
 4474+74D2 ED 53 0D 73  		ld	(next_item_page),de
 4475+74D6
 4476+74D6 7E           		ld	a,(hl)
 4477+74D7 5F           		ld	e,a
 4478+74D8 CD FE 6D     		call	DIR128_INC_HL
 4479+74DB 38 1F        		jr	c,item_add_end
 4480+74DD 7E           		ld	a,(hl)
 4481+74DE B3           		or	e
 4482+74DF 28 1B        		jr	z,item_add_end		;next item begins 00 00 = end of directory
 4483+74E1
 4484+74E1              		;Commit candidate address.
 4485+74E1 2A 13 73     		ld	hl,(dir_op_addr_var)
 4486+74E4 ED 5B 0B 73  		ld	de,(next_item_addr)
 4487+74E8 73           		ld	(hl),e
 4488+74E9 23           		inc	hl
 4489+74EA 72           		ld	(hl),d
 4490+74EB
 4491+74EB              		;Commit candidate bank companion.
 4492+74EB 2A 15 73     		ld	hl,(dir_op_page_var)
 4493+74EE ED 5B 0D 73  		ld	de,(next_item_page)
 4494+74F2 73           		ld	(hl),e
 4495+74F3 23           		inc	hl
 4496+74F4 72           		ld	(hl),d
 4497+74F5
 4498+74F5              		;Leave the bank containing the new item mapped.
 4499+74F5 CD 8D 6E     		call	DIR128_MAP_DE
 4500+74F8 3E 01        		ld	a,1
 4501+74FA B7           		or	a			;NZ, NC
 4502+74FB C9           		ret
 4503+74FC
 4504+74FC              item_add_end
 4505+74FC AF           		xor	a			;Z = do not alter caller pointer variables
 4506+74FD C9           		ret

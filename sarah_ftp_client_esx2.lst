   70+717F              ; Refill an aligned 256-byte window in the existing INPBUFF after FTP is done.
   71+717F              ; HL=logical offset (preserved). The aligned window never crosses a RAM bank.
   72+717F              text_fill:
   73+717F E5                   push    hl
   74+7180 2E 00                ld      l,0
   75+7182 CD 62 71             call    text_map
   76+7185 11 81 8F             ld      de,INPBUFF
   77+7188 01 00 01             ld      bc,256
   78+718B ED B0                ldir

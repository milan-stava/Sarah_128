 8978+8487              ;89) get_item_name	;get file name under cursor
 8979+8487              ;IN: current active callers use SCF. 128K parser always returns full info.
 8980+8487              ;OUT=HL=name start, BC= name length, DE= file length
 8981+8487              ;OUT=A=0= item is a directory+ HL, BC
 8982+8487              ;OUT=A=1=item is a file+ HL, BC
 8983+8487              ;OUT=A=2=item type cannot be determined (because of NLST command)+ HL, BC
 8984+8487              ;OUT=A=3= item not parsed (for the moment) bacause it is LIST in full, HL, BC irrelevant
 8985+8487              ;OUT=A=4= starting item ".."
 8986+8487              ;bits 1 (items 0=abbreviated, 1= full) and 3 (current command type 0=LIST, 1=NLST) from flag_dir are of interest here
 8987+8487              ; --- DOKUMENTACE CZ: get_item_name ---
 8988+8487              ; Ucel: Rozebere aktuální položku adresáře a vrátí jméno a typ.
 8989+8487              ; Vstup: cur_item_addr/cur_item_addr_page; IX=flag1; vstupní Carry se nevyužívá.
 8990+8487              ; Vystup: HL=jméno, BC=délka, item_name_page=banka; DE=16bitová velikost u zkráceného LIST.
 8991+8487              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 8992+8487              ; Poznamka: A: 0 adresář, 1 soubor, 2 NLST (typ neznámý), 3 plný LIST/chybná položka, 4
 8993+8487              ;   syntetické ..; pro A=3 nejsou HL/BC obecně platné.
 8994+8487              ; --- KONEC DOKUMENTACE CZ ---
 8995+8487              get_item_name
 8996+8487              ;128K bank-safe parser.
 8997+8487              ;IN: callers currently use SCF; C/NC is kept only for source compatibility.
 8998+8487              ;OUT=HL=name start in banked directory RAM
 8999+8487              ;    BC=16-bit name length
 9000+8487              ;    DE=16-bit file length for LIST abbreviated (0 for NLST/"..")
 9001+8487              ;    item_name_page=page-table pointer belonging to returned HL
 9002+8487              ;OUT=A=0 directory, A=1 file, A=2 NLST unknown type,
 9003+8487              ;      A=3 LIST full/malformed, A=4 synthetic ".."
 9004+8487              ;
 9005+8487              ;No temporary zero is written into the directory. The parser uses the stored
 9006+8487              ;16-bit item length as its boundary, so an item/name may cross 16K pages and
 9007+8487              ;may also be longer than 255 bytes.
 9008+8487 2A 6F 8E             ld      hl,(cur_item_addr)
 9009+848A ED 5B DA 88          ld      de,(cur_item_addr_page)
 9010+848E CD 65 6A             call    DIR128_MAP_DE
 9011+8491
 9012+8491                      ;Read item length LOW/HIGH. Even the length field may cross a page.
 9013+8491 7E                   ld      a,(hl)
 9014+8492 4F                   ld      c,a
 9015+8493 CD D6 69             call    DIR128_INC_HL
 9016+8496 DA 76 85             jp      c,gfn_bad
 9017+8499 7E                   ld      a,(hl)
 9018+849A 47                   ld      b,a
 9019+849B 78                   ld      a,b
 9020+849C B1                   or      c

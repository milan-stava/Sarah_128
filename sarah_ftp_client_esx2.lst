 4431+749E              		;Load/map directory page from page companion variable.
 4432+749E E5           		push	hl
 4433+749F 2A 15 73     		ld	hl,(dir_op_page_var)
 4434+74A2 5E           		ld	e,(hl)
 4435+74A3 23           		inc	hl
 4436+74A4 56           		ld	d,(hl)
 4437+74A5 E1           		pop	hl
 4438+74A6 CD 8D 6E     		call	DIR128_MAP_DE

  890+61E4              ;speed management 2.0. starts here. Enables to set user_defined speed. Works with every MBFW.
  891+61E4              ;the principle:
  892+61E4              ;are you aligned?
  893+61E4              ;NO: try to align, if not success->error. If sucess, you have AKT (=current alligned speed is ;known). Is user defined speed definied? (IX+2=255 for no user defined speed) yes, END. NO. set ;speed according to ix+2 (max up to MBFW), end
  894+61E4              ;
  895+61E4              ;YES:
  896+61E4              ;is user defined speed set? (ix+2=255 or other?) NO=check if FW is 7/12? YES, align at speed
  897+61E4              ;ix+2, end. FW is higher then 7/12, then check if AKT=IX+2? YES, end, NO, align at ix+2, END.
  898+61E4              ;ix+2 was not 255, is FW 7/12? YES, then set FWmax, end. NO the is AKT=MBFW max? YES, then END
  899+61E4              ;NO, then align at FW max speed, end
  900+61E4              ;output: ix+7= 0-23 if speed set, or 255 if not set
  901+61E4
  902+61E4              ;SM20 uses:
  903+61E4              ;bit 4,(ix+0)	PRINT or not to PRINT
  904+61E4              ;(ix+8)		contains maximum speed by detected MBFW (7, 12 or 23)
  905+61E4              ;(ix+6)		timeout value
  906+61E4              ;bit 6,(ix+0)	state of speed alignment between uart& module, 0 not aligned
  907+61E4              ;bit 5,(ix+0)	state of module connection to AP, 0 not connected to AP
  908+61E4
  909+61E4              ;internal subroutines: switch_speed, find_out_speed
  910+61E4              ;external subroutines: send_at:check_ok, set_ud_speed, set_print_speed, print_speed
  911+61E4
  912+61E4              ; --- DOKUMENTACE CZ: speed_management ---
  913+61E4              ; Ucel: Sjednotí rychlost komunikace UART a Wi-Fi při inicializaci.
  914+61E4              ; Vstup: Inicializovaný BIOS a příznaky na IX.
  915+61E4              ; Vystup: Připravená komunikace nebo obsluha chyby.
  916+61E4              ; Meni: AF, BC, DE, HL, BC'; další změny dle volaných BIOS/DOS a tiskových služeb.
  917+61E4              ; Poznamka: Pracuje s konfigurací rychlosti, příjmovým bufferem a stavovým výpisem.
  918+61E4              ; --- KONEC DOKUMENTACE CZ ---
  919+61E4              speed_management
  920+61E4 DD 36 07 FF  		ld	(ix+7),#FF		;reset currently set speed status
  921+61E8 DD CB 00 B6  		res	6,(ix+0)		;set signal UART and module speed not aligned
  922+61EC
  923+61EC              ;;		ld	hl,#4300
  924+61EC              ;;		ld	de,wifi_on_off
  925+61EC              ;;		call	PRINTHL
  926+61EC
  927+61EC 37           		scf				;power on wifi
  928+61ED CD 9A A5     		call	wifi_on
  929+61F0
  930+61F0
  931+61F0 21 00 02     		ld	hl,txt_adr_speed_login	;print "Speed" text
  932+61F3 11 DF 89     		ld	de,speed
  933+61F6 CD 85 90     		call	PRINTHL
  934+61F9
  935+61F9 01 3B 78     		ld	bc,#783B		;set CPU to 3,5 MHz
  936+61FC 3E 30        		ld	a,#30

 959+ 6209              ; --- DOKUMENTACE CZ: speed_management ---
 960+ 6209              ; Ucel: Sjednotí rychlost komunikace UART a Wi-Fi při inicializaci.
 961+ 6209              ; Vstup: Inicializovaný BIOS a příznaky na IX.
 962+ 6209              ; Vystup: Připravená komunikace nebo obsluha chyby.
 963+ 6209              ; Meni: AF, BC, DE, HL, BC'; další změny dle volaných BIOS/DOS a tiskových služeb.
 964+ 6209              ; Poznamka: Pracuje s konfigurací rychlosti, příjmovým bufferem a stavovým výpisem.
 965+ 6209              ; --- KONEC DOKUMENTACE CZ ---
 966+ 6209              speed_management
 967+ 6209 DD 36 07 FF  		ld	(ix+7),#FF		;reset currently set speed status
 968+ 620D DD CB 00 B6  		res	6,(ix+0)		;set signal UART and module speed not aligned

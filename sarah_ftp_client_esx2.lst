 9575+8734              get_item_name
 9576+8734              ;128K bank-safe parser.
 9577+8734              ;IN: callers currently use SCF; C/NC is kept only for source compatibility.
 9578+8734              ;OUT=HL=name start in banked directory RAM
 9579+8734              ;    BC=16-bit name length
 9580+8734              ;    DE=16-bit file length for LIST abbreviated (0 for NLST/"..")
 9581+8734              ;    item_name_page=page-table pointer belonging to returned HL
 9582+8734              ;OUT=A=0 directory, A=1 file, A=2 NLST unknown type,
 9583+8734              ;      A=3 LIST full/malformed, A=4 synthetic ".."
 9584+8734              ;
 9585+8734              ;No temporary zero is written into the directory. The parser uses the stored
 9586+8734              ;16-bit item length as its boundary, so an item/name may cross 16K pages and
 9587+8734              ;may also be longer than 255 bytes.

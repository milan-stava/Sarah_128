 4093+7111              ; -----------------------------------------------------------------------------
 4094+7111              ; item_add / item_sub - 128K bank-aware directory movement
 4095+7111              ;
 4096+7111              ; IN:
 4097+7111              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
 4098+7111              ;       DE = address of its 16-bit page-table-pointer companion
 4099+7111              ;
 4100+7111              ; Example:
 4101+7111              ;       ld bc,cur_item_addr
 4102+7111              ;       ld de,cur_item_addr_page
 4103+7111              ;       call item_add
 4104+7111              ;
 4105+7111              ; OUT:
 4106+7111              ;       Z  = cannot move (end/start of directory)
 4107+7111              ;       NZ = pointer + its bank companion were moved to adjacent item
 4108+7111              ;
 4109+7111              ; The address variable and page variable deliberately do NOT have to be adjacent.
 4110+7111              ; This keeps the original IX+... variable layout completely unchanged.
 4111+7111              ; The two-byte item length at either end of an item may itself cross a bank.
 4112+7111              ; -----------------------------------------------------------------------------
 4113+7111              ; --- DOKUMENTACE CZ: item_add ---
 4114+7111              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
 4115+7111              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
 4116+7111              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
 4117+7111              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
 4118+7111              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
 4119+7111              ; --- KONEC DOKUMENTACE CZ ---
 4120+7111              item_add
 4121+7111 ED 43 7A 6F  		ld	(dir_op_addr_var),bc
 4122+7115 ED 53 7C 6F  		ld	(dir_op_page_var),de

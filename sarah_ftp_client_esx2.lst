 4185+7166
 4186+7166              		;Commit candidate address.
 4187+7166 2A 7A 6F     		ld	hl,(dir_op_addr_var)
 4188+7169 ED 5B 72 6F  		ld	de,(next_item_addr)
 4189+716D 73           		ld	(hl),e

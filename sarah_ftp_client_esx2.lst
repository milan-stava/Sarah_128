  966+6210 DD 77 08     		ld	(ix+8),a		;save max possible speed for given FW
  967+6213
  968+6213 DD 36 06 01  		ld	(ix+6),1		;timeout for quick AT check, 1 should be ok.
  969+6217 CD 4F 7B     		call	send_at_check_ok

 9051+848D              ;89) get_item_name	;get file name under cursor
 9052+848D              ;IN: current active callers use SCF. 128K parser always returns full info.
 9053+848D              ;OUT=HL=name start, BC= name length, DE= file length
 9054+848D              ;OUT=A=0= item is a directory+ HL, BC
 9055+848D              ;OUT=A=1=item is a file+ HL, BC
 9056+848D              ;OUT=A=2=item type cannot be determined (because of NLST command)+ HL, BC
 9057+848D              ;OUT=A=3= item not parsed (for the moment) bacause it is LIST in full, HL, BC irrelevant
 9058+848D              ;OUT=A=4= starting item ".."
 9059+848D              ;bits 1 (items 0=abbreviated, 1= full) and 3 (current command type 0=LIST, 1=NLST) from flag_dir are of interest here
 9060+848D              ; --- DOKUMENTACE CZ: get_item_name ---
 9061+848D              ; Ucel: Rozebere aktuální položku adresáře a vrátí jméno a typ.
 9062+848D              ; Vstup: cur_item_addr/cur_item_addr_page; IX=flag1; vstupní Carry se nevyužívá.
 9063+848D              ; Vystup: HL=jméno, BC=délka, item_name_page=banka; DE=16bitová velikost u zkráceného LIST.
 9064+848D              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 9065+848D              ; Poznamka: A: 0 adresář, 1 soubor, 2 NLST (typ neznámý), 3 plný LIST/chybná položka, 4
 9066+848D              ;   syntetické ..; pro A=3 nejsou HL/BC obecně platné.
 9067+848D              ; --- KONEC DOKUMENTACE CZ ---
 9068+848D              get_item_name
 9069+848D              ;128K bank-safe parser.
 9070+848D              ;IN: callers currently use SCF; C/NC is kept only for source compatibility.
 9071+848D              ;OUT=HL=name start in banked directory RAM
 9072+848D              ;    BC=16-bit name length
 9073+848D              ;    DE=16-bit file length for LIST abbreviated (0 for NLST/"..")
 9074+848D              ;    item_name_page=page-table pointer belonging to returned HL
 9075+848D              ;OUT=A=0 directory, A=1 file, A=2 NLST unknown type,
 9076+848D              ;      A=3 LIST full/malformed, A=4 synthetic ".."
 9077+848D              ;
 9078+848D              ;No temporary zero is written into the directory. The parser uses the stored
 9079+848D              ;16-bit item length as its boundary, so an item/name may cross 16K pages and
 9080+848D              ;may also be longer than 255 bytes.
 9081+848D 2A 8D 8E             ld      hl,(cur_item_addr)
 9082+8490 ED 5B E0 88          ld      de,(cur_item_addr_page)
 9083+8494 CD 32 6A             call    DIR128_MAP_DE
 9084+8497
 9085+8497                      ;Read item length LOW/HIGH. Even the length field may cross a page.
 9086+8497 7E                   ld      a,(hl)
 9087+8498 4F                   ld      c,a
 9088+8499 CD A3 69             call    DIR128_INC_HL
 9089+849C DA 7C 85             jp      c,gfn_bad
 9090+849F 7E                   ld      a,(hl)
 9091+84A0 47                   ld      b,a
 9092+84A1 78                   ld      a,b
 9093+84A2 B1                   or      c
 9094+84A3 CA 7C 85             jp      z,gfn_bad
 9095+84A6 ED 43 8D 6F          ld      (gfn_remaining),bc      ;includes mark/info byte + stored data
 9096+84AA
 9097+84AA                      ;Move from header HIGH to mark/info byte (item+2).
 9098+84AA CD A3 69             call    DIR128_INC_HL
 9099+84AD DA 7C 85             jp      c,gfn_bad
 9100+84B0
 9101+84B0                      ;Synthetic first item ".." is always page 0:#C000.
 9102+84B0 E5                   push    hl
 9103+84B1 2A E0 88             ld      hl,(cur_item_addr_page)
 9104+84B4 11 F1 BF             ld      de,ftp_dir_page+1
 9105+84B7 B7                   or      a
 9106+84B8 ED 52                sbc     hl,de
 9107+84BA E1                   pop     hl
 9108+84BB 20 26                jr      nz,gfn_not_first
 9109+84BD E5                   push    hl
 9110+84BE 2A 8D 8E             ld      hl,(cur_item_addr)
 9111+84C1 11 00 C0             ld      de,ftp_dir_start
 9112+84C4 B7                   or      a
 9113+84C5 ED 52                sbc     hl,de
 9114+84C7 E1                   pop     hl
 9115+84C8 20 19                jr      nz,gfn_not_first
 9116+84CA
 9117+84CA                      ;Skip mark/info byte. The synthetic item contains exactly "..".
 9118+84CA CD 86 85             call    gfn_next
 9119+84CD DA 7C 85             jp      c,gfn_bad
 9120+84D0 ED 4B 8D 6F          ld      bc,(gfn_remaining)
 9121+84D4 ED 5B F6 BF          ld      de,(fdp_pointer)
 9122+84D8 ED 53 8B 6F          ld      (item_name_page),de

 2779+6A80              ; -----------------------------------------------------------------------------
 2780+6A80              ; search_by_Busy_dir
 2781+6A80              ; Bank-safe replacement used by FIND for names returned by get_item_name.
 2782+6A80              ; IN:  HL = physical name start, BC = 16-bit name length
 2783+6A80              ;      item_name_page = bank companion for HL
 2784+6A80              ; Pattern remains INPBUFF, pattern length is the value patched into txtlen+1.
 2785+6A80              ; OUT: Z=pattern found, NZ=not found
 2786+6A80              ; One-character input matches only the FIRST character of a name (quick jump).
 2787+6A80              ; Two or more characters use normal case-insensitive substring search. There is
 2788+6A80              ; no 255-byte directory-name limit; directory page crossings are transparent.
 2789+6A80              ; -----------------------------------------------------------------------------
 2790+6A80              ; --- DOKUMENTACE CZ: search_by_Busy_dir ---
 2791+6A80              ; Ucel: Vyhledá vzor ve jménu; zvolí rychlou nebo stránkovanou variantu.
 2792+6A80              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF = malá písmena vzoru, txtlen+1
 2793+6A80              ;   = délka vzoru.
 2794+6A80              ; Vystup: Z = shoda, NZ = nenalezeno.
 2795+6A80              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 2796+6A80              ; Poznamka: Jednoznakový vzor porovnává jen začátek jména; může změnit mapování RAM.
 2797+6A80              ; --- KONEC DOKUMENTACE CZ ---
 2798+6A80              search_by_Busy_dir:
 2799+6A80                      ; Empty name cannot contain a non-empty search pattern.
 2800+6A80 78                   ld      a,b
 2801+6A81 B1                   or      c
 2802+6A82 28 2A                jr      z,.dir_search_not_found_fast
 2803+6A84
 2804+6A84                      ; Map the directory bank containing the first byte of the name ONCE.
 2805+6A84                      ; For the normal case the whole name is inside this one 16K bank and
 2806+6A84                      ; no further paging is needed during FIND.
 2807+6A84 ED 5B B9 6F          ld      de,(item_name_page)
 2808+6A88 CD 5C 6A             call    DIR128_MAP_DE
 2809+6A8B
 2810+6A8B                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
 2811+6A8B                      ; the first character of the file name.  Thus FIND "S" selects names
 2812+6A8B                      ; beginning with S, while 2+ characters remain a substring search.
 2813+6A8B                      ; This is also much faster for the common one-letter jump.
 2814+6A8B ED 5B 43 79          ld      de,(txtlen+1)
 2815+6A8F 7A                   ld      a,d
 2816+6A90 B7                   or      a
 2817+6A91 20 0F                jr      nz,.dir_search_len_ge2
 2818+6A93 7B                   ld      a,e
 2819+6A94 FE 01                cp      1
 2820+6A96 20 0A                jr      nz,.dir_search_len_ge2
 2821+6A98 7E                   ld      a,(hl)
 2822+6A99 CD 67 79             call    convert
 2823+6A9C 57                   ld      d,a
 2824+6A9D 3A 70 8F             ld      a,(INPBUFF)             ;already normalized by find_items
 2825+6AA0 BA                   cp      d                       ;Z=first character matches
 2826+6AA1 C9                   ret

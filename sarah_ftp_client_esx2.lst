 6576+7BEA              ; --- DOKUMENTACE CZ: convASCII2hex ---
 6577+7BEA              ; Ucel: Složí dolní půlbajty dvou znaků do jednoho bajtu.
 6578+7BEA              ; Vstup: HL = adresa dvou ASCII číslic, např. "14".
 6579+7BEA              ; Vystup: A = #14 pro vstup "14"; HL ukazuje na druhý znak.
 6580+7BEA              ; Meni: AF, E, HL; D, BC, IX a IY zachovány.
 6581+7BEA              ; Poznamka: Není obecný hexadecimální parser: nepřevádí písmena A–F.
 6582+7BEA              ; --- KONEC DOKUMENTACE CZ ---
 6583+7BEA              convASCII2hex
 6584+7BEA              ;IN=HL ASCII number address (2 digits) eg. hl,14
 6585+7BEA              ;OUT=A=#14
 6586+7BEA 7E           		ld	a,(hl)
 6587+7BEB E6 0F        		and	%00001111
 6588+7BED CB 27        		sla	a
 6589+7BEF CB 27        		sla	a
 6590+7BF1 CB 27        		sla	a
 6591+7BF3 CB 27        		sla	a
 6592+7BF5 5F           		ld	e,a
 6593+7BF6 23           		inc	hl
 6594+7BF7 7E           		ld	a,(hl)
 6595+7BF8 E6 0F        		and	%00001111
 6596+7BFA B3           		or	e
 6597+7BFB C9           		ret

6161+ 781F              ; --- DOKUMENTACE CZ: string_dl ---
6162+ 781F              ; Ucel: Vypočítá a případně zapíše jednu desetinnou číslici.
6163+ 781F              ; Vstup: HL = zbytek čísla, BC = desítkový řád, DE = cíl; IX = flag1.
6164+ 781F              ; Vystup: HL = zbytek po odečtení řádu; DE posunut pouze při zápisu číslice.
6165+ 781F              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
6166+ 781F              ; Poznamka: Používá a nastavuje bit 7 v (IX+0) pro potlačení úvodních nul.
6167+ 781F              ; --- KONEC DOKUMENTACE CZ ---
6168+ 781F 3E 2F        string_dl:		ld a,'0'-1
6169+ 7821
6170+ 7821 3C           string_lp2:		inc a

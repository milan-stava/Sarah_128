 6574+7BB2              ; --- DOKUMENTACE CZ: convASCII2hex ---
 6575+7BB2              ; Ucel: Složí dolní půlbajty dvou znaků do jednoho bajtu.
 6576+7BB2              ; Vstup: HL = adresa dvou ASCII číslic, např. "14".
 6577+7BB2              ; Vystup: A = #14 pro vstup "14"; HL ukazuje na druhý znak.
 6578+7BB2              ; Meni: AF, E, HL; D, BC, IX a IY zachovány.
 6579+7BB2              ; Poznamka: Není obecný hexadecimální parser: nepřevádí písmena A–F.
 6580+7BB2              ; --- KONEC DOKUMENTACE CZ ---
 6581+7BB2              convASCII2hex
 6582+7BB2              ;IN=HL ASCII number address (2 digits) eg. hl,14
 6583+7BB2              ;OUT=A=#14
 6584+7BB2 7E           		ld	a,(hl)
 6585+7BB3 E6 0F        		and	%00001111
 6586+7BB5 CB 27        		sla	a
 6587+7BB7 CB 27        		sla	a
 6588+7BB9 CB 27        		sla	a
 6589+7BBB CB 27        		sla	a
 6590+7BBD 5F           		ld	e,a
 6591+7BBE 23           		inc	hl
 6592+7BBF 7E           		ld	a,(hl)
 6593+7BC0 E6 0F        		and	%00001111
 6594+7BC2 B3           		or	e
 6595+7BC3 C9           		ret

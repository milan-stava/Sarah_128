4238+ 707E              		;Commit candidate bank companion.
4239+ 707E 2A A8 6E     		ld	hl,(dir_op_page_var)
4240+ 7081 ED 5B A0 6E  		ld	de,(next_item_page)
4241+ 7085 73           		ld	(hl),e

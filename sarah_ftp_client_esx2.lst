3032+ 6A53              ; -----------------------------------------------------------------------------
3033+ 6A53              ; search_by_Busy_dir_slow
3034+ 6A53              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
3035+ 6A53              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
3036+ 6A53              ; no longer slows down every ordinary FIND operation.
3037+ 6A53              ;
3038+ 6A53              ; One-character FIND is handled before this fallback and compares only the
3039+ 6A53              ; first character.  This slow path therefore normally handles 2+ character
3040+ 6A53              ; substring searches whose source name crosses a directory-bank boundary.
3041+ 6A53              ; -----------------------------------------------------------------------------
3042+ 6A53              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
3043+ 6A53              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
3044+ 6A53              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
3045+ 6A53              ;   a délka.
3046+ 6A53              ; Vystup: Z = shoda, NZ = nenalezeno.
3047+ 6A53              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
3048+ 6A53              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
3049+ 6A53              ; --- KONEC DOKUMENTACE CZ ---
3050+ 6A53              search_by_Busy_dir_slow:
3051+ 6A53 22 B9 6E             ld      (dir_search_addr),hl
3052+ 6A56 ED 43 BD 6E          ld      (dir_search_remaining),bc
3053+ 6A5A ED 5B B2 6E          ld      de,(item_name_page)
3054+ 6A5E ED 53 BB 6E          ld      (dir_search_page),de
3055+ 6A62 2A 31 77             ld      hl,(txtlen+1)
3056+ 6A65 22 BF 6E             ld      (dir_search_patlen),hl
3057+ 6A68 7C                   ld      a,h
3058+ 6A69 B5                   or      l
3059+ 6A6A 28 56                jr      z,.dir_search_found
3060+ 6A6C
3061+ 6A6C              .dir_search_outer:
3062+ 6A6C                      ;If remaining source length < pattern length, no further match exists.
3063+ 6A6C 2A BD 6E             ld      hl,(dir_search_remaining)
3064+ 6A6F ED 5B BF 6E          ld      de,(dir_search_patlen)
3065+ 6A73 B7                   or      a
3066+ 6A74 ED 52                sbc     hl,de
3067+ 6A76 38 4C                jr      c,.dir_search_not_found
3068+ 6A78
3069+ 6A78                      ;Start one comparison at current candidate address/page.
3070+ 6A78 2A B9 6E             ld      hl,(dir_search_addr)
3071+ 6A7B ED 5B BB 6E          ld      de,(dir_search_page)
3072+ 6A7F CD C4 69             call    DIR128_MAP_DE
3073+ 6A82 11 DA 8B             ld      de,INPBUFF
3074+ 6A85 ED 4B BF 6E          ld      bc,(dir_search_patlen)
3075+ 6A89
3076+ 6A89              .dir_search_cmp:
3077+ 6A89 7E                   ld      a,(hl)
3078+ 6A8A CD 55 77             call    convert                 ;source char -> lower case
3079+ 6A8D EB                   ex      de,hl
3080+ 6A8E BE                   cp      (hl)                    ;pattern already normalized by FIND
3081+ 6A8F EB                   ex      de,hl
3082+ 6A90 20 0D                jr      nz,.dir_search_advance_candidate
3083+ 6A92
3084+ 6A92 13                   inc     de
3085+ 6A93 0B                   dec     bc
3086+ 6A94 78                   ld      a,b
3087+ 6A95 B1                   or      c
3088+ 6A96 28 2A                jr      z,.dir_search_found
3089+ 6A98 CD 35 69             call    DIR128_INC_HL
3090+ 6A9B 38 27                jr      c,.dir_search_not_found
3091+ 6A9D 18 EA                jr      .dir_search_cmp
3092+ 6A9F
3093+ 6A9F              .dir_search_advance_candidate:
3094+ 6A9F                      ;Always advance by exactly ONE source character.  This fixes both the
3095+ 6A9F                      ;old overlapping-match bug and the old one-character special case.
3096+ 6A9F 2A B9 6E             ld      hl,(dir_search_addr)
3097+ 6AA2 ED 5B BB 6E          ld      de,(dir_search_page)
3098+ 6AA6 CD C4 69             call    DIR128_MAP_DE
3099+ 6AA9 CD 35 69             call    DIR128_INC_HL
3100+ 6AAC 38 16                jr      c,.dir_search_not_found
3101+ 6AAE 22 B9 6E             ld      (dir_search_addr),hl
3102+ 6AB1 ED 5B F6 BF          ld      de,(fdp_pointer)
3103+ 6AB5 ED 53 BB 6E          ld      (dir_search_page),de
3104+ 6AB9 2A BD 6E             ld      hl,(dir_search_remaining)
3105+ 6ABC 2B                   dec     hl
3106+ 6ABD 22 BD 6E             ld      (dir_search_remaining),hl
3107+ 6AC0 18 AA                jr      .dir_search_outer
3108+ 6AC2
3109+ 6AC2              .dir_search_found:
3110+ 6AC2 AF                   xor     a                       ;Z
3111+ 6AC3 C9                   ret
3112+ 6AC4              .dir_search_not_found:
3113+ 6AC4 3E 01                ld      a,1
3114+ 6AC6 B7                   or      a                       ;NZ
3115+ 6AC7 C9                   ret

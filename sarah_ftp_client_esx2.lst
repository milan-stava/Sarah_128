 4164+7237              ; -----------------------------------------------------------------------------
 4165+7237              ; item_add / item_sub - 128K bank-aware directory movement
 4166+7237              ;
 4167+7237              ; IN:
 4168+7237              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
 4169+7237              ;       DE = address of its 16-bit page-table-pointer companion
 4170+7237              ;
 4171+7237              ; Example:
 4172+7237              ;       ld bc,cur_item_addr
 4173+7237              ;       ld de,cur_item_addr_page
 4174+7237              ;       call item_add
 4175+7237              ;
 4176+7237              ; OUT:
 4177+7237              ;       Z  = cannot move (end/start of directory)
 4178+7237              ;       NZ = pointer + its bank companion were moved to adjacent item
 4179+7237              ;
 4180+7237              ; The address variable and page variable deliberately do NOT have to be adjacent.
 4181+7237              ; This keeps the original IX+... variable layout completely unchanged.
 4182+7237              ; The two-byte item length at either end of an item may itself cross a bank.
 4183+7237              ; -----------------------------------------------------------------------------
 4184+7237              ; --- DOKUMENTACE CZ: item_add ---
 4185+7237              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
 4186+7237              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
 4187+7237              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
 4188+7237              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
 4189+7237              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
 4190+7237              ; --- KONEC DOKUMENTACE CZ ---
 4191+7237              item_add
 4192+7237 ED 43 B6 6F  		ld	(dir_op_addr_var),bc
 4193+723B ED 53 B8 6F  		ld	(dir_op_page_var),de
 4194+723F
 4195+723F              		;Load physical item address from *(BC).
 4196+723F 60           		ld	h,b
 4197+7240 69           		ld	l,c
 4198+7241 5E           		ld	e,(hl)
 4199+7242 23           		inc	hl
 4200+7243 56           		ld	d,(hl)
 4201+7244 ED 53 AE 6F  		ld	(next_item_addr),de	;temporary physical start
 4202+7248 EB           		ex	de,hl			;HL=current physical item start
 4203+7249
 4204+7249              		;Load/map directory page from page companion variable.
 4205+7249 E5           		push	hl
 4206+724A 2A B8 6F     		ld	hl,(dir_op_page_var)
 4207+724D 5E           		ld	e,(hl)
 4208+724E 23           		inc	hl
 4209+724F 56           		ld	d,(hl)
 4210+7250 E1           		pop	hl
 4211+7251 CD 65 6A     		call	DIR128_MAP_DE
 4212+7254
 4213+7254              		;Read item length LOW/HIGH. Header itself may cross #FFFF/#C000.
 4214+7254 7E           		ld	a,(hl)
 4215+7255 5F           		ld	e,a			;E=length LOW
 4216+7256 CD D6 69     		call	DIR128_INC_HL
 4217+7259 38 4C        		jr	c,item_add_end

2812+ 6A8D                      ; For the normal case the whole name is inside this one 16K bank and
2813+ 6A8D                      ; no further paging is needed during FIND.
2814+ 6A8D ED 5B C2 6F          ld      de,(item_name_page)
2815+ 6A91 CD 65 6A             call    DIR128_MAP_DE
2816+ 6A94
2817+ 6A94                      ; One-character FIND is the old quick-jump behaviour: compare ONLY
2818+ 6A94                      ; the first character of the file name.  Thus FIND "S" selects names
2819+ 6A94                      ; beginning with S, while 2+ characters remain a substring search.
2820+ 6A94                      ; This is also much faster for the common one-letter jump.
2821+ 6A94 ED 5B 57 78          ld      de,(txtlen+1)

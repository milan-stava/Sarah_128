 2830+6AAB              .dir_search_len_ge2:
 2831+6AAB                      ; Is the LAST byte of the name still inside the same physical window?
 2832+6AAB                      ; last = HL + BC - 1
 2833+6AAB                      ; Carry means that the name crosses #FFFF -> #C000, therefore use the
 2834+6AAB                      ; fully bank-safe (but slower) routine below.
 2835+6AAB E5                   push    hl
 2836+6AAC C5                   push    bc
 2837+6AAD 0B                   dec     bc
 2838+6AAE 09                   add     hl,bc
 2839+6AAF C1                   pop     bc

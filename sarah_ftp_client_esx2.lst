 2828+6AA2              .dir_search_len_ge2:
 2829+6AA2                      ; Is the LAST byte of the name still inside the same physical window?
 2830+6AA2                      ; last = HL + BC - 1
 2831+6AA2                      ; Carry means that the name crosses #FFFF -> #C000, therefore use the
 2832+6AA2                      ; fully bank-safe (but slower) routine below.
 2833+6AA2 E5                   push    hl
 2834+6AA3 C5                   push    bc
 2835+6AA4 0B                   dec     bc
 2836+6AA5 09                   add     hl,bc
 2837+6AA6 C1                   pop     bc
 2838+6AA7 E1                   pop     hl

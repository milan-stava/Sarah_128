  978+626E              ; --- DOKUMENTACE CZ: find_out_speed ---
  979+626E              ; Ucel: Zjistí index aktuální rychlosti UART, případně rychlosti vyzkouší.
  980+626E              ; Vstup: IX = flag1; dostupné služby get_baud/set_baud.
  981+626E              ; Vystup: D = index zjištěné rychlosti při úspěchu.
  982+626E              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
  983+626E              ; Poznamka: Při nepodporovaném get_baud používá switch_speed; jeho neúspěch nepovažujte za
  984+626E              ;   platnou rychlost.
  985+626E              ; --- KONEC DOKUMENTACE CZ ---
  986+626E              find_out_speed					;subroutine is able to find out current speed for all MBFW, output in D
  987+626E CD 84 9F     		call	get_baud		;we are at aligned speed, is the one we want?
  988+6271 30 04        		jr	nc,fos1			;C=speed reading not supported by given MBFW
  989+6273 CD 79 62     		call	switch_speed		;in case of MBFW 7, 12-> find out currently aligned speed
  990+6276 7A           		ld	a,d
  991+6277 57           fos1		ld	d,a			;D=curently aligned speed
  992+6278 C9           		ret
  993+6279
  994+6279              						;tests speeds <7-0>, then <max-8>
  995+6279              ;switch_speed	ld	a,7			;start with speeds 7-0 (quicker finds the speed)
  996+6279              ;		call	sws2
  997+6279              ;		ret	z			;Z= speed <0,7> found
  998+6279
  999+6279              ; --- DOKUMENTACE CZ: switch_speed ---
 1000+6279              ; Ucel: Zkouší rychlosti UART sestupně od maximální až po nulu.
 1001+6279              ; Vstup: (IX+8) = nejvyšší zkoušený index rychlosti.
 1002+6279              ; Vystup: Z = modul odpověděl OK, D = nalezený index; NZ = nenalezeno.
 1003+6279              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
 1004+6279              ; Poznamka: Mění UART a (IX+6), vyprazdňuje příjem.
 1005+6279              ; --- KONEC DOKUMENTACE CZ ---
 1006+6279 DD 7E 08     switch_speed	ld	a,(ix+8)		;try out every speed if you find connection UART+Wifi
 1007+627C              						;start with max speed, end with 0
 1008+627C F5           sws2		push	af
 1009+627D CD E6 7D     		call	set_print_speed
 1010+6280
 1011+6280 CD 86 9F     		call	clear_rece_buf		;very important to clear receive buffer!!!
 1012+6283

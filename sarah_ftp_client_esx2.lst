 8991+8476              ;128K bank-safe parser.
 8992+8476              ;IN: callers currently use SCF; C/NC is kept only for source compatibility.
 8993+8476              ;OUT=HL=name start in banked directory RAM
 8994+8476              ;    BC=16-bit name length
 8995+8476              ;    DE=16-bit file length for LIST abbreviated (0 for NLST/"..")
 8996+8476              ;    item_name_page=page-table pointer belonging to returned HL
 8997+8476              ;OUT=A=0 directory, A=1 file, A=2 NLST unknown type,
 8998+8476              ;      A=3 LIST full/malformed, A=4 synthetic ".."
 8999+8476              ;
 9000+8476              ;No temporary zero is written into the directory. The parser uses the stored
 9001+8476              ;16-bit item length as its boundary, so an item/name may cross 16K pages and
 9002+8476              ;may also be longer than 255 bytes.
 9003+8476 2A 5E 8E             ld      hl,(cur_item_addr)
 9004+8479 ED 5B C9 88          ld      de,(cur_item_addr_page)
 9005+847D CD 5C 6A             call    DIR128_MAP_DE
 9006+8480
 9007+8480                      ;Read item length LOW/HIGH. Even the length field may cross a page.
 9008+8480 7E                   ld      a,(hl)
 9009+8481 4F                   ld      c,a
 9010+8482 CD CD 69             call    DIR128_INC_HL
 9011+8485 DA 65 85             jp      c,gfn_bad
 9012+8488 7E                   ld      a,(hl)
 9013+8489 47                   ld      b,a
 9014+848A 78                   ld      a,b
 9015+848B B1                   or      c
 9016+848C CA 65 85             jp      z,gfn_bad
 9017+848F ED 43 BB 6F          ld      (gfn_remaining),bc      ;includes mark/info byte + stored data
 9018+8493
 9019+8493                      ;Move from header HIGH to mark/info byte (item+2).
 9020+8493 CD CD 69             call    DIR128_INC_HL
 9021+8496 DA 65 85             jp      c,gfn_bad
 9022+8499
 9023+8499                      ;Synthetic first item ".." is always page 0:#C000.
 9024+8499 E5                   push    hl

 2778+6A6D 57                   ld      d,a
 2779+6A6E 3A CD 8E             ld      a,(INPBUFF)             ;already normalized by find_items
 2780+6A71 BA                   cp      d                       ;Z=first character matches
 2781+6A72 C9                   ret

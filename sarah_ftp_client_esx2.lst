 4121+71E3              ; -----------------------------------------------------------------------------
 4122+71E3              ; item_add / item_sub - 128K bank-aware directory movement
 4123+71E3              ;
 4124+71E3              ; IN:
 4125+71E3              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
 4126+71E3              ;       DE = address of its 16-bit page-table-pointer companion
 4127+71E3              ;
 4128+71E3              ; Example:
 4129+71E3              ;       ld bc,cur_item_addr
 4130+71E3              ;       ld de,cur_item_addr_page
 4131+71E3              ;       call item_add
 4132+71E3              ;
 4133+71E3              ; OUT:
 4134+71E3              ;       Z  = cannot move (end/start of directory)
 4135+71E3              ;       NZ = pointer + its bank companion were moved to adjacent item
 4136+71E3              ;
 4137+71E3              ; The address variable and page variable deliberately do NOT have to be adjacent.
 4138+71E3              ; This keeps the original IX+... variable layout completely unchanged.
 4139+71E3              ; The two-byte item length at either end of an item may itself cross a bank.
 4140+71E3              ; -----------------------------------------------------------------------------
 4141+71E3              ; --- DOKUMENTACE CZ: item_add ---
 4142+71E3              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
 4143+71E3              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
 4144+71E3              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
 4145+71E3              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
 4146+71E3              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
 4147+71E3              ; --- KONEC DOKUMENTACE CZ ---
 4148+71E3              item_add
 4149+71E3 ED 43 7F 6F  		ld	(dir_op_addr_var),bc
 4150+71E7 ED 53 81 6F  		ld	(dir_op_page_var),de
 4151+71EB
 4152+71EB              		;Load physical item address from *(BC).
 4153+71EB 60           		ld	h,b
 4154+71EC 69           		ld	l,c
 4155+71ED 5E           		ld	e,(hl)
 4156+71EE 23           		inc	hl
 4157+71EF 56           		ld	d,(hl)
 4158+71F0 ED 53 77 6F  		ld	(next_item_addr),de	;temporary physical start
 4159+71F4 EB           		ex	de,hl			;HL=current physical item start
 4160+71F5
 4161+71F5              		;Load/map directory page from page companion variable.
 4162+71F5 E5           		push	hl
 4163+71F6 2A 81 6F     		ld	hl,(dir_op_page_var)
 4164+71F9 5E           		ld	e,(hl)
 4165+71FA 23           		inc	hl
 4166+71FB 56           		ld	d,(hl)
 4167+71FC E1           		pop	hl
 4168+71FD CD 32 6A     		call	DIR128_MAP_DE
 4169+7200
 4170+7200              		;Read item length LOW/HIGH. Header itself may cross #FFFF/#C000.
 4171+7200 7E           		ld	a,(hl)
 4172+7201 5F           		ld	e,a			;E=length LOW
 4173+7202 CD A3 69     		call	DIR128_INC_HL
 4174+7205 38 4C        		jr	c,item_add_end
 4175+7207 7E           		ld	a,(hl)
 4176+7208 57           		ld	d,a			;DE=item length
 4177+7209 B3           		or	e

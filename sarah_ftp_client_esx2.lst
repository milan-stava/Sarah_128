  932+6209              ;speed management 2.0. starts here. Enables to set user_defined speed. Works with every MBFW.
  933+6209              ;the principle:
  934+6209              ;are you aligned?
  935+6209              ;NO: try to align, if not success->error. If sucess, you have AKT (=current alligned speed is ;known). Is user defined speed definied? (IX+2=255 for no user defined speed) yes, END. NO. set ;speed according to ix+2 (max up to MBFW), end
  936+6209              ;
  937+6209              ;YES:
  938+6209              ;is user defined speed set? (ix+2=255 or other?) NO=check if FW is 7/12? YES, align at speed
  939+6209              ;ix+2, end. FW is higher then 7/12, then check if AKT=IX+2? YES, end, NO, align at ix+2, END.
  940+6209              ;ix+2 was not 255, is FW 7/12? YES, then set FWmax, end. NO the is AKT=MBFW max? YES, then END
  941+6209              ;NO, then align at FW max speed, end
  942+6209              ;output: ix+7= 0-23 if speed set, or 255 if not set
  943+6209
  944+6209              ;SM20 uses:
  945+6209              ;bit 4,(ix+0)	PRINT or not to PRINT
  946+6209              ;(ix+8)		contains maximum speed by detected MBFW (7, 12 or 23)
  947+6209              ;(ix+6)		timeout value
  948+6209              ;bit 6,(ix+0)	state of speed alignment between uart& module, 0 not aligned
  949+6209              ;bit 5,(ix+0)	state of module connection to AP, 0 not connected to AP
  950+6209
  951+6209              ;internal subroutines: switch_speed, find_out_speed
  952+6209              ;external subroutines: send_at:check_ok, set_ud_speed, set_print_speed, print_speed
  953+6209
  954+6209              ; --- DOKUMENTACE CZ: speed_management ---
  955+6209              ; Ucel: Sjednotí rychlost komunikace UART a Wi-Fi při inicializaci.
  956+6209              ; Vstup: Inicializovaný BIOS a příznaky na IX.
  957+6209              ; Vystup: Připravená komunikace nebo obsluha chyby.
  958+6209              ; Meni: AF, BC, DE, HL, BC'; další změny dle volaných BIOS/DOS a tiskových služeb.
  959+6209              ; Poznamka: Pracuje s konfigurací rychlosti, příjmovým bufferem a stavovým výpisem.
  960+6209              ; --- KONEC DOKUMENTACE CZ ---
  961+6209              speed_management
  962+6209 DD 36 07 FF  		ld	(ix+7),#FF		;reset currently set speed status
  963+620D DD CB 00 B6  		res	6,(ix+0)		;set signal UART and module speed not aligned

1066+ 62F5              ;switch_speed	ld	a,7			;start with speeds 7-0 (quicker finds the speed)
1067+ 62F5              ;		call	sws2
1068+ 62F5              ;		ret	z			;Z= speed <0,7> found
1069+ 62F5
1070+ 62F5              ; --- DOKUMENTACE CZ: switch_speed ---
1071+ 62F5              ; Ucel: Zkouší rychlosti UART sestupně od maximální až po nulu.
1072+ 62F5              ; Vstup: (IX+8) = nejvyšší zkoušený index rychlosti.
1073+ 62F5              ; Vystup: Z = modul odpověděl OK, D = nalezený index; NZ = nenalezeno.
1074+ 62F5              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
1075+ 62F5              ; Poznamka: Mění UART a (IX+6), vyprazdňuje příjem.
1076+ 62F5              ; --- KONEC DOKUMENTACE CZ ---
1077+ 62F5 DD 7E 08     switch_speed	ld	a,(ix+8)		;try out every speed if you find connection UART+Wifi
1078+ 62F8              						;start with max speed, end with 0
1079+ 62F8 F5           sws2		push	af
1080+ 62F9 CD 04 7C     		call	set_print_speed
1081+ 62FC 38 1B        		jr c,sws_unsupported ;do not report a UART setting rejected by BIOS
1082+ 62FE
1083+ 62FE F1           		pop	af			;we need to inrease timeout for speeds <3
1084+ 62FF F5           		push	af
1085+ 6300 FE 03        		cp	3
1086+ 6302 DD 36 06 01  		ld	(ix+6),1		;set timeout for 1 for speeds >3
1087+ 6306 30 04        		jr	nc,sws1
1088+ 6308 DD 36 06 0A  		ld	(ix+6),#A		;set tieout for #A for speeds <2
1089+ 630C
1090+ 630C CD CC 7B     sws1		call	send_at_check_ok
1091+ 630F D1           		pop	de
1092+ 6310 C8           		ret	z			;Z=answer found, D= speed set in HW
1093+ 6311 7A           sws_next ld	a,d
1094+ 6312 3D           		dec	a
1095+ 6313 FE FF        		cp	255			;test for 255, so that also speed 0 is tested
1096+ 6315 20 E1        		jr	nz,sws2
1097+ 6317 3D           		dec	a			;NZ=not successfull
1098+ 6318 C9           		ret
1099+ 6319 D1           sws_unsupported pop de
1100+ 631A 18 F5                jr sws_next

 4201+717A CD 2D 6A     		call	DIR128_MAP_DE
 4202+717D 3E 01        		ld	a,1
 4203+717F B7           		or	a			;NZ, NC
 4204+7180 C9           		ret
 4205+7181
 4206+7181              item_add_end
 4207+7181 AF           		xor	a			;Z = do not alter caller pointer variables
 4208+7182 C9           		ret

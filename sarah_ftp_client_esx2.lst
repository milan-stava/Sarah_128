4243+ 7087 72           		ld	(hl),d
4244+ 7088
4245+ 7088              		;Leave the bank containing the new item mapped.
4246+ 7088 CD C4 69     		call	DIR128_MAP_DE
4247+ 708B 3E 01        		ld	a,1
4248+ 708D B7           		or	a			;NZ, NC
4249+ 708E C9           		ret
4250+ 708F
4251+ 708F              item_add_end
4252+ 708F AF           		xor	a			;Z = do not alter caller pointer variables
4253+ 7090 C9           		ret

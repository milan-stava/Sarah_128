 1027+6279              ; --- DOKUMENTACE CZ: switch_speed ---
 1028+6279              ; Ucel: Zkouší rychlosti UART sestupně od maximální až po nulu.
 1029+6279              ; Vstup: (IX+8) = nejvyšší zkoušený index rychlosti.
 1030+6279              ; Vystup: Z = modul odpověděl OK, D = nalezený index; NZ = nenalezeno.
 1031+6279              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
 1032+6279              ; Poznamka: Mění UART a (IX+6), vyprazdňuje příjem.
 1033+6279              ; --- KONEC DOKUMENTACE CZ ---
 1034+6279 DD 7E 08     switch_speed	ld	a,(ix+8)		;try out every speed if you find connection UART+Wifi
 1035+627C              						;start with max speed, end with 0
 1036+627C F5           sws2		push	af
 1037+627D CD B5 7A     		call	set_print_speed

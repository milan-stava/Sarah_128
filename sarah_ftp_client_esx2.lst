 7698+7EEB              ; --- DOKUMENTACE CZ: error_handler ---
 7699+7EEB              ; Ucel: Zobrazí chybu, ukončí čekání a vrátí řízení na nejvyšší úroveň.
 7700+7EEB              ; Vstup: C = číslo chyby; inicializovaný hlavní zásobník.
 7701+7EEB              ; Vystup: Nevrací se běžně volajícímu: SP nastaví na basic_end-2.
 7702+7EEB              ; Meni: AF, BC, DE, HL, BC' (přes příjem odpovědi); další registry externích služeb viz jejich
 7703+7EEB              ;   rozhraní. SP.
 7704+7EEB              ; Poznamka: Obnovuje 3,5 MHz a vypíná pasivní příjem.
 7705+7EEB              ; --- KONEC DOKUMENTACE CZ ---
 7706+7EEB AF           error_handler xor a
 7707+7EEC 32 B8 A1                ld (upload_legacy_mode),a
 7708+7EEF C5                      push bc                ;preserve original error across clock switch
 7709+7EF0 CD BA 82                call set_3_5mhz
 7710+7EF3 C1                      pop bc
 7711+7EF4 3A 1F 7F                ld a,(error_recovering)
 7712+7EF7 B7                      or a
 7713+7EF8 20 16                   jr nz,error_handler_exit ;cleanup itself failed: do not recurse again
 7714+7EFA 3C                      inc a
 7715+7EFB 32 1F 7F                ld (error_recovering),a
 7716+7EFE CD 20 7F                call display_error
 7717+7F01 CD E0 7C                call wifi_unwait
 7718+7F04 CD B8 A5                call at_reset_stream
 7719+7F07 DD CB 00 76             bit 6,(ix+0)
 7720+7F0B 28 03                   jr z,error_handler_exit ;no cleanup AT commands at an unknown baud
 7721+7F0D CD 0C 84                call passive_receive_off ;one best-effort cleanup attempt only
 7722+7F10              error_handler_exit
 7723+7F10 AF                      xor a
 7724+7F11 32 1F 7F                ld (error_recovering),a
 7725+7F14 DD CB 00 76             bit 6,(ix+0)
 7726+7F18 CA 72 78                jp z,quit_keep_directory
 7727+7F1B 31 FE 5F                ld sp,basic_end-2
 7728+7F1E C9                      ret
 7729+7F1F 00           error_recovering db 0

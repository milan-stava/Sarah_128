2840+ 6B4A              ; -----------------------------------------------------------------------------
2841+ 6B4A              ; search_by_Busy_dir_slow
2842+ 6B4A              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
2843+ 6B4A              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
2844+ 6B4A              ; no longer slows down every ordinary FIND operation.
2845+ 6B4A              ;
2846+ 6B4A              ; One-character FIND is handled before this fallback and compares only the
2847+ 6B4A              ; first character.  This slow path therefore normally handles 2+ character
2848+ 6B4A              ; substring searches whose source name crosses a directory-bank boundary.
2849+ 6B4A              ; -----------------------------------------------------------------------------
2850+ 6B4A              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
2851+ 6B4A              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
2852+ 6B4A              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
2853+ 6B4A              ;   a délka.
2854+ 6B4A              ; Vystup: Z = shoda, NZ = nenalezeno.
2855+ 6B4A              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2856+ 6B4A              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
2857+ 6B4A              ; --- KONEC DOKUMENTACE CZ ---
2858+ 6B4A              search_by_Busy_dir_slow:
2859+ 6B4A 22 19 70             ld      (dir_search_addr),hl
2860+ 6B4D ED 43 1D 70          ld      (dir_search_remaining),bc
2861+ 6B51 ED 5B 12 70          ld      de,(item_name_page)
2862+ 6B55 ED 53 1B 70          ld      (dir_search_page),de
2863+ 6B59 2A 46 79             ld      hl,(txtlen+1)
2864+ 6B5C 22 1F 70             ld      (dir_search_patlen),hl
2865+ 6B5F 7C                   ld      a,h
2866+ 6B60 B5                   or      l
2867+ 6B61 28 56                jr      z,.dir_search_found
2868+ 6B63
2869+ 6B63              .dir_search_outer:
2870+ 6B63                      ;If remaining source length < pattern length, no further match exists.
2871+ 6B63 2A 1D 70             ld      hl,(dir_search_remaining)
2872+ 6B66 ED 5B 1F 70          ld      de,(dir_search_patlen)
2873+ 6B6A B7                   or      a
2874+ 6B6B ED 52                sbc     hl,de
2875+ 6B6D 38 4C                jr      c,.dir_search_not_found
2876+ 6B6F
2877+ 6B6F                      ;Start one comparison at current candidate address/page.
2878+ 6B6F 2A 19 70             ld      hl,(dir_search_addr)
2879+ 6B72 ED 5B 1B 70          ld      de,(dir_search_page)
2880+ 6B76 CD BB 6A             call    DIR128_MAP_DE
2881+ 6B79 11 9C 8E             ld      de,INPBUFF
2882+ 6B7C ED 4B 1F 70          ld      bc,(dir_search_patlen)
2883+ 6B80
2884+ 6B80              .dir_search_cmp:
2885+ 6B80 7E                   ld      a,(hl)
2886+ 6B81 CD 6A 79             call    convert                 ;source char -> lower case
2887+ 6B84 EB                   ex      de,hl
2888+ 6B85 BE                   cp      (hl)                    ;pattern already normalized by FIND
2889+ 6B86 EB                   ex      de,hl
2890+ 6B87 20 0D                jr      nz,.dir_search_advance_candidate
2891+ 6B89
2892+ 6B89 13                   inc     de
2893+ 6B8A 0B                   dec     bc
2894+ 6B8B 78                   ld      a,b
2895+ 6B8C B1                   or      c
2896+ 6B8D 28 2A                jr      z,.dir_search_found
2897+ 6B8F CD 2C 6A             call    DIR128_INC_HL
2898+ 6B92 38 27                jr      c,.dir_search_not_found

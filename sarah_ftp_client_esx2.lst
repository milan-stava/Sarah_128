2748+ 6A70              ; -----------------------------------------------------------------------------
2749+ 6A70              ; DIR128_COPY_NAME_TO_DE
2750+ 6A70              ; Copy the name returned by get_item_name to fixed RAM.
2751+ 6A70              ; IN:  HL = physical source address in directory window
2752+ 6A70              ;      BC = 16-bit name length
2753+ 6A70              ;      DE = fixed-RAM destination
2754+ 6A70              ;      item_name_page = page-table pointer belonging to HL
2755+ 6A70              ; OUT: DE points behind copied bytes, BC=0
2756+ 6A70              ; The source may cross any #FFFF -> #C000 directory-page boundary.
2757+ 6A70              ; -----------------------------------------------------------------------------
2758+ 6A70              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
2759+ 6A70              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
2760+ 6A70              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
2761+ 6A70              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
2762+ 6A70              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2763+ 6A70              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
2764+ 6A70              ; --- KONEC DOKUMENTACE CZ ---
2765+ 6A70              DIR128_COPY_NAME_TO_DE:
2766+ 6A70 D5                   push    de
2767+ 6A71 ED 5B C2 6F          ld      de,(item_name_page)
2768+ 6A75 CD 65 6A             call    DIR128_MAP_DE
2769+ 6A78 D1                   pop     de

7308+ 7B69              ;58) sends abort command (in order to abort existing command and get unstuck)
7309+ 7B69              ;send_ftp_command is the main routine that sends command+ string if needed and returns ftp answer code
7310+ 7B69              ;IN=A=0=command only (eg. "ABORT"). A=1=comamnd+prepared string from INPUT (eg. "STOR filename"), A=2=command+new INPUT
7311+ 7B69              ;OUT=A=0=NC=sent ok, awaited ftp code returned correctly
7312+ 7B69              ;A=1=C=c=1=error sending string
7313+ 7B69              ;A=2=C=c=11=error in module answer (expected answer ">" not returned)
7314+ 7B69              ;A=3=C=c=4=sent ok, but return code other than expected
7315+ 7B69              ; --- DOKUMENTACE CZ: send_abort ---
7316+ 7B69              ; Ucel: Odešle FTP příkaz ABOR prostřednictvím send_ftp_command.
7317+ 7B69              ; Vstup: DE = očekávaný FTP návratový kód.
7318+ 7B69              ; Vystup: Stejné rozhraní jako send_ftp_command.
7319+ 7B69              ; Meni: AF, BC, DE, HL, BC' (přes příjem odpovědi); další registry externích služeb viz jejich
7320+ 7B69              ;   rozhraní.
7321+ 7B69              ; --- KONEC DOKUMENTACE CZ ---
7322+ 7B69 AF           send_abort	xor	a
7323+ 7B6A 21 22 86     		ld	hl,ftp_abor
7324+ 7B6D              ; --- DOKUMENTACE CZ: send_ftp_command ---
7325+ 7B6D              ; Ucel: Sestaví, odešle a vyhodnotí FTP příkaz na řídicím spojení.
7326+ 7B6D              ; Vstup: HL = příkaz, DE = očekávaný FTP kód; A=0 bez parametru, 1 parametr v INPBUFF, 2 nový
7327+ 7B6D              ;   vstup.
7328+ 7B6D              ; Vystup: NC a A=0 = očekávaná odpověď; C = chyba. HL = přijatý kód při vyhodnocené odpovědi.
7329+ 7B6D              ; Meni: AF, BC, DE, HL, BC' (přes příjem odpovědi); další registry externích služeb viz jejich
7330+ 7B6D              ;   rozhraní.
7331+ 7B6D              ; Poznamka: Mění TX_buf/RX_buf; navazuje přímo na cipsend_request. Zrušení vstupu může obnovit
7332+ 7B6D              ;   zásobník a přejít do hlavní smyčky.

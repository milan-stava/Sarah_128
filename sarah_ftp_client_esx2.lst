 3447+6FCE
 3448+6FCE
 3449+6FCE 3E C3        		ld	a,#C3		;"jp"= abbreviated
 3450+6FD0 01 35 71     		ld	bc,dr5_skip
 3451+6FD3 11 86 70     dr1		ld	de,dr_switch
 3452+6FD6 12           		ld	(de),a
 3453+6FD7 13           		inc	de
 3454+6FD8 79           		ld	a,c
 3455+6FD9 12           		ld	(de),a
 3456+6FDA 13           		inc	de
 3457+6FDB 78           		ld	a,b

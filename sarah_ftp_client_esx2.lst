2952+ 6A1A              ; -----------------------------------------------------------------------------
2953+ 6A1A              ; search_by_Busy_fast
2954+ 6A1A              ; Fast case-insensitive substring search for a name fully contained in the
2955+ 6A1A              ; currently mapped 16K directory page.
2956+ 6A1A              ;
2957+ 6A1A              ; IN:  HL = name start, BC = 16-bit name length
2958+ 6A1A              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
2959+ 6A1A              ; OUT: Z = found, NZ = not found
2960+ 6A1A              ;
2961+ 6A1A              ; This is deliberately close to the original Busy FIND: the inner compare uses
2962+ 6A1A              ; the Z80 CPI instruction.  The pattern has already been converted to lower
2963+ 6A1A              ; case once by find_items, so only the source character needs convert here.
2964+ 6A1A              ;
2965+ 6A1A              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
2966+ 6A1A              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
2967+ 6A1A              ; matches therefore cannot be skipped.
2968+ 6A1A              ; -----------------------------------------------------------------------------
2969+ 6A1A              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
2970+ 6A1A              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
2971+ 6A1A              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
2972+ 6A1A              ;   délka.
2973+ 6A1A              ; Vystup: Z = shoda, NZ = nenalezeno.
2974+ 6A1A              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2975+ 6A1A              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
2976+ 6A1A              ; --- KONEC DOKUMENTACE CZ ---
2977+ 6A1A              search_by_Busy_fast:
2978+ 6A1A EB                   ex      de,hl                   ;DE=current candidate in file name
2979+ 6A1B
2980+ 6A1B                      ; candidate_count = name_length - pattern_length + 1
2981+ 6A1B 60                   ld      h,b
2982+ 6A1C 69                   ld      l,c
2983+ 6A1D ED 4B 31 77          ld      bc,(txtlen+1)
2984+ 6A21 78                   ld      a,b
2985+ 6A22 B1                   or      c
2986+ 6A23 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
2987+ 6A25 B7                   or      a
2988+ 6A26 ED 42                sbc     hl,bc
2989+ 6A28 38 25                jr      c,.fast_not_found       ;pattern longer than file name
2990+ 6A2A 23                   inc     hl
2991+ 6A2B
2992+ 6A2B                      ; Keep number of possible candidate starts in alternate BC.
2993+ 6A2B E5                   push    hl
2994+ 6A2C D9                   exx
2995+ 6A2D C1                   pop     bc
2996+ 6A2E D9                   exx
2997+ 6A2F
2998+ 6A2F              .fast_next_candidate:
2999+ 6A2F D5                   push    de                      ;remember exact candidate start
3000+ 6A30 21 DA 8B             ld      hl,INPBUFF
3001+ 6A33 ED 4B 31 77          ld      bc,(txtlen+1)
3002+ 6A37
3003+ 6A37              .fast_compare:
3004+ 6A37 1A                   ld      a,(de)
3005+ 6A38 CD 55 77             call    convert                 ;source char -> lower case
3006+ 6A3B ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
3007+ 6A3D 13                   inc     de
3008+ 6A3E 20 06                jr      nz,.fast_candidate_failed
3009+ 6A40 EA 37 6A             jp      pe,.fast_compare        ;matched, more pattern bytes remain
3010+ 6A43
3011+ 6A43 D1                   pop     de                      ;discard saved candidate start
3012+ 6A44              .fast_found:
3013+ 6A44 AF                   xor     a                       ;Z = found
3014+ 6A45 C9                   ret
3015+ 6A46
3016+ 6A46              .fast_candidate_failed:
3017+ 6A46 D1                   pop     de                      ;restore previous candidate start
3018+ 6A47 13                   inc     de                      ;next candidate = previous + 1
3019+ 6A48 D9                   exx
3020+ 6A49 0B                   dec     bc
3021+ 6A4A 78                   ld      a,b
3022+ 6A4B B1                   or      c
3023+ 6A4C D9                   exx
3024+ 6A4D 20 E0                jr      nz,.fast_next_candidate
3025+ 6A4F
3026+ 6A4F              .fast_not_found:
3027+ 6A4F 3E 01                ld      a,1
3028+ 6A51 B7                   or      a                       ;NZ = not found
3029+ 6A52 C9                   ret

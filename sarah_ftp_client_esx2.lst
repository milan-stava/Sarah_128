   12+A5D5 C1                   pop     bc
   13+A5D6 DD CB 00 76          bit     6,(ix+0)
   14+A5DA CA 31 A6             jp      z,ftp_recovery_failed ; never send AT at an unknown baud
   15+A5DD CD 3C A6             call    ftp_mark_disconnected
   16+A5E0 CD F3 A4             call    at_reset_stream
   17+A5E3 CD 01 A1             call    at_probe_drain   ; bounded discard of replies from the old session
   18+A5E6 21 42 89             ld      hl,at_cipclose5  ; drop BOTH old data and control connections
   19+A5E9 CD E3 A0             call    at_send_ok
   20+A5EC 30 24                jr      nc,.closed
   21+A5EE FE 02                cp      AT_ERROR
   22+A5F0 0E 2B                ld      c,43
   23+A5F2 C2 31 A6             jp      nz,ftp_recovery_failed
   24+A5F5                      ; ERROR may mean all sockets were already closed. Verify, never assume.
   25+A5F5 21 E6 88             ld      hl,cipstatus
   26+A5F8 CD A1 79             call    send_string
   27+A5FB 0E 2B                ld      c,43
   28+A5FD C2 31 A6             jp      nz,ftp_recovery_failed
   29+A600 CD 04 A5             call    at_status_response
   30+A603 0E 2B                ld      c,43
   31+A605 DA 31 A6             jp      c,ftp_recovery_failed
   32+A608 3A C4 A5             ld      a,(at_status_haslink)
   33+A60B 21 C1 A5             ld      hl,at_status_data
   34+A60E B6                   or      (hl)
   35+A60F C2 31 A6             jp      nz,ftp_recovery_failed
   36+A612              .closed:
   37+A612 CD 01 A1             call    at_probe_drain
   38+A615 0E 31                ld      c,49
   39+A617 DA 31 A6             jp      c,ftp_recovery_failed
   40+A61A CD F3 A4             call    at_reset_stream

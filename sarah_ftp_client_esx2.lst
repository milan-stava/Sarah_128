2762+ 6B16              ; -----------------------------------------------------------------------------
2763+ 6B16              ; search_by_Busy_fast
2764+ 6B16              ; Fast case-insensitive substring search for a name fully contained in the
2765+ 6B16              ; currently mapped 16K directory page.
2766+ 6B16              ;
2767+ 6B16              ; IN:  HL = name start, BC = 16-bit name length
2768+ 6B16              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
2769+ 6B16              ; OUT: Z = found, NZ = not found
2770+ 6B16              ;
2771+ 6B16              ; This is deliberately close to the original Busy FIND: the inner compare uses
2772+ 6B16              ; the Z80 CPI instruction.  The pattern has already been converted to lower
2773+ 6B16              ; case once by find_items, so only the source character needs convert here.
2774+ 6B16              ;
2775+ 6B16              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
2776+ 6B16              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
2777+ 6B16              ; matches therefore cannot be skipped.
2778+ 6B16              ; -----------------------------------------------------------------------------
2779+ 6B16              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
2780+ 6B16              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
2781+ 6B16              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
2782+ 6B16              ;   délka.
2783+ 6B16              ; Vystup: Z = shoda, NZ = nenalezeno.
2784+ 6B16              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
2785+ 6B16              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
2786+ 6B16              ; --- KONEC DOKUMENTACE CZ ---
2787+ 6B16              search_by_Busy_fast:
2788+ 6B16 EB                   ex      de,hl                   ;DE=current candidate in file name
2789+ 6B17
2790+ 6B17                      ; candidate_count = name_length - pattern_length + 1
2791+ 6B17 60                   ld      h,b
2792+ 6B18 69                   ld      l,c
2793+ 6B19 ED 4B 91 79          ld      bc,(txtlen+1)
2794+ 6B1D 78                   ld      a,b
2795+ 6B1E B1                   or      c
2796+ 6B1F 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
2797+ 6B21 B7                   or      a
2798+ 6B22 ED 42                sbc     hl,bc
2799+ 6B24 38 25                jr      c,.fast_not_found       ;pattern longer than file name
2800+ 6B26 23                   inc     hl
2801+ 6B27
2802+ 6B27                      ; Keep number of possible candidate starts in alternate BC.
2803+ 6B27 E5                   push    hl
2804+ 6B28 D9                   exx
2805+ 6B29 C1                   pop     bc
2806+ 6B2A D9                   exx
2807+ 6B2B
2808+ 6B2B              .fast_next_candidate:
2809+ 6B2B D5                   push    de                      ;remember exact candidate start
2810+ 6B2C 21 E7 8E             ld      hl,INPBUFF
2811+ 6B2F ED 4B 91 79          ld      bc,(txtlen+1)
2812+ 6B33
2813+ 6B33              .fast_compare:
2814+ 6B33 1A                   ld      a,(de)
2815+ 6B34 CD B5 79             call    convert                 ;source char -> lower case
2816+ 6B37 ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
2817+ 6B39 13                   inc     de
2818+ 6B3A 20 06                jr      nz,.fast_candidate_failed
2819+ 6B3C EA 33 6B             jp      pe,.fast_compare        ;matched, more pattern bytes remain
2820+ 6B3F
2821+ 6B3F D1                   pop     de                      ;discard saved candidate start
2822+ 6B40              .fast_found:
2823+ 6B40 AF                   xor     a                       ;Z = found
2824+ 6B41 C9                   ret
2825+ 6B42
2826+ 6B42              .fast_candidate_failed:
2827+ 6B42 D1                   pop     de                      ;restore previous candidate start
2828+ 6B43 13                   inc     de                      ;next candidate = previous + 1
2829+ 6B44 D9                   exx
2830+ 6B45 0B                   dec     bc
2831+ 6B46 78                   ld      a,b
2832+ 6B47 B1                   or      c
2833+ 6B48 D9                   exx
2834+ 6B49 20 E0                jr      nz,.fast_next_candidate
2835+ 6B4B
2836+ 6B4B              .fast_not_found:
2837+ 6B4B 3E 01                ld      a,1
2838+ 6B4D B7                   or      a                       ;NZ = not found
2839+ 6B4E C9                   ret

2844+ 69CF              ; -----------------------------------------------------------------------------
2845+ 69CF              ; DIR128_COPY_NAME_TO_DE
2846+ 69CF              ; Copy the name returned by get_item_name to fixed RAM.
2847+ 69CF              ; IN:  HL = physical source address in directory window
2848+ 69CF              ;      BC = 16-bit name length
2849+ 69CF              ;      DE = fixed-RAM destination
2850+ 69CF              ;      item_name_page = page-table pointer belonging to HL
2851+ 69CF              ; OUT: DE points behind copied bytes, BC=0
2852+ 69CF              ; The source may cross any #FFFF -> #C000 directory-page boundary.
2853+ 69CF              ; -----------------------------------------------------------------------------
2854+ 69CF              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
2855+ 69CF              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
2856+ 69CF              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
2857+ 69CF              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
2858+ 69CF              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
2859+ 69CF              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
2860+ 69CF              ; --- KONEC DOKUMENTACE CZ ---
2861+ 69CF              DIR128_COPY_NAME_TO_DE:
2862+ 69CF D5                   push    de
2863+ 69D0 ED 5B B2 6E          ld      de,(item_name_page)
2864+ 69D4 CD C4 69             call    DIR128_MAP_DE
2865+ 69D7 D1                   pop     de

   42+A620 31 FE 5F             ld      sp,basic_end-2  ; discard calls belonging to the failed operation
   43+A623 21 2A A6             ld      hl,ftp_recovery_done
   44+A626 E5                   push    hl
   45+A627 C3 1E 69             jp      auto_login      ; configured host/user/password; fresh listing on success
   46+A62A

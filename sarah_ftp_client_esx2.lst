 4194+7170 2A 7C 6F     		ld	hl,(dir_op_page_var)
 4195+7173 ED 5B 74 6F  		ld	de,(next_item_page)
 4196+7177 73           		ld	(hl),e
 4197+7178 23           		inc	hl
 4198+7179 72           		ld	(hl),d

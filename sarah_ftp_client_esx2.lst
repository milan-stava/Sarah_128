 4391+748C              ; -----------------------------------------------------------------------------
 4392+748C              ; item_add / item_sub - 128K bank-aware directory movement
 4393+748C              ;
 4394+748C              ; IN:
 4395+748C              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
 4396+748C              ;       DE = address of its 16-bit page-table-pointer companion
 4397+748C              ;
 4398+748C              ; Example:
 4399+748C              ;       ld bc,cur_item_addr
 4400+748C              ;       ld de,cur_item_addr_page
 4401+748C              ;       call item_add
 4402+748C              ;
 4403+748C              ; OUT:
 4404+748C              ;       Z  = cannot move (end/start of directory)
 4405+748C              ;       NZ = pointer + its bank companion were moved to adjacent item
 4406+748C              ;
 4407+748C              ; The address variable and page variable deliberately do NOT have to be adjacent.
 4408+748C              ; This keeps the original IX+... variable layout completely unchanged.
 4409+748C              ; The two-byte item length at either end of an item may itself cross a bank.
 4410+748C              ; -----------------------------------------------------------------------------
 4411+748C              ; --- DOKUMENTACE CZ: item_add ---
 4412+748C              ; Ucel: Posune uložený ukazatel na sousední položku adresáře (add vpřed, sub zpět).
 4413+748C              ; Vstup: BC = adresa proměnné s adresou položky; DE = adresa proměnné s ukazatelem banky.
 4414+748C              ; Vystup: NZ = ukazatele aktualizovány; Z = hranice, proměnné ukazatelů nezměněny.
 4415+748C              ; Meni: AF, DE, HL; BC, IX a IY zachovány.
 4416+748C              ; Poznamka: Používá dir_op_*, next_item_* a mění mapování RAM i při neúspěšném hledání souseda.
 4417+748C              ; --- KONEC DOKUMENTACE CZ ---
 4418+748C              item_add
 4419+748C ED 43 13 73  		ld	(dir_op_addr_var),bc
 4420+7490 ED 53 15 73  		ld	(dir_op_page_var),de
 4421+7494
 4422+7494              		;Load physical item address from *(BC).
 4423+7494 60           		ld	h,b
 4424+7495 69           		ld	l,c
 4425+7496 5E           		ld	e,(hl)
 4426+7497 23           		inc	hl
 4427+7498 56           		ld	d,(hl)
 4428+7499 ED 53 0B 73  		ld	(next_item_addr),de	;temporary physical start
 4429+749D EB           		ex	de,hl			;HL=current physical item start

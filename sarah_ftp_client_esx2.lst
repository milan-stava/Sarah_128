 2931+6AF4              ; -----------------------------------------------------------------------------
 2932+6AF4              ; search_by_Busy_dir_slow
 2933+6AF4              ; Fully bank-safe fallback. It is used only when a file name itself crosses a
 2934+6AF4              ; #FFFF -> #C000 directory-page boundary. Such names are rare, so paging cost
 2935+6AF4              ; no longer slows down every ordinary FIND operation.
 2936+6AF4              ;
 2937+6AF4              ; One-character FIND is handled before this fallback and compares only the
 2938+6AF4              ; first character.  This slow path therefore normally handles 2+ character
 2939+6AF4              ; substring searches whose source name crosses a directory-bank boundary.
 2940+6AF4              ; -----------------------------------------------------------------------------
 2941+6AF4              ; --- DOKUMENTACE CZ: search_by_Busy_dir_slow ---
 2942+6AF4              ; Ucel: Vyhledá podřetězec i přes hranice bank adresáře.
 2943+6AF4              ; Vstup: HL = jméno, BC = délka, item_name_page = banka; INPBUFF a txtlen+1 = normalizovaný vzor
 2944+6AF4              ;   a délka.
 2945+6AF4              ; Vystup: Z = shoda, NZ = nenalezeno.
 2946+6AF4              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 2947+6AF4              ; Poznamka: Používá pracovní proměnné dir_search_* a mění mapování RAM.
 2948+6AF4              ; --- KONEC DOKUMENTACE CZ ---
 2949+6AF4              search_by_Busy_dir_slow:
 2950+6AF4 22 C9 6F             ld      (dir_search_addr),hl
 2951+6AF7 ED 43 CD 6F          ld      (dir_search_remaining),bc
 2952+6AFB ED 5B C2 6F          ld      de,(item_name_page)
 2953+6AFF ED 53 CB 6F          ld      (dir_search_page),de
 2954+6B03 2A 4C 79             ld      hl,(txtlen+1)
 2955+6B06 22 CF 6F             ld      (dir_search_patlen),hl
 2956+6B09 7C                   ld      a,h
 2957+6B0A B5                   or      l
 2958+6B0B 28 56                jr      z,.dir_search_found
 2959+6B0D
 2960+6B0D              .dir_search_outer:
 2961+6B0D                      ;If remaining source length < pattern length, no further match exists.
 2962+6B0D 2A CD 6F             ld      hl,(dir_search_remaining)
 2963+6B10 ED 5B CF 6F          ld      de,(dir_search_patlen)
 2964+6B14 B7                   or      a
 2965+6B15 ED 52                sbc     hl,de
 2966+6B17 38 4C                jr      c,.dir_search_not_found
 2967+6B19
 2968+6B19                      ;Start one comparison at current candidate address/page.
 2969+6B19 2A C9 6F             ld      hl,(dir_search_addr)
 2970+6B1C ED 5B CB 6F          ld      de,(dir_search_page)
 2971+6B20 CD 65 6A             call    DIR128_MAP_DE
 2972+6B23 11 81 8F             ld      de,INPBUFF
 2973+6B26 ED 4B CF 6F          ld      bc,(dir_search_patlen)
 2974+6B2A
 2975+6B2A              .dir_search_cmp:
 2976+6B2A 7E                   ld      a,(hl)
 2977+6B2B CD 70 79             call    convert                 ;source char -> lower case
 2978+6B2E EB                   ex      de,hl
 2979+6B2F BE                   cp      (hl)                    ;pattern already normalized by FIND
 2980+6B30 EB                   ex      de,hl
 2981+6B31 20 0D                jr      nz,.dir_search_advance_candidate
 2982+6B33
 2983+6B33 13                   inc     de
 2984+6B34 0B                   dec     bc
 2985+6B35 78                   ld      a,b
 2986+6B36 B1                   or      c
 2987+6B37 28 2A                jr      z,.dir_search_found
 2988+6B39 CD D6 69             call    DIR128_INC_HL
 2989+6B3C 38 27                jr      c,.dir_search_not_found
 2990+6B3E 18 EA                jr      .dir_search_cmp
 2991+6B40
 2992+6B40              .dir_search_advance_candidate:
 2993+6B40                      ;Always advance by exactly ONE source character.  This fixes both the
 2994+6B40                      ;old overlapping-match bug and the old one-character special case.
 2995+6B40 2A C9 6F             ld      hl,(dir_search_addr)
 2996+6B43 ED 5B CB 6F          ld      de,(dir_search_page)
 2997+6B47 CD 65 6A             call    DIR128_MAP_DE
 2998+6B4A CD D6 69             call    DIR128_INC_HL
 2999+6B4D 38 16                jr      c,.dir_search_not_found
 3000+6B4F 22 C9 6F             ld      (dir_search_addr),hl
 3001+6B52 ED 5B F6 BF          ld      de,(fdp_pointer)
 3002+6B56 ED 53 CB 6F          ld      (dir_search_page),de
 3003+6B5A 2A CD 6F             ld      hl,(dir_search_remaining)
 3004+6B5D 2B                   dec     hl
 3005+6B5E 22 CD 6F             ld      (dir_search_remaining),hl
 3006+6B61 18 AA                jr      .dir_search_outer

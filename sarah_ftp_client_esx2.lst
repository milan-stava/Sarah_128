5461+ 7919 13                inc de           ;   6 : 13
5462+ 791A                                    ;
5463+ 791A 44                ld b,h           ;   4 : 44
5464+ 791B 4D                ld c,l           ;   4 : 4D
5465+ 791C 29                add hl,hl        ;  11 : 29
5466+ 791D 29                add hl,hl        ;  11 : 29
5467+ 791E 09                add hl,bc        ;  11 : 09
5468+ 791F 29                add hl,hl        ;  11 : 29
5469+ 7920                                    ;
5470+ 7920 85                add a,l          ;   4 : 85
5471+ 7921 6F                ld l,a           ;   4 : 6F
5472+ 7922 30 EF             jr nc,ConvLoop   ;12|23: 30EE
5473+ 7924 24                inc h            ; --- : 24
5474+ 7925 18 EC             jr ConvLoop      ; --- : 18EB

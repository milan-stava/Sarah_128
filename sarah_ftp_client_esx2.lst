1044+ 62E1              ; --- DOKUMENTACE CZ: find_out_speed ---
1045+ 62E1              ; Ucel: Zjistí index aktuální rychlosti UART, případně rychlosti vyzkouší.
1046+ 62E1              ; Vstup: IX = flag1; dostupné služby get_baud/set_baud.
1047+ 62E1              ; Vystup: D = index zjištěné rychlosti při úspěchu.
1048+ 62E1              ; Meni: AF, BC, DE, HL; další změny dle volaných tiskových/klávesnicových služeb.
1049+ 62E1              ; Poznamka: Při nepodporovaném get_baud používá switch_speed; jeho neúspěch nepovažujte za
1050+ 62E1              ;   platnou rychlost.
1051+ 62E1              ; --- KONEC DOKUMENTACE CZ ---
1052+ 62E1              find_out_speed
1053+ 62E1 CD 00 A6             call get_baud
1054+ 62E4 30 06                jr nc,.known
1055+ 62E6 CD F5 62             call switch_speed
1056+ 62E9 20 08                jr nz,.failed
1057+ 62EB 7A                   ld a,d
1058+ 62EC FE 18        .known  cp 24
1059+ 62EE 30 03                jr nc,.failed
1060+ 62F0 57                   ld d,a
1061+ 62F1 B7                   or a
1062+ 62F2 C9                   ret
1063+ 62F3 37           .failed scf
1064+ 62F4 C9                   ret

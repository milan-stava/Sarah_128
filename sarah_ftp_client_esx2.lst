  945+620B DD 77 08     		ld	(ix+8),a		;save max possible speed for given FW
  946+620E
  947+620E DD 36 06 01  		ld	(ix+6),1		;timeout for quick AT check, 1 should be ok.
  948+6212 CD 7D 7A     		call	send_at_check_ok
  949+6215 28 1F        		jr	z,speed_aligned		;Z= speed aligned (UART<-> module)
  950+6217

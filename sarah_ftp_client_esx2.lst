4113+ 7317              ; item_add / item_sub - 128K bank-aware directory movement
4114+ 7317              ;
4115+ 7317              ; IN:
4116+ 7317              ;       BC = address of the 16-bit physical pointer variable (#C000-#FFFF)
4117+ 7317              ;       DE = address of its 16-bit page-table-pointer companion
4118+ 7317              ;
4119+ 7317              ; Example:
4120+ 7317              ;       ld bc,cur_item_addr
4121+ 7317              ;       ld de,cur_item_addr_page
4122+ 7317              ;       call item_add
4123+ 7317              ;

 2804+6A83              ; -----------------------------------------------------------------------------
 2805+6A83              ; search_by_Busy_fast
 2806+6A83              ; Fast case-insensitive substring search for a name fully contained in the
 2807+6A83              ; currently mapped 16K directory page.
 2808+6A83              ;
 2809+6A83              ; IN:  HL = name start, BC = 16-bit name length
 2810+6A83              ;      pattern = INPBUFF, pattern length = value patched into txtlen+1
 2811+6A83              ; OUT: Z = found, NZ = not found
 2812+6A83              ;
 2813+6A83              ; This is deliberately close to the original Busy FIND: the inner compare uses
 2814+6A83              ; the Z80 CPI instruction.  The pattern has already been converted to lower
 2815+6A83              ; case once by find_items, so only the source character needs convert here.
 2816+6A83              ;
 2817+6A83              ; Bugfix against the old search_by_Busy: after a failed PARTIAL match DE is
 2818+6A83              ; restored to the exact candidate start and advanced by ONE byte.  Overlapping
 2819+6A83              ; matches therefore cannot be skipped.
 2820+6A83              ; -----------------------------------------------------------------------------
 2821+6A83              ; --- DOKUMENTACE CZ: search_by_Busy_fast ---
 2822+6A83              ; Ucel: Vyhledá podřetězec bez rozlišení velikosti písmen v jedné bance.
 2823+6A83              ; Vstup: HL = jméno, BC = délka; INPBUFF = vzor převedený na malá písmena, txtlen+1 = jeho
 2824+6A83              ;   délka.
 2825+6A83              ; Vystup: Z = shoda, NZ = nenalezeno.
 2826+6A83              ; Meni: AF, BC, DE, HL, BC'; IX a IY zachovány.
 2827+6A83              ; Poznamka: Celé jméno musí ležet v aktuálně namapované bance.
 2828+6A83              ; --- KONEC DOKUMENTACE CZ ---
 2829+6A83              search_by_Busy_fast:
 2830+6A83 EB                   ex      de,hl                   ;DE=current candidate in file name
 2831+6A84
 2832+6A84                      ; candidate_count = name_length - pattern_length + 1
 2833+6A84 60                   ld      h,b
 2834+6A85 69                   ld      l,c
 2835+6A86 ED 4B 42 78          ld      bc,(txtlen+1)
 2836+6A8A 78                   ld      a,b
 2837+6A8B B1                   or      c
 2838+6A8C 28 1F                jr      z,.fast_found           ;empty pattern (normally impossible)
 2839+6A8E B7                   or      a
 2840+6A8F ED 42                sbc     hl,bc
 2841+6A91 38 25                jr      c,.fast_not_found       ;pattern longer than file name
 2842+6A93 23                   inc     hl
 2843+6A94
 2844+6A94                      ; Keep number of possible candidate starts in alternate BC.
 2845+6A94 E5                   push    hl
 2846+6A95 D9                   exx
 2847+6A96 C1                   pop     bc
 2848+6A97 D9                   exx
 2849+6A98
 2850+6A98              .fast_next_candidate:
 2851+6A98 D5                   push    de                      ;remember exact candidate start
 2852+6A99 21 CD 8E             ld      hl,INPBUFF
 2853+6A9C ED 4B 42 78          ld      bc,(txtlen+1)
 2854+6AA0
 2855+6AA0              .fast_compare:
 2856+6AA0 1A                   ld      a,(de)
 2857+6AA1 CD 66 78             call    convert                 ;source char -> lower case
 2858+6AA4 ED A1                cpi                             ;CP (HL), INC HL, DEC BC, P/V=(BC!=0)
 2859+6AA6 13                   inc     de
 2860+6AA7 20 06                jr      nz,.fast_candidate_failed
 2861+6AA9 EA A0 6A             jp      pe,.fast_compare        ;matched, more pattern bytes remain
 2862+6AAC
 2863+6AAC D1                   pop     de                      ;discard saved candidate start
 2864+6AAD              .fast_found:
 2865+6AAD AF                   xor     a                       ;Z = found
 2866+6AAE C9                   ret
 2867+6AAF
 2868+6AAF              .fast_candidate_failed:
 2869+6AAF D1                   pop     de                      ;restore previous candidate start
 2870+6AB0 13                   inc     de                      ;next candidate = previous + 1
 2871+6AB1 D9                   exx
 2872+6AB2 0B                   dec     bc
 2873+6AB3 78                   ld      a,b
 2874+6AB4 B1                   or      c
 2875+6AB5 D9                   exx
 2876+6AB6 20 E0                jr      nz,.fast_next_candidate
 2877+6AB8
 2878+6AB8              .fast_not_found:
 2879+6AB8 3E 01                ld      a,1
 2880+6ABA B7                   or      a                       ;NZ = not found
 2881+6ABB C9                   ret

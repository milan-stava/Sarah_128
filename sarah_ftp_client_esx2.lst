 6574+7BE1              ; --- DOKUMENTACE CZ: convASCII2hex ---
 6575+7BE1              ; Ucel: Složí dolní půlbajty dvou znaků do jednoho bajtu.
 6576+7BE1              ; Vstup: HL = adresa dvou ASCII číslic, např. "14".
 6577+7BE1              ; Vystup: A = #14 pro vstup "14"; HL ukazuje na druhý znak.
 6578+7BE1              ; Meni: AF, E, HL; D, BC, IX a IY zachovány.
 6579+7BE1              ; Poznamka: Není obecný hexadecimální parser: nepřevádí písmena A–F.
 6580+7BE1              ; --- KONEC DOKUMENTACE CZ ---
 6581+7BE1              convASCII2hex
 6582+7BE1              ;IN=HL ASCII number address (2 digits) eg. hl,14
 6583+7BE1              ;OUT=A=#14
 6584+7BE1 7E           		ld	a,(hl)
 6585+7BE2 E6 0F        		and	%00001111
 6586+7BE4 CB 27        		sla	a
 6587+7BE6 CB 27        		sla	a
 6588+7BE8 CB 27        		sla	a
 6589+7BEA CB 27        		sla	a
 6590+7BEC 5F           		ld	e,a
 6591+7BED 23           		inc	hl
 6592+7BEE 7E           		ld	a,(hl)
 6593+7BEF E6 0F        		and	%00001111
 6594+7BF1 B3           		or	e
 6595+7BF2 C9           		ret

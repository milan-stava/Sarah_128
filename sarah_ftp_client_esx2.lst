 2536+69B2              ; -----------------------------------------------------------------------------
 2537+69B2              ; FTP DIRECTORY BANK API
 2538+69B2              ;
 2539+69B2              ; fdp_pointer always points to the table byte of the CURRENT directory page.
 2540+69B2              ; ftp_dir_page has #FF sentinels on both sides:
 2541+69B2              ;       #FF, 0, 1, 3, 7, #FF
 2542+69B2              ;
 2543+69B2              ; HL is always a physical address in the banked window #C000-#FFFF.
 2544+69B2              ; DIR128_INC_HL / DIR128_DEC_HL transparently cross page boundaries.
 2545+69B2              ;
 2546+69B2              ; OUT for INC/DEC:
 2547+69B2              ;       NC = movement succeeded
 2548+69B2              ;       C  = no next/previous directory page (64 KB boundary)
 2549+69B2              ;
 2550+69B2              ; General helper uses Carry for status. FTP receive parser uses DIR128_INC_HL_PARSER,
 2551+69B2              ; which preserves AF/BC/DE/IX/IY exactly.
 2552+69B2              ; -----------------------------------------------------------------------------
 2553+69B2
 2554+69B2              ; --- DOKUMENTACE CZ: DIR128_MAP_CURRENT ---
 2555+69B2              ; Ucel: Namapuje aktuální banku adresáře do #C000–#FFFF.
 2556+69B2              ; Vstup: fdp_pointer ukazuje do tabulky ftp_dir_page.
 2557+69B2              ; Vystup: NC = platná banka, C = sentinel #FF.
 2558+69B2              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
 2559+69B2              ; Poznamka: Mění PAGE128_STATE a port #7FFD.
 2560+69B2              ; --- KONEC DOKUMENTACE CZ ---
 2561+69B2              DIR128_MAP_CURRENT:
 2562+69B2 E5                   push    hl
 2563+69B3 D5                   push    de
 2564+69B4 ED 5B F6 BF          ld      de,(fdp_pointer)
 2565+69B8 1A                   ld      a,(de)
 2566+69B9 FE FF                cp      #FF
 2567+69BB 28 07                jr      z,DIR128_MAP_BAD
 2568+69BD CD E0 BF             call    PAGE128
 2569+69C0 D1                   pop     de
 2570+69C1 E1                   pop     hl
 2571+69C2 B7                   or      a                       ;NC = valid page
 2572+69C3 C9                   ret
 2573+69C4              DIR128_MAP_BAD:
 2574+69C4 D1                   pop     de
 2575+69C5 E1                   pop     hl
 2576+69C6 37                   scf
 2577+69C7 C9                   ret
 2578+69C8
 2579+69C8              ;Select first FTP directory page (page 0).
 2580+69C8              ; --- DOKUMENTACE CZ: DIR128_FIRST_PAGE ---
 2581+69C8              ; Ucel: Vybere první banku adresáře (RAM 0).
 2582+69C8              ; Vstup: Bez parametrů.
 2583+69C8              ; Vystup: fdp_pointer = ftp_dir_page+1; NC.
 2584+69C8              ; Meni: AF; BC, DE, HL, IX a IY zachovány.
 2585+69C8              ; Poznamka: Mění mapování RAM a PAGE128_STATE.
 2586+69C8              ; --- KONEC DOKUMENTACE CZ ---
 2587+69C8              DIR128_FIRST_PAGE:
 2588+69C8 E5                   push    hl
 2589+69C9 21 F1 BF             ld      hl,ftp_dir_page+1       ;first real entry = page 0
 2590+69CC 22 F6 BF             ld      (fdp_pointer),hl
 2591+69CF 7E                   ld      a,(hl)
 2592+69D0 CD E0 BF             call    PAGE128
 2593+69D3 E1                   pop     hl
 2594+69D4 B7                   or      a
 2595+69D5 C9                   ret
 2596+69D6
 2597+69D6              ;HL++ across #FFFF -> #C000 of the next directory page.
 2598+69D6              ;IMPORTANT: A is preserved. OUT: NC=OK, C=end of directory RAM.
 2599+69D6              ; --- DOKUMENTACE CZ: DIR128_INC_HL ---
 2600+69D6              ; Ucel: Posune adresu o bajt vpřed, případně přepne na další banku.
 2601+69D6              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
 2602+69D6              ; Vystup: NC = posun proveden; C = konec RAM, HL zůstane #FFFF.
 2603+69D6              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
 2604+69D6              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
 2605+69D6              ; --- KONEC DOKUMENTACE CZ ---
 2606+69D6              DIR128_INC_HL:
 2607+69D6 F5                   push    af                      ;old INC HL never changed A - preserve it here too
 2608+69D7 23                   inc     hl
 2609+69D8 7C                   ld      a,h
 2610+69D9 B7                   or      a                       ;normal increment unless #FFFF wrapped to #0000
 2611+69DA 28 03                jr      z,DIR128_INC_CROSS
 2612+69DC F1                   pop     af
 2613+69DD B7                   or      a                       ;restore A and return NC = OK
 2614+69DE C9                   ret
 2615+69DF
 2616+69DF              DIR128_INC_CROSS:
 2617+69DF D5                   push    de
 2618+69E0 ED 5B F6 BF          ld      de,(fdp_pointer)
 2619+69E4 13                   inc     de
 2620+69E5 1A                   ld      a,(de)
 2621+69E6 FE FF                cp      #FF
 2622+69E8 28 0E                jr      z,DIR128_INC_END
 2623+69EA ED 53 F6 BF          ld      (fdp_pointer),de
 2624+69EE CD E0 BF             call    PAGE128
 2625+69F1 21 00 C0             ld      hl,ftp_dir_start        ;#C000
 2626+69F4 D1                   pop     de
 2627+69F5 F1                   pop     af                      ;restore caller's A
 2628+69F6 B7                   or      a                       ;NC = OK, A unchanged
 2629+69F7 C9                   ret
 2630+69F8              DIR128_INC_END:
 2631+69F8 1B                   dec     de                      ;keep fdp_pointer on last valid page
 2632+69F9 ED 53 F6 BF          ld      (fdp_pointer),de
 2633+69FD 21 FF FF             ld      hl,#FFFF                ;restore last valid physical address
 2634+6A00 D1                   pop     de
 2635+6A01 F1                   pop     af                      ;restore caller's A
 2636+6A02 37                   scf                             ;C = no following directory page
 2637+6A03 C9                   ret
 2638+6A04
 2639+6A04              ;Parser-safe HL++ used while receiving FTP LIST/NLST.
 2640+6A04              ;Unlike the general helper, this preserves the COMPLETE parser state:
 2641+6A04              ;AF (including flags), BC, DE, IX and IY remain exactly unchanged.
 2642+6A04              ;Only HL / mapped page may change. End-of-64K status is returned in memory.
 2643+6A04              ;  dir128_parser_status = 0  OK
 2644+6A04              ;  dir128_parser_status = 1  no next directory page
 2645+6A04              ; --- DOKUMENTACE CZ: DIR128_INC_HL_PARSER ---
 2646+6A04              ; Ucel: Posune ukazatel přijímacího parseru bez změny příznaků CPU.
 2647+6A04              ; Vstup: HL = adresa v aktuální bance adresáře.
 2648+6A04              ; Vystup: dir128_parser_status = 0 při úspěchu, 1 na konci RAM.
 2649+6A04              ; Meni: Pouze HL; AF, BC, DE, IX a IY zachovány.
 2650+6A04              ; Poznamka: Může změnit fdp_pointer, PAGE128_STATE a mapování RAM.
 2651+6A04              ; --- KONEC DOKUMENTACE CZ ---
 2652+6A04              DIR128_INC_HL_PARSER:
 2653+6A04 F5                   push    af
 2654+6A05 D5                   push    de
 2655+6A06 AF                   xor     a
 2656+6A07 32 DC 88             ld      (dir128_parser_status),a
 2657+6A0A 23                   inc     hl
 2658+6A0B 7C                   ld      a,h
 2659+6A0C B7                   or      a
 2660+6A0D 20 14                jr      nz,.ok
 2661+6A0F ED 5B F6 BF          ld      de,(fdp_pointer)
 2662+6A13 13                   inc     de
 2663+6A14 1A                   ld      a,(de)
 2664+6A15 FE FF                cp      #FF
 2665+6A17 28 0D                jr      z,.full
 2666+6A19 ED 53 F6 BF          ld      (fdp_pointer),de
 2667+6A1D CD E0 BF             call    PAGE128
 2668+6A20 21 00 C0             ld      hl,ftp_dir_start
 2669+6A23              .ok:
 2670+6A23 D1                   pop     de
 2671+6A24 F1                   pop     af
 2672+6A25 C9                   ret
 2673+6A26              .full:
 2674+6A26 1B                   dec     de
 2675+6A27 ED 53 F6 BF          ld      (fdp_pointer),de
 2676+6A2B 21 FF FF             ld      hl,#FFFF
 2677+6A2E 3E 01                ld      a,1
 2678+6A30 32 DC 88             ld      (dir128_parser_status),a
 2679+6A33 D1                   pop     de
 2680+6A34 F1                   pop     af
 2681+6A35 C9                   ret
 2682+6A36
 2683+6A36              ;HL-- across #C000 -> #FFFF of the previous directory page.
 2684+6A36              ;IMPORTANT: A is preserved. OUT: NC=OK, C=start of directory RAM.
 2685+6A36              ; --- DOKUMENTACE CZ: DIR128_DEC_HL ---
 2686+6A36              ; Ucel: Posune adresu o bajt zpět, případně přepne na předchozí banku.
 2687+6A36              ; Vstup: HL = adresa ve stránkovaném okně; fdp_pointer = aktuální banka.
 2688+6A36              ; Vystup: NC = posun proveden; C = začátek RAM, HL zůstane #C000.
 2689+6A36              ; Meni: F, HL; A, BC, DE, IX a IY zachovány.
 2690+6A36              ; Poznamka: Při překročení hranice mění fdp_pointer a mapování RAM.
 2691+6A36              ; --- KONEC DOKUMENTACE CZ ---
 2692+6A36              DIR128_DEC_HL:
 2693+6A36 F5                   push    af                      ;old DEC HL never changed A - preserve it here too
 2694+6A37 2B                   dec     hl
 2695+6A38 7C                   ld      a,h
 2696+6A39 FE BF                cp      #BF                     ;only #C000-1 gives #BFFF
 2697+6A3B 28 03                jr      z,DIR128_DEC_CROSS
 2698+6A3D F1                   pop     af
 2699+6A3E B7                   or      a                       ;restore A and return NC = OK
 2700+6A3F C9                   ret
 2701+6A40
 2702+6A40              DIR128_DEC_CROSS:
 2703+6A40 D5                   push    de
 2704+6A41 ED 5B F6 BF          ld      de,(fdp_pointer)
 2705+6A45 1B                   dec     de
 2706+6A46 1A                   ld      a,(de)
 2707+6A47 FE FF                cp      #FF
 2708+6A49 28 0E                jr      z,DIR128_DEC_START
 2709+6A4B ED 53 F6 BF          ld      (fdp_pointer),de
 2710+6A4F CD E0 BF             call    PAGE128
 2711+6A52 21 FF FF             ld      hl,#FFFF
 2712+6A55 D1                   pop     de
 2713+6A56 F1                   pop     af                      ;restore caller's A
 2714+6A57 B7                   or      a                       ;NC = OK, A unchanged
 2715+6A58 C9                   ret
 2716+6A59              DIR128_DEC_START:
 2717+6A59 13                   inc     de                      ;keep fdp_pointer on first valid page
 2718+6A5A ED 53 F6 BF          ld      (fdp_pointer),de
 2719+6A5E 21 00 C0             ld      hl,ftp_dir_start        ;restore #C000
 2720+6A61 D1                   pop     de
 2721+6A62 F1                   pop     af                      ;restore caller's A
 2722+6A63 37                   scf                             ;C = no previous directory page
 2723+6A64 C9                   ret
 2724+6A65
 2725+6A65              ;Map page-table pointer stored in DE. HL is preserved.
 2726+6A65              ;IN: DE = pointer to one of the real entries in ftp_dir_page.
 2727+6A65              ; --- DOKUMENTACE CZ: DIR128_MAP_DE ---
 2728+6A65              ; Ucel: Namapuje banku určenou ukazatelem do tabulky.
 2729+6A65              ; Vstup: DE = adresa platné položky ftp_dir_page (nikoli číslo banky).
 2730+6A65              ; Vystup: fdp_pointer = DE; příslušná banka je dostupná v #C000–#FFFF.
 2731+6A65              ; Meni: Žádné z AF, BC, DE, HL, IX, IY.
 2732+6A65              ; Poznamka: Neověřuje sentinel; mění mapování RAM a PAGE128_STATE.
 2733+6A65              ; --- KONEC DOKUMENTACE CZ ---
 2734+6A65              DIR128_MAP_DE:
 2735+6A65 F5                   push    af
 2736+6A66 ED 53 F6 BF          ld      (fdp_pointer),de
 2737+6A6A 1A                   ld      a,(de)
 2738+6A6B CD E0 BF             call    PAGE128
 2739+6A6E F1                   pop     af
 2740+6A6F C9                   ret
 2741+6A70
 2742+6A70
 2743+6A70              ; -----------------------------------------------------------------------------
 2744+6A70              ; DIR128_COPY_NAME_TO_DE
 2745+6A70              ; Copy the name returned by get_item_name to fixed RAM.
 2746+6A70              ; IN:  HL = physical source address in directory window
 2747+6A70              ;      BC = 16-bit name length
 2748+6A70              ;      DE = fixed-RAM destination
 2749+6A70              ;      item_name_page = page-table pointer belonging to HL
 2750+6A70              ; OUT: DE points behind copied bytes, BC=0
 2751+6A70              ; The source may cross any #FFFF -> #C000 directory-page boundary.
 2752+6A70              ; -----------------------------------------------------------------------------
 2753+6A70              ; --- DOKUMENTACE CZ: DIR128_COPY_NAME_TO_DE ---
 2754+6A70              ; Ucel: Zkopíruje jméno ze stránkovaného adresáře do pevné RAM.
 2755+6A70              ; Vstup: HL = zdroj, BC = délka, DE = cíl; item_name_page = banka zdroje.
 2756+6A70              ; Vystup: BC = 0, DE za kopií; C při nedostatku bank před koncem kopie.
 2757+6A70              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
 2758+6A70              ; Poznamka: Nepřidává nulový terminátor. Mění cílovou paměť a mapování RAM.
 2759+6A70              ; --- KONEC DOKUMENTACE CZ ---
 2760+6A70              DIR128_COPY_NAME_TO_DE:
 2761+6A70 D5                   push    de
 2762+6A71 ED 5B C2 6F          ld      de,(item_name_page)
 2763+6A75 CD 65 6A             call    DIR128_MAP_DE
 2764+6A78 D1                   pop     de
 2765+6A79              .dir128_copy_loop:
 2766+6A79 78                   ld      a,b
 2767+6A7A B1                   or      c

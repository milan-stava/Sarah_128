 7670+7E19              ; --- DOKUMENTACE CZ: error_handler ---
 7671+7E19              ; Ucel: Zobrazí chybu, ukončí čekání a vrátí řízení na nejvyšší úroveň.
 7672+7E19              ; Vstup: C = číslo chyby; inicializovaný hlavní zásobník.
 7673+7E19              ; Vystup: Nevrací se běžně volajícímu: SP nastaví na basic_end-2.
 7674+7E19              ; Meni: AF, BC, DE, HL, BC' (přes příjem odpovědi); další registry externích služeb viz jejich
 7675+7E19              ;   rozhraní. SP.
 7676+7E19              ; Poznamka: Obnovuje 3,5 MHz a vypíná pasivní příjem.
 7677+7E19              ; --- KONEC DOKUMENTACE CZ ---
 7678+7E19 AF           error_handler xor a
 7679+7E1A 32 E3 A0                ld (upload_legacy_mode),a
 7680+7E1D C5                      push bc                ;preserve original error across clock switch
 7681+7E1E CD E8 81                call set_3_5mhz
 7682+7E21 C1                      pop bc
 7683+7E22 3A 4D 7E                ld a,(error_recovering)
 7684+7E25 B7                      or a
 7685+7E26 20 16                   jr nz,error_handler_exit ;cleanup itself failed: do not recurse again
 7686+7E28 3C                      inc a
 7687+7E29 32 4D 7E                ld (error_recovering),a
 7688+7E2C CD 4E 7E                call display_error
 7689+7E2F CD 0E 7C                call wifi_unwait
 7690+7E32 CD E3 A4                call at_reset_stream
 7691+7E35 DD CB 00 76             bit 6,(ix+0)
 7692+7E39 28 03                   jr z,error_handler_exit ;no cleanup AT commands at an unknown baud
 7693+7E3B CD 3A 83                call passive_receive_off ;one best-effort cleanup attempt only
 7694+7E3E              error_handler_exit
 7695+7E3E AF                      xor a
 7696+7E3F 32 4D 7E                ld (error_recovering),a
 7697+7E42 DD CB 00 76             bit 6,(ix+0)
 7698+7E46 CA A0 77                jp z,quit_keep_directory

6145+ 780D              ; Ucel: Vstup do převodu od řádu desetitisíců, resp. stovek.
6146+ 780D              ; Vstup: HL = číslo, DE = cíl; bit 7 v (IX+0) řídí tisk úvodních nul.
6147+ 780D              ; Vystup: DE za poslední číslicí, bez nulového terminátoru.
6148+ 780D              ; Meni: AF, BC, DE, HL; IX a IY zachovány.
6149+ 780D              ; Poznamka: Na rozdíl od HL2ASCII nenuluje bit 7. Pro pevnou šířku jej nastavte před voláním.
6150+ 780D              ; --- KONEC DOKUMENTACE CZ ---
6151+ 780D 01 64 00     HL2ASCII_000		ld bc,100
